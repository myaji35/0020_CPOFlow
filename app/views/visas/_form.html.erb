<%= form_with model: [@employee, visa], multipart: true, class: "flex flex-col gap-6" do |f| %>
  <% if visa.errors.any? %>
    <div class="bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 text-red-700 dark:text-red-400 px-4 py-3 rounded-lg text-sm">
      <% visa.errors.full_messages.each do |msg| %><p><%= msg %></p><% end %>
    </div>
  <% end %>

  <%= render "shared/form_with_documents", f: f, record: visa do %>
    <div class="grid grid-cols-2 gap-4">
      <div>
        <%= f.label :visa_type, t("visas.form.visa_type"), class: "block text-xs font-medium text-gray-600 dark:text-gray-500 mb-1" %>
        <%= f.select :visa_type, Visa::VISA_TYPES, { selected: visa.visa_type.presence || "Employment" },
            required: true,
            class: "w-full border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-primary" %>
      </div>
      <div>
        <%= f.label :issuing_country, t("visas.form.issuing_country"), class: "block text-xs font-medium text-gray-600 dark:text-gray-500 mb-1" %>
        <%= f.select :issuing_country,
            Employee::NATIONALITIES.map { |code, label| ["#{label} (#{code})", code] },
            { include_blank: t("visas.form.select_country"), selected: visa.issuing_country.presence || @employee&.nationality },
            required: true,
            class: "w-full border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-primary" %>
        <p class="text-xs text-gray-400 mt-1"><%= t("visas.form.country_default_hint") %></p>
      </div>
      <div>
        <%= f.label :visa_number, t("visas.form.visa_number"), class: "block text-xs font-medium text-gray-600 dark:text-gray-500 mb-1" %>
        <%= f.text_field :visa_number, class: "w-full border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-primary" %>
      </div>
      <div>
        <%= f.label :status, t("visas.form.status"), class: "block text-xs font-medium text-gray-600 dark:text-gray-500 mb-1" %>
        <%= f.select :status, [[t("visas.status.active"), "active"], [t("visas.status.expired"), "expired"], [t("visas.status.pending"), "pending"], [t("visas.status.cancelled"), "cancelled"]],
            { selected: visa.status.presence || "active" },
            required: true,
            class: "w-full border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-primary" %>
      </div>
      <div>
        <%= f.label :issue_date, t("visas.form.issue_date"), class: "block text-xs font-medium text-gray-600 dark:text-gray-500 mb-1" %>
        <%= f.date_field :issue_date, class: "w-full border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-primary" %>
      </div>
      <div>
        <%= f.label :expiry_date, t("visas.form.expiry_date"), class: "block text-xs font-medium text-gray-600 dark:text-gray-500 mb-1" %>
        <%= f.date_field :expiry_date, required: true, class: "w-full border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-primary" %>
      </div>
      <div class="col-span-2">
        <%= f.label :notes, t("visas.form.notes"), class: "block text-xs font-medium text-gray-600 dark:text-gray-500 mb-1" %>
        <%= f.text_area :notes, rows: 2, class: "w-full border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-primary resize-none" %>
      </div>
    </div>
  <% end %>

  <div class="flex justify-end gap-3">
    <%= link_to t("actions.cancel"), @employee, class: "px-4 py-2 border border-gray-200 dark:border-gray-600 text-gray-600 dark:text-gray-500 rounded-lg text-sm hover:bg-gray-50 dark:hover:bg-gray-700" %>
    <%= f.submit visa.new_record? ? t("visas.form.submit_create") : t("actions.save"),
        class: "px-4 py-2 bg-primary text-white rounded-lg text-sm font-medium hover:bg-primary-dark cursor-pointer" %>
  </div>
<% end %>
