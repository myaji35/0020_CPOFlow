<% content_for :title, @employee.name %>

<%# 만료 30일 이내 항목 경고 배지 %>
<%
  _visa = @employee.active_visa
  _contract = @employee.current_contract
  _visa_days = _visa ? _visa.days_until_expiry : nil
  _contract_days = _contract&.end_date ? (_contract.end_date - Date.today).to_i : nil
  _alerts = []
  _alerts << { label: "비자 만료 D-#{_visa_days}", urgent: _visa_days <= 14 } if _visa_days && _visa_days <= 30
  _alerts << { label: "계약 만료 D-#{_contract_days}", urgent: _contract_days <= 14 } if _contract_days && _contract_days <= 30
%>

<div class="flex flex-col gap-6">
  <% if _alerts.any? %>
    <div class="flex items-center gap-3 bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-xl px-4 py-3">
      <svg class="w-5 h-5 text-red-600 dark:text-red-400 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
      <div class="flex items-center gap-2 flex-wrap">
        <% _alerts.each do |a| %>
          <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold <%= a[:urgent] ? 'bg-red-600 text-white' : 'bg-orange-500 text-white' %>">
            <%= a[:label] %>
          </span>
        <% end %>
        <span class="text-sm text-red-700 dark:text-red-300 font-medium ml-1">갱신 절차를 확인하세요</span>
      </div>
    </div>
  <% end %>

  <!-- Header -->
  <div class="flex items-start justify-between">
    <div class="flex items-center gap-4">
      <!-- FR-01: 아바타 (80px 원형 — 사진 또는 이니셜 fallback) -->
      <div class="flex-shrink-0">
        <%= render "employee_avatar", employee: @employee, size_px: 80 %>
      </div>
      <div>
        <div class="flex items-center gap-2 text-sm text-gray-500 dark:text-gray-500 mb-1">
          <%= link_to "직원 관리", employees_path, class: "hover:text-primary" %>
          <span>/</span>
          <span><%= @employee.name %></span>
        </div>
        <h1 class="text-2xl font-bold text-gray-900 dark:text-white"><%= @employee.name %></h1>
        <div class="flex items-center gap-3 mt-1.5 text-sm text-gray-500 dark:text-gray-500">
          <% if @employee.name_en.present? %><span><%= @employee.name_en %></span><% end %>
          <span class="inline-flex px-2 py-0.5 text-xs font-medium rounded-full bg-blue-50 dark:bg-blue-900/30 text-blue-700 dark:text-blue-400"><%= @employee.nationality_label %></span>
          <span class="inline-flex px-2 py-0.5 text-xs font-medium rounded-full bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-500"><%= @employee.employment_type_label %></span>
          <% if @employee.job_title.present? %>
            <span class="inline-flex px-2 py-0.5 text-xs font-medium rounded-full bg-indigo-50 dark:bg-indigo-900/30 text-indigo-700 dark:text-indigo-400"><%= @employee.job_title %></span>
          <% end %>
          <% unless @employee.active? %>
            <span class="inline-flex px-2 py-0.5 text-xs font-bold rounded-full bg-red-50 dark:bg-red-900/30 text-red-700 dark:text-red-400">퇴직</span>
          <% end %>
        </div>
      </div>
    </div>
    <div class="flex gap-2">
      <%= link_to edit_employee_path(@employee), class: "inline-flex items-center gap-1 border border-gray-200 dark:border-gray-600 text-gray-600 dark:text-gray-500 px-3 py-2 rounded-lg text-sm hover:bg-gray-50 dark:hover:bg-gray-700" do %>
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
        수정
      <% end %>
      <% if current_user.manager? || current_user.admin? %>
        <%= link_to employee_path(@employee), data: { turbo_method: :delete, turbo_confirm: "직원을 삭제하시겠습니까?" },
            class: "inline-flex items-center gap-1 border border-red-200 dark:border-red-800 text-red-600 dark:text-red-400 px-3 py-2 rounded-lg text-sm hover:bg-red-50 dark:hover:bg-red-900/20" do %>
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6m4-6v6"/><path d="M9 6V4h6v2"/></svg>
          삭제
        <% end %>
      <% end %>
    </div>
  </div>

  <!-- KPI 카드 -->
  <div class="grid grid-cols-4 gap-4">
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-4 shadow-sm">
      <p class="text-xs text-gray-500 dark:text-gray-500">재직 기간</p>
      <% if @employee.hire_date %>
        <!-- FR-05: tenure_label -->
        <p class="text-xl font-bold text-gray-900 dark:text-white mt-1"><%= @employee.tenure_label %></p>
        <p class="text-xs text-gray-500 dark:text-gray-500"><%= @employee.hire_date.strftime("%Y.%m.%d") %> 입사 (<%= @employee.tenure_days %>일)</p>
      <% else %>
        <p class="text-xl font-bold text-gray-500 dark:text-gray-500 mt-1">-</p>
      <% end %>
    </div>
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-4 shadow-sm">
      <p class="text-xs text-gray-500 dark:text-gray-500">현재 현장</p>
      <% assignment = @employee.current_assignment %>
      <% if assignment %>
        <p class="text-sm font-bold text-primary mt-1"><%= assignment.project.name %></p>
        <p class="text-xs text-gray-500 dark:text-gray-500"><%= assignment.role %></p>
      <% else %>
        <p class="text-xl font-bold text-gray-500 dark:text-gray-500 mt-1">-</p>
      <% end %>
    </div>
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-4 shadow-sm">
      <p class="text-xs text-gray-500 dark:text-gray-500">비자 만료까지</p>
      <% visa = @employee.active_visa %>
      <% if visa %>
        <% days = visa.days_until_expiry %>
        <p class="text-xl font-bold <%= days <= 30 ? 'text-red-600 dark:text-red-400' : days <= 60 ? 'text-yellow-600 dark:text-yellow-400' : 'text-gray-900 dark:text-white' %> mt-1">
          <%= days >= 0 ? "D-#{days}" : "만료됨" %>
        </p>
        <p class="text-xs text-gray-500 dark:text-gray-500"><%= visa.expiry_date.strftime("%Y.%m.%d") %></p>
      <% else %>
        <%# ISS-272: 비자 미등록 시 명시적 CTA — member 이상만 %>
        <% if current_user.admin? || current_user.manager? || current_user.member? %>
          <%= link_to new_employee_visa_path(@employee),
                      class: "mt-2 inline-flex items-center gap-1.5 bg-[#166c72] hover:bg-[#11555a] text-white px-3 py-1.5 rounded-md text-xs font-semibold transition-colors" do %>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            비자 등록
          <% end %>
        <% else %>
          <p class="text-xl font-bold text-gray-500 dark:text-gray-500 mt-1">-</p>
        <% end %>
      <% end %>
    </div>
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-4 shadow-sm">
      <p class="text-xs text-gray-500 dark:text-gray-500">계약 만료까지</p>
      <% contract = @employee.current_contract %>
      <% if contract&.end_date %>
        <% days = (contract.end_date - Date.today).to_i %>
        <p class="text-xl font-bold <%= days <= 14 ? 'text-red-600 dark:text-red-400' : days <= 30 ? 'text-orange-600 dark:text-orange-400' : 'text-gray-900 dark:text-white' %> mt-1">
          <%= days >= 0 ? "D-#{days}" : "만료됨" %>
        </p>
        <p class="text-xs text-gray-500 dark:text-gray-500"><%= contract.end_date.strftime("%Y.%m.%d") %></p>
      <% else %>
        <%# ISS-272: 계약 미등록 시 명시적 CTA — member 이상만 %>
        <% if current_user.admin? || current_user.manager? || current_user.member? %>
          <%= link_to new_employee_employment_contract_path(@employee),
                      class: "mt-2 inline-flex items-center gap-1.5 bg-[#166c72] hover:bg-[#11555a] text-white px-3 py-1.5 rounded-md text-xs font-semibold transition-colors" do %>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            계약 등록
          <% end %>
        <% else %>
          <p class="text-xl font-bold text-gray-500 dark:text-gray-500 mt-1">-</p>
        <% end %>
      <% end %>
    </div>
  </div>

  <!-- FR-02: 탭 URL 직링크 -->
  <div x-data="{
    tab: new URLSearchParams(window.location.search).get('tab') || 'info',
    switchTab(t) {
      this.tab = t;
      const url = new URL(window.location);
      url.searchParams.set('tab', t);
      window.history.pushState({}, '', url);
    }
  }" class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 shadow-sm">
    <div class="border-b border-gray-200 dark:border-gray-700 px-4">
      <nav class="flex gap-6">
        <button @click="switchTab('info')" :class="tab==='info' ? 'border-primary text-primary' : 'border-transparent text-gray-500 dark:text-gray-500 hover:text-gray-700 dark:hover:text-gray-300'"
            class="py-3 border-b-2 text-sm font-medium transition-colors">기본정보</button>
        <button @click="switchTab('visas')" :class="tab==='visas' ? 'border-primary text-primary' : 'border-transparent text-gray-500 dark:text-gray-500 hover:text-gray-700 dark:hover:text-gray-300'"
            class="py-3 border-b-2 text-sm font-medium transition-colors">비자 (<%= @visas.count %>)</button>
        <button @click="switchTab('contracts')" :class="tab==='contracts' ? 'border-primary text-primary' : 'border-transparent text-gray-500 dark:text-gray-500 hover:text-gray-700 dark:hover:text-gray-300'"
            class="py-3 border-b-2 text-sm font-medium transition-colors">계약 (<%= @contracts.count %>)</button>
        <button @click="switchTab('certs')" :class="tab==='certs' ? 'border-primary text-primary' : 'border-transparent text-gray-500 dark:text-gray-500 hover:text-gray-700 dark:hover:text-gray-300'"
            class="py-3 border-b-2 text-sm font-medium transition-colors">자격증 (<%= @certifications.count %>)</button>
        <button @click="switchTab('warnings')" :class="tab==='warnings' ? 'border-primary text-primary' : 'border-transparent text-gray-500 dark:text-gray-500 hover:text-gray-700 dark:hover:text-gray-300'"
            class="py-3 border-b-2 text-sm font-medium transition-colors">경고장 (<%= @warnings_count %>)</button>
      </nav>
    </div>

    <!-- 기본정보 탭 -->
    <div x-show="tab==='info'" class="p-6">
      <dl class="grid grid-cols-2 gap-x-8 gap-y-4 text-sm">
        <div><dt class="text-gray-500 dark:text-gray-500">이름 (한글)</dt><dd class="font-medium text-gray-900 dark:text-white mt-1"><%= @employee.name %></dd></div>
        <div><dt class="text-gray-500 dark:text-gray-500">이름 (영문)</dt><dd class="font-medium text-gray-900 dark:text-white mt-1"><%= @employee.name_en.presence || "-" %></dd></div>
        <div><dt class="text-gray-500 dark:text-gray-500">국적</dt><dd class="font-medium text-gray-900 dark:text-white mt-1"><%= @employee.nationality_label %></dd></div>
        <div><dt class="text-gray-500 dark:text-gray-500">생년월일</dt><dd class="font-medium text-gray-900 dark:text-white mt-1"><%= @employee.date_of_birth&.strftime("%Y-%m-%d") || "-" %></dd></div>
        <% if current_user.manager? || current_user.admin? %>
          <div><dt class="text-gray-500 dark:text-gray-500">여권번호</dt><dd class="font-medium text-gray-900 dark:text-white mt-1"><%= @employee.passport_number.presence || "-" %></dd></div>
        <% end %>
        <!-- FR-03: 전화번호 원클릭 -->
        <div>
          <dt class="text-gray-500 dark:text-gray-500">전화번호</dt>
          <dd class="mt-1">
            <% if @employee.phone.present? %>
              <div class="flex items-center gap-2">
                <a href="tel:<%= @employee.phone %>" class="font-medium text-gray-900 dark:text-white hover:text-primary flex items-center gap-1">
                  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13.6 19.79 19.79 0 0 1 1.63 5a2 2 0 0 1 1.99-2.18h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.91 10.1a16 16 0 0 0 6 6l.92-.92a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 17.58z"/></svg>
                  <%= @employee.phone %>
                </a>
                <a href="https://wa.me/<%= @employee.phone.gsub(/\D/, '') %>" target="_blank" rel="noopener"
                   class="w-6 h-6 flex items-center justify-center rounded-full bg-green-50 dark:bg-green-900/30 text-green-600 dark:text-green-400 hover:bg-green-100 dark:hover:bg-green-900/50"
                   title="WhatsApp으로 연락">
                  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>
                </a>
              </div>
            <% else %>
              <span class="font-medium text-gray-500 dark:text-gray-500">-</span>
            <% end %>
          </dd>
        </div>
        <div><dt class="text-gray-500 dark:text-gray-500">비상 연락처</dt><dd class="font-medium text-gray-900 dark:text-white mt-1"><%= @employee.emergency_contact.presence || "-" %></dd></div>
        <div>
          <dt class="text-gray-500 dark:text-gray-500">비상 연락전화</dt>
          <dd class="mt-1">
            <% if @employee.emergency_phone.present? %>
              <a href="tel:<%= @employee.emergency_phone %>" class="font-medium text-gray-900 dark:text-white hover:text-primary flex items-center gap-1 w-fit">
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13.6 19.79 19.79 0 0 1 1.63 5a2 2 0 0 1 1.99-2.18h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.91 10.1a16 16 0 0 0 6 6l.92-.92a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 17.58z"/></svg>
                <%= @employee.emergency_phone %>
              </a>
            <% else %>
              <span class="font-medium text-gray-500 dark:text-gray-500">-</span>
            <% end %>
          </dd>
        </div>
        <div><dt class="text-gray-500 dark:text-gray-500">부서</dt><dd class="font-medium text-gray-900 dark:text-white mt-1"><%= @employee.department&.name || "-" %></dd></div>
        <div><dt class="text-gray-500 dark:text-gray-500">직급</dt><dd class="font-medium text-gray-900 dark:text-white mt-1"><%= @employee.job_title.presence || "-" %></dd></div>
        <div><dt class="text-gray-500 dark:text-gray-500">고용형태</dt><dd class="font-medium text-gray-900 dark:text-white mt-1"><%= @employee.employment_type_label %></dd></div>
        <div><dt class="text-gray-500 dark:text-gray-500">입사일</dt><dd class="font-medium text-gray-900 dark:text-white mt-1"><%= @employee.hire_date&.strftime("%Y-%m-%d") || "-" %></dd></div>
        <% if @employee.notes.present? %>
          <div class="col-span-2"><dt class="text-gray-500 dark:text-gray-500">메모</dt><dd class="font-medium text-gray-900 dark:text-white mt-1 whitespace-pre-wrap"><%= @employee.notes %></dd></div>
        <% end %>
      </dl>

      <%# ISS-322 (직원 첨부 카드뷰) — 기본정보 탭 끝 %>
      <% docs = @employee.documents.includes(:blob).to_a rescue [] %>
      <div class="mt-6 pt-6 border-t border-gray-200 dark:border-gray-700">
        <div class="flex items-center justify-between mb-3">
          <h3 class="text-sm font-semibold text-gray-700 dark:text-gray-300">
            첨부 문서 <span class="text-xs text-gray-500">(<%= docs.size %>건)</span>
          </h3>
          <% if can_update?(:employees) || current_user.admin_or_manager? %>
            <%= link_to "+ 파일 추가", edit_employee_path(@employee, anchor: "documents"),
                class: "text-xs text-primary hover:text-primary-dark font-medium" %>
          <% end %>
        </div>
        <% if docs.any? %>
          <div id="employee-documents-grid" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3">
            <% docs.each do |doc| %>
              <% blob = doc.blob %>
              <% ext = File.extname(blob.filename.to_s).downcase.delete(".") %>
              <% icon_color = case ext
                              when "pdf" then "text-red-500"
                              when "xls", "xlsx", "csv" then "text-emerald-600"
                              when "doc", "docx" then "text-blue-600"
                              when "jpg", "jpeg", "png", "gif", "webp", "heic" then "text-purple-500"
                              else "text-gray-500"
                              end %>
              <% is_image = blob.content_type.to_s.start_with?("image/") %>
              <div data-doc-id="<%= doc.id %>"
                   class="group relative bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg p-3 hover:shadow-md hover:border-primary transition-all">
                <%# 미리보기/아이콘 영역 %>
                <div class="flex items-center justify-center h-24 bg-gray-50 dark:bg-gray-700/40 rounded mb-2 overflow-hidden">
                  <% if is_image %>
                    <%= image_tag rails_blob_path(doc), class: "w-full h-full object-cover", loading: "lazy" %>
                  <% else %>
                    <svg class="w-12 h-12 <%= icon_color %>" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                      <polyline points="14 2 14 8 20 8"/>
                    </svg>
                  <% end %>
                </div>
                <%# 파일 정보 %>
                <div class="min-w-0">
                  <p class="text-xs font-medium text-gray-900 dark:text-white truncate" title="<%= blob.filename %>">
                    <%= blob.filename %>
                  </p>
                  <div class="flex items-center justify-between mt-1">
                    <span class="text-[10px] text-gray-500 uppercase font-mono"><%= ext.presence || "?" %></span>
                    <span class="text-[10px] text-gray-500"><%= number_to_human_size(blob.byte_size) %></span>
                  </div>
                </div>
                <%# 액션 버튼 (hover 시) %>
                <div class="absolute top-2 right-2 flex gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
                  <%= link_to rails_blob_path(doc, disposition: "attachment"),
                      class: "w-6 h-6 flex items-center justify-center bg-white dark:bg-gray-700 border border-gray-200 dark:border-gray-600 rounded shadow-sm hover:bg-gray-50",
                      title: "다운로드" do %>
                    <svg class="w-3 h-3 text-gray-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="text-center py-8 bg-gray-50 dark:bg-gray-700/30 rounded-lg border border-dashed border-gray-200 dark:border-gray-700">
            <svg class="w-10 h-10 mx-auto text-gray-300 mb-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
            <p class="text-xs text-gray-500">첨부된 문서가 없습니다.</p>
            <p class="text-[10px] text-gray-400 mt-1">계약서, 비자 사본, 자격증 등을 직원 수정 페이지에서 업로드하세요.</p>
          </div>
        <% end %>
      </div>
    </div>

    <!-- 비자 탭 -->
    <div x-show="tab==='visas'" class="p-4">
      <div class="flex justify-between items-center mb-4">
        <h3 class="font-medium text-gray-900 dark:text-white">비자 목록</h3>
        <%= link_to new_employee_visa_path(@employee), class: "inline-flex items-center gap-1 text-sm text-primary hover:underline" do %>
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          비자 추가
        <% end %>
      </div>
      <div class="space-y-3">
        <% @visas.each do |visa| %>
          <% needs_renewal = visa.days_until_expiry <= 60 && visa.renewal_started_at.nil? %>
          <% in_renewal = visa.renewal_started_at.present? %>
          <div class="flex items-center justify-between p-3 border <%= needs_renewal ? 'border-yellow-300 dark:border-yellow-700 bg-yellow-50/50 dark:bg-yellow-900/10' : (in_renewal ? 'border-blue-300 dark:border-blue-700 bg-blue-50/50 dark:bg-blue-900/10' : 'border-gray-200 dark:border-gray-700') %> rounded-lg hover:border-primary/30 transition-colors">
            <div class="flex items-center gap-4">
              <div>
                <div class="flex items-center gap-2">
                  <span class="font-medium text-sm text-gray-900 dark:text-white"><%= visa.visa_type %></span>
                  <span class="text-xs text-gray-500 dark:text-gray-500">(<%= visa.issuing_country %>)</span>
                  <span class="inline-flex px-2 py-0.5 text-xs font-medium rounded-full <%= visa.expiry_badge_class %>">
                    <%= visa.expiry_date.strftime("%Y-%m-%d") %>
                    (<%= visa.days_until_expiry >= 0 ? "D-#{visa.days_until_expiry}" : "만료" %>)
                  </span>
                  <% if in_renewal %>
                    <% auto_started = visa.renewal_note.to_s.include?("자동 시작") %>
                    <span class="inline-flex items-center gap-1 px-2 py-0.5 text-xs font-medium rounded-full bg-[#00A1E0] text-white" title="갱신 시작: <%= visa.renewal_started_at.strftime('%Y-%m-%d') %>">
                      <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M23 4v6h-6"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
                      갱신 진행중
                    </span>
                    <% if auto_started %>
                      <span class="inline-flex items-center gap-1 px-1.5 py-0.5 text-[10px] font-medium rounded-full bg-amber-100 dark:bg-amber-900/40 text-amber-700 dark:text-amber-300 border border-amber-200 dark:border-amber-900/50" title="HrExpiryNotificationJob이 D-60에 자동 시작">
                        🤖 자동
                      </span>
                    <% end %>
                  <% end %>
                </div>
                <p class="text-xs text-gray-500 dark:text-gray-500 mt-0.5">번호: <%= visa.visa_number.presence || "-" %> | 발급: <%= visa.issue_date&.strftime("%Y-%m-%d") || "-" %><% if in_renewal %> | 갱신 시작: <%= visa.renewal_started_at.strftime("%Y-%m-%d") %><% end %></p>
                <% if in_renewal && visa.renewal_note.present? %>
                  <p class="text-xs text-blue-700 dark:text-blue-300 mt-1">📝 <%= visa.renewal_note %></p>
                <% end %>
              </div>
            </div>
            <div class="flex gap-2 items-center">
              <% if needs_renewal %>
                <%= button_to start_renewal_employee_visa_path(@employee, visa),
                    method: :post,
                    data: { turbo_confirm: "비자 갱신 프로세스를 시작하시겠습니까?" },
                    class: "inline-flex items-center gap-1 text-xs bg-[#F4A83A] text-white px-2.5 py-1 rounded-lg hover:bg-orange-500 transition-colors font-medium" do %>
                  <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M23 4v6h-6"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
                  갱신 시작
                <% end %>
              <% end %>
              <%= link_to edit_employee_visa_path(@employee, visa), class: "text-xs text-gray-500 dark:text-gray-500 hover:text-primary" do %>수정<% end %>
              <%= link_to employee_visa_path(@employee, visa), data: { turbo_method: :delete, turbo_confirm: "비자를 삭제하시겠습니까?" },
                  class: "text-xs text-gray-500 dark:text-gray-500 hover:text-red-500" do %>삭제<% end %>
            </div>
          </div>
        <% end %>
        <!-- FR-04: 빈 상태 CTA -->
        <% if @visas.empty? %>
          <div class="flex flex-col items-center justify-center py-10 gap-3">
            <svg class="w-10 h-10 text-gray-200 dark:text-gray-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
            <p class="text-sm text-gray-500 dark:text-gray-500">등록된 비자가 없습니다.</p>
            <%= link_to new_employee_visa_path(@employee),
                class: "inline-flex items-center gap-1 text-sm text-primary border border-primary/30 rounded-lg px-3 py-1.5 hover:bg-primary/5 transition-colors" do %>
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
              비자 추가
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

    <!-- 계약 탭 -->
    <div x-show="tab==='contracts'" class="p-4">
      <div class="flex justify-between items-center mb-4">
        <h3 class="font-medium text-gray-900 dark:text-white">계약 이력</h3>
        <%= link_to new_employee_employment_contract_path(@employee), class: "inline-flex items-center gap-1 text-sm text-primary hover:underline" do %>
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          계약 추가
        <% end %>
      </div>
      <div class="space-y-3">
        <% @contracts.each do |contract| %>
          <div class="flex items-center justify-between p-3 border border-gray-200 dark:border-gray-700 rounded-lg hover:border-primary/30 transition-colors">
            <div>
              <div class="flex items-center gap-2">
                <span class="inline-flex px-2 py-0.5 text-xs font-medium rounded-full <%= contract.status_badge_class %>"><%= contract.status_label %></span>
                <span class="text-sm font-medium text-gray-900 dark:text-white">
                  <%= contract.start_date.strftime("%Y.%m.%d") %> ~
                  <%= contract.end_date&.strftime("%Y.%m.%d") || "기간 없음" %>
                </span>
              </div>
              <div class="text-xs text-gray-500 dark:text-gray-500 mt-0.5">
                <% if contract.base_salary.present? && (current_user.manager? || current_user.admin?) %>
                  급여: <%= contract.currency %> <%= number_with_delimiter(contract.base_salary.to_i) %> / <%= contract.pay_frequency_label %>
                <% end %>
                <% if contract.project.present? %>
                  | 현장: <%= contract.project.name %>
                <% end %>
              </div>
            </div>
            <div class="flex gap-2">
              <%= link_to edit_employee_employment_contract_path(@employee, contract), class: "text-xs text-gray-500 dark:text-gray-500 hover:text-primary" do %>수정<% end %>
              <%= link_to employee_employment_contract_path(@employee, contract),
                  data: { turbo_method: :delete, turbo_confirm: "계약을 삭제하시겠습니까?" },
                  class: "text-xs text-gray-500 dark:text-gray-500 hover:text-red-500" do %>삭제<% end %>
            </div>
          </div>
        <% end %>
        <!-- FR-04: 빈 상태 CTA -->
        <% if @contracts.empty? %>
          <div class="flex flex-col items-center justify-center py-10 gap-3">
            <svg class="w-10 h-10 text-gray-200 dark:text-gray-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
            <p class="text-sm text-gray-500 dark:text-gray-500">등록된 계약이 없습니다.</p>
            <%= link_to new_employee_employment_contract_path(@employee),
                class: "inline-flex items-center gap-1 text-sm text-primary border border-primary/30 rounded-lg px-3 py-1.5 hover:bg-primary/5 transition-colors" do %>
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
              계약 추가
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

    <!-- 자격증 탭 -->
    <div x-show="tab==='certs'" class="p-4">
      <div class="flex justify-between items-center mb-4">
        <h3 class="font-medium text-gray-900 dark:text-white">자격증/교육 이력</h3>
        <%= link_to new_employee_certification_path(@employee), class: "inline-flex items-center gap-1 text-sm text-primary hover:underline" do %>
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          자격증 추가
        <% end %>
      </div>
      <div class="space-y-3">
        <% @certifications.each do |cert| %>
          <div class="flex items-center justify-between p-3 border border-gray-200 dark:border-gray-700 rounded-lg hover:border-primary/30 transition-colors">
            <div>
              <div class="flex items-center gap-2">
                <span class="font-medium text-sm text-gray-900 dark:text-white"><%= cert.name %></span>
                <% if cert.expiry_date %>
                  <span class="inline-flex px-2 py-0.5 text-xs font-medium rounded-full <%= cert.expiry_badge_class %>">
                    <%= cert.expired? ? "만료" : cert.expiring_soon? ? "만료임박" : "유효" %>
                  </span>
                <% end %>
              </div>
              <p class="text-xs text-gray-500 dark:text-gray-500 mt-0.5">
                <%= cert.issuing_body.presence || "발급기관 미기재" %> |
                취득: <%= cert.issued_date&.strftime("%Y-%m-%d") || "-" %>
                <% if cert.expiry_date %>| 만료: <%= cert.expiry_date.strftime("%Y-%m-%d") %><% end %>
              </p>
            </div>
            <div class="flex gap-2">
              <%= link_to edit_employee_certification_path(@employee, cert), class: "text-xs text-gray-500 dark:text-gray-500 hover:text-primary" do %>수정<% end %>
              <%= link_to employee_certification_path(@employee, cert),
                  data: { turbo_method: :delete, turbo_confirm: "자격증을 삭제하시겠습니까?" },
                  class: "text-xs text-gray-500 dark:text-gray-500 hover:text-red-500" do %>삭제<% end %>
            </div>
          </div>
        <% end %>
        <!-- FR-04: 빈 상태 CTA -->
        <% if @certifications.empty? %>
          <div class="flex flex-col items-center justify-center py-10 gap-3">
            <svg class="w-10 h-10 text-gray-200 dark:text-gray-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89L17 22l-5-3-5 3 1.523-9.11"/></svg>
            <p class="text-sm text-gray-500 dark:text-gray-500">등록된 자격증이 없습니다.</p>
            <%= link_to new_employee_certification_path(@employee),
                class: "inline-flex items-center gap-1 text-sm text-primary border border-primary/30 rounded-lg px-3 py-1.5 hover:bg-primary/5 transition-colors" do %>
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
              자격증 추가
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

    <!-- 경고장 탭 (ISS-332+) UAE Federal Decree-Law 33/2021 -->
    <div x-show="tab==='warnings'" class="p-4">
      <% active_count = @employee.active_warnings_count %>
      <% threshold = EmployeeWarning::TERMINATION_THRESHOLD %>
      <% has_gross = @employee.has_gross_misconduct? %>

      <%# UAE 누적 알림 배너 %>
      <% if active_count >= threshold || has_gross %>
        <div class="mb-4 bg-red-50 dark:bg-red-900/20 border border-red-300 dark:border-red-700 rounded-lg p-3 flex items-start gap-2">
          <svg class="w-5 h-5 text-red-600 mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/></svg>
          <div class="text-sm">
            <p class="font-semibold text-red-800 dark:text-red-300">⚠️ 해고 검토 필요 (UAE 노동법)</p>
            <% if has_gross %>
              <p class="text-xs text-red-700 dark:text-red-400 mt-1">Art.44 즉시 해고 사유 활성 경고 존재 — 비자/추방 절차 검토</p>
            <% end %>
            <% if active_count >= threshold %>
              <p class="text-xs text-red-700 dark:text-red-400 mt-1">활성 경고장 <%= active_count %>회 (기준 <%= threshold %>회 도달) — 실무 관행상 해고 검토 단계</p>
            <% end %>
          </div>
        </div>
      <% elsif active_count > 0 %>
        <div class="mb-4 bg-yellow-50 dark:bg-yellow-900/20 border border-yellow-300 dark:border-yellow-700 rounded-lg p-2.5 text-xs text-yellow-800 dark:text-yellow-300">
          활성 경고장 <strong><%= active_count %>회</strong> / <%= threshold %>회 — 1회 누적당 위험 증가
        </div>
      <% end %>

      <div class="flex justify-between items-center mb-4">
        <h3 class="font-medium text-gray-900 dark:text-white">경고장 이력 (UAE Art.39/44)</h3>
        <% if current_user.member? || current_user.manager? || current_user.admin? %>
          <%= link_to new_employee_warning_path(@employee), class: "inline-flex items-center gap-1 text-sm text-primary hover:underline" do %>
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            경고장 발급
          <% end %>
        <% end %>
      </div>
      <div class="space-y-2">
        <% @warnings.each do |w| %>
          <div class="flex items-center justify-between p-3 border border-gray-200 dark:border-gray-700 rounded-lg hover:border-primary/30 transition-colors">
            <div class="flex items-center gap-3 min-w-0 flex-1">
              <span class="inline-flex px-2 py-0.5 text-xs font-medium rounded-full <%= w.severity_badge_class %>"><%= w.severity_label.split(":").first %></span>
              <span class="inline-flex px-2 py-0.5 text-xs font-medium rounded-full <%= w.status_badge_class %>"><%= w.status_label %></span>
              <% if w.gross_misconduct? %>
                <span class="inline-flex px-2 py-0.5 text-xs font-bold rounded-full bg-red-100 text-red-800 border border-red-300">Art.44</span>
              <% end %>
              <% if w.visa_action_required? %>
                <span class="inline-flex px-2 py-0.5 text-xs font-bold rounded-full bg-purple-100 text-purple-800 border border-purple-300">비자조치</span>
              <% end %>
              <div class="min-w-0 flex-1">
                <p class="text-sm font-medium text-gray-900 dark:text-white truncate"><%= w.subject %></p>
                <p class="text-xs text-gray-500 dark:text-gray-500 mt-0.5">
                  <%= w.category_label.split("(").first.strip %> · <%= w.issued_at.strftime("%Y.%m.%d") %>
                  <% if w.issued_by %> · 발급: <%= w.issued_by.name %><% end %>
                  <% unless w.notification_complete? %><span class="text-amber-600">· ⚠ Art.41 통지 미완료</span><% end %>
                </p>
              </div>
            </div>
            <%= link_to employee_warning_path(@employee, w), class: "text-xs text-gray-400 hover:text-primary shrink-0" do %>상세<% end %>
          </div>
        <% end %>
        <% if @warnings.empty? %>
          <div class="flex flex-col items-center justify-center py-10 gap-3">
            <svg class="w-10 h-10 text-gray-200 dark:text-gray-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
            <p class="text-sm text-gray-500 dark:text-gray-500">경고장 이력이 없습니다.</p>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
