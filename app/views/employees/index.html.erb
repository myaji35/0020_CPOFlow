<% content_for :title, t("employees.title") %>

<div class="flex flex-col gap-6">
  <!-- Header -->
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-gray-900 dark:text-white"><%= t("employees.title") %></h1>
      <p class="text-sm text-gray-500 dark:text-gray-500 mt-1"><%= t("employees.subtitle") %></p>
    </div>
    <div class="flex items-center gap-2">
      <%# ISS-311: CSV 다운로드 — admin/manager만 노출 %>
      <% if current_user.admin_or_manager? %>
        <%= link_to employees_path(request.query_parameters.merge(format: :csv)),
            class: "inline-flex items-center gap-2 px-3 py-2 text-sm text-gray-700 dark:text-gray-300 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-600 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors" do %>
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          <%= t("employees.csv_download") %>
        <% end %>
      <% end %>
      <%# ISS-264: viewer는 Create 버튼 비노출 %>
      <% if current_user.admin? || current_user.manager? || current_user.member? %>
        <%= link_to new_employee_path, class: "inline-flex items-center gap-2 bg-primary text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-primary-dark transition-colors" do %>
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          <%= t("employees.new") %>
        <% end %>
      <% end %>
    </div>
  </div>

  <!-- 비자 만료 임박 배너 (ISS-205: 갱신 워크플로우 시작 CTA) -->
  <% if @stats[:visa_expiring] > 0 %>
    <div class="flex items-center gap-3 bg-yellow-50 dark:bg-yellow-900/20 border border-yellow-200 dark:border-yellow-800 rounded-xl px-4 py-3">
      <svg class="w-5 h-5 text-yellow-600 dark:text-yellow-400 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
      <div class="flex-1">
        <p class="text-sm font-semibold text-yellow-800 dark:text-yellow-300">
          <%= t("employees.visa_expiry_banner", count: @stats[:visa_expiring]) %>
          <% if @stats[:visa_renewal_needed].to_i > 0 %>
            <span class="ml-2 inline-flex items-center gap-1 px-2 py-0.5 text-xs font-bold bg-[#D93025] text-white rounded-full">
              <%= t("employees.visa_renewal_needed", count: @stats[:visa_renewal_needed]) %>
            </span>
          <% end %>
          <% if @stats[:visa_in_renewal].to_i > 0 %>
            <span class="ml-1 inline-flex items-center gap-1 px-2 py-0.5 text-xs font-bold bg-[#00A1E0] text-white rounded-full">
              <%= t("employees.visa_in_renewal", count: @stats[:visa_in_renewal]) %>
            </span>
          <% end %>
        </p>
        <p class="text-xs text-yellow-700 dark:text-yellow-400 mt-0.5"><%= t("employees.visa_expiry_desc") %></p>
      </div>
      <%= link_to employees_path(expiring: "visa"), class: "text-xs font-medium text-yellow-700 dark:text-yellow-400 hover:text-yellow-900 dark:hover:text-yellow-200 underline flex-shrink-0" do %>
        <%= t("employees.visa_view_targets") %>
      <% end %>
    </div>
  <% end %>

  <%# AUDIT-005: 미매핑 직원 경고 카드 — admin만 표시 %>
  <% if current_user.admin? && @stats[:unmapped] > 0 %>
    <div class="flex items-center gap-3 bg-orange-50 dark:bg-orange-900/20 border border-orange-200 dark:border-orange-800 rounded-xl px-4 py-3">
      <svg class="w-5 h-5 text-orange-600 dark:text-orange-400 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
      <div class="flex-1">
        <p class="text-sm font-semibold text-orange-800 dark:text-orange-300">
          <%= t("employees.unmapped_banner", count: @stats[:unmapped]) %>
        </p>
        <p class="text-xs text-orange-700 dark:text-orange-400 mt-0.5"><%= t("employees.unmapped_banner_desc") %></p>
      </div>
      <%= link_to employees_path(filter: "unmapped"), class: "text-xs font-medium text-orange-700 dark:text-orange-400 hover:text-orange-900 dark:hover:text-orange-200 underline flex-shrink-0" do %>
        <%= t("employees.unmapped_view_targets") %>
      <% end %>
    </div>
  <% end %>

  <!-- 통계 카드 -->
  <div class="grid grid-cols-4 gap-4">
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 shadow-sm p-4">
      <p class="text-xs text-gray-500 dark:text-gray-500"><%= t("employees.stat_total") %></p>
      <p class="text-2xl font-bold text-gray-900 dark:text-white mt-1"><%= @stats[:total] %></p>
    </div>
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 shadow-sm p-4">
      <p class="text-xs text-gray-500 dark:text-gray-500"><%= t("employees.stat_deployed") %></p>
      <p class="text-2xl font-bold text-primary mt-1"><%= @stats[:dispatched] %></p>
    </div>
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 shadow-sm p-4 <%= @stats[:visa_expiring] > 0 ? 'border-yellow-200 dark:border-yellow-800' : '' %>">
      <p class="text-xs text-gray-500 dark:text-gray-500"><%= t("employees.stat_visa_expiring") %></p>
      <p class="text-2xl font-bold <%= @stats[:visa_expiring] > 0 ? 'text-yellow-600 dark:text-yellow-400' : 'text-gray-900 dark:text-white' %> mt-1"><%= @stats[:visa_expiring] %></p>
    </div>
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 shadow-sm p-4 <%= @stats[:contract_expiring] > 0 ? 'border-orange-200 dark:border-orange-800' : '' %>">
      <p class="text-xs text-gray-500 dark:text-gray-500"><%= t("employees.stat_contract_expiring") %></p>
      <p class="text-2xl font-bold <%= @stats[:contract_expiring] > 0 ? 'text-orange-600 dark:text-orange-400' : 'text-gray-900 dark:text-white' %> mt-1"><%= @stats[:contract_expiring] %></p>
    </div>
  </div>

  <!-- 검색/필터 -->
  <%= form_with url: employees_path, method: :get, class: "flex gap-2 flex-wrap items-center" do |f| %>
    <%= f.text_field :q, value: params[:q], placeholder: t("employees.search_placeholder"),
        class: "border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white rounded-lg px-3 py-2 text-sm w-36 focus:outline-none focus:border-primary" %>
    <%= f.select :type, [[t("employees.filter_type_all"), ""], [t("employees.filter_type_regular"), "regular"], [t("employees.filter_type_contract"), "contract"], [t("employees.filter_type_dispatch"), "dispatch"]],
        { selected: params[:type] },
        class: "border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-primary" %>
    <!-- FR-06: 부서 필터 -->
    <%= f.select :department,
        [[t("employees.filter_dept_all"), ""]] + @departments.map { |d| [d.name, d.id] },
        { selected: params[:department] },
        class: "border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-primary" %>
    <!-- FR-06: 직책 필터 -->
    <%= f.select :job_title,
        [[t("employees.filter_title_all"), ""]] + @job_titles.map { |jt| [jt.name, jt.name] },
        { selected: params[:job_title] },
        class: "border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-primary" %>
    <label class="inline-flex items-center gap-1.5 text-sm text-gray-600 dark:text-gray-500 cursor-pointer">
      <%= f.check_box :deployed, { checked: params[:deployed] == "1" }, "1", "" %>
      <%= t("employees.filter_deployed") %>
    </label>
    <label class="inline-flex items-center gap-1.5 text-sm text-gray-600 dark:text-gray-500 cursor-pointer">
      <%= f.check_box :show_inactive, { checked: params[:show_inactive] == "1" }, "1", "" %>
      <%= t("employees.filter_include_inactive") %>
    </label>
    <%# AUDIT-005: 미매핑 필터 — admin만 표시 %>
    <% if current_user.admin? %>
      <label class="inline-flex items-center gap-1.5 text-sm text-orange-600 dark:text-orange-400 cursor-pointer">
        <%= f.check_box :filter, { checked: params[:filter] == "unmapped" }, "unmapped", "" %>
        <%= t("employees.filter_unmapped") %>
      </label>
    <% end %>
    <%= f.submit t("employees.search_btn"), class: "bg-primary text-white px-4 py-2 rounded-lg text-sm hover:bg-primary-dark cursor-pointer" %>
    <%= link_to t("employees.reset_btn"), employees_path, class: "text-sm text-gray-500 dark:text-gray-500 hover:text-gray-700 dark:hover:text-gray-300 px-2 py-2" %>
  <% end %>

  <!-- 테이블 -->
  <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 shadow-sm overflow-hidden">
    <table class="w-full">
      <thead class="bg-gray-50 dark:bg-gray-700/50 border-b border-gray-200 dark:border-gray-700">
        <tr>
          <th class="text-left px-4 py-3 text-xs font-semibold text-gray-500 dark:text-gray-500 uppercase"><%= t("employees.col_name") %></th>
          <th class="text-left px-4 py-3 text-xs font-semibold text-gray-500 dark:text-gray-500 uppercase"><%= t("employees.col_nationality_dept") %></th>
          <th class="text-left px-4 py-3 text-xs font-semibold text-gray-500 dark:text-gray-500 uppercase"><%= t("employees.col_employment_type") %></th>
          <th class="text-left px-4 py-3 text-xs font-semibold text-gray-500 dark:text-gray-500 uppercase"><%= t("employees.col_current_site") %></th>
          <th class="text-left px-4 py-3 text-xs font-semibold text-gray-500 dark:text-gray-500 uppercase"><%= t("employees.col_visa_expiry") %></th>
          <th class="text-left px-4 py-3 text-xs font-semibold text-gray-500 dark:text-gray-500 uppercase"><%= t("employees.col_contract_expiry") %></th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-50 dark:divide-gray-700">
        <% @employees.each do |emp| %>
          <%
            visa       = emp.active_visa
            contract   = emp.current_contract
            assignment = emp.current_assignment
          %>
          <!-- FR-08: group 클래스로 hover Quick Action 지원 -->
          <tr class="group hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors cursor-pointer <%= emp.active? ? '' : 'opacity-50' %>"
              onclick="if(!event.target.closest('a,button,input,select,textarea')){window.location='<%= employee_path(emp) %>'}"
              title="<%= t("employees.view_detail", default: "상세 보기") %>">
            <td class="px-4 py-3">
              <div class="flex items-center gap-2.5">
                <!-- FR-01: 미니 아바타 (32px) -->
                <div class="w-8 h-8 rounded-full <%= emp.avatar_color %> flex items-center justify-center text-white text-xs font-bold flex-shrink-0">
                  <%= emp.initials %>
                </div>
                <div>
                  <div class="flex items-center gap-1.5">
                    <span class="font-medium text-gray-900 dark:text-white"><%= emp.name %></span>
                    <% if emp.user_id.present? %>
                      <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-xs font-medium bg-green-50 dark:bg-green-900/30 text-green-700 dark:text-green-400" title="<%= t("employees.account_linked") %>: <%= emp.user&.email %>">
                        <svg class="w-2.5 h-2.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                        <%= t("employees.account_linked") %>
                      </span>
                    <% else %>
                      <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-xs font-medium bg-gray-100 dark:bg-gray-700 text-gray-500 dark:text-gray-500" title="<%= t("employees.account_unlinked") %>">
                        <%= t("employees.account_unlinked") %>
                      </span>
                    <% end %>
                  </div>
                  <% if emp.name_en.present? %>
                    <div class="text-xs text-gray-500 dark:text-gray-500"><%= emp.name_en %></div>
                  <% end %>
                </div>
              </div>
            </td>
            <!-- FR-07: 직책 컬럼 병합 -->
            <td class="px-4 py-3 text-sm text-gray-600 dark:text-gray-500">
              <div><%= emp.nationality_label %></div>
              <div class="text-xs text-gray-500 dark:text-gray-500">
                <%= [emp.department&.name, emp.job_title.presence].compact.join(" · ") %>
              </div>
            </td>
            <td class="px-4 py-3">
              <span class="inline-flex px-2 py-0.5 text-xs font-medium rounded-full bg-blue-50 dark:bg-blue-900/30 text-blue-700 dark:text-blue-400">
                <%= emp.employment_type_label %>
              </span>
            </td>
            <td class="px-4 py-3 text-sm text-gray-600 dark:text-gray-500">
              <% if assignment %>
                <%= assignment.project.name %>
              <% else %>
                <span class="text-gray-300 dark:text-gray-600">-</span>
              <% end %>
            </td>
            <td class="px-4 py-3">
              <% if visa %>
                <span class="inline-flex px-2 py-0.5 text-xs font-medium rounded-full <%= visa.expiry_badge_class %>">
                  <%= visa.expiry_date.strftime("%Y-%m-%d") %>
                  <% if visa.days_until_expiry >= 0 %>
                    (D-<%= visa.days_until_expiry %>)
                  <% else %>
                    (<%= t("employees.expired_label") %>)
                  <% end %>
                </span>
              <% else %>
                <span class="text-gray-300 dark:text-gray-600 text-xs">-</span>
              <% end %>
            </td>
            <td class="px-4 py-3">
              <% if contract&.end_date %>
                <%
                  days_left = (contract.end_date - Date.today).to_i
                  badge_class = if days_left < 0 then "bg-red-600 text-white dark:bg-red-900/30 dark:text-red-400"
                                elsif days_left <= 14 then "bg-red-600 text-white dark:bg-red-900/30 dark:text-red-400"
                                elsif days_left <= 30 then "bg-orange-50 text-orange-700 dark:bg-orange-900/30 dark:text-orange-400"
                                else "bg-green-600 text-white dark:bg-green-900/30 dark:text-green-400" end
                %>
                <span class="inline-flex px-2 py-0.5 text-xs font-medium rounded-full <%= badge_class %>">
                  <%= contract.end_date.strftime("%Y-%m-%d") %>
                </span>
              <% else %>
                <span class="text-gray-300 dark:text-gray-600 text-xs">-</span>
              <% end %>
            </td>
            <!-- FR-08: Quick Action -->
            <td class="px-4 py-3 text-right">
              <div class="flex items-center justify-end gap-3">
                <%= link_to t("employees.detail_link"), emp, class: "text-xs text-primary hover:underline" %>
                <% if current_user.manager? || current_user.admin? %>
                  <%= link_to t("employees.edit_link"), edit_employee_path(emp),
                      class: "text-xs text-gray-500 dark:text-gray-500 hover:text-gray-700 dark:hover:text-gray-300 opacity-0 group-hover:opacity-100 transition-opacity" %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
        <% if @employees.empty? %>
          <tr><td colspan="7" class="px-4 py-12 text-center text-gray-500 dark:text-gray-500 text-sm"><%= t("employees.no_employees") %></td></tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%# ISS-310: 페이지네이션 %>
  <% if defined?(@pagy) && @pagy.pages > 1 %>
    <div class="mt-4 flex items-center justify-between text-sm">
      <div class="text-gray-500 dark:text-gray-400">
        <%= t("employees.pagination_info", count: @pagy.count, from: @pagy.from, to: @pagy.to, page: @pagy.page, pages: @pagy.pages) %>
      </div>
      <div class="flex items-center gap-1">
        <%= raw pagy_nav(@pagy) %>
      </div>
    </div>
  <% end %>
</div>
