<%= form_with model: employee, html: { multipart: true, enctype: "multipart/form-data" }, class: "flex flex-col gap-6" do |f| %>
  <% if employee.errors.any? %>
    <div class="bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 text-red-700 dark:text-red-400 px-4 py-3 rounded-lg text-sm">
      <% employee.errors.full_messages.each do |msg| %>
        <p><%= msg %></p>
      <% end %>
    </div>
  <% end %>

  <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 shadow-sm p-6" data-controller="employee-avatar-uploader">
    <h3 class="text-sm font-semibold text-gray-700 dark:text-gray-300 mb-4">프로필 사진</h3>
    <div class="flex items-center gap-4 mb-2">
      <div data-employee-avatar-uploader-target="preview" class="flex-shrink-0">
        <%= render "employee_avatar", employee: (employee.persisted? ? employee : Employee.new(name: "?", nationality: "KR", employment_type: "regular")), size_px: 80 %>
      </div>
      <div>
        <%= f.file_field :avatar, accept: "image/*",
            data: { action: "change->employee-avatar-uploader#preview", "employee-avatar-uploader-target": "input" },
            class: "text-sm text-gray-600 dark:text-gray-400 file:mr-3 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-medium file:bg-blue-50 file:text-blue-700 dark:file:bg-blue-900/30 dark:file:text-blue-400 hover:file:bg-blue-100" %>
        <p class="text-xs text-gray-500 dark:text-gray-500 mt-1">JPEG / PNG / WebP / HEIC · 최대 3MB</p>
      </div>
    </div>
  </div>

  <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 shadow-sm p-6">
    <h3 class="text-sm font-semibold text-gray-700 dark:text-gray-300 mb-4"><%= t("employees.form.section_basic") %></h3>
    <div class="grid grid-cols-2 gap-4">
      <div>
        <%= f.label :name, t("employees.form.label_name"), class: "block text-xs font-medium text-gray-600 dark:text-gray-500 mb-1" %>
        <%= f.text_field :name, class: "w-full border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-primary", placeholder: t("employees.form.name_placeholder") %>
      </div>
      <div>
        <%= f.label :name_en, t("employees.form.label_name_en"), class: "block text-xs font-medium text-gray-600 dark:text-gray-500 mb-1" %>
        <%= f.text_field :name_en, class: "w-full border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-primary", placeholder: "Hong Gildong" %>
      </div>
      <div>
        <%= f.label :nationality, t("employees.form.label_nationality"), class: "block text-xs font-medium text-gray-600 dark:text-gray-500 mb-1" %>
        <%= f.select :nationality,
            Employee::NATIONALITIES.map { |code, label| ["#{label} (#{code})", code] },
            { include_blank: t("employees.form.nationality_placeholder") },
            class: "w-full border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-primary" %>
      </div>
      <div>
        <%= f.label :date_of_birth, t("employees.form.label_dob"), class: "block text-xs font-medium text-gray-600 dark:text-gray-500 mb-1" %>
        <%= f.date_field :date_of_birth, class: "w-full border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-primary" %>
      </div>
      <div>
        <%= f.label :passport_number, t("employees.form.label_passport"), class: "block text-xs font-medium text-gray-600 dark:text-gray-500 mb-1" %>
        <%= f.text_field :passport_number, class: "w-full border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-primary" %>
      </div>
      <div>
        <%= f.label :employment_type, t("employees.form.label_employment_type"), class: "block text-xs font-medium text-gray-600 dark:text-gray-500 mb-1" %>
        <%= f.select :employment_type,
            [[t("employees.form.type_regular"), "regular"], [t("employees.form.type_contract"), "contract"], [t("employees.form.type_dispatch"), "dispatch"]],
            {},
            class: "w-full border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-primary" %>
      </div>
    </div>
  </div>

  <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 shadow-sm p-6">
    <h3 class="text-sm font-semibold text-gray-700 dark:text-gray-300 mb-4"><%= t("employees.form.section_contact") %></h3>
    <div class="grid grid-cols-2 gap-4">
      <div>
        <%= f.label :phone, t("employees.form.label_phone"), class: "block text-xs font-medium text-gray-600 dark:text-gray-500 mb-1" %>
        <%= f.text_field :phone, class: "w-full border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-primary", placeholder: "+971-50-0000000" %>
      </div>
      <div>
        <div class="flex items-center gap-1 mb-1">
          <%= f.label :email, class: "block text-xs font-medium text-gray-600 dark:text-gray-500" do %>
            <%= t("employees.form.label_email") %><span class="text-amber-500 ml-0.5">*</span>
          <% end %>
        </div>
        <%
          # 자동완성 후보: 미연결 User 우선 + 이미 연결된 User 후순위
          linked_user_ids = Employee.where.not(user_id: nil).where.not(id: employee.id || 0).pluck(:user_id).uniq
          unlinked_users  = User.where.not(id: linked_user_ids).order(:name).limit(50)
          linked_users    = User.where(id: linked_user_ids).order(:name).limit(50)
          datalist_id     = "employee-email-suggestions-#{employee.id || 'new'}"
        %>
        <%= f.email_field :email,
            placeholder: "name@company.com",
            list: datalist_id,
            autocomplete: "off",
            class: "w-full border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-primary" %>
        <datalist id="<%= datalist_id %>">
          <% unlinked_users.each do |u| %>
            <option value="<%= u.email %>"><%= u.display_name %> · <%= t("employees.form.email_unlinked") %></option>
          <% end %>
          <% linked_users.each do |u| %>
            <option value="<%= u.email %>"><%= u.display_name %> · <%= t("employees.form.email_already_linked") %></option>
          <% end %>
        </datalist>
        <% if employee.email.blank? %>
          <div class="mt-1.5 flex items-start gap-1.5 bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-700 rounded-md px-2.5 py-1.5 text-xs text-amber-700 dark:text-amber-400">
            <svg class="w-3.5 h-3.5 flex-shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
            <%= t("employees.form.email_missing_warning") %>
          </div>
        <% else %>
          <p class="text-xs text-gray-500 mt-1">
            <%= t("employees.form.email_hint", unlinked: unlinked_users.size, linked: linked_users.size) %>
          </p>
        <% end %>
      </div>
      <div>
        <%= f.label :emergency_contact, t("employees.form.label_emergency_contact"), class: "block text-xs font-medium text-gray-600 dark:text-gray-500 mb-1" %>
        <%= f.text_field :emergency_contact, class: "w-full border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-primary" %>
      </div>
      <div>
        <%= f.label :emergency_phone, t("employees.form.label_emergency_phone"), class: "block text-xs font-medium text-gray-600 dark:text-gray-500 mb-1" %>
        <%= f.text_field :emergency_phone, class: "w-full border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-primary" %>
      </div>
    </div>
  </div>

  <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 shadow-sm p-6">
    <h3 class="text-sm font-semibold text-gray-700 dark:text-gray-300 mb-4"><%= t("employees.form.section_job") %></h3>
    <div class="grid grid-cols-2 gap-4">
      <%# 부서 선택 + 인라인 추가/삭제 %>
      <div data-controller="department-manager"
           data-department-manager-url-value="<%= employees_departments_path %>">

        <div class="flex items-center justify-between mb-1">
          <%= f.label :department_id, t("employees.form.label_department"), class: "text-xs font-medium text-gray-600 dark:text-gray-500" %>
          <button type="button"
                  class="flex items-center gap-1 text-xs text-primary hover:text-primary-dark font-medium"
                  data-action="click->department-manager#open">
            <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
            <%= t("employees.form.dept_manage_btn") %>
          </button>
        </div>

        <%= f.select :department_id,
            Department.active.by_sort.map { |d| [d.full_name, d.id] },
            { include_blank: t("employees.form.dept_blank") },
            class: "w-full border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-primary",
            data: { "department-manager-target": "select" } %>

        <%# 부서 관리 모달 %>
        <div data-department-manager-target="modal"
             class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/40"
             data-action="click->department-manager#backdropClose">
          <div class="bg-white dark:bg-gray-800 rounded-xl shadow-xl w-full max-w-md mx-4 overflow-hidden">

            <%# 헤더 %>
            <div class="flex items-center justify-between px-5 py-4 border-b border-gray-200 dark:border-gray-700">
              <h3 class="text-sm font-semibold text-gray-800 dark:text-white"><%= t("employees.form.dept_modal_title") %></h3>
              <button type="button" class="p-1 rounded hover:bg-gray-100 dark:hover:bg-gray-700 text-gray-500"
                      data-action="click->department-manager#close">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
              </button>
            </div>

            <%# 부서 목록 %>
            <div class="px-4 py-3 max-h-52 overflow-y-auto">
              <div data-department-manager-target="list">
                <p class="text-xs text-gray-500 py-2 text-center"><%= t("employees.form.modal_loading") %></p>
              </div>
              <p data-department-manager-target="deleteError" class="text-xs text-red-500 mt-1 min-h-[1rem]"></p>
            </div>

            <%# 부서 추가 폼 %>
            <div class="px-4 pb-4 border-t border-gray-200 dark:border-gray-700 pt-3">
              <p class="text-xs font-medium text-gray-600 dark:text-gray-500 mb-2"><%= t("employees.form.dept_add_title") %></p>
              <div class="flex gap-2 mb-2">
                <select data-department-manager-target="addCompany"
                        class="border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-800 dark:text-white rounded-lg px-2 py-1.5 text-xs focus:outline-none focus:border-primary flex-shrink-0">
                  <% Company.order(:name).each do |company| %>
                    <option value="<%= company.id %>"><%= company.name %></option>
                  <% end %>
                </select>
                <input type="text"
                       placeholder="<%= t("employees.form.dept_add_placeholder") %>"
                       data-department-manager-target="addInput"
                       data-action="keydown.enter->department-manager#addDept"
                       class="flex-1 border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-800 dark:text-white rounded-lg px-3 py-1.5 text-xs focus:outline-none focus:border-primary" />
                <button type="button"
                        data-action="click->department-manager#addDept"
                        class="px-3 py-1.5 bg-primary text-white rounded-lg text-xs font-medium hover:bg-primary-dark flex-shrink-0">
                  <%= t("employees.form.modal_add_btn") %>
                </button>
              </div>
              <p data-department-manager-target="addError" class="text-xs text-red-500 min-h-[1rem]"></p>
            </div>

          </div>
        </div>
      </div>
      <%# 직책 선택 + 인라인 추가/삭제 모달 %>
      <div data-controller="job-title-manager"
           data-job-title-manager-url-value="<%= employees_job_titles_path %>">

        <div class="flex items-center justify-between mb-1">
          <%= f.label :job_title, t("employees.form.label_job_title"), class: "text-xs font-medium text-gray-600 dark:text-gray-500" %>
          <button type="button"
                  class="flex items-center gap-1 text-xs text-primary hover:text-primary-dark font-medium"
                  data-action="click->job-title-manager#open">
            <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
            <%= t("employees.form.job_title_manage_btn") %>
          </button>
        </div>

        <%= f.select :job_title,
            JobTitle.active.by_sort.map { |jt| [jt.name, jt.name] },
            { include_blank: t("employees.form.job_title_blank") },
            class: "w-full border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-primary",
            data: { "job-title-manager-target": "select" } %>

        <%# 직책 관리 모달 %>
        <div data-job-title-manager-target="modal"
             class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/40"
             data-action="click->job-title-manager#backdropClose">
          <div class="bg-white dark:bg-gray-800 rounded-xl shadow-xl w-full max-w-sm mx-4 overflow-hidden">

            <%# 헤더 %>
            <div class="flex items-center justify-between px-5 py-4 border-b border-gray-200 dark:border-gray-700">
              <h3 class="text-sm font-semibold text-gray-800 dark:text-white"><%= t("employees.form.job_title_modal_title") %></h3>
              <button type="button" class="p-1 rounded hover:bg-gray-100 dark:hover:bg-gray-700 text-gray-500"
                      data-action="click->job-title-manager#close">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
              </button>
            </div>

            <%# 직책 목록 %>
            <div class="px-4 py-3 max-h-52 overflow-y-auto">
              <div data-job-title-manager-target="list">
                <p class="text-xs text-gray-500 py-2 text-center"><%= t("employees.form.modal_loading") %></p>
              </div>
              <p data-job-title-manager-target="deleteError" class="text-xs text-red-500 mt-1 min-h-[1rem]"></p>
            </div>

            <%# 직책 추가 폼 %>
            <div class="px-4 pb-4 border-t border-gray-200 dark:border-gray-700 pt-3">
              <p class="text-xs font-medium text-gray-600 dark:text-gray-500 mb-2"><%= t("employees.form.job_title_add_title") %></p>
              <div class="flex gap-2 mb-2">
                <input type="text"
                       placeholder="<%= t("employees.form.job_title_add_placeholder") %>"
                       data-job-title-manager-target="addInput"
                       data-action="keydown.enter->job-title-manager#addJobTitle"
                       class="flex-1 border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-800 dark:text-white rounded-lg px-3 py-1.5 text-xs focus:outline-none focus:border-primary" />
                <button type="button"
                        data-action="click->job-title-manager#addJobTitle"
                        class="px-3 py-1.5 bg-primary text-white rounded-lg text-xs font-medium hover:bg-primary-dark flex-shrink-0">
                  <%= t("employees.form.modal_add_btn") %>
                </button>
              </div>
              <p data-job-title-manager-target="addError" class="text-xs text-red-500 min-h-[1rem]"></p>
            </div>

          </div>
        </div>
      </div>
      <div>
        <%= f.label :hire_date, t("employees.form.label_hire_date"), class: "block text-xs font-medium text-gray-600 dark:text-gray-500 mb-1" %>
        <%= f.date_field :hire_date, class: "w-full border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-primary" %>
      </div>
      <div>
        <%= f.label :termination_date, t("employees.form.label_termination_date"), class: "block text-xs font-medium text-gray-600 dark:text-gray-500 mb-1" %>
        <%= f.date_field :termination_date, class: "w-full border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-primary" %>
      </div>
      <div>
        <%= f.label :user_id, t("employees.form.label_user_mapping"), class: "block text-xs font-medium text-gray-600 dark:text-gray-500 mb-1" %>
        <%# AUDIT-005: 자동 제안 박스 — user_id 미연결 + 후보 있을 때만 표시 %>
        <% suggested = employee.suggested_user %>
        <% if suggested %>
          <div id="user-mapping-suggestion"
               class="mb-2 flex items-center justify-between gap-2 bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 rounded-lg px-3 py-2 text-xs text-blue-800 dark:text-blue-300">
            <span>
              <svg class="w-3.5 h-3.5 inline-block mr-1 text-blue-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
              <%= t("employees.form.suggested_user_hint", name: suggested.display_name, email: suggested.email) %>
            </span>
            <button type="button"
                    class="flex-shrink-0 px-2 py-1 bg-blue-600 hover:bg-blue-700 text-white rounded text-xs font-medium"
                    onclick="document.getElementById('employee_user_id').value = '<%= suggested.id %>'; document.getElementById('user-mapping-suggestion').style.display='none';">
              <%= t("employees.form.apply_suggestion") %>
            </button>
          </div>
        <% end %>
        <%= f.select :user_id,
            User.order(:name).map { |u| ["#{u.display_name} (#{u.email})", u.id] },
            { include_blank: t("employees.form.user_mapping_blank") },
            class: "w-full border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-primary" %>
        <p class="text-xs text-gray-500 mt-1"><%= t("employees.form.user_mapping_hint") %></p>
      </div>
      <div class="flex items-end">
        <label class="inline-flex items-center gap-2 cursor-pointer">
          <%= f.check_box :active, class: "w-4 h-4 rounded border-gray-300 dark:border-gray-600 text-primary" %>
          <span class="text-sm text-gray-700 dark:text-gray-300"><%= t("employees.form.label_active") %></span>
        </label>
      </div>
    </div>
    <div class="mt-4">
      <%= f.label :notes, t("employees.form.label_notes"), class: "block text-xs font-medium text-gray-600 dark:text-gray-500 mb-1" %>
      <%= f.text_area :notes, rows: 3, class: "w-full border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-primary resize-none" %>
    </div>
    <%= render "shared/documents_field", f: f, record: employee %>
  </div>

  <div class="flex justify-end gap-3">
    <%= link_to t("common.cancel"), employees_path, class: "px-4 py-2 border border-gray-200 dark:border-gray-600 text-gray-600 dark:text-gray-500 rounded-lg text-sm hover:bg-gray-50 dark:hover:bg-gray-700" %>
    <%= f.submit employee.new_record? ? t("employees.form.submit_new") : t("employees.form.submit_edit"),
        class: "px-4 py-2 bg-primary text-white rounded-lg text-sm font-medium hover:bg-primary-dark cursor-pointer" %>
  </div>
<% end %>
