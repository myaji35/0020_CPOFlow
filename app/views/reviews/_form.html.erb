<%# ISS-231: 공개 피드백 제출 폼 — SLDS 준수 %>
<div class="bg-white border border-gray-200 rounded-xl shadow-sm p-8">
  <!-- Header -->
  <div class="mb-6">
    <div class="flex items-center gap-3 mb-2">
      <div class="w-8 h-8 bg-[#00A1E0] rounded-lg flex items-center justify-center">
        <svg class="w-4 h-4 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
        </svg>
      </div>
      <h1 class="text-lg font-bold text-[#1E3A5F]">피드백 남기기</h1>
    </div>
    <p class="text-sm text-gray-500">CPOFlow 서비스 개선을 위한 소중한 의견을 남겨주세요.</p>
  </div>

  <%= form_with model: review, url: reviews_path, local: true, html: { id: "review-form-inner" } do |f| %>
    <!-- Errors -->
    <% if review.errors.any? %>
      <div class="mb-4 px-4 py-3 bg-red-50 border border-red-200 rounded-lg">
        <p class="text-sm font-semibold text-red-700 mb-1">입력 오류</p>
        <ul class="list-disc list-inside text-sm text-red-600 space-y-0.5">
          <% review.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <!-- 별점 -->
    <div class="mb-5" data-controller="star-rating">
      <label class="block text-xs font-semibold text-gray-600 mb-1.5">만족도 <span class="text-red-500">*</span></label>
      <%= f.hidden_field :rating, value: review.rating.to_i, "data-star-rating-target": "input" %>

      <div class="flex items-center gap-2">
        <% (1..5).each do |i| %>
          <button type="button"
                  data-star-rating-target="star"
                  data-value="<%= i %>"
                  data-action="click->star-rating#select mouseover->star-rating#hover mouseout->star-rating#leave"
                  class="w-9 h-9 flex items-center justify-center transition-transform hover:scale-110 text-gray-300 cursor-pointer"
                  aria-label="<%= i %>점">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-7 h-7">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
            </svg>
          </button>
        <% end %>
        <span class="ml-2 text-sm text-gray-500" data-star-rating-target="label"></span>
      </div>
    </div>

    <!-- 본문 -->
    <div class="mb-5">
      <label class="block text-xs font-semibold text-gray-600 mb-1.5" for="review_body">
        의견 <span class="text-red-500">*</span>
      </label>
      <%= f.text_area :body,
            id: "review_body",
            rows: 5,
            placeholder: "서비스를 사용하면서 느낀 점, 개선이 필요한 부분, 좋았던 점 등을 자유롭게 작성해주세요. (최소 5자)",
            class: "w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:border-[#00A1E0] focus:ring-1 focus:ring-[#00A1E0] resize-none" %>
    </div>

    <!-- 이메일 (선택) -->
    <div class="mb-5">
      <label class="block text-xs font-semibold text-gray-600 mb-1.5" for="review_email">
        이메일 (선택)
      </label>
      <%= f.email_field :email,
            id: "review_email",
            placeholder: "example@company.com",
            class: "w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:border-[#00A1E0] focus:ring-1 focus:ring-[#00A1E0]" %>

      <!-- 이메일 해시 옵션 -->
      <div class="mt-2 flex items-start gap-2">
        <input type="checkbox"
               id="hash_email"
               name="hash_email"
               value="1"
               class="mt-0.5 w-4 h-4 rounded border-gray-300 text-[#00A1E0] focus:ring-[#00A1E0]">
        <label for="hash_email" class="text-xs text-gray-500 leading-relaxed">
          이메일을 해시로만 저장 (원문 미저장, 익명성 보호)
        </label>
      </div>
    </div>

    <!-- 제출 버튼 -->
    <div class="flex items-center gap-3">
      <%= f.submit "피드백 제출",
            class: "flex-1 bg-[#1E3A5F] hover:bg-[#2D5282] text-white text-sm font-semibold px-6 py-2.5 rounded-lg transition-colors cursor-pointer" %>
      <a href="/" class="text-sm text-gray-500 hover:text-gray-700 px-4 py-2.5">취소</a>
    </div>
  <% end %>
</div>
