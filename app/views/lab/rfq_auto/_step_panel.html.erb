<%# 단계 패널 — 헤더 + 본문 일체. 상태별 시각화.
    locals:
      num    : 1~5
      title  : 단계명
      step   : step hash (status, latency_ms, ...)
      badge  : 작은 라벨
      &block : 본문 yield (완료 시 결과 표시) %>
<%
  status = step["status"] || (step.empty? ? "pending" : "ok")
  case status
  when "ok"      then color, label = "emerald", "완료"
  when "error"   then color, label = "red",     "실패"
  when "skipped" then color, label = "ink",     "건너뜀"
  when "running" then color, label = "amber",   "처리 중"
  else                color, label = "ink",     "대기"
  end
  latency = step["latency_ms"]
  expanded = %w[ok error skipped running].include?(status)
%>
<div class="border <%= status == 'running' ? 'border-amber-300 dark:border-amber-700' : 'border-ink-150 dark:border-ink-800' %> rounded-md bg-white dark:bg-ink-900 overflow-hidden">
  <%# 헤더 %>
  <div class="flex items-center gap-3 px-3 py-2.5 <%= status == 'pending' ? 'bg-ink-50/50 dark:bg-ink-900' : 'bg-' + color + '-50/50 dark:bg-' + color + '-900/10' %>">
    <div class="w-7 h-7 rounded-full bg-<%= color %>-100 dark:bg-<%= color %>-900/40 text-<%= color %>-700 dark:text-<%= color %>-300 grid place-items-center text-[12px] font-bold relative shrink-0">
      <% if status == "running" %>
        <svg class="w-4 h-4 animate-spin absolute" viewBox="0 0 24 24" fill="none">
          <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="3" stroke-dasharray="40 60" stroke-linecap="round"></circle>
        </svg>
        <span class="opacity-30"><%= num %></span>
      <% elsif status == "ok" %>
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
      <% elsif status == "error" %>
        ✗
      <% else %>
        <%= num %>
      <% end %>
    </div>
    <div class="flex-1 min-w-0">
      <div class="flex items-center gap-2 flex-wrap">
        <span class="text-[14px] font-semibold text-ink-900 dark:text-white"><%= title %></span>
        <span class="text-[10px] px-1.5 py-0.5 rounded font-mono <%= status == 'running' ? "bg-#{color}-100 dark:bg-#{color}-900/40 text-#{color}-700 dark:text-#{color}-300" : 'bg-ink-100 dark:bg-ink-800 text-ink-600 dark:text-ink-300' %>">
          <%= label %>
        </span>
        <% if badge.present? %>
          <span class="text-[10px] px-1.5 py-0.5 rounded bg-ink-100 dark:bg-ink-800 text-ink-600 dark:text-ink-300 font-mono"><%= badge %></span>
        <% end %>
        <% if latency && status != "running" %>
          <span class="text-[10px] text-ink-400 font-mono"><%= latency %>ms</span>
        <% end %>
      </div>
    </div>
  </div>

  <%# 본문 — 상태별 분기 %>
  <% if status == "pending" %>
    <div class="px-3 py-3 text-[11px] text-ink-400 italic">아직 시작 전입니다.</div>
  <% elsif status == "running" %>
    <div class="px-3 py-3 text-[11px] text-amber-700 dark:text-amber-300 flex items-center gap-2">
      <svg class="w-3 h-3 animate-spin" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="3" stroke-dasharray="40 60" stroke-linecap="round"/></svg>
      처리 중입니다…
    </div>
  <% elsif status == "skipped" %>
    <div class="px-3 py-3 text-[11px] text-ink-500">— <%= step["reason"] %></div>
  <% elsif status == "error" %>
    <div class="px-3 py-3 text-[11px] text-red-700 dark:text-red-300 font-mono break-all">⚠ <%= step["error"] %></div>
  <% else %>
    <%# 완료 — block yield %>
    <div class="px-3 pb-3 pt-1">
      <%= yield %>
    </div>
  <% end %>
</div>
