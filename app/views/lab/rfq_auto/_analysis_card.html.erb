<%# 분석 결과 카드 — Turbo Stream으로 부분 갱신.
    locals:
      analysis        — RfqAutoAnalysis 인스턴스 (저장 시점 데이터)
      transient_steps — Analyzer 진행 중 메모리 상태 (선택, 우선 적용)
%>
<% steps = (transient_steps if defined?(transient_steps) && transient_steps.is_a?(Hash) && transient_steps.any?) || analysis.steps_data %>
<% summary = analysis.summary_data %>
<%# D-5 선택된 공급사 인덱스 — (item_idx, supplier_name) → selection 객체 %>
<% selections_index = analysis.supplier_selections.includes(:supplier).index_by { |s| [ s.item_idx, s.supplier_name ] } rescue {} %>

<div id="rfq-auto-analysis-<%= analysis.id %>"
     data-status="<%= analysis.status %>">
  <%# 상태 배지 + 메트릭 카드 %>
  <div class="flex items-center gap-3 mb-4">
    <% case analysis.status
       when "running" %>
      <span class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full text-[12px] font-semibold bg-amber-100 dark:bg-amber-900/40 text-amber-800 dark:text-amber-300">
        <svg class="w-3.5 h-3.5 animate-spin" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" stroke-dasharray="40 80"></circle></svg>
        분석 중...
      </span>
    <% when "completed" %>
      <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[12px] font-semibold bg-emerald-100 dark:bg-emerald-900/40 text-emerald-800 dark:text-emerald-300">
        ✓ 분석 완료
      </span>
    <% when "failed" %>
      <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[12px] font-semibold bg-red-100 dark:bg-red-900/40 text-red-800 dark:text-red-300">
        ✗ 실패
      </span>
    <% else %>
      <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[12px] font-semibold bg-ink-100 dark:bg-ink-800 text-ink-600 dark:text-ink-300">
        대기 중
      </span>
    <% end %>
    <span class="text-[11px] text-ink-500"><%= analysis.user&.display_name %> · <%= time_ago_in_words(analysis.created_at) rescue '' %> 전</span>
    <% if summary["applied_at"].present? %>
      <span class="text-[11px] px-2 py-0.5 rounded bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300">📌 카드에 적용됨 · Task <%= summary["tasks_created"] %>건</span>
    <% end %>
  </div>

  <% if analysis.status != "running" %>
    <div class="grid grid-cols-2 md:grid-cols-5 gap-3 mb-5">
      <% s = summary %>
      <% [
        ["첨부",     "#{s['attachments_relevant'].to_i}/#{s['attachments_total'].to_i}", "관련/전체"],
        ["품목",     "#{s['items_count'].to_i}",                                          "추출"],
        ["누락 항목", "#{s['items_missing_total'].to_i}",                                  "필수 11항목"],
        ["공급사",   "#{s['suppliers_total'].to_i}",                                      "탐색 결과"],
        ["소요/비용", "#{s['elapsed_seconds']}s · $#{s['cost_usd']}",                     "LLM"]
      ].each do |label, val, sub| %>
        <div class="bg-white dark:bg-ink-900 border border-ink-150 dark:border-ink-800 rounded-md p-3">
          <div class="text-[10px] uppercase tracking-wider text-ink-500"><%= label %></div>
          <div class="text-[18px] font-semibold text-ink-900 dark:text-white mt-0.5 font-mono"><%= val %></div>
          <div class="text-[10px] text-ink-400 mt-0.5"><%= sub %></div>
        </div>
      <% end %>
    </div>
  <% end %>

  <%# 5단계 패널 — 단계별 status에 따라 자동 펼침 %>
  <div class="space-y-3">
    <% step1 = steps["step1_attachments"] || {} %>
    <%= render layout: "lab/rfq_auto/step_panel", locals: { num: 1, title: "첨부 파일 인식", step: step1, badge: step1.empty? ? nil : "#{step1['relevant'].to_i}/#{step1['total'].to_i} 관련" } do %>
      <% if step1["items"].is_a?(Array) && step1["items"].any? %>
        <div class="space-y-1.5">
          <% step1["items"].each do |it| %>
            <div class="flex items-center justify-between text-[12px] px-3 py-2 bg-ink-50 dark:bg-ink-900 rounded border border-ink-100 dark:border-ink-800">
              <div class="flex items-center gap-2 min-w-0">
                <span class="font-mono text-ink-700 dark:text-ink-200 truncate max-w-[420px]"><%= it["filename"] %></span>
                <span class="text-[10px] px-1.5 py-0.5 rounded bg-blue-50 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300"><%= it["type"] %></span>
              </div>
              <div class="flex items-center gap-2 shrink-0">
                <span class="text-[10px] text-ink-500">관련도 <%= it["relevance_score"] %></span>
                <span class="w-12 h-1 bg-ink-100 rounded-full overflow-hidden"><span class="block h-full bg-brand-500" style="width: <%= [it["relevance_score"].to_i, 100].min %>%"></span></span>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="text-[11px] text-ink-500">첨부 없음.</div>
      <% end %>
    <% end %>

    <% step1b = steps["step1b_format"] || {} %>
    <% if step1b["status"] && step1b["status"] != "skipped" %>
      <%= render layout: "lab/rfq_auto/step_panel", locals: {
            num: "1b",
            title: "양식 인식 (NAWAH/ENEC 정규식)",
            step: step1b,
            badge: step1b["format"].present? ? step1b["format"] : nil
          } do %>
        <% if step1b["invalid"] %>
          <div class="p-3 bg-amber-50 dark:bg-amber-900/30 border border-amber-200 dark:border-amber-800 rounded">
            <div class="text-[12px] font-semibold text-amber-800 dark:text-amber-300">⚠ 무효 문서 감지</div>
            <div class="text-[11px] text-amber-700 dark:text-amber-400 mt-1">
              SAP Ariba 로그인 페이지 캡처입니다. 실제 RFQ 본문이 없어 분석이 제한됩니다 — 발신자에게 첨부 재요청 권장.
            </div>
          </div>
        <% else %>
          <div class="grid grid-cols-2 lg:grid-cols-4 gap-2">
            <div class="px-2 py-2 bg-blue-50 dark:bg-blue-900/30 rounded text-center">
              <div class="text-[10px] uppercase text-blue-700 dark:text-blue-300">필드</div>
              <div class="text-[14px] font-bold text-blue-800 dark:text-blue-200"><%= step1b["fields_count"].to_i %></div>
            </div>
            <div class="px-2 py-2 bg-red-50 dark:bg-red-900/30 rounded text-center">
              <div class="text-[10px] uppercase text-red-700 dark:text-red-300">CRITICAL</div>
              <div class="text-[14px] font-bold text-red-800 dark:text-red-200"><%= step1b["critical_count"].to_i %></div>
            </div>
            <div class="px-2 py-2 bg-amber-50 dark:bg-amber-900/30 rounded text-center">
              <div class="text-[10px] uppercase text-amber-700 dark:text-amber-300">MUST</div>
              <div class="text-[14px] font-bold text-amber-800 dark:text-amber-200"><%= (step1b["must_comply"] || []).size %></div>
            </div>
            <div class="px-2 py-2 bg-emerald-50 dark:bg-emerald-900/30 rounded text-center">
              <div class="text-[10px] uppercase text-emerald-700 dark:text-emerald-300">NICE</div>
              <div class="text-[14px] font-bold text-emerald-800 dark:text-emerald-200"><%= (step1b["nice_to_have"] || []).size %></div>
            </div>
          </div>
          <% if (step1b["must_comply"] || []).any? %>
            <div class="mt-2 space-y-1">
              <div class="text-[11px] font-semibold text-ink-700 dark:text-ink-200">⚠ 반드시 챙길 사항</div>
              <% step1b["must_comply"].each do |mc| %>
                <% color = mc["severity"] == "critical" ? "red" : "amber" %>
                <div class="text-[11px] px-2 py-1 bg-<%= color %>-50 dark:bg-<%= color %>-900/30 border border-<%= color %>-200 dark:border-<%= color %>-800 rounded">
                  <span class="font-semibold text-<%= color %>-800 dark:text-<%= color %>-300"><%= mc["category"] %></span>
                  <span class="text-[10px] uppercase text-<%= color %>-600 dark:text-<%= color %>-400 ml-1"><%= mc["severity"] %></span>
                </div>
              <% end %>
            </div>
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <% step2 = steps["step2_items"] || {} %>
    <%= render layout: "lab/rfq_auto/step_panel", locals: { num: 2, title: "품목 추출 + 필수 11항목 점검", step: step2, badge: step2.empty? ? nil : "#{step2['count'].to_i}품" } do %>

    <%# 항상 표시 — 11항목 매트릭스. 품목별 또는 문서 단위 fallback %>
    <% if step2.is_a?(Hash) && (step2["items"].present? || step2["doc_level_missing"].present?) %>
      <div>
        <%# 추출 모드 정보 (LLM / OCR / Escalation / Vision) %>
        <div class="mb-3 flex flex-wrap gap-1.5 text-[10px]">
          <% if step2["llm_model"].present? %>
            <span class="px-2 py-0.5 rounded bg-blue-50 dark:bg-blue-900/20 text-blue-700 dark:text-blue-300">
              🤖 <%= step2["llm_model"] %> · $<%= step2["llm_cost_usd"] %>
            </span>
          <% end %>
          <% if step2["ocr_used"] %>
            <span class="px-2 py-0.5 rounded bg-orange-50 dark:bg-orange-900/20 text-orange-700 dark:text-orange-300">
              📷 OCR (tesseract)
            </span>
          <% end %>
          <% if step2["escalated"] %>
            <span class="px-2 py-0.5 rounded bg-purple-50 dark:bg-purple-900/20 text-purple-700 dark:text-purple-300">
              ⬆ Opus escalate · $<%= step2["escalation_cost_usd"] %>
            </span>
          <% end %>
          <% if step2["vision_used"] %>
            <span class="px-2 py-0.5 rounded bg-fuchsia-50 dark:bg-fuchsia-900/20 text-fuchsia-700 dark:text-fuchsia-300">
              👁 Vision <%= step2["vision_model"] %> · <%= step2["vision_pages"] %>p · $<%= step2["vision_cost_usd"] %>
            </span>
          <% end %>
        </div>
        <% if step2["vision_error"].present? %>
          <div class="mb-3 p-2 text-[11px] bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded text-red-700 dark:text-red-300 font-mono">
            <%= step2["vision_error"] %>
          </div>
        <% end %>

        <%# 텍스트 추출 결과 + LLM 에러 진단 정보 %>
        <% if step2["text_chars"].to_i > 0 || step2["llm_error"].present? %>
          <details class="mb-3 text-[11px]">
            <summary class="cursor-pointer text-ink-500 hover:text-ink-700">
              📄 추출 텍스트 <%= step2["text_chars"] %>자
              <% if step2["llm_error"].present? %>· <span class="text-red-600">⚠ LLM 에러</span><% end %>
            </summary>
            <% if step2["llm_error"].present? %>
              <div class="mt-1 p-2 bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded text-red-700 dark:text-red-300 font-mono break-all">
                <%= step2["llm_error"] %>
              </div>
            <% end %>
            <% if step2["text_preview"].present? %>
              <pre class="mt-1 p-2 bg-ink-50 dark:bg-ink-900 border border-ink-150 dark:border-ink-800 rounded text-ink-700 dark:text-ink-200 max-h-48 overflow-auto whitespace-pre-wrap"><%= step2["text_preview"] %></pre>
            <% end %>
          </details>
        <% end %>

        <%# 11항목 매트릭스 — 행: 품목 / 열: 11항목 ✓ ✗ 단일 표 %>
        <% if step2["items"].is_a?(Array) && step2["items"].any? %>
          <%# AtoZ RFQ 7컬럼 양식 — 이메일과 동일 양식으로 화면 미리보기 통일 (ISS-358 Wave 3 T8) %>
          <details open class="mb-3">
            <summary class="cursor-pointer text-[11px] font-semibold text-ink-700 dark:text-ink-200 mb-2 hover:text-brand-600">
              📦 품목 기본 정보 (<%= step2["items"].size %>건) — AtoZ RFQ 양식
            </summary>
            <%= render "shared/atoz_rfq_items_table", items: step2["items"], mode: :screen %>
          </details>

          <%# 11항목 매트릭스 — 행=품목, 열=11항목 (✓/✗) — 한눈에 결손 패턴 보기 %>
          <details open>
            <summary class="cursor-pointer text-[11px] font-semibold text-ink-700 dark:text-ink-200 mb-2 hover:text-brand-600">
              ✓✗ 필수 11항목 매트릭스 (행: 품목, 열: 항목)
            </summary>
            <div class="overflow-x-auto rounded-md border border-ink-150 dark:border-ink-800">
              <table class="w-full text-[11px] border-collapse">
                <thead class="bg-ink-50 dark:bg-ink-800 text-[10px] text-ink-600 dark:text-ink-300">
                  <tr>
                    <th class="sticky left-0 bg-ink-50 dark:bg-ink-800 px-2 py-1.5 text-left w-44 z-10 border-r border-ink-200 dark:border-ink-700">품목</th>
                    <% RfqAuto::Analyzer::REQUIRED_FIELDS.each do |field| %>
                      <th class="px-1 py-1.5 text-center min-w-[64px] border-l border-ink-200 dark:border-ink-700 align-middle">
                        <div class="leading-tight whitespace-pre-line"><%= RfqAuto::Analyzer::REQUIRED_FIELD_LABELS[field].gsub(' ', "\n") %></div>
                      </th>
                    <% end %>
                    <th class="px-2 py-1.5 text-center w-14 border-l border-ink-200 dark:border-ink-700">결손</th>
                  </tr>
                </thead>
                <tbody class="bg-white dark:bg-ink-900">
                  <% step2["items"].each do |item| %>
                    <tr class="border-t border-ink-100 dark:border-ink-800">
                      <td class="sticky left-0 bg-white dark:bg-ink-900 px-2 py-1.5 border-r border-ink-200 dark:border-ink-700 z-10">
                        <div class="font-semibold text-ink-900 dark:text-white truncate max-w-[160px]" title="<%= item["name"] %>">#<%= item["idx"] %>. <%= item["name"].to_s.truncate(20) %></div>
                      </td>
                      <% missing = (item["missing_fields"] || []) %>
                      <% RfqAuto::Analyzer::REQUIRED_FIELDS.each do |field| %>
                        <% is_missing = missing.include?(field) %>
                        <td class="px-1 py-1.5 text-center border-l border-ink-100 dark:border-ink-800 <%= is_missing ? 'bg-red-50 dark:bg-red-900/20' : 'bg-emerald-50/50 dark:bg-emerald-900/10' %>">
                          <span class="<%= is_missing ? 'text-red-600 dark:text-red-400' : 'text-emerald-600 dark:text-emerald-400' %> font-bold text-[14px]">
                            <%= is_missing ? "✗" : "✓" %>
                          </span>
                        </td>
                      <% end %>
                      <td class="px-2 py-1.5 text-center border-l border-ink-200 dark:border-ink-700">
                        <% if item["missing_count"].to_i > 0 %>
                          <span class="text-[10px] px-1.5 py-0.5 rounded bg-amber-100 dark:bg-amber-900/30 text-amber-800 dark:text-amber-300 font-mono">⚠ <%= item["missing_count"] %></span>
                        <% else %>
                          <span class="text-[10px] px-1.5 py-0.5 rounded bg-emerald-100 dark:bg-emerald-900/30 text-emerald-800 dark:text-emerald-300">완비</span>
                        <% end %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
            <div class="mt-2 text-[10px] text-ink-500">✓ 충족 / ✗ 누락 — 컬럼 헤더에 마우스 hover하면 전체 항목명 표시</div>
          </details>
        <% else %>
          <%# 품목 0개 — 문서 단위 11항목 매트릭스 %>
          <div class="border border-amber-200 dark:border-amber-700 rounded-md p-3 bg-amber-50/40 dark:bg-amber-900/10">
            <div class="text-[12px] font-semibold text-amber-800 dark:text-amber-300 mb-2">
              ⚠ 품목 추출 실패 — 문서 단위 11항목 점검 결과
            </div>
            <div class="grid grid-cols-2 md:grid-cols-3 gap-1">
              <% doc_missing = (step2["doc_level_missing"] || []) %>
              <% RfqAuto::Analyzer::REQUIRED_FIELDS.each do |field| %>
                <% is_missing = doc_missing.include?(field) %>
                <span class="text-[10px] px-1.5 py-0.5 rounded <%= is_missing ? 'bg-red-50 dark:bg-red-900/30 text-red-700 dark:text-red-300' : 'bg-emerald-50 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-300' %>">
                  <%= is_missing ? "✗" : "✓" %> <%= RfqAuto::Analyzer::REQUIRED_FIELD_LABELS[field] %>
                </span>
              <% end %>
            </div>
            <div class="text-[10px] text-ink-500 mt-2">
              ✓ 표시: 문서 텍스트에서 해당 키워드 발견됨 / ✗ 표시: 키워드 미발견 또는 LLM 추출 실패
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
    <% end %>

    <%# Step 3 — Task 목록 후보 (dry-run, 카드 적용 전 미리보기) %>
    <% step3 = steps["step3_tasks"] || {} %>
    <%= render layout: "lab/rfq_auto/step_panel", locals: { num: 3, title: "Task 목록 후보 (카드 적용 시 자동 생성)", step: step3, badge: step3.empty? ? nil : "#{step3['count'].to_i}건 / 결손 #{step3['missing_count'].to_i}" } do %>
    <% missing_tasks = (step3["tasks"] || []).select { |t| t["status"] == "missing" } %>
    <% if missing_tasks.any? %>
      <div>
        <div class="text-[11px] text-ink-500 mb-2">
          📌 카드에 적용 시 다음 Task가 자동 생성됩니다 (누락 항목 1건 = Task 1건).
        </div>
        <div class="overflow-x-auto rounded-md border border-amber-200 dark:border-amber-700">
          <table class="w-full text-[11px]">
            <thead class="bg-amber-50 dark:bg-amber-900/30 text-[10px] uppercase tracking-wider text-amber-800 dark:text-amber-200">
              <tr>
                <th class="px-2 py-1.5 text-left w-8">#</th>
                <th class="px-2 py-1.5 text-left">품목</th>
                <th class="px-2 py-1.5 text-left">자동 생성될 Task 제목</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-amber-100 dark:divide-amber-900/40 bg-white dark:bg-ink-900">
              <% missing_tasks.first(30).each_with_index do |t, i| %>
                <tr>
                  <td class="px-2 py-1.5 text-ink-500 font-mono"><%= i + 1 %></td>
                  <td class="px-2 py-1.5 text-ink-700 dark:text-ink-200 truncate max-w-[200px]"><%= t["item_name"].to_s.truncate(40) %></td>
                  <td class="px-2 py-1.5 text-ink-900 dark:text-white">
                    <span class="font-mono text-[10px] text-amber-700 dark:text-amber-300">[<%= t["item_name"].to_s.truncate(20) %>]</span>
                    <%= t["label"] %> 확인
                  </td>
                </tr>
              <% end %>
              <% if missing_tasks.size > 30 %>
                <tr><td colspan="3" class="px-2 py-1.5 text-center text-ink-500">…외 <%= missing_tasks.size - 30 %>건</td></tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    <% elsif step3["count"].to_i > 0 %>
      <div class="text-[11px] text-emerald-700 dark:text-emerald-300">
        ✓ 모든 필수 항목이 충족되어 자동 생성될 Task가 없습니다.
      </div>
    <% end %>
    <% end %>

    <%# Step 4 — 공급사 탐색 %>
    <% step4 = steps["step4_suppliers"] || {} %>
    <%= render layout: "lab/rfq_auto/step_panel", locals: { num: 4, title: "공급사 탐색", step: step4, badge: step4.empty? ? nil : "#{step4['count'].to_i}건" } do %>
    <% if step4["suppliers"].is_a?(Array) && step4["suppliers"].any? %>
      <%# 품목별 그룹핑 — 같은 품목의 공급사들이 모여 있어 사용자가 품목 단위로 선택 가능.
          매칭은 step2 items의 idx와 매핑 시도. 매칭 안 되면 '기타'에 모음. %>
      <% items_step2 = (steps["step2_items"] || {})["items"] || [] %>
      <% sup_groups = step4["suppliers"].group_by do |sup|
           kw = sup["item_keyword"].to_s.downcase
           # step2 items 중 가장 가까운 것 찾기
           match = items_step2.find { |it| it["name"].to_s.downcase.include?(kw) || kw.include?(it["name"].to_s.downcase) } if kw.present?
           match ? [ match["idx"], match["name"] ] : [ 0, sup["item_keyword"].presence || "기타" ]
         end %>
      <%# 정렬: 품목 idx 순 %>
      <% sup_groups = sup_groups.sort_by { |(idx, _name), _| idx.to_i } %>
      <div class="space-y-4">
        <% sup_groups.each do |(item_idx, item_name), sups| %>
          <div class="border-l-4 border-brand-400 dark:border-brand-600 pl-3">
            <%# 품목 헤더 %>
            <div class="flex items-center gap-2 mb-2">
              <span class="text-[14px] font-bold text-ink-900 dark:text-white">
                <% if item_idx > 0 %>#<%= item_idx %>. <% end %><%= item_name %>
              </span>
              <span class="text-[10px] text-ink-500">공급사 <%= sups.size %>건</span>
              <%# 소스별 카운트 %>
              <% sups.group_by { |s| s["source"] }.each do |src, list| %>
                <span class="text-[10px] px-1.5 py-0.5 rounded
                  <% case src
                     when 'local_db' %>bg-emerald-50 dark:bg-emerald-900/20 text-emerald-700 dark:text-emerald-300
                  <% when 'datago' %>bg-yellow-50 dark:bg-yellow-900/20 text-yellow-700 dark:text-yellow-300
                  <% else %>bg-ink-100 dark:bg-ink-800 text-ink-600 dark:text-ink-300
                  <% end %>">
                  <% case src
                     when 'local_db' %>🏠 DB
                  <% when 'datago' %>🇰🇷 조달청
                  <% when 'google_cse' %>🌐 Google
                  <% else %><%= src %><% end %>
                  <%= list.size %>
                </span>
              <% end %>
            </div>
            <div class="overflow-x-auto rounded-md border border-ink-150 dark:border-ink-800">
              <table class="w-full text-[11px]">
                <thead class="bg-ink-50 dark:bg-ink-800 text-[10px] uppercase tracking-wider text-ink-600 dark:text-ink-300">
                  <tr>
                    <th class="px-2 py-1.5 text-center w-8">선택</th>
                    <th class="px-2 py-1.5 text-left">업체명</th>
                    <th class="px-2 py-1.5 text-left w-16">소스</th>
                    <th class="px-2 py-1.5 text-left w-20">거래이력</th>
                    <th class="px-2 py-1.5 text-left w-12">신뢰도</th>
                    <th class="px-2 py-1.5 text-left">이메일</th>
                    <th class="px-2 py-1.5 text-left">웹사이트</th>
                    <th class="px-2 py-1.5 text-left w-12">국가</th>
                    <th class="px-2 py-1.5 text-left w-16">출처</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-ink-100 dark:divide-ink-800 bg-white dark:bg-ink-900">
                  <% sups.first(10).each_with_index do |sup, sup_idx| %>
                    <% items_step = (steps["step2_items"] || {})["items"] || [] %>
                    <% matching_item = items_step.find { |it| it["name"].to_s.downcase.include?(sup["item_keyword"].to_s.downcase) || sup["item_keyword"].to_s.downcase.include?(it["name"].to_s.downcase) } %>
                    <% item_idx = matching_item ? matching_item["idx"] : (sup_idx + 1) %>
                    <% sel = selections_index[[ item_idx, sup["name"] ]] %>
                    <% selected = !sel.nil? %>
                    <tr class="<%= 'bg-emerald-50/30 dark:bg-emerald-900/10' if selected %>">
                      <%# D-5 선택 체크박스 (button_to 토글) %>
                      <td class="px-2 py-1.5 text-center">
                        <%= button_to select_supplier_lab_rfq_auto_path(analysis.order, analysis_id: analysis.id),
                                method: :post,
                                params: {
                                  item_idx:       item_idx,
                                  item_keyword:   sup["item_keyword"],
                                  supplier_name:  sup["name"],
                                  supplier_id:    sup["supplier_id"],
                                  contact_email:  sup["email"],
                                  contact_phone:  sup["phone"],
                                  website:        sup["website"],
                                  country:        sup["country"],
                                  source:         sup["source"],
                                  confidence:     sup["confidence"],
                                  source_url:     sup["source_url"]
                                },
                                class: "inline-flex items-center justify-center w-6 h-6 rounded border #{selected ? 'bg-emerald-500 border-emerald-600 text-white' : 'border-ink-300 hover:border-brand-400'}",
                                title: selected ? "선택 해제" : "선택" do %>
                          <%= selected ? "✓" : "" %>
                        <% end %>
                      </td>
                      <td class="px-2 py-1.5 font-semibold text-ink-900 dark:text-white truncate max-w-[200px]" title="<%= sup["name"] %>"><%= sup["name"] %></td>
                      <%# 소스 배지 — 출처 시각 구분 %>
                      <td class="px-2 py-1.5">
                        <% src = sup["source"].to_s %>
                        <% case src
                           when 'local_db' %><span class="text-[10px] px-1.5 py-0.5 rounded bg-emerald-50 dark:bg-emerald-900/20 text-emerald-700 dark:text-emerald-300">🏠 DB</span>
                        <% when 'datago' %><span class="text-[10px] px-1.5 py-0.5 rounded bg-yellow-50 dark:bg-yellow-900/20 text-yellow-700 dark:text-yellow-300">🇰🇷 조달</span>
                        <% when 'google_cse' %><span class="text-[10px] px-1.5 py-0.5 rounded bg-blue-50 dark:bg-blue-900/20 text-blue-700 dark:text-blue-300">🌐 GCSE</span>
                        <% else %><span class="text-[10px] text-ink-400"><%= src %></span><% end %>
                      </td>
                      <%# D-7 거래이력 (자체 DB 매칭에만) %>
                      <td class="px-2 py-1.5">
                        <% if sup["order_count"].to_i > 0 %>
                          <span class="text-[10px] px-1.5 py-0.5 rounded bg-blue-50 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300" title="총 거래액 $<%= number_with_delimiter(sup["order_value"].to_i) rescue sup["order_value"] %>">
                            <%= sup["order_count"] %>건<% if sup["last_order_at"] %> · <%= time_ago_in_words(sup["last_order_at"]) rescue '' %><% end %>
                          </span>
                        <% elsif sup["auto_imported"] %>
                          <span class="text-[10px] px-1.5 py-0.5 rounded bg-fuchsia-50 dark:bg-fuchsia-900/30 text-fuchsia-700 dark:text-fuchsia-300" title="자동 import — 미검증">자동</span>
                        <% else %>
                          <span class="text-[10px] text-ink-400">신규</span>
                        <% end %>
                      </td>
                      <td class="px-2 py-1.5">
                        <% conf = sup["confidence"].to_i %>
                        <% conf_color = conf >= 80 ? "emerald" : (conf >= 60 ? "amber" : "ink") %>
                        <span class="text-[10px] px-1.5 py-0.5 rounded bg-<%= conf_color %>-100 dark:bg-<%= conf_color %>-900/30 text-<%= conf_color %>-700 dark:text-<%= conf_color %>-300 font-mono"><%= conf %></span>
                      </td>
                      <td class="px-2 py-1.5 text-ink-700 dark:text-ink-200 truncate max-w-[180px]">
                        <% if sup["email"].present? %><a href="mailto:<%= sup["email"] %>" class="hover:underline text-brand-600"><%= sup["email"] %></a><% else %>—<% end %>
                      </td>
                      <td class="px-2 py-1.5 truncate max-w-[200px]">
                        <% if sup["website"].present? %><a href="<%= sup["website"] %>" target="_blank" rel="noopener" class="hover:underline text-brand-600"><%= sup["website"].sub(/^https?:\/\//, "")[0, 28] %></a><% else %>—<% end %>
                      </td>
                      <td class="px-2 py-1.5 text-ink-500"><%= sup["country"].presence || "—" %></td>
                      <td class="px-2 py-1.5">
                        <% if sup["source_url"].present? %>
                          <a href="<%= sup["source_url"] %>" target="_blank" rel="noopener" class="text-[10px] text-cyan-600 hover:underline" title="<%= sup["source_url"] %>">🔗 출처</a>
                        <% else %>—<% end %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <%# 공급사 0건 안내 — 사용된 소스 진단 %>
      <% if step4["status"] != "skipped" %>
        <div class="ml-9 -mt-2 mb-4 p-3 bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-700 rounded-md text-[11px]">
          <div class="font-semibold text-amber-800 dark:text-amber-300 mb-1.5">⚠ 매칭된 공급사 없음</div>
          <div class="text-amber-700 dark:text-amber-200">탐색 결과:</div>
          <ul class="mt-1 space-y-0.5 text-amber-700 dark:text-amber-200">
            <li>🏠 자체 Supplier DB — 품목명으로 매칭되는 거래처 없음</li>
            <% datago_on = ENV["DATAGO_SERVICE_KEY"].present? || (Rails.application.credentials.dig(:datago, :service_key).present? rescue false) %>
            <% google_on = ENV["GOOGLE_CSE_API_KEY"].present? || (Rails.application.credentials.dig(:google_cse, :api_key).present? rescue false) %>
            <li>🇰🇷 한국 조달청 API — <%= datago_on ? "키 등록됨, 결과 없음" : "DATAGO_SERVICE_KEY 미설정 (자동 skip)" %></li>
            <li>🌐 Google Custom Search — <%= google_on ? "키 등록됨, 결과 없음" : "GOOGLE_CSE_API_KEY+CX 미설정 (자동 skip)" %></li>
          </ul>
        </div>
      <% else %>
        <div class="text-[11px] text-ink-500">
          품목 0개로 탐색 skip — 품목 추출 후 다시 분석해주세요.
        </div>
      <% end %>
    <% end %>

    <%# D-5/D-6 선택 요약 + 멀티 발송 %>
    <% selected_count = selections_index.size %>
    <% pending_email = selections_index.values.count { |s| s.contact_email.present? && !s.emailed? } rescue 0 %>
    <% emailed = selections_index.values.count(&:emailed?) rescue 0 %>
    <% if selected_count > 0 || pending_email > 0 %>
      <div class="mt-3 p-3 rounded-md bg-emerald-50 dark:bg-emerald-900/20 border border-emerald-200 dark:border-emerald-700 flex items-center justify-between gap-3 flex-wrap">
        <div class="text-[12px] text-emerald-800 dark:text-emerald-200">
          ✅ 선택된 공급사 <strong><%= selected_count %></strong>건 ·
          📨 발송 대기 <strong><%= pending_email %></strong>건 ·
          ✓ 발송 완료 <strong><%= emailed %></strong>건
        </div>
        <% if pending_email > 0 %>
          <%= button_to send_rfq_emails_lab_rfq_auto_path(analysis.order, analysis_id: analysis.id), method: :post,
                  data: { turbo_confirm: "선택된 공급사 #{pending_email}곳에 RFQ 견적 요청 이메일을 발송합니다. 계속하시겠습니까?" },
                  class: "shrink-0 inline-flex items-center gap-2 px-3 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white text-[12px] font-semibold rounded transition-colors" do %>
            📨 선택 공급사 <%= pending_email %>곳에 RFQ 발송
          <% end %>
        <% end %>
      </div>
    <% end %>
    <% end %>

    <%# Step 5 — 종합 보고서 %>
    <% step5 = steps["step5_summary"] || {} %>
    <%= render layout: "lab/rfq_auto/step_panel", locals: { num: 5, title: "종합 보고서", step: step5, badge: step5.empty? ? nil : "완료" } do %>
    <% if analysis.completed? && summary.present? %>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-2 text-[11px]">
        <div class="p-2 rounded bg-ink-50 dark:bg-ink-900 border border-ink-150 dark:border-ink-800">
          <div class="text-ink-500 mb-0.5">📎 첨부 분류</div>
          <div class="font-mono text-ink-900 dark:text-white"><%= summary["attachments_relevant"].to_i %>/<%= summary["attachments_total"].to_i %> 관련</div>
        </div>
        <div class="p-2 rounded bg-ink-50 dark:bg-ink-900 border border-ink-150 dark:border-ink-800">
          <div class="text-ink-500 mb-0.5">📦 품목 추출</div>
          <div class="font-mono text-ink-900 dark:text-white"><%= summary["items_count"].to_i %>건</div>
        </div>
        <div class="p-2 rounded bg-ink-50 dark:bg-ink-900 border border-ink-150 dark:border-ink-800">
          <div class="text-ink-500 mb-0.5">⚠ 누락 항목 합계</div>
          <div class="font-mono text-amber-700 dark:text-amber-300"><%= summary["items_missing_total"].to_i %>건</div>
        </div>
        <div class="p-2 rounded bg-ink-50 dark:bg-ink-900 border border-ink-150 dark:border-ink-800">
          <div class="text-ink-500 mb-0.5">📌 자동 생성 예정 Task</div>
          <div class="font-mono text-ink-900 dark:text-white"><%= summary["tasks_missing"].to_i %>건</div>
        </div>
        <div class="p-2 rounded bg-ink-50 dark:bg-ink-900 border border-ink-150 dark:border-ink-800">
          <div class="text-ink-500 mb-0.5">🏢 공급사 후보</div>
          <div class="font-mono text-ink-900 dark:text-white"><%= summary["suppliers_total"].to_i %>건</div>
        </div>
        <div class="p-2 rounded bg-ink-50 dark:bg-ink-900 border border-ink-150 dark:border-ink-800">
          <div class="text-ink-500 mb-0.5">⏱ 소요 / 비용</div>
          <div class="font-mono text-ink-900 dark:text-white"><%= summary["elapsed_seconds"] %>s · $<%= summary["cost_usd"] %></div>
        </div>
      </div>
    <% end %>
    <% end %>
  </div>

  <%# 액션 + 피드백 (완료 상태에서만) %>
  <% if analysis.completed? %>
    <div class="mt-6 pt-4 border-t border-ink-150 dark:border-ink-800 flex items-center justify-between gap-4 flex-wrap">
      <div class="flex items-center gap-2">
        <% if summary["applied_at"].blank? %>
          <%= button_to apply_lab_rfq_auto_path(analysis.order, analysis_id: analysis.id), method: :post,
                  data: { turbo_confirm: "분석 결과를 카드에 적용합니다. 누락 항목당 Task 1개씩 자동 생성됩니다. 계속하시겠습니까?" },
                  class: "inline-flex items-center gap-2 px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white text-[13px] font-semibold rounded-md transition-colors" do %>
            📌 카드에 적용 (Task 자동 생성)
          <% end %>
        <% else %>
          <span class="text-[12px] text-emerald-700 dark:text-emerald-300 font-semibold">📌 적용 완료 — Task <%= summary["tasks_created"] %>건 생성됨</span>
        <% end %>
      </div>
      <div class="flex items-center gap-2">
        <span class="text-[11px] text-ink-500 mr-2">분석 정확도:</span>
        <% %w[correct partial wrong].each do |val| %>
          <%= button_to feedback_lab_rfq_auto_path(analysis.order, value: val, analysis_id: analysis.id), method: :post,
                  class: "text-[12px] px-3 py-1.5 rounded border #{analysis.feedback == val ? 'bg-brand-600 text-white border-brand-600' : 'border-ink-200 hover:border-brand-400'}" do %>
            <%= { "correct" => "✓ 정확", "partial" => "△ 부분", "wrong" => "✗ 틀림" }[val] %>
          <% end %>
        <% end %>
      </div>
    </div>
  <% elsif analysis.failed? %>
    <div class="mt-6 pt-4 border-t border-ink-150 dark:border-ink-800">
      <div class="text-[12px] text-red-600 dark:text-red-400">
        실패 원인: <span class="font-mono"><%= analysis.error_message %></span>
      </div>
    </div>
  <% end %>
</div>
