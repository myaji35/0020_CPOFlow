<% content_for :page_title, "🔬 LAB · RFQ Auto · #{@order.title || @order.display_subject}" %>

<div class="px-6 py-6 max-w-[1200px] mx-auto">
  <header class="mb-5 flex items-start justify-between gap-4">
    <div class="min-w-0">
      <div class="flex items-center gap-2 mb-1">
        <%= link_to "← 목록", lab_rfq_auto_index_path, class: "text-[12px] text-ink-500 hover:text-brand-600" %>
        <span class="text-[10px] font-bold uppercase tracking-wider px-1.5 py-0.5 rounded bg-amber-100 dark:bg-amber-900/40 text-amber-800 dark:text-amber-300">LAB</span>
      </div>
      <h1 class="text-lg font-semibold text-ink-900 dark:text-white truncate">
        <%= @order.title.presence || @order.display_subject %>
        <% if @order.lab_sandbox? %>
          <span class="text-[10px] font-bold uppercase tracking-wider px-1.5 py-0.5 rounded bg-fuchsia-100 dark:bg-fuchsia-900/40 text-fuchsia-800 dark:text-fuchsia-300 align-middle ml-1">SANDBOX</span>
        <% end %>
      </h1>
      <div class="text-[11px] text-ink-500 mt-1">
        <%= @order.reference_no.presence || @order.rfq_no.presence || "RFQ no 없음" %> ·
        <%= @order.client&.name || @order.customer_name || "고객 미지정" %> ·
        첨부 <%= @order.attachments.size %>개
      </div>
    </div>

    <%= button_to analyze_lab_rfq_auto_path(@order), method: :post,
            data: { turbo_confirm: "자동 분석을 시작합니다. LLM 호출 비용이 발생할 수 있습니다. 계속하시겠습니까?" },
            class: "shrink-0 inline-flex items-center gap-2 px-4 py-2 bg-amber-500 hover:bg-amber-600 text-white text-[13px] font-semibold rounded-md transition-colors shadow-sh-1" do %>
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      <%= @latest ? "다시 분석" : "🔬 자동 분석 시작" %>
    <% end %>
  </header>

  <%# 첨부 관리 패널 — 임의 파일 업로드/삭제로 분석 능력 점검 %>
  <div class="mb-5 border border-ink-150 dark:border-ink-800 rounded-lg bg-white dark:bg-ink-900 p-4">
    <div class="flex items-center justify-between mb-3">
      <h2 class="text-[13px] font-semibold text-ink-900 dark:text-white">📎 첨부 파일 (분석 입력)</h2>
      <span class="text-[11px] text-ink-500"><%= @order.attachments.size %>개</span>
    </div>

    <%# 업로드 폼 %>
    <%= form_with url: upload_lab_rfq_auto_path(@order), method: :post, multipart: true,
            local: true, data: { turbo: false },
            class: "flex items-center gap-2 flex-wrap mb-3 p-3 bg-ink-50 dark:bg-ink-800/40 rounded-md" do |f| %>
      <%= f.file_field :files, multiple: true,
              accept: ".pdf,.doc,.docx,.xls,.xlsx,.csv,.txt,.png,.jpg,.jpeg,.dwg,.dxf,.eml,.msg,.zip",
              class: "text-[12px] flex-1 min-w-[260px] file:mr-2 file:px-3 file:py-1.5 file:rounded file:border-0 file:bg-brand-600 file:text-white file:text-[12px] file:font-semibold hover:file:bg-brand-700 file:cursor-pointer" %>
      <label class="inline-flex items-center gap-1.5 text-[12px] text-ink-700 dark:text-ink-200 cursor-pointer">
        <input type="checkbox" name="auto_analyze" value="1" class="w-3.5 h-3.5">
        업로드 후 즉시 분석
      </label>
      <%= f.submit "📤 업로드",
              class: "shrink-0 text-[12px] px-3 py-1.5 rounded bg-emerald-600 hover:bg-emerald-700 text-white font-semibold cursor-pointer" %>
    <% end %>

    <%# 현재 첨부 목록 + 개별 삭제 %>
    <% if @order.attachments.any? %>
      <div class="space-y-1">
        <% @order.attachments_attachments.includes(:blob).each do |att| %>
          <div class="flex items-center justify-between text-[12px] px-3 py-2 bg-ink-50 dark:bg-ink-900 border border-ink-100 dark:border-ink-800 rounded">
            <div class="flex items-center gap-2 min-w-0">
              <svg class="w-3.5 h-3.5 text-ink-500 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg>
              <span class="font-mono truncate text-ink-700 dark:text-ink-200"><%= att.blob.filename %></span>
              <span class="text-[10px] text-ink-400 shrink-0"><%= number_to_human_size(att.blob.byte_size) %></span>
            </div>
            <%= button_to attachment_lab_rfq_auto_path(@order, attachment_id: att.id), method: :delete,
                    data: { turbo_confirm: "이 첨부를 삭제하시겠습니까? (LAB 한정 — 운영 영향 없음)" },
                    class: "shrink-0 text-[10px] px-2 py-0.5 rounded text-red-600 hover:bg-red-50 dark:hover:bg-red-900/30 transition-colors" do %>
              ✗ 삭제
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="text-[11px] text-ink-500 text-center py-3">
        첨부 없음 — 위에서 PDF/DOC/XLS/이미지/도면 등을 업로드해보세요.
      </div>
    <% end %>
  </div>

  <% if @latest.nil? %>
    <div class="border border-dashed border-ink-200 dark:border-ink-700 rounded-lg p-8 text-center text-ink-500">
      아직 분석 기록이 없습니다. 위 <strong class="text-amber-600">자동 분석 시작</strong> 버튼을 눌러주세요.
    </div>
  <% else %>
    <%# Turbo Stream 구독 — Analyzer가 단계마다 broadcast하면 부분 갱신 %>
    <%= turbo_stream_from "rfq_auto_analysis_#{@latest.id}" %>
    <%= render "analysis_card", analysis: @latest %>

    <%# 과거 분석 이력 %>
    <% if @analyses.size > 1 %>
      <div class="mt-8 pt-4 border-t border-ink-150 dark:border-ink-800">
        <h3 class="text-[13px] font-semibold text-ink-700 dark:text-ink-200 mb-2">과거 분석 이력</h3>
        <div class="space-y-1">
          <% @analyses[1..].each do |a| %>
            <div class="flex items-center gap-3 text-[11px] text-ink-500 py-1">
              <span><%= l(a.created_at, format: :short) rescue a.created_at %></span>
              <span class="font-mono px-1.5 py-0.5 rounded bg-ink-100 dark:bg-ink-800"><%= a.status %></span>
              <span><%= a.user&.display_name %></span>
              <span class="font-mono">$<%= a.cost_usd %> · <%= a.duration_seconds %>s</span>
              <% if a.feedback.present? %>
                <span class="text-[10px] px-1.5 py-0.5 rounded bg-brand-50 text-brand-700"><%= a.feedback %></span>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
