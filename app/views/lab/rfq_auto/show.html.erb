<% content_for :page_title, "🔬 LAB · RFQ Auto · #{@order.title || @order.display_subject}" %>

<div class="px-6 py-6 max-w-[1200px] mx-auto">
  <header class="mb-5 flex items-start justify-between gap-4">
    <div class="min-w-0">
      <div class="flex items-center gap-2 mb-1">
        <%= link_to "← 목록", lab_rfq_auto_index_path, class: "text-[12px] text-ink-500 hover:text-brand-600" %>
        <span class="text-[10px] font-bold uppercase tracking-wider px-1.5 py-0.5 rounded bg-amber-100 dark:bg-amber-900/40 text-amber-800 dark:text-amber-300">LAB</span>
      </div>
      <h1 class="text-lg font-semibold text-ink-900 dark:text-white truncate"><%= @order.title.presence || @order.display_subject %></h1>
      <div class="text-[11px] text-ink-500 mt-1">
        <%= @order.reference_no.presence || @order.rfq_no.presence || "RFQ no 없음" %> ·
        <%= @order.client&.name || @order.customer_name || "고객 미지정" %> ·
        첨부 <%= @order.attachments.size %>개
      </div>
    </div>

    <%= button_to analyze_lab_rfq_auto_path(@order), method: :post,
            data: { turbo_confirm: "자동 분석을 시작합니다. LLM 호출 비용이 발생할 수 있습니다. 계속하시겠습니까?" },
            class: "shrink-0 inline-flex items-center gap-2 px-4 py-2 bg-amber-500 hover:bg-amber-600 text-white text-[13px] font-semibold rounded-md transition-colors shadow-sh-1" do %>
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      <%= @latest ? "다시 분석" : "🔬 자동 분석 시작" %>
    <% end %>
  </header>

  <% if @latest.nil? %>
    <div class="border border-dashed border-ink-200 dark:border-ink-700 rounded-lg p-8 text-center text-ink-500">
      아직 분석 기록이 없습니다. 위 <strong class="text-amber-600">자동 분석 시작</strong> 버튼을 눌러주세요.
    </div>
  <% else %>
    <%# 메트릭 카드 %>
    <div class="grid grid-cols-2 md:grid-cols-5 gap-3 mb-5">
      <% s = @latest.summary_data %>
      <% [
        ["첨부",     "#{s['attachments_relevant'].to_i}/#{s['attachments_total'].to_i}", "관련/전체"],
        ["품목",     "#{s['items_count'].to_i}",                                          "추출"],
        ["누락 항목", "#{s['items_missing_total'].to_i}",                                  "필수 11항목"],
        ["공급사",   "#{s['suppliers_total'].to_i}",                                      "탐색 결과"],
        ["소요/비용", "#{s['elapsed_seconds']}s · $#{s['cost_usd']}",                     "LLM"]
      ].each do |label, val, sub| %>
        <div class="bg-white dark:bg-ink-900 border border-ink-150 dark:border-ink-800 rounded-md p-3">
          <div class="text-[10px] uppercase tracking-wider text-ink-500"><%= label %></div>
          <div class="text-[18px] font-semibold text-ink-900 dark:text-white mt-0.5 font-mono"><%= val %></div>
          <div class="text-[10px] text-ink-400 mt-0.5"><%= sub %></div>
        </div>
      <% end %>
    </div>

    <%# 5단계 결과 카드 %>
    <% steps = @latest.steps_data %>
    <div class="space-y-4">
      <%# Step 1 — 첨부 분류 %>
      <% step1 = steps["step1_attachments"] || {} %>
      <%= render "step_header", num: 1, title: "첨부 파일 인식", step: step1, badge: "#{step1['relevant'].to_i}/#{step1['total'].to_i} 관련" %>
      <% if step1["items"].is_a?(Array) && step1["items"].any? %>
        <div class="ml-9 -mt-2 mb-4 space-y-1.5">
          <% step1["items"].each do |it| %>
            <div class="flex items-center justify-between text-[12px] px-3 py-2 bg-ink-50 dark:bg-ink-900 rounded border border-ink-100 dark:border-ink-800">
              <div class="flex items-center gap-2 min-w-0">
                <span class="font-mono text-ink-700 dark:text-ink-200 truncate max-w-[420px]"><%= it["filename"] %></span>
                <span class="text-[10px] px-1.5 py-0.5 rounded bg-blue-50 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300"><%= it["type"] %></span>
              </div>
              <div class="flex items-center gap-2 shrink-0">
                <span class="text-[10px] text-ink-500">관련도 <%= it["relevance_score"] %></span>
                <span class="w-12 h-1 bg-ink-100 rounded-full overflow-hidden"><span class="block h-full bg-brand-500" style="width: <%= [it["relevance_score"].to_i, 100].min %>%"></span></span>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>

      <%# Step 2 — 품목 + 11항목 %>
      <% step2 = steps["step2_items"] || {} %>
      <%= render "step_header", num: 2, title: "품목 추출 + 필수 11항목 점검", step: step2, badge: "#{step2['count'].to_i}품" %>
      <% if step2["items"].is_a?(Array) && step2["items"].any? %>
        <div class="ml-9 -mt-2 mb-4 space-y-2">
          <% step2["items"].each do |item| %>
            <div class="border border-ink-150 dark:border-ink-800 rounded-md p-3 bg-white dark:bg-ink-900">
              <div class="flex items-start justify-between gap-3 mb-2">
                <div class="min-w-0">
                  <div class="text-[13px] font-semibold text-ink-900 dark:text-white">
                    #<%= item["idx"] %>. <%= item["name"].presence || "(품명 없음)" %>
                    <% if item["model"].present? %><span class="text-ink-500 font-normal text-[12px]">/ <%= item["model"] %></span><% end %>
                  </div>
                  <div class="text-[11px] text-ink-500 mt-0.5"><%= item["spec"] %></div>
                </div>
                <div class="text-right shrink-0">
                  <div class="text-[12px] font-mono text-ink-700 dark:text-ink-200"><%= item["quantity"] %> <%= item["unit"] %></div>
                  <% if item["missing_count"].to_i > 0 %>
                    <span class="inline-flex items-center gap-1 text-[10px] px-1.5 py-0.5 mt-1 rounded bg-amber-100 dark:bg-amber-900/30 text-amber-800 dark:text-amber-300">
                      ⚠ 누락 <%= item["missing_count"] %>
                    </span>
                  <% else %>
                    <span class="text-[10px] px-1.5 py-0.5 mt-1 rounded bg-emerald-100 dark:bg-emerald-900/30 text-emerald-800 dark:text-emerald-300">완비</span>
                  <% end %>
                </div>
              </div>
              <% missing = (item["missing_fields"] || []) %>
              <% if missing.any? %>
                <div class="flex flex-wrap gap-1 mt-2 pt-2 border-t border-ink-100 dark:border-ink-800">
                  <% missing.each do |field| %>
                    <span class="text-[10px] px-1.5 py-0.5 rounded bg-red-50 dark:bg-red-900/30 text-red-700 dark:text-red-300">
                      ✗ <%= RfqAuto::Analyzer::REQUIRED_FIELD_LABELS[field] || field %>
                    </span>
                  <% end %>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>

      <%# Step 3 — Task 후보 %>
      <% step3 = steps["step3_tasks"] || {} %>
      <%= render "step_header", num: 3, title: "Task 목록 후보 (dry-run)", step: step3,
                 badge: "#{step3['count'].to_i}건 / 결손 #{step3['missing_count'].to_i}" %>

      <%# Step 4 — 공급사 탐색 %>
      <% step4 = steps["step4_suppliers"] || {} %>
      <%= render "step_header", num: 4, title: "공급사 탐색", step: step4, badge: "#{step4['count'].to_i}건" %>
      <% if step4["suppliers"].is_a?(Array) && step4["suppliers"].any? %>
        <div class="ml-9 -mt-2 mb-4 space-y-1.5">
          <% step4["suppliers"].first(10).each do |sup| %>
            <div class="flex items-center justify-between text-[12px] px-3 py-2 bg-ink-50 dark:bg-ink-900 rounded border border-ink-100 dark:border-ink-800">
              <div class="min-w-0">
                <div class="font-semibold text-ink-900 dark:text-white"><%= sup["name"] %></div>
                <div class="text-[10px] text-ink-500"><%= sup["email"] %> · <%= sup["phone"] %> · <%= sup["website"] %></div>
              </div>
              <div class="shrink-0 flex items-center gap-2">
                <span class="text-[10px] px-1.5 py-0.5 rounded bg-emerald-50 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-300">신뢰도 <%= sup["confidence"] %></span>
                <span class="text-[10px] text-ink-400"><%= sup["source"] %></span>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
      <% if step4["status"] == "skipped" || (step4["count"].to_i == 0 && step4["status"] != "error") %>
        <div class="ml-9 -mt-2 mb-4 text-[11px] text-ink-500">
          Phase 1: 자체 Supplier DB 검색만 동작. 한국 조달청·UAE 검색은 Phase 3 예정.
        </div>
      <% end %>

      <%# Step 5 — 종합 %>
      <% step5 = steps["step5_summary"] || {} %>
      <%= render "step_header", num: 5, title: "종합 보고서", step: step5, badge: "완료" %>

      <%# 피드백 %>
      <div class="mt-6 pt-4 border-t border-ink-150 dark:border-ink-800">
        <div class="text-[12px] text-ink-600 dark:text-ink-300 mb-2">이 분석 결과는 정확합니까?</div>
        <div class="flex items-center gap-2">
          <% %w[correct partial wrong].each do |val| %>
            <%= button_to feedback_lab_rfq_auto_path(@order, value: val, analysis_id: @latest.id), method: :post,
                    class: "text-[12px] px-3 py-1.5 rounded border #{@latest.feedback == val ? 'bg-brand-600 text-white border-brand-600' : 'border-ink-200 hover:border-brand-400'}" do %>
              <%= { "correct" => "✓ 정확", "partial" => "△ 부분", "wrong" => "✗ 틀림" }[val] %>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>

    <%# 과거 분석 이력 %>
    <% if @analyses.size > 1 %>
      <div class="mt-8">
        <h3 class="text-[13px] font-semibold text-ink-700 dark:text-ink-200 mb-2">과거 분석 이력</h3>
        <div class="space-y-1">
          <% @analyses[1..].each do |a| %>
            <div class="flex items-center gap-3 text-[11px] text-ink-500 py-1">
              <span><%= l(a.created_at, format: :short) rescue a.created_at %></span>
              <span class="font-mono"><%= a.status %></span>
              <span><%= a.user&.display_name %></span>
              <span class="font-mono">$<%= a.cost_usd %> · <%= a.duration_seconds %>s</span>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
