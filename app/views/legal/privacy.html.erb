<% content_for :page_title, t("legal.privacy.title") %>

<%# ── Hero ─────────────────────────────────────────────────────────── %>
<div class="mb-10">
  <div class="inline-flex items-center gap-2 text-xs font-medium text-hero bg-hero/10 px-3 py-1 rounded-full mb-4">
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
    <%= t("legal.privacy.badge") %>
  </div>
  <h1 class="text-3xl font-bold text-navy mb-3"><%= t("legal.privacy.title") %></h1>
  <p class="text-sm text-gray-500"><%= t("legal.privacy.effective_date") %></p>
  <p class="mt-4 text-gray-600 leading-relaxed max-w-2xl"><%= t("legal.privacy.intro") %></p>
</div>

<%# ── Disclaimer ───────────────────────────────────────────────────── %>
<div class="bg-amber-50 border border-amber-200 rounded-lg px-5 py-4 mb-10 text-sm text-amber-800">
  <strong><%= t("legal.privacy.disclaimer_title") %></strong>
  <%= t("legal.privacy.disclaimer_body") %>
</div>

<%# ── Table of Contents ────────────────────────────────────────────── %>
<div class="bg-white border border-gray-200 rounded-xl p-6 mb-10 no-print">
  <h2 class="text-sm font-semibold text-gray-700 mb-4 uppercase tracking-wider"><%= t("legal.toc") %></h2>
  <ol class="space-y-1.5 text-sm">
    <% [
      ["#s1", "legal.privacy.s1.heading"],
      ["#s2", "legal.privacy.s2.heading"],
      ["#s3", "legal.privacy.s3.heading"],
      ["#s4", "legal.privacy.s4.heading"],
      ["#s5", "legal.privacy.s5.heading"],
      ["#s6", "legal.privacy.s6.heading"],
      ["#s7", "legal.privacy.s7.heading"],
      ["#s8", "legal.privacy.s8.heading"],
      ["#s9", "legal.privacy.s9.heading"],
      ["#s10", "legal.privacy.s10.heading"],
      ["#s11", "legal.privacy.s11.heading"],
    ].each_with_index do |(href, key), i| %>
      <li>
        <a href="<%= href %>" class="text-hero hover:underline">
          <%= i + 1 %>. <%= t(key) %>
        </a>
      </li>
    <% end %>
  </ol>
</div>

<%# ── Sections ─────────────────────────────────────────────────────── %>
<div class="prose prose-sm max-w-none space-y-10">

  <%# S1: Company Information %>
  <section id="s1" class="bg-white border border-gray-200 rounded-xl p-7">
    <h2 class="text-xl font-semibold text-navy mb-4 flex items-center gap-2">
      <span class="w-7 h-7 rounded-full bg-hero/10 text-hero text-xs font-bold flex items-center justify-center">1</span>
      <%= t("legal.privacy.s1.heading") %>
    </h2>
    <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-3 text-sm">
      <div>
        <dt class="font-semibold text-gray-700"><%= t("legal.privacy.s1.company_name_label") %></dt>
        <dd class="text-gray-600">AtoZ2010 Inc.</dd>
      </div>
      <div>
        <dt class="font-semibold text-gray-700"><%= t("legal.privacy.s1.hq_label") %></dt>
        <dd class="text-gray-600">Abu Dhabi, UAE</dd>
      </div>
      <div>
        <dt class="font-semibold text-gray-700"><%= t("legal.privacy.s1.branch_label") %></dt>
        <dd class="text-gray-600">Seoul, Republic of Korea</dd>
      </div>
      <div>
        <dt class="font-semibold text-gray-700"><%= t("legal.privacy.s1.service_label") %></dt>
        <dd class="text-gray-600">CPOFlow — Procurement Management SaaS</dd>
      </div>
      <div>
        <dt class="font-semibold text-gray-700"><%= t("legal.privacy.s1.contact_label") %></dt>
        <dd class="text-gray-600"><a href="mailto:privacy@atozone.com" class="text-hero hover:underline">privacy@atozone.com</a></dd>
      </div>
    </dl>
  </section>

  <%# S2: Information We Collect %>
  <section id="s2" class="bg-white border border-gray-200 rounded-xl p-7">
    <h2 class="text-xl font-semibold text-navy mb-4 flex items-center gap-2">
      <span class="w-7 h-7 rounded-full bg-hero/10 text-hero text-xs font-bold flex items-center justify-center">2</span>
      <%= t("legal.privacy.s2.heading") %>
    </h2>
    <div class="space-y-5 text-sm text-gray-700">
      <div>
        <h3 class="font-semibold text-gray-900 mb-2"><%= t("legal.privacy.s2.account_title") %></h3>
        <ul class="list-disc list-inside space-y-1 text-gray-600">
          <li><%= t("legal.privacy.s2.account_email") %></li>
          <li><%= t("legal.privacy.s2.account_name") %></li>
          <li><%= t("legal.privacy.s2.account_role") %></li>
          <li><%= t("legal.privacy.s2.account_google_token") %></li>
        </ul>
      </div>
      <div>
        <h3 class="font-semibold text-gray-900 mb-2"><%= t("legal.privacy.s2.gmail_title") %></h3>
        <p class="text-gray-600 mb-2"><%= t("legal.privacy.s2.gmail_scope_note") %></p>
        <ul class="list-disc list-inside space-y-1 text-gray-600">
          <li><%= t("legal.privacy.s2.gmail_subject") %></li>
          <li><%= t("legal.privacy.s2.gmail_body") %></li>
          <li><%= t("legal.privacy.s2.gmail_attachments") %></li>
          <li><%= t("legal.privacy.s2.gmail_metadata") %></li>
        </ul>
      </div>
      <div>
        <h3 class="font-semibold text-gray-900 mb-2"><%= t("legal.privacy.s2.usage_title") %></h3>
        <ul class="list-disc list-inside space-y-1 text-gray-600">
          <li><%= t("legal.privacy.s2.usage_log") %></li>
          <li><%= t("legal.privacy.s2.usage_browser") %></li>
        </ul>
      </div>
    </div>
  </section>

  <%# S3: Purpose of Use %>
  <section id="s3" class="bg-white border border-gray-200 rounded-xl p-7">
    <h2 class="text-xl font-semibold text-navy mb-4 flex items-center gap-2">
      <span class="w-7 h-7 rounded-full bg-hero/10 text-hero text-xs font-bold flex items-center justify-center">3</span>
      <%= t("legal.privacy.s3.heading") %>
    </h2>
    <ul class="space-y-3 text-sm text-gray-700">
      <li class="flex gap-3">
        <svg class="w-4 h-4 text-hero mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
        <span><%= t("legal.privacy.s3.purpose_rfq") %></span>
      </li>
      <li class="flex gap-3">
        <svg class="w-4 h-4 text-hero mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
        <span><%= t("legal.privacy.s3.purpose_attachment") %></span>
      </li>
      <li class="flex gap-3">
        <svg class="w-4 h-4 text-hero mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
        <span><%= t("legal.privacy.s3.purpose_workflow") %></span>
      </li>
      <li class="flex gap-3">
        <svg class="w-4 h-4 text-hero mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
        <span><%= t("legal.privacy.s3.purpose_notification") %></span>
      </li>
      <li class="flex gap-3">
        <svg class="w-4 h-4 text-hero mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
        <span><%= t("legal.privacy.s3.purpose_improvement") %></span>
      </li>
    </ul>
  </section>

  <%# S4: Third-Party Sharing %>
  <section id="s4" class="bg-white border border-gray-200 rounded-xl p-7">
    <h2 class="text-xl font-semibold text-navy mb-4 flex items-center gap-2">
      <span class="w-7 h-7 rounded-full bg-hero/10 text-hero text-xs font-bold flex items-center justify-center">4</span>
      <%= t("legal.privacy.s4.heading") %>
    </h2>
    <p class="text-sm text-gray-600 mb-4"><%= t("legal.privacy.s4.intro") %></p>
    <div class="space-y-4">
      <div class="border border-gray-200 rounded-lg overflow-hidden">
        <table class="w-full text-sm">
          <thead class="bg-surface">
            <tr>
              <th class="text-left px-4 py-2.5 font-semibold text-gray-700 w-1/4"><%= t("legal.privacy.s4.col_party") %></th>
              <th class="text-left px-4 py-2.5 font-semibold text-gray-700 w-1/4"><%= t("legal.privacy.s4.col_data") %></th>
              <th class="text-left px-4 py-2.5 font-semibold text-gray-700"><%= t("legal.privacy.s4.col_purpose") %></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <tr>
              <td class="px-4 py-3 font-medium text-gray-800">Google LLC</td>
              <td class="px-4 py-3 text-gray-600"><%= t("legal.privacy.s4.google_data") %></td>
              <td class="px-4 py-3 text-gray-600"><%= t("legal.privacy.s4.google_purpose") %></td>
            </tr>
            <tr>
              <td class="px-4 py-3 font-medium text-gray-800">Anthropic PBC</td>
              <td class="px-4 py-3 text-gray-600"><%= t("legal.privacy.s4.anthropic_data") %></td>
              <td class="px-4 py-3 text-gray-600"><%= t("legal.privacy.s4.anthropic_purpose") %></td>
            </tr>
            <tr>
              <td class="px-4 py-3 font-medium text-gray-800">Vultr</td>
              <td class="px-4 py-3 text-gray-600"><%= t("legal.privacy.s4.vultr_data") %></td>
              <td class="px-4 py-3 text-gray-600"><%= t("legal.privacy.s4.vultr_purpose") %></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
    <p class="mt-4 text-sm text-gray-600"><%= t("legal.privacy.s4.no_sell") %></p>
  </section>

  <%# S5: Data Retention %>
  <section id="s5" class="bg-white border border-gray-200 rounded-xl p-7">
    <h2 class="text-xl font-semibold text-navy mb-4 flex items-center gap-2">
      <span class="w-7 h-7 rounded-full bg-hero/10 text-hero text-xs font-bold flex items-center justify-center">5</span>
      <%= t("legal.privacy.s5.heading") %>
    </h2>
    <ul class="space-y-3 text-sm text-gray-700">
      <li class="flex gap-3">
        <span class="font-semibold text-gray-900 w-40 shrink-0"><%= t("legal.privacy.s5.email_label") %></span>
        <span class="text-gray-600"><%= t("legal.privacy.s5.email_period") %></span>
      </li>
      <li class="flex gap-3">
        <span class="font-semibold text-gray-900 w-40 shrink-0"><%= t("legal.privacy.s5.attachment_label") %></span>
        <span class="text-gray-600"><%= t("legal.privacy.s5.attachment_period") %></span>
      </li>
      <li class="flex gap-3">
        <span class="font-semibold text-gray-900 w-40 shrink-0"><%= t("legal.privacy.s5.log_label") %></span>
        <span class="text-gray-600"><%= t("legal.privacy.s5.log_period") %></span>
      </li>
      <li class="flex gap-3">
        <span class="font-semibold text-gray-900 w-40 shrink-0"><%= t("legal.privacy.s5.account_label") %></span>
        <span class="text-gray-600"><%= t("legal.privacy.s5.account_period") %></span>
      </li>
    </ul>
  </section>

  <%# S6: User Rights %>
  <section id="s6" class="bg-white border border-gray-200 rounded-xl p-7">
    <h2 class="text-xl font-semibold text-navy mb-4 flex items-center gap-2">
      <span class="w-7 h-7 rounded-full bg-hero/10 text-hero text-xs font-bold flex items-center justify-center">6</span>
      <%= t("legal.privacy.s6.heading") %>
    </h2>
    <div class="space-y-3 text-sm">
      <div class="flex gap-3">
        <svg class="w-4 h-4 text-hero mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
        <span class="text-gray-700"><%= t("legal.privacy.s6.right_access") %></span>
      </div>
      <div class="flex gap-3">
        <svg class="w-4 h-4 text-hero mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
        <span class="text-gray-700"><%= t("legal.privacy.s6.right_rectify") %></span>
      </div>
      <div class="flex gap-3">
        <svg class="w-4 h-4 text-hero mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6M14 11v6"/></svg>
        <span class="text-gray-700"><%= t("legal.privacy.s6.right_delete") %></span>
      </div>
      <div class="flex gap-3">
        <svg class="w-4 h-4 text-hero mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
        <span class="text-gray-700"><%= t("legal.privacy.s6.right_gmail_revoke") %></span>
      </div>
      <div class="flex gap-3">
        <svg class="w-4 h-4 text-hero mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
        <span class="text-gray-700"><%= t("legal.privacy.s6.right_contact") %> <a href="mailto:privacy@atozone.com" class="text-hero hover:underline">privacy@atozone.com</a></span>
      </div>
    </div>
  </section>

  <%# S7: Security %>
  <section id="s7" class="bg-white border border-gray-200 rounded-xl p-7">
    <h2 class="text-xl font-semibold text-navy mb-4 flex items-center gap-2">
      <span class="w-7 h-7 rounded-full bg-hero/10 text-hero text-xs font-bold flex items-center justify-center">7</span>
      <%= t("legal.privacy.s7.heading") %>
    </h2>
    <ul class="space-y-2 text-sm text-gray-700">
      <li class="flex gap-3"><svg class="w-4 h-4 text-hero mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg><span><%= t("legal.privacy.s7.lockbox") %></span></li>
      <li class="flex gap-3"><svg class="w-4 h-4 text-hero mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg><span><%= t("legal.privacy.s7.https") %></span></li>
      <li class="flex gap-3"><svg class="w-4 h-4 text-hero mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg><span><%= t("legal.privacy.s7.access_control") %></span></li>
      <li class="flex gap-3"><svg class="w-4 h-4 text-hero mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg><span><%= t("legal.privacy.s7.backup") %></span></li>
    </ul>
  </section>

  <%# S8: Cookies %>
  <section id="s8" class="bg-white border border-gray-200 rounded-xl p-7">
    <h2 class="text-xl font-semibold text-navy mb-4 flex items-center gap-2">
      <span class="w-7 h-7 rounded-full bg-hero/10 text-hero text-xs font-bold flex items-center justify-center">8</span>
      <%= t("legal.privacy.s8.heading") %>
    </h2>
    <p class="text-sm text-gray-700 mb-3"><%= t("legal.privacy.s8.body") %></p>
    <ul class="space-y-2 text-sm text-gray-700">
      <li class="flex gap-3"><svg class="w-4 h-4 text-hero mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg><span><%= t("legal.privacy.s8.session") %></span></li>
      <li class="flex gap-3"><svg class="w-4 h-4 text-hero mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg><span><%= t("legal.privacy.s8.csrf") %></span></li>
      <li class="flex gap-3"><svg class="w-4 h-4 text-hero mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg><span><%= t("legal.privacy.s8.no_tracking") %></span></li>
    </ul>
  </section>

  <%# S9: Minimum Age %>
  <section id="s9" class="bg-white border border-gray-200 rounded-xl p-7">
    <h2 class="text-xl font-semibold text-navy mb-4 flex items-center gap-2">
      <span class="w-7 h-7 rounded-full bg-hero/10 text-hero text-xs font-bold flex items-center justify-center">9</span>
      <%= t("legal.privacy.s9.heading") %>
    </h2>
    <p class="text-sm text-gray-700"><%= t("legal.privacy.s9.body") %></p>
  </section>

  <%# S10: Policy Changes %>
  <section id="s10" class="bg-white border border-gray-200 rounded-xl p-7">
    <h2 class="text-xl font-semibold text-navy mb-4 flex items-center gap-2">
      <span class="w-7 h-7 rounded-full bg-hero/10 text-hero text-xs font-bold flex items-center justify-center">10</span>
      <%= t("legal.privacy.s10.heading") %>
    </h2>
    <p class="text-sm text-gray-700"><%= t("legal.privacy.s10.body") %></p>
  </section>

  <%# S11: Contact %>
  <section id="s11" class="bg-hero/5 border border-hero/20 rounded-xl p-7">
    <h2 class="text-xl font-semibold text-navy mb-4 flex items-center gap-2">
      <span class="w-7 h-7 rounded-full bg-hero/10 text-hero text-xs font-bold flex items-center justify-center">11</span>
      <%= t("legal.privacy.s11.heading") %>
    </h2>
    <p class="text-sm text-gray-700 mb-3"><%= t("legal.privacy.s11.body") %></p>
    <dl class="text-sm space-y-2">
      <div class="flex gap-4">
        <dt class="font-semibold text-gray-700 w-28"><%= t("legal.privacy.s11.email_label") %></dt>
        <dd><a href="mailto:privacy@atozone.com" class="text-hero hover:underline">privacy@atozone.com</a></dd>
      </div>
      <div class="flex gap-4">
        <dt class="font-semibold text-gray-700 w-28"><%= t("legal.privacy.s11.company_label") %></dt>
        <dd class="text-gray-600">AtoZ2010 Inc.</dd>
      </div>
    </dl>
  </section>

</div>

<%# ── Print button ────────────────────────────────────────────────── %>
<div class="mt-10 no-print flex justify-end">
  <button onclick="window.print()" class="inline-flex items-center gap-2 px-4 py-2 text-sm border border-gray-300 rounded-lg text-gray-600 hover:bg-gray-50 transition">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 01-2-2v-5a2 2 0 012-2h16a2 2 0 012 2v5a2 2 0 01-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
    <%= t("legal.print") %>
  </button>
</div>
