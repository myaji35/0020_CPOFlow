<%# 중복 주문 병합 — 관리자 페이지 %>
<div class="max-w-6xl mx-auto py-8 px-4">

  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="text-2xl font-bold text-gray-900 dark:text-white">중복 주문 병합</h1>
      <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">같은 Gmail 스레드에서 생성된 중복 칸반 카드를 병합합니다</p>
    </div>
    <%= link_to kanban_path, class: "flex items-center gap-2 px-4 py-2 bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 text-gray-700 dark:text-gray-300 text-sm font-medium rounded-lg transition-colors" do %>
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
      칸반으로 돌아가기
    <% end %>
  </div>

  <%# Flash %>
  <% if notice %>
    <div class="mb-4 rounded-lg bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 px-4 py-3 text-green-800 dark:text-green-400 text-sm"><%= notice %></div>
  <% end %>
  <% if alert %>
    <div class="mb-4 rounded-lg bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 px-4 py-3 text-red-800 dark:text-red-400 text-sm"><%= alert %></div>
  <% end %>

  <%# 통계 %>
  <div class="mb-6 flex items-center gap-4">
    <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg px-5 py-3">
      <span class="text-2xl font-bold text-red-600"><%= @groups.size %></span>
      <span class="text-sm text-gray-500 dark:text-gray-400 ml-1">중복 스레드</span>
    </div>
    <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg px-5 py-3">
      <span class="text-2xl font-bold text-orange-500"><%= @groups.sum { |g| g[:orders].size - 1 } %></span>
      <span class="text-sm text-gray-500 dark:text-gray-400 ml-1">병합 대상 카드</span>
    </div>
  </div>

  <% status_colors = { "new_rfq"=>"bg-gray-400","make_quo"=>"bg-blue-400","pending_po"=>"bg-yellow-400","new_po"=>"bg-indigo-400","delivery_items"=>"bg-orange-400","problem"=>"bg-purple-400","get_grn"=>"bg-green-500","give_up"=>"bg-gray-200","done"=>"bg-emerald-600" } %>

  <% if @groups.empty? %>
    <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg p-12 text-center">
      <svg class="w-12 h-12 mx-auto text-green-500 mb-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
      <p class="text-lg font-medium text-gray-900 dark:text-white">중복 주문이 없습니다</p>
      <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">모든 칸반 카드가 정상입니다</p>
    </div>
  <% else %>

    <% @groups.each_with_index do |group, gi| %>
      <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg mb-6 overflow-hidden">

        <%# 그룹 헤더 %>
        <div class="bg-gray-50 dark:bg-gray-750 px-5 py-3 border-b border-gray-200 dark:border-gray-700 flex items-center justify-between">
          <div class="flex items-center gap-3">
            <span class="inline-flex items-center justify-center w-7 h-7 rounded-full bg-red-100 dark:bg-red-900/30 text-red-600 dark:text-red-400 text-xs font-bold"><%= group[:orders].size %></span>
            <div>
              <span class="text-sm font-semibold text-gray-900 dark:text-white">Thread: <%= group[:thread_id] %></span>
              <span class="text-xs text-gray-500 dark:text-gray-400 ml-2"><%= group[:orders].first.customer_name %></span>
            </div>
          </div>
        </div>

        <%# 병합 폼 %>
        <%= form_tag merge_admin_duplicate_orders_path, method: :post, class: "merge-form", data: { group: gi } do %>

          <div class="divide-y divide-gray-100 dark:divide-gray-700">
            <% group[:orders].each_with_index do |order, oi| %>
              <div class="px-5 py-4 flex items-start gap-4 hover:bg-gray-50 dark:hover:bg-gray-750 transition-colors">

                <%# 라디오: 메인 주문 선택 %>
                <div class="pt-0.5">
                  <label class="flex items-center gap-1.5 cursor-pointer" title="이 주문을 메인으로 유지">
                    <input type="radio" name="main_order_id" value="<%= order.id %>"
                           class="main-radio text-blue-600 focus:ring-blue-500"
                           data-group="<%= gi %>"
                           <%= "checked" if oi == 0 %>
                           onchange="updateMergeCheckboxes(this)">
                    <span class="text-xs font-medium text-blue-600 dark:text-blue-400">메인</span>
                  </label>
                </div>

                <%# 체크박스: 병합 대상 선택 %>
                <div class="pt-0.5">
                  <input type="checkbox" name="merge_order_ids[]" value="<%= order.id %>"
                         class="merge-cb rounded border-gray-300 text-orange-500 focus:ring-orange-500"
                         data-group="<%= gi %>"
                         <%= "checked" if oi > 0 %>
                         <%= "disabled" if oi == 0 %>>
                </div>

                <%# 주문 정보 %>
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2 mb-1">
                    <span class="text-xs font-mono text-gray-400 dark:text-gray-500">#<%= order.id %></span>
                    <span class="inline-block px-2 py-0.5 text-xs font-medium rounded-full text-white <%= status_colors[order.status] || 'bg-gray-400' %>">
                      <%= Order::STATUS_LABELS[order.status] || order.status %>
                    </span>
                    <% if order.sub_orders.any? %>
                      <span class="text-xs text-blue-600 dark:text-blue-400">+<%= order.sub_orders.size %>건 서브</span>
                    <% end %>
                  </div>
                  <p class="text-sm font-medium text-gray-900 dark:text-white truncate"><%= order.title %></p>
                  <div class="flex items-center gap-3 mt-1 text-xs text-gray-500 dark:text-gray-400">
                    <span><%= order.created_at.strftime("%Y-%m-%d %H:%M") %></span>
                    <span>From: <%= order.original_email_from.to_s.truncate(40) %></span>
                    <% if order.assignees.any? %>
                      <span>담당: <%= order.assignees.map(&:display_name).join(", ") %></span>
                    <% end %>
                  </div>
                </div>

                <%# 칸반 링크 %>
                <a href="<%= kanban_path %>#order-<%= order.id %>" target="_blank"
                   class="text-gray-400 hover:text-blue-600 transition-colors" title="칸반에서 보기">
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                </a>
              </div>
            <% end %>
          </div>

          <%# 병합 버튼 %>
          <div class="px-5 py-3 bg-gray-50 dark:bg-gray-750 border-t border-gray-200 dark:border-gray-700 flex justify-end">
            <button type="submit" class="flex items-center gap-2 px-4 py-2 bg-orange-500 hover:bg-orange-600 text-white text-sm font-medium rounded-lg transition-colors"
                    onclick="return confirm('선택한 주문을 메인 주문에 병합합니다. 병합된 주문은 서브 주문으로 변환됩니다.\n\n계속하시겠습니까?')">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 16 12 12 8 16"/><line x1="12" y1="12" x2="12" y2="21"/><path d="M20.39 18.39A5 5 0 0 0 18 9h-1.26A8 8 0 1 0 3 16.3"/></svg>
              선택 주문 병합
            </button>
          </div>
        <% end %>
      </div>
    <% end %>

  <% end %>
</div>

<script>
// 메인 라디오 선택 시, 해당 주문의 체크박스 해제+비활성, 나머지 체크박스 활성화+체크
function updateMergeCheckboxes(radio) {
  const groupId = radio.dataset.group;
  const checkboxes = document.querySelectorAll(`.merge-cb[data-group="${groupId}"]`);
  const mainValue = radio.value;

  checkboxes.forEach(cb => {
    if (cb.value === mainValue) {
      cb.checked = false;
      cb.disabled = true;
    } else {
      cb.disabled = false;
      cb.checked = true;
    }
  });
}
</script>
