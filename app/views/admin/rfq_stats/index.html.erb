<%# Phase E: RFQ AI 학습 통계 대시보드 (한국어 UI) %>
<div class="max-w-6xl mx-auto px-6 py-8">
  <div class="mb-6">
    <h1 class="text-2xl font-bold text-[#16325C]">RFQ AI 학습 통계</h1>
    <p class="text-sm text-gray-600 mt-1">사용자 피드백을 기반으로 한 AI 분류 정확도</p>
  </div>

  <%# ISS-045 Phase C4: classify_v2 Shadow Mode 모니터링 %>
  <div class="mb-6">
    <h2 class="text-lg font-semibold text-[#16325C] mb-3">v2 Shadow Mode (ISS-045)</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <%# 카드 1: 오늘 분류 비용 (CostGuard 포함 — ISS-058) %>
      <div class="bg-white border border-gray-200 rounded-lg p-4">
        <div class="flex items-center justify-between mb-1.5">
          <div class="text-xs font-semibold text-gray-600">Today Classify Cost</div>
          <% if @cost_guard[:exceeded] %>
            <span class="text-xs px-1.5 py-0.5 bg-red-600 text-white rounded font-semibold">BLOCKED</span>
          <% elsif @cost_guard[:utilization_pct] >= 80 %>
            <span class="text-xs px-1.5 py-0.5 bg-yellow-500 text-white rounded font-semibold">WARN</span>
          <% else %>
            <span class="text-xs px-1.5 py-0.5 bg-green-600 text-white rounded font-semibold">OK</span>
          <% end %>
        </div>
        <div class="text-2xl font-bold text-[#00A1E0]">$<%= number_with_precision(@classify_cost_today, precision: 4) %></div>
        <div class="text-xs text-gray-500 mt-1">Budget: $<%= @cost_guard[:budget] %>/day (<%= @cost_guard[:utilization_pct] %>% used)</div>
        <div class="w-full bg-gray-200 rounded h-1.5 mt-2">
          <div class="h-1.5 rounded <%= @cost_guard[:exceeded] ? 'bg-red-600' : (@cost_guard[:utilization_pct] >= 80 ? 'bg-yellow-500' : 'bg-green-600') %>"
               style="width: <%= [@cost_guard[:utilization_pct], 100].min %>%"></div>
        </div>
      </div>

      <%# 카드 2: Stage 분기율 (24h) %>
      <div class="bg-white border border-gray-200 rounded-lg p-4">
        <div class="text-xs font-semibold text-gray-600 mb-1.5">Stage Distribution (24h)</div>
        <div class="text-sm text-gray-900">
          <div>Stage 1: <span class="font-semibold"><%= @stage_distribution[:stage1] %></span> (<%= @stage_distribution[:stage1_pct] %>%)</div>
          <div>Stage 2: <span class="font-semibold"><%= @stage_distribution[:stage2] %></span> (<%= @stage_distribution[:stage2_pct] %>%)</div>
          <div>Stage 3: <span class="font-semibold"><%= @stage_distribution[:stage3] %></span> (<%= @stage_distribution[:stage3_pct] %>%)</div>
        </div>
        <div class="text-xs text-gray-500 mt-2">Total: <%= @stage_distribution[:total] %></div>
      </div>

      <%# 카드 3: 최근 7일 FN %>
      <div class="bg-white border border-gray-200 rounded-lg p-4">
        <div class="text-xs font-semibold text-gray-600 mb-1.5">Shadow FN (7일)</div>
        <div class="text-2xl font-bold <%= @recent_fn_count.zero? ? 'text-[#1E8E3E]' : 'text-[#D93025]' %>">
          <%= @recent_fn_count %>
        </div>
        <div class="text-xs text-gray-500 mt-2">Target: 0 / 7d (Cutover 조건)</div>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
    <%# 정확도 %>
    <div class="bg-white border border-gray-200 rounded p-4">
      <div class="flex items-center gap-2 mb-2">
        <svg class="w-4 h-4 text-[#00A1E0]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        <span class="text-xs font-semibold text-gray-600">AI 정확도</span>
      </div>
      <div class="text-3xl font-bold text-[#16325C]"><%= @stats[:accuracy_pct] %><span class="text-base text-gray-500">%</span></div>
      <div class="text-xs text-gray-500 mt-1"><%= @stats[:ai_correct] %>/<%= @stats[:with_score] %> 일치</div>
    </div>

    <%# 최근 7일 일치율 %>
    <div class="bg-white border border-gray-200 rounded p-4">
      <div class="flex items-center gap-2 mb-2">
        <svg class="w-4 h-4 text-[#00A1E0]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        <span class="text-xs font-semibold text-gray-600">최근 <%= @stats[:window_days] %>일 일치율</span>
      </div>
      <div class="text-3xl font-bold text-[#16325C]"><%= @stats[:match_rate_pct] %><span class="text-base text-gray-500">%</span></div>
      <div class="text-xs text-gray-500 mt-1">롤링 윈도우</div>
    </div>

    <%# 총 학습 데이터 %>
    <div class="bg-white border border-gray-200 rounded p-4">
      <div class="flex items-center gap-2 mb-2">
        <svg class="w-4 h-4 text-[#00A1E0]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
        <span class="text-xs font-semibold text-gray-600">총 학습 데이터</span>
      </div>
      <div class="text-3xl font-bold text-[#16325C]"><%= @stats[:total] %><span class="text-base text-gray-500">건</span></div>
      <div class="text-xs text-gray-500 mt-1">+ Few-shot <%= @stats[:few_shot_total] - @stats[:total] %>건</div>
    </div>

    <%# 평균 confidence %>
    <div class="bg-white border border-gray-200 rounded p-4">
      <div class="flex items-center gap-2 mb-2">
        <svg class="w-4 h-4 text-[#00A1E0]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
        <span class="text-xs font-semibold text-gray-600">평균 AI Score</span>
      </div>
      <div class="text-3xl font-bold text-[#16325C]"><%= @stats[:avg_score] %></div>
      <div class="text-xs text-gray-500 mt-1">0.0 ~ 1.0</div>
    </div>
  </div>

  <div class="bg-white border border-gray-200 rounded p-4">
    <h2 class="text-sm font-semibold text-[#16325C] mb-3">피드백 분포</h2>
    <div class="grid grid-cols-2 gap-4">
      <div class="flex items-center justify-between p-3 bg-gray-50 rounded">
        <span class="text-sm text-gray-700">RFQ 확정</span>
        <span class="text-lg font-bold text-[#1E8E3E]"><%= @stats[:confirmed_count] %></span>
      </div>
      <div class="flex items-center justify-between p-3 bg-gray-50 rounded">
        <span class="text-sm text-gray-700">RFQ 아님</span>
        <span class="text-lg font-bold text-[#D93025]"><%= @stats[:rejected_count] %></span>
      </div>
    </div>
  </div>

  <%# ISS-209: 최근 AI 오판 사례 + 일괄 재판독 %>
  <div class="mt-8 bg-white border border-gray-200 rounded-xl p-6">
    <div class="flex items-center justify-between mb-4">
      <div>
        <h2 class="text-lg font-semibold text-[#16325C]">최근 AI 오판 사례 (<%= @window_days %>일)</h2>
        <p class="text-xs text-gray-500 mt-1">AI 점수와 사용자 verdict가 불일치한 피드백</p>
      </div>
      <% if @mismatch_count.to_i > 0 %>
        <%= button_to reclassify_mismatches_admin_rfq_stats_path(window: @window_days),
              method: :post,
              data: { turbo_confirm: "#{@mismatch_count}건 오판 사례를 재판독합니다. 계속하시겠습니까?" },
              class: "inline-flex items-center gap-2 px-4 py-2 bg-[#F4A83A] hover:bg-orange-500 text-white text-sm font-semibold rounded-lg transition-colors" do %>
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 4v6h-6"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
          <%= @mismatch_count %>건 일괄 재판독
        <% end %>
      <% end %>
    </div>

    <% if @mismatches.any? %>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-gray-200 text-left">
              <th class="py-2 px-2 text-xs font-semibold text-gray-600">일자</th>
              <th class="py-2 px-2 text-xs font-semibold text-gray-600">제목</th>
              <th class="py-2 px-2 text-xs font-semibold text-gray-600">AI Score</th>
              <th class="py-2 px-2 text-xs font-semibold text-gray-600">AI 판정</th>
              <th class="py-2 px-2 text-xs font-semibold text-gray-600">사용자</th>
              <th class="py-2 px-2 text-xs font-semibold text-gray-600">피드백자</th>
              <th class="py-2 px-2 text-xs font-semibold text-gray-600">액션</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% @mismatches.first(20).each do |fb| %>
              <% ai_rfq = fb.ai_score.to_f >= 0.5 %>
              <tr class="hover:bg-gray-50">
                <td class="py-2 px-2 text-xs text-gray-500"><%= fb.created_at.strftime("%m/%d %H:%M") %></td>
                <td class="py-2 px-2 text-sm text-gray-900 truncate max-w-[240px]">
                  <%= link_to (fb.order&.original_email_subject.presence || fb.order&.title || "-"),
                        fb.order ? inbox_email_path(fb.order.id) : "#",
                        class: "text-[#00A1E0] hover:underline" %>
                </td>
                <td class="py-2 px-2 text-xs tabular-nums"><%= fb.ai_score&.round(2) || "-" %></td>
                <td class="py-2 px-2">
                  <span class="text-xs px-1.5 py-0.5 rounded font-medium <%= ai_rfq ? 'bg-blue-100 text-blue-700' : 'bg-gray-100 text-gray-600' %>">
                    <%= ai_rfq ? "RFQ" : "일반" %>
                  </span>
                </td>
                <td class="py-2 px-2">
                  <span class="text-xs px-1.5 py-0.5 rounded font-medium <%= fb.verdict == 'confirmed' ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700' %>">
                    <%= fb.verdict == "confirmed" ? "RFQ 맞음" : (fb.verdict == "rejected" ? "RFQ 아님" : fb.verdict) %>
                  </span>
                </td>
                <td class="py-2 px-2 text-xs text-gray-600"><%= fb.user&.display_name || "-" %></td>
                <td class="py-2 px-2">
                  <% if fb.order %>
                    <%= link_to "열기", inbox_email_path(fb.order.id),
                          class: "text-xs text-[#00A1E0] hover:underline" %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <% if @mismatches.size > 20 %>
        <p class="text-xs text-gray-500 mt-3">외 <%= @mismatches.size - 20 %>건 — 재판독 버튼은 전체 <%= @mismatch_count %>건에 적용됩니다</p>
      <% end %>
    <% else %>
      <div class="text-center py-8 text-gray-500">
        <svg class="w-10 h-10 mx-auto text-green-400 mb-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
        <p class="text-sm">최근 <%= @window_days %>일 오판 사례 없음 — AI 정확도 양호</p>
      </div>
    <% end %>
  </div>
</div>
