<div class="max-w-7xl mx-auto px-4 py-6">

  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="text-xl font-bold text-gray-900 dark:text-white">📦 eCount 품목</h1>
      <p class="text-sm text-gray-500 mt-0.5">eCount ERP에서 동기화된 자재 목록</p>
    </div>
    <div class="flex items-center gap-2">
      <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-100 text-green-800 text-sm font-medium">
        ✓ 활성
      </span>
      <%= link_to "동기화 관리", admin_ecount_sync_index_path, class: "text-sm text-blue-600 hover:underline" %>
    </div>
  </div>

  <%# 통계 카드 %>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-4">
      <p class="text-xs text-gray-500 font-medium mb-1">전체 품목</p>
      <p class="text-2xl font-bold text-gray-900 dark:text-white tabular-nums"><%= number_with_delimiter(@total) %></p>
    </div>
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-4">
      <p class="text-xs text-gray-500 font-medium mb-1">마지막 동기화</p>
      <p class="text-base font-bold text-gray-900 dark:text-white">
        <%= @last_sync ? l(@last_sync.completed_at, format: :short) : "—" %>
      </p>
      <p class="text-xs text-gray-500 mt-1"><%= @last_sync ? "#{@last_sync.success_count}건 성공" : "이력 없음" %></p>
    </div>
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-4">
      <p class="text-xs text-gray-500 font-medium mb-1">데이터 출처</p>
      <p class="text-base font-bold text-gray-900 dark:text-white">eCount OAPI</p>
      <p class="text-xs text-gray-500 mt-1 font-mono">/InventoryBasic/GetBasicProductsList</p>
    </div>
  </div>

  <%# 검색 + 테이블 %>
  <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 overflow-hidden">
    <div class="px-5 py-3 border-b border-gray-200 dark:border-gray-700 flex items-center gap-3">
      <%= form_with url: admin_ecount_products_path, method: :get, local: true, class: "flex-1" do %>
        <input type="text" name="q" value="<%= @q %>" placeholder="품목명 / 코드 / 규격으로 검색"
               class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:border-blue-500" />
      <% end %>
      <span class="text-sm text-gray-500"><%= @products.size %> / <%= number_with_delimiter(@total) %>건</span>
    </div>

    <% if @products.any? %>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="bg-gray-50 dark:bg-gray-700/50">
            <tr>
              <th class="px-4 py-2.5 text-left text-xs font-semibold text-gray-600">eCount 코드</th>
              <th class="px-4 py-2.5 text-left text-xs font-semibold text-gray-600">품목명</th>
              <th class="px-4 py-2.5 text-left text-xs font-semibold text-gray-600">규격</th>
              <th class="px-4 py-2.5 text-left text-xs font-semibold text-gray-600">단위</th>
              <th class="px-4 py-2.5 text-right text-xs font-semibold text-gray-600">단가</th>
              <th class="px-4 py-2.5 text-left text-xs font-semibold text-gray-600">분류</th>
              <th class="px-4 py-2.5 text-left text-xs font-semibold text-gray-600">동기화</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% @products.each do |p| %>
              <tr class="hover:bg-gray-50">
                <td class="px-4 py-2 font-mono text-xs text-gray-700"><%= p.ecount_code %></td>
                <td class="px-4 py-2 text-gray-900 font-medium">
                  <%= link_to p.name.presence || "(이름 없음)", admin_ecount_product_path(p), class: "hover:text-blue-600" %>
                </td>
                <td class="px-4 py-2 text-gray-600 text-xs"><%= p.description.to_s.truncate(40) %></td>
                <td class="px-4 py-2 text-gray-600"><%= p.unit %></td>
                <td class="px-4 py-2 text-right tabular-nums text-gray-900"><%= p.currency %> <%= number_with_precision(p.unit_price, precision: 2, delimiter: ",") %></td>
                <td class="px-4 py-2 text-gray-500 text-xs"><%= p.category %></td>
                <td class="px-4 py-2 text-gray-500 text-xs"><%= p.ecount_synced_at&.strftime("%m/%d %H:%M") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <% if @total_pages > 1 %>
        <div class="px-5 py-3 border-t border-gray-200 flex items-center justify-between">
          <span class="text-xs text-gray-500">페이지 <%= @page %> / <%= @total_pages %></span>
          <div class="flex gap-1">
            <% if @page > 1 %>
              <%= link_to "‹ 이전", admin_ecount_products_path(q: @q, page: @page - 1), class: "px-3 py-1.5 text-sm border border-gray-300 rounded hover:bg-gray-50" %>
            <% end %>
            <% if @page < @total_pages %>
              <%= link_to "다음 ›", admin_ecount_products_path(q: @q, page: @page + 1), class: "px-3 py-1.5 text-sm border border-gray-300 rounded hover:bg-gray-50" %>
            <% end %>
          </div>
        </div>
      <% end %>
    <% else %>
      <div class="text-center py-16 text-sm text-gray-500">
        <% if @q.present? %>
          "<%= @q %>" 검색 결과 없음
        <% else %>
          품목이 없습니다. <%= link_to "동기화 실행", admin_ecount_sync_index_path, class: "text-blue-600 hover:underline" %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
