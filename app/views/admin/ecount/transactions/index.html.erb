<div class="max-w-7xl mx-auto px-4 py-6">

  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="text-xl font-bold text-gray-900">📋 eCount 거래내역</h1>
      <p class="text-sm text-gray-500 mt-0.5">판매/구매 전표 (현재는 RFQ/PO 참조번호 기반 임시 표시)</p>
    </div>
    <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-amber-100 text-amber-800 text-sm font-medium">⏳ Phase 2 계획</span>
  </div>

  <div class="mb-6 p-4 bg-amber-50 border border-amber-200 rounded-lg text-sm text-amber-900">
    <p class="font-semibold mb-1">eCount 전표 직접 동기화 미활성</p>
    <p class="text-xs"><%= @sync_pending_reason %></p>
  </div>

  <div class="bg-white rounded-xl border overflow-hidden">
    <div class="px-5 py-3 border-b">
      <%= form_with url: admin_ecount_transactions_path, method: :get, local: true, class: "flex gap-2" do %>
        <input type="text" name="q" value="<%= @q %>" placeholder="참조번호 / 제목 검색" class="flex-1 px-3 py-2 border border-gray-300 rounded-lg text-sm" />
      <% end %>
    </div>

    <% if @transactions.any? %>
      <table class="w-full text-sm">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-4 py-2.5 text-left text-xs font-semibold text-gray-600">참조번호</th>
            <th class="px-4 py-2.5 text-left text-xs font-semibold text-gray-600">제목</th>
            <th class="px-4 py-2.5 text-left text-xs font-semibold text-gray-600">발주처</th>
            <th class="px-4 py-2.5 text-left text-xs font-semibold text-gray-600">거래처</th>
            <th class="px-4 py-2.5 text-left text-xs font-semibold text-gray-600">상태</th>
            <th class="px-4 py-2.5 text-left text-xs font-semibold text-gray-600">생성일</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% @transactions.each do |o| %>
            <tr class="hover:bg-gray-50">
              <td class="px-4 py-2 font-mono text-xs"><%= o.reference_no %></td>
              <td class="px-4 py-2"><%= o.original_email_subject.to_s.truncate(60) %></td>
              <td class="px-4 py-2 text-gray-600"><%= o.client&.name %></td>
              <td class="px-4 py-2 text-gray-600"><%= o.supplier&.name %></td>
              <td class="px-4 py-2">
                <% if o.card_status %>
                  <span class="inline-block px-2 py-0.5 rounded text-xs" style="background:<%= o.card_status.bg_color %>; color:<%= o.card_status.text_color %>; border:1px solid <%= o.card_status.border_color %>;">
                    <%= o.card_status.name %>
                  </span>
                <% end %>
              </td>
              <td class="px-4 py-2 text-gray-500 text-xs"><%= o.created_at.strftime("%m/%d %H:%M") %></td>
            </tr>
          <% end %>
        </tbody>
      </table>

      <% if @total_pages > 1 %>
        <div class="px-5 py-3 border-t flex items-center justify-between">
          <span class="text-xs text-gray-500">페이지 <%= @page %> / <%= @total_pages %></span>
          <div class="flex gap-1">
            <% if @page > 1 %>
              <%= link_to "‹ 이전", admin_ecount_transactions_path(q: @q, page: @page - 1), class: "px-3 py-1.5 text-sm border rounded hover:bg-gray-50" %>
            <% end %>
            <% if @page < @total_pages %>
              <%= link_to "다음 ›", admin_ecount_transactions_path(q: @q, page: @page + 1), class: "px-3 py-1.5 text-sm border rounded hover:bg-gray-50" %>
            <% end %>
          </div>
        </div>
      <% end %>
    <% else %>
      <p class="text-center py-16 text-sm text-gray-500">거래내역 없음</p>
    <% end %>
  </div>
</div>
