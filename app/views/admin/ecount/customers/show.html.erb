<div class="max-w-5xl mx-auto px-4 py-6">

  <div class="mb-6">
    <%= link_to "← 거래처 목록", admin_ecount_customers_path, class: "text-sm text-[#00A1E0] hover:underline" %>
  </div>

  <div class="bg-white rounded-xl border overflow-hidden mb-6">
    <div class="px-6 py-5 border-b">
      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-xl font-bold text-gray-900"><%= @customer.name %></h1>
          <div class="flex items-center gap-2 mt-1">
            <span class="font-mono text-xs text-gray-500"><%= @customer.code %></span>
            <% if @customer.ecount_code.present? %>
              <span class="font-mono text-xs px-2 py-0.5 bg-blue-50 text-blue-700 rounded">eCount: <%= @customer.ecount_code %></span>
            <% end %>
            <span class="inline-block px-2 py-0.5 rounded text-xs <%= @type == 'supplier' ? 'bg-emerald-100 text-emerald-700' : 'bg-blue-100 text-blue-700' %>">
              <%= @type == "supplier" ? "Supplier" : "Client" %>
            </span>
          </div>
        </div>
        <%= link_to "메인 상세 →",
            @type == "supplier" ? supplier_path(@customer) : client_path(@customer),
            class: "px-4 py-2 text-sm border border-gray-300 rounded-lg hover:bg-gray-50" %>
      </div>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 px-6 py-4">
      <div>
        <p class="text-xs text-gray-500 mb-0.5">국가</p>
        <p class="text-sm font-medium"><%= @customer.country.presence || "-" %></p>
      </div>
      <div>
        <p class="text-xs text-gray-500 mb-0.5">이메일</p>
        <p class="text-sm font-medium"><%= @customer.contact_email.presence || "-" %></p>
      </div>
      <div>
        <p class="text-xs text-gray-500 mb-0.5">전화</p>
        <p class="text-sm font-medium"><%= @customer.contact_phone.presence || "-" %></p>
      </div>
      <div>
        <p class="text-xs text-gray-500 mb-0.5">eCount 동기화</p>
        <p class="text-sm font-medium"><%= @customer.ecount_synced_at&.in_time_zone("Asia/Seoul")&.strftime("%Y-%m-%d %H:%M") || "미동기화" %></p>
      </div>
    </div>
  </div>

  <%# 관련 주문 목록 %>
  <div class="bg-white rounded-xl border overflow-hidden">
    <div class="px-6 py-4 border-b">
      <h2 class="text-sm font-semibold text-gray-900">관련 주문 (<%= @orders.size %>건)</h2>
    </div>
    <% if @orders.any? %>
      <table class="w-full text-sm">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-4 py-2.5 text-left text-xs font-semibold text-gray-600">참조번호</th>
            <th class="px-4 py-2.5 text-left text-xs font-semibold text-gray-600">제목</th>
            <th class="px-4 py-2.5 text-left text-xs font-semibold text-gray-600">상태</th>
            <th class="px-4 py-2.5 text-left text-xs font-semibold text-gray-600">생성일</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% @orders.each do |o| %>
            <tr class="hover:bg-gray-50 cursor-pointer" onclick="window.location='<%= order_path(o) %>'">
              <td class="px-4 py-2 font-mono text-xs text-[#00A1E0]"><%= o.reference_no %></td>
              <td class="px-4 py-2"><%= o.display_subject.truncate(60) %></td>
              <td class="px-4 py-2">
                <% if o.card_status %>
                  <span class="inline-block px-2 py-0.5 rounded text-xs" style="background:<%= o.card_status.bg_color %>; color:<%= o.card_status.text_color %>;">
                    <%= o.card_status.name %>
                  </span>
                <% end %>
              </td>
              <td class="px-4 py-2 text-gray-500 text-xs"><%= o.created_at.strftime("%m/%d %H:%M") %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="text-center py-10 text-sm text-gray-500">관련 주문 없음</p>
    <% end %>
  </div>
</div>
