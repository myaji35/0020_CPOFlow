<%#
  주문 카드의 관리번호 칩 라인.
  active 코드를 position 순으로 모두 노출하되, 값이 있는 코드만 표시한다.
  형식: <span style="color:#hex">R</span>:<span class="text-[#1E3A5F]">99999</span>
  locals: order
%>
<% codes = TrackingCode.active.ordered %>
<% values_by_code = order.tracking_numbers.includes(:tracking_code).index_by(&:tracking_code_id) %>
<% chips = codes.map { |c| [ c, values_by_code[c.id]&.value ] }.select { |_c, v| v.present? } %>
<% if chips.any? %>
  <span class="flex items-center gap-1.5 truncate text-xs font-mono">
    <% chips.each do |c, val| %>
      <span class="inline-flex items-center gap-0.5">
        <span class="font-bold" style="color: <%= c.color %>"><%= c.short_label %></span>
        <span class="text-gray-500">:</span>
        <span class="text-[#1E3A5F] dark:text-blue-300 font-semibold"><%= val %></span>
      </span>
    <% end %>
  </span>
<% end %>
