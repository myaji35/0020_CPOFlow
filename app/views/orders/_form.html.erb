<%= form_with model: order, multipart: true, class: "space-y-5" do |f| %>
  <% board = order.kanban_board || KanbanBoard.default_board.first %>
  <% is_purchase = board&.board_type == "purchase" || board&.is_default? %>
  <% if order.errors.any? %>
    <div class="px-4 py-3 bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-lg text-red-800 dark:text-red-400 text-sm">
      <%= order.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <%# ===== 보드 선택 (복수 보드 시) ===== %>
  <% boards = KanbanBoard.ordered %>
  <% if boards.size > 1 %>
    <div>
      <h3 class="text-xs font-semibold text-gray-500 dark:text-gray-500 mb-3"><%= t("orders.form.board_select") %></h3>
      <%= f.select :kanban_board_id,
          boards.map { |b| [b.name, b.id] },
          { selected: order.kanban_board_id || boards.find(&:is_default?)&.id },
          class: "w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm bg-white focus:ring-2 focus:ring-accent focus:border-transparent outline-none" %>
    </div>
  <% else %>
    <%= f.hidden_field :kanban_board_id, value: boards.first&.id %>
  <% end %>

  <%# ===== 섹션 1: 기본 정보 ===== %>
  <div>
    <h3 class="text-xs font-semibold text-gray-500 dark:text-gray-500 mb-3"><%= t("orders.form.section_basic") %></h3>
    <div class="space-y-3">
      <%# 제목 %>
      <div>
        <%= f.label :title, t("orders.form.title_label"), class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
        <%= f.text_field :title, placeholder: "e.g. Sika Waterproofing - Barakah NPP",
            class: "w-full px-3 py-2 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white rounded-lg text-sm focus:ring-2 focus:ring-accent focus:border-transparent outline-none" %>
      </div>
      <%# 발주처 + 외부담당자 (구매 보드 전용) / 비구매 보드는 자유 텍스트 customer_name %>
      <% if is_purchase %>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        <div>
          <%= f.label :client_id, t("orders.form.client_label"), class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
          <div data-controller="autocomplete"
               data-autocomplete-url-value="<%= search_clients_path %>"
               data-autocomplete-placeholder-value="<%= t("orders.form.client_placeholder") %>"
               data-autocomplete-sublabel-value="code"
               id="client-autocomplete"
               class="relative">
            <%= f.hidden_field :client_id, data: { autocomplete_target: "hidden" }, id: "order_client_id" %>
            <div data-autocomplete-target="badge"
                 class="<%= order.client_id.present? ? '' : 'hidden' %> flex items-center gap-2 px-3 py-2 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 rounded-lg text-sm">
              <span data-autocomplete-target="badgeLabel" class="text-gray-900 dark:text-white font-medium"><%= order.client&.name %></span>
              <span data-autocomplete-target="badgeSub" class="text-gray-500 dark:text-gray-500 text-xs"><%= order.client&.code ? "(#{order.client.code})" : "" %></span>
              <button type="button" data-action="click->autocomplete#clear"
                      class="ml-auto text-gray-500 hover:text-gray-600 dark:hover:text-gray-300">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
              </button>
            </div>
            <input type="text"
                   data-autocomplete-target="input"
                   data-action="input->autocomplete#onInput keydown->autocomplete#onKeydown"
                   placeholder="e.g. KEPCO Engineering"
                   autocomplete="off"
                   class="<%= order.client_id.present? ? 'hidden' : '' %> w-full px-3 py-2 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white rounded-lg text-sm focus:ring-2 focus:ring-accent focus:border-transparent outline-none">
            <div data-autocomplete-target="dropdown"
                 class="hidden absolute z-50 left-0 right-0 mt-1 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg shadow-lg max-h-52 overflow-y-auto">
            </div>
          </div>
        </div>
        <div>
          <%= f.label :contact_person_id, t("orders.form.contact_person_label"), class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
          <div data-controller="autocomplete"
               data-autocomplete-url-value="<%= search_contact_persons_path(order.client_id ? { client_id: order.client_id } : {}) %>"
               data-autocomplete-placeholder-value="<%= t("orders.form.contact_person_placeholder") %>"
               data-autocomplete-sublabel-value="code"
               id="contact-person-autocomplete"
               class="relative">
            <%= f.hidden_field :contact_person_id, data: { autocomplete_target: "hidden" } %>
            <div data-autocomplete-target="badge"
                 class="<%= order.contact_person_id.present? ? '' : 'hidden' %> flex items-center gap-2 px-3 py-2 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 rounded-lg text-sm">
              <span data-autocomplete-target="badgeLabel" class="text-gray-900 dark:text-white font-medium"><%= order.contact_person&.name %></span>
              <span data-autocomplete-target="badgeSub" class="text-gray-500 dark:text-gray-500 text-xs"><%= order.contact_person&.email.presence ? "(#{order.contact_person.email})" : "" %></span>
              <button type="button" data-action="click->autocomplete#clear"
                      class="ml-auto text-gray-500 hover:text-gray-600 dark:hover:text-gray-300">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
              </button>
            </div>
            <input type="text"
                   data-autocomplete-target="input"
                   data-action="input->autocomplete#onInput keydown->autocomplete#onKeydown focus->autocomplete#onFocus"
                   placeholder="<%= t("orders.form.contact_person_placeholder") %>"
                   autocomplete="off"
                   class="<%= order.contact_person_id.present? ? 'hidden' : '' %> w-full px-3 py-2 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white rounded-lg text-sm focus:ring-2 focus:ring-accent focus:border-transparent outline-none">
            <div data-autocomplete-target="dropdown"
                 class="hidden absolute z-50 left-0 right-0 mt-1 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg shadow-lg max-h-52 overflow-y-auto">
            </div>
          </div>
        </div>
      </div>
      <% else %>
      <div>
        <%= f.label :customer_name, t("orders.form.customer_name_label"), class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
        <%= f.text_field :customer_name, placeholder: t("orders.form.customer_name_placeholder"),
            class: "w-full px-3 py-2 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white rounded-lg text-sm focus:ring-2 focus:ring-accent focus:border-transparent outline-none" %>
      </div>
      <% end %>
    </div>
  </div>

  <div class="border-t border-gray-200 dark:border-gray-700"></div>

  <% if is_purchase %>
  <%# ===== 섹션 2: 거래 정보 (구매 전용) ===== %>
  <div>
    <h3 class="text-xs font-semibold text-gray-500 dark:text-gray-500 mb-3"><%= t("orders.form.section_trade") %></h3>
    <div class="space-y-3">
      <%# 공급사 + 현장/프로젝트 %>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        <div>
          <%= f.label :supplier_id, t("orders.form.supplier_label"), class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
          <div data-controller="autocomplete"
               data-autocomplete-url-value="<%= search_suppliers_path %>"
               data-autocomplete-placeholder-value="<%= t("orders.form.supplier_placeholder") %>"
               data-autocomplete-sublabel-value="code"
               class="relative">
            <%= f.hidden_field :supplier_id, data: { autocomplete_target: "hidden" } %>
            <div data-autocomplete-target="badge"
                 class="<%= order.supplier_id.present? ? '' : 'hidden' %> flex items-center gap-2 px-3 py-2 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 rounded-lg text-sm">
              <span data-autocomplete-target="badgeLabel" class="text-gray-900 dark:text-white font-medium"><%= order.supplier&.name %></span>
              <span data-autocomplete-target="badgeSub" class="text-gray-500 dark:text-gray-500 text-xs"><%= order.supplier&.ecount_code ? "(#{order.supplier.ecount_code})" : "" %></span>
              <button type="button" data-action="click->autocomplete#clear"
                      class="ml-auto text-gray-500 hover:text-gray-600 dark:hover:text-gray-300">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
              </button>
            </div>
            <input type="text"
                   data-autocomplete-target="input"
                   data-action="input->autocomplete#onInput keydown->autocomplete#onKeydown"
                   placeholder="<%= t("orders.form.supplier_placeholder") %>"
                   autocomplete="off"
                   class="<%= order.supplier_id.present? ? 'hidden' : '' %> w-full px-3 py-2 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white rounded-lg text-sm focus:ring-2 focus:ring-accent focus:border-transparent outline-none">
            <div data-autocomplete-target="dropdown"
                 class="hidden absolute z-50 left-0 right-0 mt-1 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg shadow-lg max-h-52 overflow-y-auto">
            </div>
          </div>
        </div>
        <div>
          <%= f.label :project_id, t("orders.form.project_label"), class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
          <div data-controller="autocomplete"
               data-autocomplete-url-value="<%= search_projects_path %>"
               data-autocomplete-placeholder-value="<%= t("orders.form.project_placeholder") %>"
               data-autocomplete-sublabel-value="client_name"
               id="project-autocomplete"
               class="relative">
            <%= f.hidden_field :project_id, data: { autocomplete_target: "hidden" } %>
            <div data-autocomplete-target="badge"
                 class="<%= order.project_id.present? ? '' : 'hidden' %> flex items-center gap-2 px-3 py-2 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 rounded-lg text-sm">
              <span data-autocomplete-target="badgeLabel" class="text-gray-900 dark:text-white font-medium"><%= order.project&.name %></span>
              <span data-autocomplete-target="badgeSub" class="text-gray-500 dark:text-gray-500 text-xs"><%= order.project&.client&.name ? "(#{order.project.client.name})" : "" %></span>
              <button type="button" data-action="click->autocomplete#clear"
                      class="ml-auto text-gray-500 hover:text-gray-600 dark:hover:text-gray-300">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
              </button>
            </div>
            <input type="text"
                   data-autocomplete-target="input"
                   data-action="input->autocomplete#onInput keydown->autocomplete#onKeydown"
                   placeholder="<%= t("orders.form.project_placeholder") %>"
                   autocomplete="off"
                   class="<%= order.project_id.present? ? 'hidden' : '' %> w-full px-3 py-2 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white rounded-lg text-sm focus:ring-2 focus:ring-accent focus:border-transparent outline-none">
            <div data-autocomplete-target="dropdown"
                 class="hidden absolute z-50 left-0 right-0 mt-1 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg shadow-lg max-h-52 overflow-y-auto">
            </div>
          </div>
          <%# ISS-211: 선택된 프로젝트 예산 미리보기 + 초과 경고 (서버사이드 렌더, edit/re-render 시에만 표시) %>
          <% if order.project&.budget.to_f > 0 %>
            <% proj = order.project %>
            <% util = proj.utilization_rate %>
            <% current_val = order.estimated_value.to_f %>
            <% projected_util = proj.budget.to_f.zero? ? 0 : ((proj.budget_utilized + current_val) / proj.budget.to_f * 100).round(1) %>
            <% over_after = projected_util > 100 %>
            <div class="mt-2 px-3 py-2 rounded-lg border <%= over_after ? 'bg-red-50 border-red-300 dark:bg-red-900/20 dark:border-red-900/50' : 'bg-blue-50 border-blue-200 dark:bg-blue-900/20 dark:border-blue-900/50' %> text-xs">
              <div class="flex items-center justify-between">
                <span class="<%= over_after ? 'text-red-800 dark:text-red-300 font-semibold' : 'text-blue-800 dark:text-blue-300' %>">
                  <%= t("orders.form.budget_used", name: proj.name, pct: util, remaining: number_with_delimiter(proj.budget_remaining.round.to_i)) %>
                </span>
                <% if current_val > 0 %>
                  <span class="<%= over_after ? 'text-red-700 dark:text-red-400 font-bold' : 'text-blue-700 dark:text-blue-400' %>">
                    <%= t("orders.form.budget_with_order", pct: projected_util) %>
                  </span>
                <% end %>
              </div>
              <% if over_after %>
                <p class="mt-1 text-red-700 dark:text-red-400">⚠ <%= t("orders.form.budget_over_warning") %></p>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
      <%# 납기일 + 퀵픽 버튼 %>
      <div>
        <%= f.label :due_date, t("orders.form.due_date_label"), class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
        <div class="flex items-center gap-2">
          <%= f.date_field :due_date,
              class: "flex-1 px-3 py-2 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white rounded-lg text-sm focus:ring-2 focus:ring-accent focus:border-transparent outline-none" %>
          <button type="button" onclick="setDueDateOffset(7)"
                  class="px-2.5 py-2 text-xs font-medium border border-gray-300 dark:border-gray-600 text-gray-600 dark:text-gray-500 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors whitespace-nowrap"><%= t("orders.form.due_1w") %></button>
          <button type="button" onclick="setDueDateOffset(14)"
                  class="px-2.5 py-2 text-xs font-medium border border-gray-300 dark:border-gray-600 text-gray-600 dark:text-gray-500 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors whitespace-nowrap"><%= t("orders.form.due_2w") %></button>
          <button type="button" onclick="setDueDateOffset(30)"
                  class="px-2.5 py-2 text-xs font-medium border border-gray-300 dark:border-gray-600 text-gray-600 dark:text-gray-500 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors whitespace-nowrap"><%= t("orders.form.due_1m") %></button>
        </div>
      </div>
    </div>
  </div>

  <div class="border-t border-gray-200 dark:border-gray-700"></div>

  <%# ===== 섹션 3: 품목 / 금액 (구매 전용) ===== %>
  <div id="item-price-section"
       data-price-history-url="<%= price_history_orders_path %>"
       data-pricing-suggestion-url="<%= pricing_suggestion_orders_path %>">
    <h3 class="text-xs font-semibold text-gray-500 dark:text-gray-500 mb-3"><%= t("orders.form.section_items") %></h3>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
      <div>
        <%= f.label :item_name, t("orders.form.item_name_label"), class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
        <%= f.text_field :item_name, placeholder: "Sika® MonoTop®-412 N",
            id: "order-item-name",
            class: "w-full px-3 py-2 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white rounded-lg text-sm focus:ring-2 focus:ring-accent focus:border-transparent outline-none" %>
      </div>
      <div>
        <%= f.label :quantity, t("orders.form.quantity_label"), class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
        <%= f.number_field :quantity, placeholder: "5000",
            class: "w-full px-3 py-2 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white rounded-lg text-sm focus:ring-2 focus:ring-accent focus:border-transparent outline-none" %>
      </div>
      <div>
        <%= f.label :estimated_value, t("orders.form.estimated_value_label"), class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
        <%= f.number_field :estimated_value, placeholder: "26000", step: "0.01",
            id: "order-estimated-value",
            class: "w-full px-3 py-2 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white rounded-lg text-sm focus:ring-2 focus:ring-accent focus:border-transparent outline-none" %>
      </div>
    </div>
    <%# ISS-224: 직전 단가 제안 위젯 %>
    <div id="price-history-suggestions" class="hidden mt-3 p-3 rounded-lg bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-900/50">
      <div class="flex items-center justify-between mb-2">
        <p class="text-xs font-semibold text-blue-800 dark:text-blue-300 flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <span><%= t("orders.form.price_history_prefix") %> <span id="price-history-count">0</span><%= t("orders.form.price_history_suffix") %></span>
        </p>
        <button type="button" onclick="document.getElementById('price-history-suggestions').classList.add('hidden')" class="text-blue-600 dark:text-blue-400 hover:text-blue-800 text-xs"><%= t("common.close") %></button>
      </div>
      <ul id="price-history-list" class="space-y-1.5 text-xs"></ul>
      <p class="text-[10px] text-blue-600 dark:text-blue-400 mt-2"><%= t("orders.form.price_click_hint") %></p>
    </div>

    <%# ISS-308: 견적 단가 pre-fill 위젯 (OrderQuote 이력) %>
    <div id="iss308-quote-suggestion" class="hidden mt-3 p-3 rounded-lg bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-900/50">
      <div class="flex items-center justify-between mb-2">
        <p class="text-xs font-semibold text-green-800 dark:text-green-300 flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M2 12h20"/><circle cx="12" cy="12" r="3"/></svg>
          <span><%= t("orders.form.quote_history_title") %></span>
        </p>
        <button type="button" onclick="document.getElementById('iss308-quote-suggestion').classList.add('hidden')" class="text-green-600 dark:text-green-400 hover:text-green-800 text-xs"><%= t("common.close") %></button>
      </div>
      <ul id="iss308-quote-list" class="space-y-1.5 text-xs"></ul>
    </div>

    <%# ISS-308: 공급사 추천 칩 %>
    <div id="iss308-supplier-chips" class="hidden mt-3">
      <p class="text-xs font-semibold text-gray-600 dark:text-gray-400 mb-1.5 flex items-center gap-1">
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        <%= t("orders.form.recommended_suppliers") %>
      </p>
      <div id="iss308-supplier-chip-list" class="flex flex-wrap gap-2"></div>
    </div>
  </div>
  <% else %>
  <%# ===== 커스텀 보드: 마감일 + 칼럼 선택 ===== %>
  <div>
    <h3 class="text-xs font-semibold text-gray-500 dark:text-gray-500 mb-3"><%= t("orders.form.section_schedule") %></h3>
    <div class="space-y-3">
      <%# 마감일 + 퀵픽 버튼 %>
      <div>
        <%= f.label :due_date, t("orders.form.deadline_label"), class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
        <div class="flex items-center gap-2">
          <%= f.date_field :due_date,
              class: "flex-1 px-3 py-2 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white rounded-lg text-sm focus:ring-2 focus:ring-accent focus:border-transparent outline-none" %>
          <button type="button" onclick="setDueDateOffset(7)"
                  class="px-2.5 py-2 text-xs font-medium border border-gray-300 dark:border-gray-600 text-gray-600 dark:text-gray-500 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors whitespace-nowrap"><%= t("orders.form.due_1w") %></button>
          <button type="button" onclick="setDueDateOffset(14)"
                  class="px-2.5 py-2 text-xs font-medium border border-gray-300 dark:border-gray-600 text-gray-600 dark:text-gray-500 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors whitespace-nowrap"><%= t("orders.form.due_2w") %></button>
          <button type="button" onclick="setDueDateOffset(30)"
                  class="px-2.5 py-2 text-xs font-medium border border-gray-300 dark:border-gray-600 text-gray-600 dark:text-gray-500 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors whitespace-nowrap"><%= t("orders.form.due_1m") %></button>
        </div>
      </div>
      <%# 칼럼(단계) 선택 — 커스텀 보드만 %>
      <% columns = board&.kanban_columns&.ordered || [] %>
      <% if !is_purchase && columns.any? %>
        <div>
          <%= f.label :kanban_column_id, t("orders.form.column_label"), class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
          <%= f.select :kanban_column_id, columns.map { |c| [c.name, c.id] },
              { include_blank: t("orders.form.column_blank") },
              class: "w-full px-3 py-2.5 border border-gray-300 dark:border-gray-600 rounded-lg text-sm bg-white dark:bg-gray-800 text-gray-900 dark:text-white focus:ring-2 focus:ring-accent focus:border-transparent outline-none" %>
        </div>
      <% end %>
    </div>
  </div>
  <% end %>

  <div class="border-t border-gray-200 dark:border-gray-700"></div>

  <%# ===== 담당자 (@멘션) ===== %>
  <% unless is_purchase %>
  <div class="border-t border-gray-200 dark:border-gray-700"></div>
  <div>
    <h3 class="text-xs font-semibold text-gray-500 dark:text-gray-500 mb-3"><%= t("orders.form.section_assignee") %></h3>
    <div data-controller="mention" data-mention-mode-value="assign" data-mention-url-value="<%= mention_suggestions_path %>">
      <div class="relative">
        <input type="text" placeholder="<%= t("orders.form.assignee_placeholder") %>"
               data-mention-target="input" data-action="input->mention#onInput"
               class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm text-gray-900 bg-white focus:ring-2 focus:ring-accent focus:border-transparent outline-none" />
        <div data-mention-target="dropdown"
             class="bg-white border border-gray-200 rounded-lg shadow-lg overflow-hidden"
             style="display:none"></div>
        <%= f.hidden_field :assigned_employee_id, value: "", data: { mention_target: "employeeId" } %>
      </div>
    </div>
  </div>
  <% end %>

  <%# ===== 첨부파일 ===== %>
  <div class="border-t border-gray-200 dark:border-gray-700"></div>
  <div data-controller="file-dropzone"
       data-file-dropzone-auto-submit-value="false"
       data-file-dropzone-max-size-value="26214400">
    <div class="flex items-center justify-between mb-3">
      <h3 class="text-xs font-semibold text-gray-500 dark:text-gray-500"><%= t("orders.form.section_attachments") %></h3>
      <% existing_count = order.persisted? ? order.attachments.size : 0 %>
      <% if existing_count > 0 %>
        <span class="text-xs text-gray-500"><%= t("orders.form.attachments_count", count: existing_count) %></span>
      <% end %>
    </div>

    <%# 기존 첨부파일 목록 (edit 시) %>
    <% if order.persisted? && order.attachments.any? %>
      <ul class="mb-3 space-y-1.5">
        <% order.attachments.includes(:blob).each do |att| %>
          <li class="flex items-center gap-2 px-3 py-2 bg-gray-50 dark:bg-gray-700/50 border border-gray-200 dark:border-gray-700 rounded-lg text-sm">
            <svg class="w-4 h-4 text-gray-500 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
            <a href="<%= rails_blob_path(att, disposition: 'attachment') %>"
               class="flex-1 truncate text-gray-700 dark:text-gray-200 hover:text-[#00A1E0]"
               title="<%= att.filename %>"><%= att.filename %></a>
            <span class="text-xs text-gray-500 flex-shrink-0"><%= number_to_human_size(att.byte_size) %></span>
            <%= link_to detach_order_path(order.id, blob_id: att.blob_id),
                  data: { turbo_method: :delete, turbo_confirm: t("orders.form.attachment_delete_confirm") },
                  class: "text-gray-500 hover:text-red-600 flex-shrink-0 p-1 rounded",
                  title: t("common.delete") do %>
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-2 14a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/></svg>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>

    <%# 새 파일 업로드 영역 %>
    <% form_file_input_id = "order-form-file-input-#{order.id || 'new'}" %>
    <label for="<%= form_file_input_id %>"
           data-file-dropzone-target="zone"
           class="flex items-center justify-center gap-2 px-4 py-3 border-2 border-dashed border-gray-300 rounded-xl cursor-pointer hover:border-[#00A1E0] hover:bg-blue-50/30 transition-colors group">
      <svg class="w-5 h-5 text-gray-400 group-hover:text-[#00A1E0]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
      <span data-file-dropzone-target="label"
            class="text-sm text-gray-400 group-hover:text-[#00A1E0]">
        <%= order.persisted? && order.attachments.any? ? t("orders.form.file_add_or_drag") : t("orders.form.file_select_or_drag") %>
      </span>
    </label>
    <%= f.file_field :files, multiple: true,
          id: form_file_input_id,
          style: "position:absolute;left:-9999px;width:1px;height:1px;opacity:0;",
          data: { file_dropzone_target: "input" },
          direct_upload: false %>
  </div>

  <%# ===== 섹션 4: 추가 정보 ===== %>
  <div class="border-t border-gray-200 dark:border-gray-700"></div>
  <div>
    <h3 class="text-xs font-semibold text-gray-500 dark:text-gray-500 mb-3"><%= t("orders.form.section_extra") %></h3>
    <div class="space-y-3">
      <div class="grid grid-cols-1 <%= is_purchase ? 'md:grid-cols-2' : '' %> gap-3">
        <% if is_purchase %>
        <div>
          <%= f.label :card_status_id, t("orders.form.status_label"), class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
          <%= f.select :card_status_id,
              CardStatus.ordered.pluck(:name, :id),
              { selected: order.card_status_id || CardStatus.default&.id },
              class: "w-full px-3 py-2 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white rounded-lg text-sm focus:ring-2 focus:ring-accent focus:border-transparent outline-none" %>
        </div>
        <% end %>
        <div>
          <%= f.label :tags, t("orders.form.tags_label"), class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
          <%= f.text_field :tags, placeholder: "nuclear,sika,UAE,waterproofing",
              class: "w-full px-3 py-2 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white rounded-lg text-sm focus:ring-2 focus:ring-accent focus:border-transparent outline-none" %>
        </div>
      </div>
      <div>
        <%= f.label :description, t("orders.form.description_label"), class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
        <%= f.text_area :description, rows: 3,
            placeholder: is_purchase ? t("orders.form.description_placeholder_purchase") : t("orders.form.description_placeholder_card"),
            class: "w-full px-3 py-2 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white rounded-lg text-sm focus:ring-2 focus:ring-accent focus:border-transparent outline-none resize-none" %>
      </div>
    </div>
  </div>

  <%# ===== 액션 버튼 ===== %>
  <div class="flex items-center gap-3 pt-4 border-t border-gray-200 dark:border-gray-700">
    <%= f.submit order.new_record? ? (is_purchase ? t("orders.form.submit_purchase") : t("orders.form.submit_card")) : t("common.save"),
        class: "bg-accent text-white font-medium px-6 py-2.5 rounded-lg hover:bg-blue-500 transition-colors cursor-pointer text-sm" %>
    <%= link_to t("common.cancel"), order.new_record? ? kanban_path : order_path(order),
        class: "text-sm text-gray-500 dark:text-gray-500 hover:text-gray-700 dark:hover:text-gray-300" %>
  </div>
<% end %>

<script>
  // 납기일 퀵픽: 오늘 기준 +days 일 설정
  function setDueDateOffset(days) {
    var d = new Date();
    d.setDate(d.getDate() + days);
    var yyyy = d.getFullYear();
    var mm   = String(d.getMonth() + 1).padStart(2, '0');
    var dd   = String(d.getDate()).padStart(2, '0');
    var field = document.getElementById('order_due_date');
    if (field) field.value = yyyy + '-' + mm + '-' + dd;
  }

  // 발주처(client) 선택 시 ── 종속 자동완성(프로젝트, 외부담당자)의 URL과 선택을 갱신
  document.addEventListener('change', function(e) {
    if (!e.target || e.target.id !== 'order_client_id') return;
    var clientId = e.target.value;

    // 1) 프로젝트 자동완성 URL + 선택 초기화
    var projectEl = document.getElementById('project-autocomplete');
    if (projectEl) {
      var pBase = '<%= search_projects_path %>';
      projectEl.dataset.autocompleteUrlValue =
        clientId ? (pBase + '?client_id=' + clientId) : pBase;
      var projectHidden = projectEl.querySelector('[data-autocomplete-target="hidden"]');
      if (projectHidden && projectHidden.value) {
        var pClear = projectEl.querySelector('[data-action="click->autocomplete#clear"]');
        if (pClear) pClear.click();
      }
    }

    // 2) 외부담당자 자동완성 URL + 선택 초기화 (발주처 바뀌면 기존 담당자 무효)
    var contactEl = document.getElementById('contact-person-autocomplete');
    if (contactEl) {
      var cBase = '<%= search_contact_persons_path %>';
      contactEl.dataset.autocompleteUrlValue =
        clientId ? (cBase + '?client_id=' + clientId) : cBase;
      var contactHidden = contactEl.querySelector('[data-autocomplete-target="hidden"]');
      if (contactHidden && contactHidden.value) {
        var cClear = contactEl.querySelector('[data-action="click->autocomplete#clear"]');
        if (cClear) cClear.click();
      }
    }
  });

  // ISS-224: 직전 단가 자동 제안
  (function() {
    var section = document.getElementById('item-price-section');
    if (!section) return;
    var url = section.dataset.priceHistoryUrl;
    var itemInput = document.getElementById('order-item-name');
    var valueInput = document.getElementById('order-estimated-value');
    var clientHidden = document.querySelector('input[name="order[client_id]"]');
    var supplierHidden = document.querySelector('input[name="order[supplier_id]"]');
    var box = document.getElementById('price-history-suggestions');
    var list = document.getElementById('price-history-list');
    var countEl = document.getElementById('price-history-count');
    var debounceTimer = null;

    function fetchHistory() {
      var clientId   = clientHidden && clientHidden.value;
      var supplierId = supplierHidden && supplierHidden.value;
      var itemName   = itemInput && itemInput.value.trim();
      // 최소 2개 파라미터 조건
      var paramCount = [ clientId, supplierId, itemName ].filter(function(v) { return v; }).length;
      if (paramCount < 2) { box.classList.add('hidden'); return; }

      var params = new URLSearchParams();
      if (clientId)   params.set('client_id', clientId);
      if (supplierId) params.set('supplier_id', supplierId);
      if (itemName)   params.set('item_name', itemName);

      fetch(url + '?' + params.toString(), { headers: { 'Accept': 'application/json' }})
        .then(function(r) { return r.json(); })
        .then(function(data) {
          if (!data.entries || data.entries.length === 0) {
            box.classList.add('hidden'); return;
          }
          countEl.textContent = data.count;
          list.innerHTML = data.entries.map(function(e) {
            var unitDisplay = e.unit_price ? ('$' + e.unit_price.toLocaleString()) : '-';
            var totalDisplay = '$' + (e.total || 0).toLocaleString();
            return '<li class="flex items-center gap-2 hover:bg-blue-100 dark:hover:bg-blue-900/40 p-1.5 rounded cursor-pointer" ' +
                   'onclick="window.applyPriceSuggestion(' + (e.total || 0) + ')" ' +
                   'title="클릭 시 총액 자동 입력">' +
                   '<span class="text-gray-600 dark:text-gray-400 shrink-0 w-24">' + e.created_at + '</span>' +
                   '<span class="text-gray-900 dark:text-white truncate flex-1">' + (e.item_name || '-') + '</span>' +
                   '<span class="text-gray-500 text-[10px] shrink-0">×' + (e.quantity || '-') + '</span>' +
                   '<span class="text-blue-700 dark:text-blue-300 font-semibold shrink-0 w-20 text-right">' + unitDisplay + '/개</span>' +
                   '<span class="text-gray-900 dark:text-white font-bold shrink-0 w-24 text-right">' + totalDisplay + '</span>' +
                   '</li>';
          }).join('');
          box.classList.remove('hidden');
        })
        .catch(function() { box.classList.add('hidden'); });
    }

    window.applyPriceSuggestion = function(total) {
      if (valueInput) { valueInput.value = total; valueInput.dispatchEvent(new Event('change', { bubbles: true })); }
    };

    function debounced() {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(fetchHistory, 400);
    }

    if (itemInput) itemInput.addEventListener('input', debounced);
    // client/supplier autocomplete 변경 감지 — hidden value 변경 시 MutationObserver 사용
    [ clientHidden, supplierHidden ].forEach(function(h) {
      if (!h) return;
      var mo = new MutationObserver(debounced);
      mo.observe(h, { attributes: true, attributeFilter: [ 'value' ] });
      h.addEventListener('change', debounced);
    });
    // 초기 로드 시 한 번
    if (itemInput && itemInput.value.trim()) fetchHistory();
  })();

  // ISS-308: 견적 단가 pre-fill + 공급사 추천
  (function() {
    var section = document.getElementById('item-price-section');
    if (!section) return;
    var suggestionUrl = section.dataset.pricingSuggestionUrl;
    var itemInput     = document.getElementById('order-item-name');
    var clientHidden  = document.querySelector('input[name="order[client_id]"]');
    var supplierHidden = document.querySelector('input[name="order[supplier_id]"]');
    var estimatedInput = document.getElementById('order-estimated-value');
    var quoteBox   = document.getElementById('iss308-quote-suggestion');
    var quoteList  = document.getElementById('iss308-quote-list');
    var chipBox    = document.getElementById('iss308-supplier-chips');
    var chipList   = document.getElementById('iss308-supplier-chip-list');
    var debounceTimer = null;

    function fetchSuggestion() {
      var itemName = itemInput && itemInput.value.trim();
      if (!itemName || itemName.length < 3) {
        if (quoteBox) quoteBox.classList.add('hidden');
        if (chipBox)  chipBox.classList.add('hidden');
        return;
      }
      var params = new URLSearchParams({ item_name: itemName });
      var clientId = clientHidden && clientHidden.value;
      if (clientId) params.set('client_id', clientId);

      fetch(suggestionUrl + '?' + params.toString(), { headers: { 'Accept': 'application/json' } })
        .then(function(r) { return r.json(); })
        .then(function(data) {
          renderQuotes(data.recent_quotes || [], data.suggested_unit_price, data.suggested_currency);
          renderSupplierChips(data.suggested_suppliers || []);
        })
        .catch(function() {});
    }

    function renderQuotes(quotes, suggestedPrice, suggestedCurrency) {
      if (!quoteBox || !quoteList) return;
      if (quotes.length === 0) { quoteBox.classList.add('hidden'); return; }
      quoteList.innerHTML = quotes.map(function(q, idx) {
        var price = q.unit_price ? (q.currency + ' ' + q.unit_price.toLocaleString()) : '-';
        var isBest = idx === 0;
        return '<li class="flex items-center gap-2 hover:bg-green-100 dark:hover:bg-green-900/40 p-1.5 rounded cursor-pointer' + (isBest ? ' font-semibold' : '') + '" ' +
               'onclick="window.applyQuoteSuggestion(' + (q.unit_price || 0) + ', \'' + (q.currency || 'AED') + '\')" ' +
               'title="클릭 시 단가 자동 입력">' +
               '<span class="text-gray-500 dark:text-gray-400 shrink-0 w-24">' + (q.date || '-') + '</span>' +
               '<span class="text-gray-700 dark:text-gray-200 truncate flex-1">' + (q.supplier || '공급사 미상') + '</span>' +
               '<span class="text-green-700 dark:text-green-300 font-semibold shrink-0">' + price + '/개</span>' +
               (isBest ? '<span class="ml-1 px-1.5 py-0.5 rounded text-[10px] text-white" style="background:#1E8E3E">추천</span>' : '') +
               '</li>';
      }).join('');
      quoteBox.classList.remove('hidden');

      // 최신 단가가 있고 폼에 값이 아직 없으면 자동 채움
      if (suggestedPrice && estimatedInput && !estimatedInput.value) {
        var qty = parseFloat(document.querySelector('input[name="order[quantity]"]') && document.querySelector('input[name="order[quantity]"]').value) || 1;
        estimatedInput.value = (suggestedPrice * qty).toFixed(2);
        estimatedInput.dispatchEvent(new Event('change', { bubbles: true }));
      }
    }

    function renderSupplierChips(suppliers) {
      if (!chipBox || !chipList) return;
      if (suppliers.length === 0) { chipBox.classList.add('hidden'); return; }
      chipList.innerHTML = suppliers.map(function(s) {
        return '<button type="button" ' +
               'onclick="window.applySupplierChip(' + s.id + ', \'' + s.name.replace(/'/g, "\\'") + '\')" ' +
               'class="px-3 py-1.5 rounded-full text-xs font-medium border border-gray-300 bg-white dark:bg-gray-800 dark:border-gray-600 text-gray-700 dark:text-gray-200 hover:border-[#00A1E0] hover:text-[#00A1E0] transition-colors">' +
               s.name +
               (s.code ? ' <span class="text-gray-400 text-[10px]">(' + s.code + ')</span>' : '') +
               '</button>';
      }).join('');
      chipBox.classList.remove('hidden');
    }

    // 추천 단가 클릭 → estimated_value 자동 채움
    window.applyQuoteSuggestion = function(unitPrice, currency) {
      if (!estimatedInput) return;
      var qty = parseFloat(document.querySelector('input[name="order[quantity]"]') && document.querySelector('input[name="order[quantity]"]').value) || 1;
      estimatedInput.value = (unitPrice * qty).toFixed(2);
      estimatedInput.dispatchEvent(new Event('change', { bubbles: true }));
    };

    // 공급사 칩 클릭 → supplier hidden field 자동 채움 + autocomplete badge 표시
    window.applySupplierChip = function(supplierId, supplierName) {
      var hidden = document.querySelector('input[name="order[supplier_id]"]');
      if (!hidden) return;
      hidden.value = supplierId;
      hidden.dispatchEvent(new Event('change', { bubbles: true }));

      // autocomplete badge 업데이트
      var supplierAutocomplete = hidden.closest('[data-controller="autocomplete"]');
      if (supplierAutocomplete) {
        var badge = supplierAutocomplete.querySelector('[data-autocomplete-target="badge"]');
        var badgeLabel = supplierAutocomplete.querySelector('[data-autocomplete-target="badgeLabel"]');
        var inputEl = supplierAutocomplete.querySelector('[data-autocomplete-target="input"]');
        if (badge && badgeLabel) {
          badgeLabel.textContent = supplierName;
          badge.classList.remove('hidden');
        }
        if (inputEl) inputEl.classList.add('hidden');
      }
      if (chipBox) chipBox.classList.add('hidden');
    };

    function debounced() {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(fetchSuggestion, 450);
    }

    if (itemInput) itemInput.addEventListener('input', debounced);
    [clientHidden].forEach(function(h) {
      if (!h) return;
      var mo = new MutationObserver(debounced);
      mo.observe(h, { attributes: true, attributeFilter: ['value'] });
      h.addEventListener('change', debounced);
    });
    if (itemInput && itemInput.value.trim().length >= 3) fetchSuggestion();
  })();
</script>
