<%# ISS-039: critical Order (urgent/high + overdue + unassigned) 즉시 조치 배너 %>
<% if local_assigns[:order]&.critical? %>
  <div class="mb-4 rounded-lg border-l-4 border-[#D93025] bg-[#FEE4E2] p-4 flex items-start justify-between gap-4">
    <div class="flex items-start gap-3">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none"
           stroke="#D93025" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 shrink-0">
        <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
        <line x1="12" y1="9" x2="12" y2="13"/>
        <line x1="12" y1="17" x2="12.01" y2="17"/>
      </svg>
      <div>
        <p class="text-sm font-bold text-[#D93025]"><%= t("orders.critical_banner.title") %></p>
        <p class="text-sm text-[#16325C] mt-0.5">
          <%= t("orders.critical_banner.body", days: (Date.today - order.due_date).to_i) %>
        </p>
      </div>
    </div>
    <%= link_to t("orders.critical_banner.assign_link"),
                "#assignment-section",
                class: "shrink-0 inline-flex items-center px-4 py-2 rounded-lg text-sm font-semibold text-white hover:opacity-90 transition-opacity",
                style: "background:#D93025;" %>
  </div>
<% end %>
