<% content_for :page_title, "주문 목록" %>

<div class="flex flex-col gap-6" data-controller="bulk-select">
  <%# Header %>
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-gray-900 dark:text-white">주문 목록</h1>
      <p class="text-sm text-gray-500 dark:text-gray-500 mt-1">전체 RFQ 및 주문 현황</p>
    </div>
    <% if can_create?("orders") %>
      <%= link_to new_order_path, class: "inline-flex items-center gap-1.5 px-3 py-2 bg-primary text-white text-sm font-medium rounded-lg hover:bg-primary/90 transition-colors" do %>
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        주문 추가
      <% end %>
    <% end %>
  </div>

  <%# KPI 카드 %>
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-4 shadow-sm">
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 rounded-lg bg-primary/10 dark:bg-primary/20 flex items-center justify-center">
          <svg class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="1"/></svg>
        </div>
        <div>
          <p class="text-xs text-gray-500 dark:text-gray-500 font-medium">총 건수</p>
          <p class="text-xl font-bold text-gray-900 dark:text-white"><%= @total_count %></p>
        </div>
      </div>
    </div>
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-4 shadow-sm">
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 rounded-lg bg-blue-50 dark:bg-blue-900/20 flex items-center justify-center">
          <svg class="w-4 h-4 text-blue-600 dark:text-blue-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        </div>
        <div>
          <p class="text-xs text-gray-500 dark:text-gray-500 font-medium">진행 중</p>
          <p class="text-xl font-bold text-blue-600 dark:text-blue-400"><%= @kpi_in_progress %></p>
        </div>
      </div>
    </div>
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-4 shadow-sm">
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 rounded-lg bg-green-50 dark:bg-green-900/20 flex items-center justify-center">
          <svg class="w-4 h-4 text-green-600 dark:text-green-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        </div>
        <div>
          <p class="text-xs text-gray-500 dark:text-gray-500 font-medium">완료</p>
          <p class="text-xl font-bold text-green-600 dark:text-green-400"><%= @kpi_completed %></p>
        </div>
      </div>
    </div>
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-4 shadow-sm">
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 rounded-lg bg-red-50 dark:bg-red-900/20 flex items-center justify-center">
          <svg class="w-4 h-4 text-red-600 dark:text-red-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        </div>
        <div>
          <p class="text-xs text-gray-500 dark:text-gray-500 font-medium">연체</p>
          <p class="text-xl font-bold text-red-600 dark:text-red-400"><%= @kpi_overdue %></p>
        </div>
      </div>
    </div>
  </div>

  <%# 검색 및 필터 (FR-01 강화) %>
  <%= form_with url: orders_path, method: :get, class: "bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-4" do |f| %>
    <%# 1행: 검색 + 상태 + 기간 %>
    <div class="flex flex-wrap items-center gap-2 mb-3">
      <div class="relative flex-1 min-w-[200px] max-w-xs">
        <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <%= f.text_field :q, value: params[:q], placeholder: "주문명, 고객명 검색...",
            class: "w-full pl-9 pr-4 py-2 text-sm border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white rounded-lg focus:outline-none focus:ring-2 focus:ring-primary/30" %>
      </div>
      <%= f.select :status, [[" 전체 상태", ""], *Order::STATUS_LABELS.map { |k,v| [v, k] }],
          { selected: params[:status] },
          class: "text-sm border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-primary/30" %>
      <%= f.select :period, [["전체 기간", ""], ["이번달", "this_month"], ["최근 3개월", "3months"], ["올해", "this_year"]],
          { selected: params[:period] },
          class: "text-sm border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-primary/30" %>
    </div>
    <%# 2행: 발주처 / 거래처 / 현장 / 담당자 %>
    <div class="flex flex-wrap items-center gap-2">
      <%= f.select :client_id,
          [["전체 발주처", ""], *@filter_clients.map { |c| [c.name, c.id] }],
          { selected: params[:client_id] },
          class: "text-sm border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-primary/30" %>
      <%= f.select :supplier_id,
          [["전체 거래처", ""], *@filter_suppliers.map { |s| [s.name, s.id] }],
          { selected: params[:supplier_id] },
          class: "text-sm border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-primary/30" %>
      <%= f.select :project_id,
          [["전체 현장", ""], *@filter_projects.map { |p| [p.name, p.id] }],
          { selected: params[:project_id] },
          class: "text-sm border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-primary/30" %>
      <%= f.select :employee_id,
          [["전체 담당자", ""], *@filter_employees.map { |emp| [emp.display_name, emp.id] }],
          { selected: params[:employee_id] },
          class: "text-sm border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-primary/30" %>
      <%# 납기일 범위 (FR-03) %>
      <div class="flex items-center gap-1">
        <span class="text-xs text-gray-500 dark:text-gray-500 whitespace-nowrap">납기</span>
        <%= f.date_field :due_from, value: params[:due_from],
            class: "text-xs border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white rounded-lg px-2 py-2 focus:outline-none focus:ring-2 focus:ring-primary/30 w-32" %>
        <span class="text-xs text-gray-300 dark:text-gray-600">~</span>
        <%= f.date_field :due_to, value: params[:due_to],
            class: "text-xs border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white rounded-lg px-2 py-2 focus:outline-none focus:ring-2 focus:ring-primary/30 w-32" %>
      </div>
      <%= f.submit "검색", class: "px-4 py-2 text-sm bg-primary text-white rounded-lg hover:bg-primary/90 cursor-pointer transition-colors" %>
      <% has_filters = [ :q, :status, :period, :client_id, :supplier_id, :project_id, :employee_id, :due_from, :due_to ].any? { |k| params[k].present? } %>
      <% if has_filters %>
        <%= link_to "필터 초기화", orders_path, class: "text-sm text-gray-500 dark:text-gray-500 hover:text-red-500 transition-colors" %>
      <% end %>
      <span class="ml-auto text-xs text-gray-500 dark:text-gray-500 whitespace-nowrap"><%= @total_count %>건</span>
    </div>
  <% end %>

  <%# ISS-229: 저장된 필터 뷰 %>
  <%
    saved = current_user.saved_filters_for("orders")
    has_filters = [ :q, :status, :period, :client_id, :supplier_id, :project_id, :employee_id, :due_from, :due_to ].any? { |k| params[k].present? }
  %>
  <% if saved.any? || has_filters %>
    <div class="flex flex-wrap items-center gap-2 text-xs">
      <% if saved.any? %>
        <span class="text-gray-500 dark:text-gray-400 font-semibold">저장된 필터:</span>
        <% saved.each do |f| %>
          <% filter_params = f["params"] || {} %>
          <% is_active = filter_params.all? { |k, v| params[k].to_s == v.to_s } && filter_params.any? %>
          <div class="inline-flex items-center gap-1 border rounded-full overflow-hidden
                      <%= is_active ? 'bg-[#00A1E0] text-white border-[#00A1E0]' : 'bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-300 border-gray-300 dark:border-gray-600' %>">
            <%= link_to f["name"], orders_path(filter_params),
                  class: "px-3 py-1 hover:opacity-90 transition-colors",
                  title: filter_params.map { |k, v| "#{k}=#{v}" }.join(" · ") %>
            <%= button_to delete_saved_filter_orders_path(name: f["name"]),
                  method: :delete,
                  data: { turbo_confirm: "저장된 필터 '#{f["name"]}' 삭제하시겠습니까?" },
                  class: "px-1.5 py-1 hover:bg-red-500/20 text-xs leading-none cursor-pointer" do %>
              ×
            <% end %>
          </div>
        <% end %>
      <% end %>

      <%# 현재 필터 저장 버튼 %>
      <% if has_filters %>
        <details class="relative">
          <summary class="cursor-pointer inline-flex items-center gap-1 px-3 py-1 bg-white dark:bg-gray-800 border border-dashed border-[#00A1E0] text-[#00A1E0] rounded-full hover:bg-[#00A1E0]/5 transition-colors">
            <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
            현재 필터 저장
          </summary>
          <div class="absolute left-0 top-full mt-1 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg shadow-lg p-3 z-20 w-64">
            <%= form_with url: save_filter_orders_path, method: :post, class: "flex gap-1" do |ff| %>
              <% [ :q, :status, :period, :client_id, :supplier_id, :project_id, :employee_id, :due_from, :due_to, :date_from, :date_to ].each do |k| %>
                <% if params[k].present? %>
                  <%= ff.hidden_field k, value: params[k] %>
                <% end %>
              <% end %>
              <%= ff.text_field :filter_name, placeholder: "필터 이름 (예: 내 담당 긴급)", required: true,
                    class: "flex-1 px-2 py-1 text-xs border border-gray-300 dark:border-gray-600 rounded bg-white dark:bg-gray-800 text-gray-900 dark:text-white focus:outline-none focus:border-[#00A1E0]" %>
              <%= ff.submit "저장", class: "px-2 py-1 text-xs bg-[#00A1E0] text-white rounded hover:bg-[#0083b7] cursor-pointer" %>
            <% end %>
            <p class="text-[10px] text-gray-500 mt-1.5">최대 10개 · 같은 이름은 덮어쓰기</p>
          </div>
        </details>
      <% end %>
    </div>
  <% end %>

  <%# 주문 목록 %>
  <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 overflow-hidden">
    <% if @orders.any? %>
      <table class="min-w-full divide-y divide-gray-100 dark:divide-gray-700">
        <thead class="bg-gray-50 dark:bg-gray-700/50">
          <tr>
            <th class="px-4 py-3 w-10">
              <input type="checkbox"
                     data-bulk-select-target="selectAll"
                     data-action="change->bulk-select#toggleAll"
                     class="w-4 h-4 rounded border-gray-300 dark:border-gray-600 text-primary focus:ring-primary/30 cursor-pointer">
            </th>
            <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-500">주문명</th>
            <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-500">발주처</th>
            <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-500 hidden md:table-cell">현장</th>
            <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-500">상태</th>
            <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-500">우선순위</th>
            <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-500">마감일</th>
            <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-500">담당자</th>
            <th class="px-5 py-3"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-50 dark:divide-gray-700">
          <% @orders.each do |order| %>
            <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors" data-bulk-select-target="row">
              <td class="px-4 py-3">
                <input type="checkbox"
                       value="<%= order.id %>"
                       data-bulk-select-target="checkbox"
                       data-action="change->bulk-select#toggle"
                       class="w-4 h-4 rounded border-gray-300 dark:border-gray-600 text-primary focus:ring-primary/30 cursor-pointer">
              </td>
              <td class="px-5 py-3">
                <div>
                  <div class="flex items-center gap-2">
                    <p class="text-sm font-medium text-gray-900 dark:text-white truncate max-w-xs"><%= order.title %></p>
                    <%= risk_dot(order) %>
                  </div>
                  <% if order.item_name.present? %>
                    <p class="text-xs text-gray-500 dark:text-gray-500"><%= order.item_name %></p>
                  <% end %>
                </div>
              </td>
              <td class="px-5 py-3 text-sm text-gray-600 dark:text-gray-500">
                <% if order.client %>
                  <%= link_to order.client.name, client_path(order.client), class: "hover:text-primary hover:underline" %>
                <% else %>
                  <%= order.customer_name || "-" %>
                <% end %>
              </td>
              <td class="px-5 py-3 text-sm text-gray-500 dark:text-gray-500 hidden md:table-cell">
                <%= order.project&.name&.truncate(20) || "-" %>
              </td>
              <td class="px-5 py-3"
                  data-controller="inline-edit"
                  data-inline-edit-url-value="<%= quick_update_order_path(order) %>">
                <select data-action="change->inline-edit#saveStatus"
                        class="text-xs border-0 bg-transparent p-0 focus:ring-1 focus:ring-primary/30 rounded cursor-pointer font-medium
                               <%= case order.status
                                   when 'new_rfq'        then 'text-gray-700 dark:text-gray-300'
                                   when 'make_quo'       then 'text-blue-700 dark:text-blue-400'
                                   when 'pending_po'     then 'text-purple-700 dark:text-purple-400'
                                   when 'new_po'         then 'text-indigo-700 dark:text-indigo-400'
                                   when 'delivery_items' then 'text-yellow-700 dark:text-yellow-400'
                                   when 'problem'        then 'text-orange-700 dark:text-orange-400'
                                   when 'get_grn'        then 'text-green-700 dark:text-green-400'
                                   when 'give_up'        then 'text-gray-500 dark:text-gray-500'
                                   else 'text-gray-700 dark:text-gray-300'
                                   end %>">
                  <% Order::STATUS_LABELS.each do |k, v| %>
                    <option value="<%= k %>" <%= 'selected' if order.status == k %>><%= v %></option>
                  <% end %>
                </select>
              </td>
              <td class="px-5 py-3">
                <% case order.card_status&.key
                   when "urgent", "overdue" %>
                  <span class="inline-flex items-center gap-1 text-xs text-red-600 dark:text-red-400">
                    <span class="w-1.5 h-1.5 rounded-full bg-red-500"></span> 긴급
                  </span>
                <% when "high" %>
                  <span class="inline-flex items-center gap-1 text-xs text-orange-600 dark:text-orange-400">
                    <span class="w-1.5 h-1.5 rounded-full bg-orange-400"></span> 높음
                  </span>
                <% else %>
                  <span class="text-xs text-gray-500 dark:text-gray-500">보통</span>
                <% end %>
              </td>
              <td class="px-5 py-3 text-sm"
                  data-controller="inline-edit"
                  data-inline-edit-url-value="<%= quick_update_order_path(order) %>">
                <input type="date"
                       value="<%= order.due_date&.strftime('%Y-%m-%d') %>"
                       data-action="change->inline-edit#saveDueDate"
                       class="text-xs border-0 bg-transparent p-0 w-24 focus:ring-1 focus:ring-primary/30 rounded cursor-pointer
                              <%= order.due_date ? due_date_color_class(order.due_date) : 'text-gray-500 dark:text-gray-500' %>">
              </td>
              <td class="px-5 py-3">
                <div class="flex -space-x-1">
                  <% order.assignees.first(3).each do |user| %>
                    <div class="w-6 h-6 rounded-full bg-primary/10 dark:bg-primary/20 border border-white dark:border-gray-800 flex items-center justify-center text-primary text-xs font-bold"
                         title="<%= user.name %>">
                      <%= user.name.first.upcase %>
                    </div>
                  <% end %>
                </div>
              </td>
              <td class="px-5 py-3 text-right">
                <%= link_to order_path(order), class: "text-xs text-primary hover:underline" do %>상세<% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div class="p-12 text-center">
        <svg class="w-12 h-12 mx-auto text-gray-200 dark:text-gray-600 mb-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="1"/></svg>
        <p class="text-sm text-gray-500 dark:text-gray-500">주문이 없습니다.</p>
        <% if can_create?("orders") %>
          <%= link_to new_order_path, class: "mt-3 inline-flex text-sm text-primary hover:underline" do %>첫 주문 추가하기 →<% end %>
        <% end %>
      </div>
    <% end %>
  </div>

  <%# 일괄 처리 액션 바 (하단 고정) %>
  <div data-bulk-select-target="actionBar"
       class="hidden fixed bottom-6 left-1/2 -translate-x-1/2 z-30 bg-gray-900 dark:bg-gray-700 text-white rounded-2xl shadow-2xl px-5 py-3 flex items-center gap-4 min-w-72">
    <span data-bulk-select-target="count" class="text-sm font-medium">0개 선택됨</span>
    <div class="h-4 w-px bg-white/20"></div>
    <%# 상태 변경 %>
    <select data-bulk-select-target="statusSelect"
            class="text-xs bg-white/10 border border-white/20 rounded-lg px-2 py-1 text-white focus:outline-none focus:ring-1 focus:ring-white/40">
      <option value="">상태 변경...</option>
      <% Order::STATUS_LABELS.each do |status, label| %>
        <option value="<%= status %>"><%= label %></option>
      <% end %>
    </select>
    <button data-action="click->bulk-select#bulkAction"
            data-url="<%= orders_bulk_path %>"
            class="text-xs bg-accent hover:bg-accent/80 px-3 py-1.5 rounded-lg transition-colors font-medium">
      적용
    </button>
    <div class="h-4 w-px bg-white/20"></div>
    <%# 담당자 배정 (FR-02) %>
    <select data-bulk-select-target="assignSelect"
            class="text-xs bg-white/10 border border-white/20 rounded-lg px-2 py-1 text-white focus:outline-none focus:ring-1 focus:ring-white/40">
      <option value="">담당자 배정...</option>
      <% User.order(:name).each do |u| %>
        <option value="<%= u.id %>"><%= u.display_name %></option>
      <% end %>
    </select>
    <button data-action="click->bulk-select#bulkAssign"
            class="text-xs bg-green-500 hover:bg-green-400 px-3 py-1.5 rounded-lg transition-colors font-medium">
      배정
    </button>
    <div class="h-4 w-px bg-white/20"></div>
    <%# CSV 내보내기 %>
    <button data-action="click->bulk-select#exportCsv"
            data-url="<%= export_csv_orders_bulk_path %>"
            class="text-xs text-white/70 hover:text-white flex items-center gap-1.5 transition-colors">
      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
      CSV
    </button>
    <button data-action="click->bulk-select#clearAll"
            class="ml-1 text-white/60 hover:text-white/80 transition-colors text-xs">
      취소
    </button>
  </div>

  <%# 페이지네이션 %>
  <% if @total_pages > 1 %>
    <div class="flex items-center justify-between px-2">
      <p class="text-xs text-gray-500 dark:text-gray-500">
        총 <%= @total_count %>건 중 <%= [(@current_page - 1) * 50 + 1, @total_count].min %>–<%= [@current_page * 50, @total_count].min %>건
      </p>
      <div class="flex items-center gap-1">
        <% if @current_page > 1 %>
          <%= link_to orders_path(q: params[:q], status: params[:status], page: @current_page - 1),
              class: "px-3 py-1.5 text-xs text-gray-600 dark:text-gray-300 border border-gray-200 dark:border-gray-600 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700" do %>이전<% end %>
        <% end %>
        <% ([1, @current_page - 1].max..[@total_pages, @current_page + 1].min).each do |pg| %>
          <%= link_to orders_path(q: params[:q], status: params[:status], page: pg),
              class: "px-3 py-1.5 text-xs rounded-lg #{pg == @current_page ? 'bg-primary text-white' : 'text-gray-600 dark:text-gray-300 border border-gray-200 dark:border-gray-600 hover:bg-gray-50 dark:hover:bg-gray-700'}" do %>
            <%= pg %>
          <% end %>
        <% end %>
        <% if @current_page < @total_pages %>
          <%= link_to orders_path(q: params[:q], status: params[:status], page: @current_page + 1),
              class: "px-3 py-1.5 text-xs text-gray-600 dark:text-gray-300 border border-gray-200 dark:border-gray-600 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700" do %>다음<% end %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
