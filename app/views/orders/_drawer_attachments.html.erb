<div id="drawer-panel-<%= order.id %>-attachments" class="p-6 hidden">
  <% att_meta = order.respond_to?(:attachment_urls) && order.attachment_urls.present? ? (JSON.parse(order.attachment_urls) rescue []) : [] %>
  <% active_storage_attachments = order.respond_to?(:attachments) ? (order.attachments.includes(:blob) rescue []) : [] %>
  <% links = order.respond_to?(:extracted_links) && order.extracted_links.present? ? (JSON.parse(order.extracted_links) rescue []) : [] %>

  <%# 파일 업로드 영역 %>
  <div class="mb-4">
    <%= form_with url: attach_order_path(order), method: :post, multipart: true,
        data: { turbo: true },
        class: "flex items-center gap-2" do |f| %>
      <label class="flex-1 flex items-center justify-center gap-2 px-4 py-3 border-2 border-dashed border-gray-300 rounded-xl cursor-pointer hover:border-[#00A1E0] hover:bg-blue-50/30 transition-colors group">
        <svg class="w-5 h-5 text-gray-500 group-hover:text-[#00A1E0] transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
        <span class="text-sm text-gray-500 group-hover:text-[#00A1E0] transition-colors" id="upload-label-<%= order.id %>">파일 선택 또는 드래그</span>
        <%= f.file_field :files, multiple: true, class: "hidden",
            onchange: "updateUploadLabel(this, #{order.id})" %>
      </label>
      <%= f.submit "업로드",
          class: "px-4 py-2.5 text-sm font-medium text-white bg-[#1E3A5F] rounded-lg hover:bg-[#1E3A5F]/90 cursor-pointer transition-colors shrink-0" %>
    <% end %>
  </div>

  <% if att_meta.any? || active_storage_attachments.any? || links.any? %>
    <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
      <div class="px-5 py-3 border-b border-gray-200 flex items-center justify-between">
        <h3 class="text-sm font-semibold text-gray-900 flex items-center gap-2">
          <svg class="w-4 h-4 text-gray-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg>
          첨부파일 및 링크
        </h3>
        <% total_att = [ att_meta.size, active_storage_attachments.size ].max + links.size %>
        <span class="text-xs text-gray-500"><%= total_att %>개</span>
      </div>
      <div class="px-5 py-4 space-y-2">
        <%# ActiveStorage 첨부파일 %>
        <% active_storage_attachments.each do |att| %>
          <% blob = att.blob %>
          <% ct = blob.content_type.to_s %>
          <% fn = blob.filename.to_s %>
          <% is_pdf = ct.include?("pdf") %>
          <% is_image = ct.start_with?("image/") %>
          <% is_html = ct.include?("html") || (fn.end_with?(".doc") && ct.include?("html")) %>
          <% is_excel = ct.include?("spreadsheet") || ct.include?("excel") || fn.match?(/\.xlsx?\z/i) || fn.match?(/\.csv\z/i) %>
          <% is_text = ct.start_with?("text/") && !is_html && !fn.match?(/\.csv\z/i) %>
          <% is_word = ct.include?("wordprocessingml") || fn.match?(/\.docx?\z/i) %>
          <% is_viewable = is_pdf || is_image || is_html || is_excel || is_text || is_word %>
          <% preview_url = attachment_preview_order_path(order, blob_id: blob.id) %>
          <%
            icon_color = if is_pdf then "text-red-500"
                         elsif is_excel then "text-green-600"
                         elsif is_image then "text-purple-500"
                         elsif is_html then "text-blue-500"
                         elsif is_word then "text-blue-700"
                         elsif is_text then "text-gray-600"
                         else "text-gray-500"
                         end
            type_label = if is_pdf then "PDF"
                        elsif is_excel then fn.match?(/\.csv\z/i) ? "CSV" : "Excel"
                        elsif is_image then ct.split("/").last&.upcase
                        elsif is_html then "HTML"
                        elsif is_word then "Word"
                        elsif is_text then "텍스트"
                        else ct.split("/").last&.upcase
                        end
          %>
          <div class="relative flex items-center gap-2.5 p-2.5 rounded-lg border border-gray-200 hover:bg-blue-50 transition-colors group cursor-pointer"
               <% if is_viewable %>onclick="openPreviewModal('<%= j(fn) %>', '<%= j(preview_url) %>')"<% end %>>
            <% unless is_viewable %>
              <a href="<%= rails_blob_path(blob, disposition: "attachment") %>" class="absolute inset-0 z-0 rounded-lg"></a>
            <% end %>
            <%# 파일 타입별 아이콘 %>
            <svg class="w-8 h-8 p-1.5 rounded bg-gray-100 <%= icon_color %> flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
            <div class="flex-1 min-w-0">
              <p class="text-xs font-medium text-gray-800 truncate"><%= fn %></p>
              <p class="text-xs text-gray-500">
                <span class="<%= icon_color %>"><%= type_label %></span> ·
                <%= number_to_human_size(blob.byte_size) %>
                <% if is_viewable %>
                  · <span class="text-blue-500">클릭하여 미리보기</span>
                <% end %>
              </p>
            </div>
            <% if is_viewable %>
              <span class="relative z-10 p-1.5 rounded hover:bg-blue-100 transition-colors" title="미리보기">
                <svg class="w-3.5 h-3.5 text-blue-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
              </span>
            <% end %>
            <a href="<%= rails_blob_path(blob, disposition: "attachment") %>" class="relative z-10 p-1.5 rounded hover:bg-gray-200 transition-colors" title="다운로드" onclick="event.stopPropagation()">
              <svg class="w-3.5 h-3.5 text-gray-500 group-hover:text-blue-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            </a>
            <%= link_to detach_order_path(order, blob_id: blob.id), method: :delete,
                data: { turbo_method: :delete, turbo_confirm: "#{fn}을(를) 삭제할까요?" },
                class: "relative z-10 p-1.5 rounded hover:bg-red-100 transition-colors",
                title: "삭제", onclick: "event.stopPropagation()" do %>
              <svg class="w-3.5 h-3.5 text-gray-500 hover:text-red-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
            <% end %>
          </div>
        <% end %>

        <%# attachment_urls 메타만 있는 경우 (레거시) %>
        <% if active_storage_attachments.empty? %>
          <% att_meta.each do |att| %>
            <% att = att.is_a?(Hash) ? att.with_indifferent_access : {} %>
            <% icon_color = att[:mime_type].to_s.include?("pdf") ? "text-red-500" : att[:mime_type].to_s.include?("sheet") || att[:mime_type].to_s.include?("excel") ? "text-green-600" : "text-blue-500" %>
            <div class="flex items-center gap-2.5 p-2.5 rounded-lg border border-gray-200 opacity-60">
              <svg class="w-8 h-8 p-1.5 rounded bg-gray-100 <%= icon_color %> flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
              <div class="flex-1 min-w-0">
                <p class="text-xs font-medium text-gray-800 truncate"><%= att[:filename] %></p>
                <p class="text-xs text-gray-500">
                  <%= att[:mime_type]&.split("/")&.last&.upcase %>
                  <% if att[:size] %> · <%= number_to_human_size(att[:size]) %><% end %>
                  · 재동기화 필요
                </p>
              </div>
            </div>
          <% end %>
        <% end %>

        <%# SAP/Ariba Portal 링크 %>
        <% sap_links_json = order.respond_to?(:sap_portal_links) && order.sap_portal_links.present? ? order.sap_portal_links.to_s : "[]" %>
        <% sap_urls = (JSON.parse(sap_links_json) rescue []) %>
        <% if sap_urls.any? %>
          <div class="mt-1 mb-2">
            <p class="text-xs font-semibold text-orange-600 mb-1.5 flex items-center gap-1">
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
              SAP / Ariba Portal Links
            </p>
            <% sap_urls.each do |sap_url| %>
              <div class="flex items-center gap-2 p-2 rounded-lg border border-orange-200 bg-orange-50 mb-1">
                <svg class="w-4 h-4 text-orange-500 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
                <a href="<%= sap_url %>" target="_blank" rel="noopener noreferrer" class="flex-1 text-xs text-orange-700 hover:underline truncate"><%= sap_url.truncate(60) %></a>
              </div>
            <% end %>
          </div>
        <% end %>

        <%# 기타 추출된 링크 %>
        <% links.reject { |u| sap_urls.include?(u) }.each do |url| %>
          <a href="<%= url %>" target="_blank" rel="noopener noreferrer"
             class="flex items-center gap-2 p-2 rounded-lg hover:bg-gray-50 transition-colors group">
            <svg class="w-4 h-4 text-blue-500 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
            <span class="text-xs text-blue-500 hover:underline truncate"><%= url.truncate(60) %></span>
          </a>
        <% end %>
      </div>
    </div>
  <% else %>
    <div class="p-8 text-center">
      <svg class="w-10 h-10 mx-auto text-gray-200 mb-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg>
      <p class="text-sm text-gray-500">첨부파일이 없습니다</p>
      <p class="text-xs text-gray-300 mt-1">위 영역에서 파일을 추가하세요</p>
    </div>
  <% end %>
  <div class="h-4"></div>
</div>
