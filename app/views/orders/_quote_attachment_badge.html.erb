<%
  kind = QuoteAttachmentClassifier.call(attachment)
  status = aqa&.status
  credit_issue = aqa&.error_message.to_s.match?(/insufficient|401|credit/i)
%>
<span id="quote-attachment-badge-<%= attachment.id %>" class="inline-flex items-center align-middle whitespace-nowrap">
  <% if status == "running" || status == "pending" %>
    <span class="inline-flex items-center px-2 py-0.5 rounded-md text-xs font-semibold animate-pulse"
          style="background:#F4A83A;color:white;"
          title="Sonnet 4.6 vision으로 분석 중 — 약 15~40초 소요. 완료 시 자동 갱신됩니다.">
      ⏳ <%= t("orders.attachments.badge_analyzing", default: "분석중 ~30초") %>
    </span>
  <% elsif status == "completed" && aqa.is_quote_doc %>
    <button type="button"
            onclick="if (typeof switchDrawerTab === 'function') switchDrawerTab(<%= order.id %>, 'quote_items'); return false;"
            class="inline-flex items-center px-2 py-0.5 rounded-md text-xs font-semibold cursor-pointer transition-opacity hover:opacity-80"
            style="background:#00A1E0;color:white;">
      🔍 <%= t("orders.attachments.badge_quoted", default: "품목 보기") %>
    </button>
  <% elsif status == "completed" && !aqa.is_quote_doc %>
    <span class="inline-flex items-center px-2 py-0.5 rounded-md text-xs font-semibold"
          style="background:#9ca3af;color:white;">
      <%= t("orders.attachments.badge_not_quote", default: "견적 아님") %>
    </span>
  <% elsif status == "failed" %>
    <%= form_with url: reanalyze_attachment_quote_analysis_path(aqa), method: :post,
                  data: { turbo_stream: true }, class: "inline-flex" do %>
      <button type="submit"
              class="inline-flex items-center px-2 py-0.5 rounded-md text-xs font-semibold cursor-pointer transition-opacity hover:opacity-80"
              style="background:#D93025;color:white;">
        <%= credit_issue ? t("orders.attachments.badge_credit", default: "💳 잔액 부족") : t("orders.attachments.badge_retry", default: "🔄 재분석") %>
      </button>
    <% end %>
  <% elsif status == "not_quote" %>
    <%# explicit not_quote — no badge %>
  <% elsif kind == :quote_candidate %>
    <%= form_with url: attachment_quote_analyses_path, data: { turbo_stream: true }, class: "inline-flex" do |f| %>
      <%= f.hidden_field :attachment_id, value: attachment.id %>
      <button type="submit"
              class="inline-flex items-center px-2.5 py-0.5 rounded-md text-xs font-semibold cursor-pointer transition-opacity hover:opacity-80"
              style="background:#00A1E0;color:white;">
        🔍 <%= t("orders.attachments.badge_analyze", default: "품목 분석") %>
      </button>
    <% end %>
  <% end %>
</span>
