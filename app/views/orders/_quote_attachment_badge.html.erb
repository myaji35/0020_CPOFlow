<%
  kind = QuoteAttachmentClassifier.call(attachment)
  status = aqa&.status
  credit_issue = aqa&.error_message.to_s.match?(/insufficient|401|credit/i)
%>
<span id="quote-attachment-badge-<%= attachment.id %>" class="inline-flex items-center">
  <% if status == "running" || status == "pending" %>
    <span class="px-2 py-0.5 rounded-md text-[11px] bg-gray-100 text-gray-700 animate-pulse">
      <%= t("orders.attachments.badge_analyzing", default: "견적 분석중...") %>
    </span>
  <% elsif status == "completed" && aqa.is_quote_doc %>
    <button type="button"
            onclick="if (typeof switchDrawerTab === 'function') switchDrawerTab(<%= order.id %>, 'quote_items'); return false;"
            class="px-2 py-0.5 rounded-md text-[11px] bg-[#00A1E0]/10 text-[#00A1E0] hover:bg-[#00A1E0]/20 cursor-pointer">
      <%= t("orders.attachments.badge_quoted", default: "견적분석") %>
    </button>
  <% elsif status == "completed" && !aqa.is_quote_doc %>
    <span class="px-2 py-0.5 rounded-md text-[11px] bg-gray-100 text-gray-500">
      <%= t("orders.attachments.badge_not_quote", default: "견적 아님") %>
    </span>
  <% elsif status == "failed" %>
    <%= form_with url: reanalyze_attachment_quote_analysis_path(aqa), method: :post,
                  data: { turbo_stream: true }, class: "inline" do %>
      <button type="submit" class="px-2 py-0.5 rounded-md text-[11px] bg-red-50 text-red-700 hover:bg-red-100 cursor-pointer">
        <%= credit_issue ? t("orders.attachments.badge_credit", default: "잔액 부족") : t("orders.attachments.badge_retry", default: "재분석") %>
      </button>
    <% end %>
  <% elsif status == "not_quote" %>
    <%# explicit not_quote — no badge %>
  <% elsif kind == :quote_candidate %>
    <%= form_with url: attachment_quote_analyses_path, data: { turbo_stream: true }, class: "inline" do |f| %>
      <%= f.hidden_field :attachment_id, value: attachment.id %>
      <button type="submit" class="px-2 py-0.5 rounded-md text-[11px] bg-[#00A1E0]/10 text-[#00A1E0] hover:bg-[#00A1E0]/20 cursor-pointer">
        <%= t("orders.attachments.badge_analyze", default: "분석") %>
      </button>
    <% end %>
  <% end %>
</span>
