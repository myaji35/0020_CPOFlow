<%# ============================================================
    주문 상세 Drawer 콘텐츠 — Drawer / Full page 공용
============================================================ %>
<% thread_orders ||= Order.none %>
<div id="order-drawer-content-<%= order.id %>">

  <%# ── 탭 바 ─────────────────────────────────────────────── %>
  <div class="flex border-b border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 sticky top-0 z-10"
       id="drawer-tabs-<%= order.id %>">
    <% att_count = order.respond_to?(:attachments) ? (order.attachments.size rescue 0) : 0 %>
    <% [
      ['detail',      '상세'],
      ['tasks',       '태스크'],
      ['comments',    '코멘트'],
      ['attachments', '첨부파일'],
      ['history',     '히스토리']
    ].each_with_index do |(tab_id, label), i| %>
      <button onclick="switchDrawerTab('<%= order.id %>', '<%= tab_id %>')"
              id="drawer-tab-<%= order.id %>-<%= tab_id %>"
              class="flex items-center gap-1.5 px-4 py-3 text-sm font-medium transition-colors border-b-2
                     <%= i == 0 ? 'border-primary text-primary' : 'border-transparent text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300' %>">
        <%= label %>
        <% if tab_id == 'tasks' && tasks.any? %>
          <span class="text-xs bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-400 px-1.5 py-0.5 rounded-full"><%= tasks.count %></span>
        <% end %>
        <% if tab_id == 'comments' && comments.any? %>
          <span class="text-xs bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-400 px-1.5 py-0.5 rounded-full"><%= comments.count %></span>
        <% end %>
        <% if tab_id == 'attachments' && att_count > 0 %>
          <span class="text-xs bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-400 px-1.5 py-0.5 rounded-full"><%= att_count %></span>
        <% end %>
      </button>
    <% end %>
  </div>

  <%# ── CPO Agent Insights 배너 ──────────────────────────── %>
  <% insights = defined?(agent_insights) ? agent_insights : (order.agent_insights.active.order(severity: :desc).limit(3) rescue []) %>
  <%= render "agent_insights/drawer_banner", insights: insights, order: order %>

  <%# ══════════════════════════════════════════════════════════
      탭 패널 1: 상세 (기본 표시)
  ══════════════════════════════════════════════════════════ %>
  <div id="drawer-panel-<%= order.id %>-detail" class="p-6 space-y-6">

    <%# ── 1. 헤더 메타 정보 ─────────────────────────────────── %>
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-5">
      <%# 상태/우선순위/D-day 배지 %>
      <div class="flex flex-wrap items-center gap-2 mb-4">
        <%= status_badge(order) %>

        <%# 우선순위 인라인 드롭다운 %>
        <div class="relative inline-block" id="priority-dropdown-<%= order.id %>">
          <button onclick="togglePriorityDropdown('<%= order.id %>', event)"
                  class="cursor-pointer focus:outline-none">
            <%= priority_badge(order) %>
          </button>
          <div id="priority-menu-<%= order.id %>"
               class="hidden absolute left-0 top-full mt-1 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg shadow-lg z-20 py-1 w-32">
            <% [['low', '낮음'], ['medium', '보통'], ['high', '높음'], ['urgent', '긴급']].each do |val, label| %>
              <%= form_with url: quick_update_order_path(order), method: :patch, local: true do |f| %>
                <%= f.hidden_field :priority, value: val %>
                <button type="submit"
                        class="w-full text-left px-3 py-1.5 text-xs transition-colors hover:bg-gray-50 dark:hover:bg-gray-700
                               <%= order.priority == val ? 'font-semibold text-primary' : 'text-gray-700 dark:text-gray-300' %>">
                  <%= label %>
                  <% if order.priority == val %>
                    <span class="float-right text-primary">✓</span>
                  <% end %>
                </button>
              <% end %>
            <% end %>
          </div>
        </div>

        <% if order.due_date %>
          <%= due_badge(order) %>
        <% end %>
        <% if order.source_email_id.present? %>
          <span class="inline-flex items-center gap-1 text-xs px-2 py-0.5 rounded-full bg-purple-50 dark:bg-purple-900/30 text-purple-700 dark:text-purple-400">
            <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            이메일 수신
          </span>
        <% end %>
        <% if order.ariba? %>
          <span class="inline-flex items-center gap-1 text-xs px-2 py-0.5 rounded-full bg-blue-50 dark:bg-blue-900/30 text-blue-700 dark:text-blue-400 font-semibold">
            <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg>
            SAP Ariba
          </span>
        <% end %>
      </div>

      <%# 주요 정보 그리드 %>
      <dl class="grid grid-cols-2 gap-x-6 gap-y-4 text-sm">
        <div>
          <dt class="text-xs text-gray-400 dark:text-gray-500 uppercase tracking-wide mb-1">고객사</dt>
          <dd class="font-medium text-gray-900 dark:text-white">
            <% if order.client %>
              <%= link_to order.client.name, client_path(order.client), class: "text-accent hover:underline" %>
            <% else %>
              <%= order.customer_name %>
            <% end %>
          </dd>
        </div>
        <div>
          <dt class="text-xs text-gray-400 dark:text-gray-500 uppercase tracking-wide mb-1">마감일</dt>
          <dd class="font-medium text-gray-900 dark:text-white"><%= order.due_date&.strftime("%Y년 %m월 %d일") || "—" %></dd>
        </div>
        <% if order.project %>
          <div>
            <dt class="text-xs text-gray-400 dark:text-gray-500 uppercase tracking-wide mb-1">프로젝트</dt>
            <dd class="font-medium text-gray-900 dark:text-white">
              <%= link_to order.project.name, project_path(order.project), class: "text-accent hover:underline" %>
            </dd>
          </div>
        <% end %>
        <% if order.supplier %>
          <div>
            <dt class="text-xs text-gray-400 dark:text-gray-500 uppercase tracking-wide mb-1">공급사</dt>
            <dd class="font-medium text-gray-900 dark:text-white">
              <%= link_to order.supplier.name, supplier_path(order.supplier), class: "text-accent hover:underline" %>
            </dd>
          </div>
        <% end %>
        <% if order.item_name.present? %>
          <div>
            <dt class="text-xs text-gray-400 dark:text-gray-500 uppercase tracking-wide mb-1">품목</dt>
            <dd class="font-medium text-gray-900 dark:text-white"><%= order.item_name %> <%= "× #{order.quantity}" if order.quantity %></dd>
            <%# eCountERP 실시간 재고 표시 — 연동된 제품만 표시 %>
            <% product = Product.find_by(name: order.item_name) %>
            <% if product&.ecount_code.present? %>
              <% stock = EcountApi::InventoryService.stock_for(product.ecount_code) rescue nil %>
              <% if stock.present? %>
                <dd class="mt-1 flex items-center gap-1.5 text-xs">
                  <svg class="w-3.5 h-3.5 text-gray-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
                  <span class="text-gray-500 dark:text-gray-400">재고</span>
                  <% if stock <= 0 %>
                    <span class="font-semibold text-red-600 dark:text-red-400">재고 없음</span>
                  <% elsif stock <= 10 %>
                    <span class="font-semibold text-orange-600 dark:text-orange-400"><%= stock %>개 (부족)</span>
                  <% else %>
                    <span class="font-medium text-green-600 dark:text-green-400"><%= stock %>개</span>
                  <% end %>
                </dd>
              <% end %>
            <% end %>
          </div>
        <% end %>
        <% if order.estimated_value.present? %>
          <div>
            <dt class="text-xs text-gray-400 dark:text-gray-500 uppercase tracking-wide mb-1">예상 금액</dt>
            <dd class="font-medium text-gray-900 dark:text-white">
              <%= number_to_currency(order.estimated_value, unit: order.currency.presence || "$", format: "%u %n") %>
            </dd>
          </div>
        <% end %>
        <% if order.ariba_event_id.present? %>
          <div>
            <dt class="text-xs text-gray-400 dark:text-gray-500 uppercase tracking-wide mb-1">Ariba 이벤트 ID</dt>
            <dd class="font-medium text-gray-900 dark:text-white font-mono"><%= order.ariba_event_id %></dd>
          </div>
        <% end %>
      </dl>

      <%# Ariba 포털 링크 버튼 %>
      <% if order.ariba_event_url.present? %>
        <div class="mt-4 pt-4 border-t border-gray-100 dark:border-gray-700">
          <%= link_to order.ariba_event_url, target: "_blank", rel: "noopener noreferrer",
              class: "inline-flex items-center gap-2 px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-lg transition-colors" do %>
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
              <polyline points="15 3 21 3 21 9"/>
              <line x1="10" y1="14" x2="21" y2="3"/>
            </svg>
            Open in Ariba
          <% end %>
        </div>
      <% end %>

      <%# 설명 %>
      <% if order.description.present? %>
        <div class="mt-4 pt-4 border-t border-gray-100 dark:border-gray-700">
          <p class="text-xs text-gray-400 dark:text-gray-500 uppercase tracking-wide mb-2">설명</p>
          <p class="text-sm text-gray-700 dark:text-gray-300 leading-relaxed whitespace-pre-wrap"><%= order.description %></p>
        </div>
      <% end %>

      <%# 태그 %>
      <% if order.tags_array.any? %>
        <div class="mt-4 flex flex-wrap gap-1.5">
          <% order.tags_array.each do |tag| %>
            <span class="text-xs bg-blue-50 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 px-2.5 py-0.5 rounded-full">#<%= tag %></span>
          <% end %>
        </div>
      <% end %>
    </div>

    <%# ── 2. 담당자 + 스테이지 이동 ─────────────────────────── %>
    <div class="grid grid-cols-2 gap-4">
      <%# 담당자 %>
      <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-4" x-data="{ showAssignMenu: false }">
        <div class="flex items-center justify-between mb-3">
          <h4 class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">담당자</h4>
          <button @click="showAssignMenu = !showAssignMenu"
                  class="w-6 h-6 flex items-center justify-center rounded-full bg-gray-100 dark:bg-gray-700 hover:bg-accent hover:text-white text-gray-500 dark:text-gray-400 transition-colors text-sm font-bold"
                  title="담당자 추가">+</button>
        </div>
        <div x-show="showAssignMenu" @click.outside="showAssignMenu = false"
             class="mb-3 rounded-lg border border-gray-200 dark:border-gray-600 overflow-hidden">
          <% unassigned_employees = Employee.active.where.not(id: order.assignee_ids).by_name %>
          <% if unassigned_employees.any? %>
            <% unassigned_employees.each do |emp| %>
              <%= form_with url: order_assignments_path(order), method: :post, local: true do |f| %>
                <%= f.hidden_field :employee_id, value: emp.id %>
                <button type="submit"
                        class="w-full flex items-center gap-2 px-3 py-2 text-xs text-gray-700 dark:text-gray-300 hover:bg-blue-50 dark:hover:bg-blue-900/30 transition-colors text-left">
                  <div class="w-6 h-6 rounded-full bg-primary text-white text-xs flex items-center justify-center font-bold shrink-0"><%= emp.initials %></div>
                  <span><%= emp.display_name %></span>
                  <span class="ml-auto text-gray-400 text-xs"><%= emp.employment_type_label %></span>
                </button>
              <% end %>
            <% end %>
          <% else %>
            <p class="px-3 py-2 text-xs text-gray-400 dark:text-gray-500">모든 팀원이 배정됨</p>
          <% end %>
        </div>
        <% if order.assignees.any? %>
          <div class="space-y-1">
            <% order.assignments.includes(:employee).each do |assignment| %>
              <% next unless assignment.employee %>
              <div class="flex items-center gap-2 group">
                <div class="w-7 h-7 rounded-full bg-primary text-white text-xs flex items-center justify-center font-bold shrink-0"><%= assignment.employee.initials %></div>
                <div class="min-w-0 flex-1">
                  <p class="text-sm font-medium text-gray-900 dark:text-white truncate"><%= assignment.employee.display_name %></p>
                  <p class="text-xs text-gray-400 dark:text-gray-500"><%= assignment.employee.employment_type_label %></p>
                </div>
                <%= form_with url: order_assignment_path(order, assignment), method: :delete, local: true do |f| %>
                  <button type="submit"
                          class="opacity-0 group-hover:opacity-100 w-5 h-5 flex items-center justify-center rounded-full text-gray-400 hover:bg-red-100 hover:text-red-500 dark:hover:bg-red-900/30 transition-all text-xs"
                          title="담당자 제거"
                          onclick="return confirm('<%= assignment.employee.display_name %>을(를) 담당자에서 제거할까요?')">✕</button>
                <% end %>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="text-xs text-gray-400 dark:text-gray-500">배정된 담당자 없음</p>
        <% end %>
      </div>

      <%# 스테이지 이동 — 이전/현재/다음 + 더보기 %>
      <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-4">
        <h4 class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide mb-3">스테이지 이동</h4>
        <%
          columns = Order::KANBAN_COLUMNS
          current_idx = columns.index(order.status) || 0
          # 이전/현재/다음 3개만 기본 표시
          visible_range = ([current_idx - 1, 0].max..[current_idx + 1, columns.size - 1].min)
        %>
        <div class="space-y-1">
          <% columns.each_with_index do |status, idx| %>
            <% is_current = order.status == status %>
            <% is_visible = visible_range.include?(idx) %>
            <%= form_with url: move_status_order_path(order), method: :patch,
                html: { class: "#{'hidden' unless is_visible}", data: { stage_item: true } } do |f| %>
              <%= f.hidden_field :status, value: status %>
              <%= f.submit Order::STATUS_LABELS[status],
                  disabled: is_current,
                  class: "w-full text-left text-xs py-1.5 px-2.5 rounded-lg cursor-pointer transition-colors #{is_current ? 'bg-accent text-white font-semibold' : 'bg-gray-50 dark:bg-gray-700 text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-600 disabled:cursor-default'}" %>
            <% end %>
          <% end %>
          <% if columns.size > 3 %>
            <button type="button"
                    onclick="this.parentElement.querySelectorAll('[data-stage-item]').forEach(el => el.classList.remove('hidden')); this.remove();"
                    class="w-full text-center text-xs py-1.5 text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 transition-colors">
              전체 단계 보기 (<%= columns.size %>개)
            </button>
          <% end %>
        </div>
      </div>
    </div>

    <%# ── 3. 이메일 원문 (있을 때만) ─────────────────────────── %>
    <% if order.original_email_body.present? %>
      <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 overflow-hidden">
        <div class="flex items-center justify-between px-5 py-3 border-b border-gray-100 dark:border-gray-700 bg-gray-50 dark:bg-gray-700/50">
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-gray-400 dark:text-gray-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            <span class="text-xs font-semibold text-gray-700 dark:text-gray-300">원본 이메일</span>
          </div>
          <span class="text-xs text-gray-400 dark:text-gray-500"><%= order.original_email_from %></span>
        </div>
        <div class="p-5">
          <% if order.original_email_subject.present? %>
            <p class="text-sm font-medium text-gray-900 dark:text-white mb-3"><% if order.reference_no.present? %><span class="text-[10px] px-1 py-0.5 bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-400 rounded font-mono mr-1"><%= order.reference_no %></span><% end %><%= order.display_subject %><% order.subject_tags.each do |tag| %><span class="text-[10px] px-1 py-0.5 bg-amber-100 dark:bg-amber-900/30 text-amber-700 dark:text-amber-400 rounded ml-1"><%= tag %></span><% end %></p>
          <% end %>
          <div class="text-xs text-gray-600 dark:text-gray-400 leading-relaxed whitespace-pre-wrap font-mono bg-gray-50 dark:bg-gray-700/50 rounded-lg p-4 max-h-48 overflow-y-auto border border-gray-100 dark:border-gray-700">
            <%= order.original_email_body %>
          </div>
        </div>
      </div>
    <% end %>

    <div class="h-4"></div>
  </div>

  <%# ══════════════════════════════════════════════════════════
      탭 패널 2: 태스크
  ══════════════════════════════════════════════════════════ %>
  <div id="drawer-panel-<%= order.id %>-tasks" class="p-6 hidden">
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-5">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-sm font-semibold text-gray-900 dark:text-white flex items-center gap-2">
          <svg class="w-4 h-4 text-gray-400 dark:text-gray-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
          태스크
        </h3>
      </div>
      <%= render "tasks/progress", order: order %>
      <div id="task-list-<%= order.id %>" class="space-y-1 mb-4">
        <% tasks.each do |task| %>
          <%= render "tasks/task", task: task, order: order %>
        <% end %>
        <% if tasks.empty? %>
          <p class="text-xs text-gray-400 dark:text-gray-500 px-3 py-2">태스크가 없습니다</p>
        <% end %>
      </div>
      <%= render "tasks/add_form", order: order %>
    </div>
    <div class="h-4"></div>
  </div>

  <%# ══════════════════════════════════════════════════════════
      탭 패널 3: 코멘트
  ══════════════════════════════════════════════════════════ %>
  <div id="drawer-panel-<%= order.id %>-comments" class="p-6 hidden">
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-5">
      <h3 class="text-sm font-semibold text-gray-900 dark:text-white flex items-center gap-2 mb-4">
        <svg class="w-4 h-4 text-gray-400 dark:text-gray-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        코멘트
        <% if comments.any? %>
          <span class="text-xs bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-400 px-1.5 py-0.5 rounded-full"><%= comments.count %></span>
        <% end %>
      </h3>
      <div id="comments-<%= order.id %>" class="space-y-4 mb-5">
        <% if comments.any? %>
          <% comments.each do |comment| %>
            <%= render "comments/comment", comment: comment %>
          <% end %>
        <% else %>
          <div class="flex items-center justify-center py-6 text-center">
            <div>
              <svg class="w-8 h-8 text-gray-200 dark:text-gray-600 mx-auto mb-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
              <p class="text-xs text-gray-400 dark:text-gray-500">아직 코멘트가 없습니다</p>
            </div>
          </div>
        <% end %>
      </div>
      <%= render "comments/form", order: order %>
    </div>
    <div class="h-4"></div>
  </div>

  <%# ══════════════════════════════════════════════════════════
      탭 패널 4: 첨부파일
  ══════════════════════════════════════════════════════════ %>
  <div id="drawer-panel-<%= order.id %>-attachments" class="p-6 hidden">
    <% att_meta = order.respond_to?(:attachment_urls) && order.attachment_urls.present? ? (JSON.parse(order.attachment_urls) rescue []) : [] %>
    <% active_storage_attachments = order.respond_to?(:attachments) ? (order.attachments rescue []) : [] %>
    <% links = order.respond_to?(:extracted_links) && order.extracted_links.present? ? (JSON.parse(order.extracted_links) rescue []) : [] %>

    <% if att_meta.any? || active_storage_attachments.any? || links.any? %>
      <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 overflow-hidden">
        <div class="px-5 py-3 border-b border-gray-100 dark:border-gray-700 flex items-center justify-between">
          <h3 class="text-sm font-semibold text-gray-900 dark:text-white flex items-center gap-2">
            <svg class="w-4 h-4 text-gray-400 dark:text-gray-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg>
            첨부파일 및 링크
          </h3>
          <% total_att = [att_meta.size, active_storage_attachments.size].max + links.size %>
          <span class="text-xs text-gray-400 dark:text-gray-500"><%= total_att %>개</span>
        </div>
        <div class="px-5 py-4 space-y-2">
          <%# ActiveStorage 첨부파일 %>
          <% active_storage_attachments.each do |att| %>
            <% blob = att.blob %>
            <% is_pdf = blob.content_type.to_s.include?("pdf") %>
            <% is_image = blob.content_type.to_s.start_with?("image/") %>
            <% is_html = blob.content_type.to_s.include?("html") || (blob.filename.to_s.end_with?(".doc") && blob.content_type.to_s.include?("html")) %>
            <% is_excel = blob.content_type.to_s.include?("spreadsheet") || blob.content_type.to_s.include?("excel") || blob.filename.to_s.match?(/\.xlsx?\z/i) %>
            <% is_viewable = is_pdf || is_image || is_html || is_excel %>
            <% preview_url = attachment_preview_order_path(order, blob_id: blob.id) %>
            <% icon_color = is_pdf ? "text-red-500" : is_excel ? "text-green-600" : is_image ? "text-purple-500" : is_html ? "text-blue-500" : "text-gray-500" %>
            <div class="relative flex items-center gap-2.5 p-2.5 rounded-lg border border-gray-200 dark:border-gray-700 hover:bg-blue-50 dark:hover:bg-blue-900/20 transition-colors group cursor-pointer"
                 <% if is_viewable %>onclick="openPreviewModal('<%= j(blob.filename.to_s) %>', '<%= j(preview_url) %>')"<% end %>>
              <% unless is_viewable %>
                <a href="<%= rails_blob_path(blob, disposition: "attachment") %>" class="absolute inset-0 z-0 rounded-lg"></a>
              <% end %>
              <svg class="w-8 h-8 p-1.5 rounded bg-gray-100 dark:bg-gray-700 <%= icon_color %> flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
              <div class="flex-1 min-w-0">
                <p class="text-xs font-medium text-gray-800 dark:text-gray-200 truncate"><%= blob.filename %></p>
                <p class="text-xs text-gray-400 dark:text-gray-500">
                  <% if is_html %>
                    <span class="text-blue-500">HTML 보고서</span> ·
                  <% elsif is_excel %>
                    <span class="text-green-600">Excel</span> ·
                  <% else %>
                    <%= blob.content_type&.split("/")&.last&.upcase %> ·
                  <% end %>
                  <%= number_to_human_size(blob.byte_size) %>
                  <% if is_viewable %>
                    · <span class="text-blue-500">클릭하여 미리보기</span>
                  <% end %>
                </p>
              </div>
              <% if is_viewable %>
                <span class="relative z-10 p-1.5 rounded hover:bg-blue-100 dark:hover:bg-blue-900/40 transition-colors" title="미리보기">
                  <svg class="w-3.5 h-3.5 text-blue-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                </span>
              <% end %>
              <a href="<%= rails_blob_path(blob, disposition: "attachment") %>" class="relative z-10 p-1.5 rounded hover:bg-gray-200 dark:hover:bg-gray-600 transition-colors" title="다운로드" onclick="event.stopPropagation()">
                <svg class="w-3.5 h-3.5 text-gray-400 group-hover:text-blue-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              </a>
            </div>
          <% end %>

          <%# attachment_urls 메타만 있는 경우 (레거시) %>
          <% if active_storage_attachments.empty? %>
            <% att_meta.each do |att| %>
              <% att = att.is_a?(Hash) ? att.with_indifferent_access : {} %>
              <% icon_color = att[:mime_type].to_s.include?("pdf") ? "text-red-500" : att[:mime_type].to_s.include?("sheet") || att[:mime_type].to_s.include?("excel") ? "text-green-600" : "text-blue-500" %>
              <div class="flex items-center gap-2.5 p-2.5 rounded-lg border border-gray-200 dark:border-gray-700 opacity-60">
                <svg class="w-8 h-8 p-1.5 rounded bg-gray-100 dark:bg-gray-700 <%= icon_color %> flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                <div class="flex-1 min-w-0">
                  <p class="text-xs font-medium text-gray-800 dark:text-gray-200 truncate"><%= att[:filename] %></p>
                  <p class="text-xs text-gray-400 dark:text-gray-500">
                    <%= att[:mime_type]&.split("/")&.last&.upcase %>
                    <% if att[:size] %> · <%= number_to_human_size(att[:size]) %><% end %>
                    · 재동기화 필요
                  </p>
                </div>
              </div>
            <% end %>
          <% end %>

          <%# 링크 %>
          <% sap_links_json = order.respond_to?(:sap_portal_links) && order.sap_portal_links.present? ? order.sap_portal_links.to_s : "[]" %>
          <% sap_urls = (JSON.parse(sap_links_json) rescue []) %>
          <% if sap_urls.any? %>
            <div class="mt-1 mb-2">
              <p class="text-xs font-semibold text-orange-600 dark:text-orange-400 mb-1.5 flex items-center gap-1">
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                SAP / Ariba Portal Links
              </p>
              <% sap_urls.each do |sap_url| %>
                <div class="flex items-center gap-2 p-2 rounded-lg border border-orange-200 dark:border-orange-800/50 bg-orange-50 dark:bg-orange-900/10 mb-1">
                  <svg class="w-4 h-4 text-orange-500 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
                  <a href="<%= sap_url %>" target="_blank" rel="noopener noreferrer" class="flex-1 text-xs text-orange-700 dark:text-orange-300 hover:underline truncate"><%= sap_url.truncate(60) %></a>
                </div>
              <% end %>
            </div>
          <% end %>

          <% links.reject { |u| sap_urls.include?(u) }.each do |url| %>
            <a href="<%= url %>" target="_blank" rel="noopener noreferrer"
               class="flex items-center gap-2 p-2 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors group">
              <svg class="w-4 h-4 text-blue-500 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
              <span class="text-xs text-blue-500 hover:underline truncate"><%= url.truncate(60) %></span>
            </a>
          <% end %>
        </div>
      </div>
    <% else %>
      <div class="p-12 text-center">
        <svg class="w-10 h-10 mx-auto text-gray-200 dark:text-gray-600 mb-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg>
        <p class="text-sm text-gray-400 dark:text-gray-500">첨부파일이 없습니다</p>
      </div>
    <% end %>
    <div class="h-4"></div>
  </div>

  <%# ══════════════════════════════════════════════════════════
      탭 패널 5: 히스토리
  ══════════════════════════════════════════════════════════ %>
  <div id="drawer-panel-<%= order.id %>-history" class="p-6 hidden">
    <%# 관련 메일 스레드 (동일 발주번호) %>
    <% if order.reference_no.present? && thread_orders.any? %>
      <div class="bg-white dark:bg-gray-800 rounded-xl border border-blue-100 dark:border-blue-900/40 p-5 mb-4">
        <h3 class="text-sm font-semibold text-gray-900 dark:text-white flex items-center gap-2 mb-4">
          <svg class="w-4 h-4 text-blue-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          관련 메일 스레드
          <span class="ml-1 text-[11px] font-mono bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-400 px-2 py-0.5 rounded">
            <%= order.reference_no %>
          </span>
          <span class="ml-auto text-[11px] text-gray-400 dark:text-gray-500 font-normal">
            총 <%= thread_orders.size + 1 %>건
          </span>
        </h3>
        <% t_status_colors = {
          "new_rfq"        => "bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-400",
          "make_quo"       => "bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-400",
          "pending_po"     => "bg-purple-100 dark:bg-purple-900/40 text-purple-700 dark:text-purple-400",
          "new_po"         => "bg-indigo-100 dark:bg-indigo-900/40 text-indigo-700 dark:text-indigo-400",
          "delivery_items" => "bg-yellow-100 dark:bg-yellow-900/40 text-yellow-700 dark:text-yellow-400",
          "problem"        => "bg-orange-100 dark:bg-orange-900/40 text-orange-700 dark:text-orange-400",
          "get_grn"        => "bg-green-100 dark:bg-green-900/40 text-green-700 dark:text-green-400",
          "give_up"        => "bg-gray-200 dark:bg-gray-800 text-gray-500 dark:text-gray-500"
        } %>
        <% all_thread = [order] + thread_orders.sort_by(&:created_at) %>
        <div class="space-y-0 divide-y divide-gray-100 dark:divide-gray-700" id="thread-accordion-<%= order.id %>">
          <% all_thread.each do |t_order| %>
            <% is_current = (t_order.id == order.id) %>
            <% thread_item_id = "thread-item-#{order.id}-#{t_order.id}" %>
            <div>
              <button type="button"
                      onclick="toggleThreadEmail('<%= order.id %>', '<%= t_order.id %>')"
                      class="w-full flex items-center gap-3 py-2.5 hover:bg-gray-50 dark:hover:bg-gray-700/30 -mx-1 px-1 rounded transition-colors text-left">
                <span class="w-1.5 h-1.5 rounded-full <%= is_current ? 'bg-blue-500' : 'bg-gray-300 dark:bg-gray-600' %> flex-shrink-0"></span>
                <span class="text-[11px] text-gray-400 dark:text-gray-500 flex-shrink-0 w-14">
                  <%= t_order.created_at.strftime("%m/%d") %>
                </span>
                <span class="text-xs text-gray-600 dark:text-gray-400 truncate flex-1 <%= 'font-medium' if is_current %>">
                  <%= t_order.display_subject %>
                </span>
                <% if is_current %>
                  <span class="text-[10px] px-1.5 py-0.5 rounded bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-400 font-medium flex-shrink-0">현재</span>
                <% else %>
                  <span class="text-[10px] px-1.5 py-0.5 rounded <%= t_status_colors[t_order.status] || 'bg-gray-100 text-gray-500' %> font-medium flex-shrink-0">
                    <%= Order::STATUS_LABELS[t_order.status] || t_order.status.humanize %>
                  </span>
                <% end %>
                <svg id="<%= thread_item_id %>-chevron" class="w-3.5 h-3.5 text-gray-400 transition-transform flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
              </button>
              <%# 이메일 본문 (접혀있음) %>
              <div id="<%= thread_item_id %>-body" class="hidden">
                <div class="ml-5 mr-1 mb-3 p-4 bg-gray-50 dark:bg-gray-700/30 rounded-lg border border-gray-100 dark:border-gray-700">
                  <%# 보낸 사람 / 받는 사람 %>
                  <div class="flex flex-wrap gap-x-4 gap-y-1 text-[11px] text-gray-500 dark:text-gray-400 mb-3 pb-2 border-b border-gray-100 dark:border-gray-600">
                    <% if t_order.respond_to?(:sender_email) && t_order.sender_email.present? %>
                      <span><strong>From:</strong> <%= t_order.sender_name.presence || t_order.sender_email %></span>
                    <% end %>
                    <span><strong>Date:</strong> <%= t_order.created_at.strftime("%Y/%m/%d %H:%M") %></span>
                  </div>
                  <%# HTML 본문 우선, 없으면 텍스트 본문 %>
                  <% if t_order.original_email_html_body.present? %>
                    <div class="prose prose-xs dark:prose-invert max-w-none text-xs leading-relaxed overflow-auto max-h-96
                                [&_table]:text-[11px] [&_td]:p-1 [&_th]:p-1 [&_img]:max-w-full">
                      <%= sanitize(t_order.original_email_html_body, tags: %w[p br div span table tr td th thead tbody a img b strong i em u ul ol li h1 h2 h3 h4 h5 h6 hr blockquote pre code], attributes: %w[href src alt style class width height colspan rowspan]) %>
                    </div>
                  <% elsif t_order.original_email_body.present? %>
                    <div class="text-xs text-gray-700 dark:text-gray-300 whitespace-pre-wrap leading-relaxed max-h-96 overflow-auto">
                      <%= t_order.original_email_body %>
                    </div>
                  <% else %>
                    <p class="text-xs text-gray-400 dark:text-gray-500 italic">이메일 본문이 없습니다</p>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <% if activities.any? %>
      <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-5">
        <h3 class="text-sm font-semibold text-gray-900 dark:text-white flex items-center gap-2 mb-5">
          <svg class="w-4 h-4 text-gray-400 dark:text-gray-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
          활동 기록
        </h3>
        <div class="relative pl-5">
          <div class="absolute left-[7px] top-1 bottom-1 w-px bg-gray-100 dark:bg-gray-700"></div>
          <% activities.first(15).each do |act| %>
            <%
              icon_svg, dot_color = case act.action
              when "status_changed"
                ['<polyline points="9 18 15 12 9 6"/>', "bg-accent"]
              when "comment_added"
                ['<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>', "bg-gray-400 dark:bg-gray-500"]
              when "task_completed"
                ['<polyline points="20 6 9 17 4 12"/>', "bg-green-400"]
              when "created"
                ['<line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>', "bg-primary"]
              else
                ['<circle cx="12" cy="12" r="4"/>', "bg-gray-300"]
              end
            %>
            <div class="relative flex gap-3 mb-4 last:mb-0">
              <div class="w-3.5 h-3.5 rounded-full <%= dot_color %> shrink-0 mt-0.5 z-10 flex items-center justify-center">
                <svg class="w-2 h-2 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><%= icon_svg.html_safe %></svg>
              </div>
              <div class="flex-1 min-w-0 -mt-0.5">
                <div class="flex flex-wrap items-center gap-1.5 text-xs">
                  <span class="font-semibold text-gray-800 dark:text-gray-200"><%= act.user.display_name %></span>
                  <% case act.action %>
                  <% when "status_changed" %>
                    <span class="text-gray-500 dark:text-gray-400">상태 변경</span>
                    <% if act.from_label && act.to_label %>
                      <span class="px-1.5 py-0.5 rounded bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-400"><%= act.from_label %></span>
                      <svg class="w-3 h-3 text-gray-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
                      <span class="px-1.5 py-0.5 rounded bg-accent/10 text-accent font-medium"><%= act.to_label %></span>
                    <% end %>
                  <% when "comment_added" %>
                    <span class="text-gray-500 dark:text-gray-400">코멘트 작성</span>
                  <% when "task_completed" %>
                    <span class="text-gray-500 dark:text-gray-400">태스크 완료</span>
                  <% when "created" %>
                    <span class="text-gray-500 dark:text-gray-400">오더 생성</span>
                  <% else %>
                    <span class="text-gray-500 dark:text-gray-400"><%= act.action.humanize.downcase %></span>
                  <% end %>
                </div>
                <span class="text-xs text-gray-400 dark:text-gray-500 mt-0.5 block"><%= act.created_at.strftime("%Y/%m/%d %H:%M") %></span>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% else %>
      <div class="p-12 text-center">
        <svg class="w-10 h-10 mx-auto text-gray-200 dark:text-gray-600 mb-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
        <p class="text-sm text-gray-400 dark:text-gray-500">활동 기록이 없습니다</p>
      </div>
    <% end %>
    <div class="h-4"></div>
  </div>

</div>

<%# switchDrawerTab / togglePriorityDropdown 은 layouts/application.html.erb 전역 정의 %>
