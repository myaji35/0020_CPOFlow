<% content_for :title, t("team.page_title") %>

<div class="flex flex-col gap-6">
  <%# Header %>
  <div class="flex items-center justify-between flex-wrap gap-3">
    <div>
      <h1 class="text-2xl font-bold text-gray-900 dark:text-white"><%= t("team.page_title") %></h1>
      <p class="text-sm text-gray-500 dark:text-gray-500 mt-1"><%= t("team.page_subtitle") %></p>
    </div>

    <%# FR-02: Branch 탭 필터 %>
    <div class="flex gap-1">
      <% [[t("team.branch_all"), nil], [t("team.branch_abu_dhabi"), 'abu_dhabi'], [t("team.branch_seoul"), 'seoul']].each do |label, val| %>
        <% is_active = params[:branch].to_s == val.to_s || (val.nil? && params[:branch].blank?) %>
        <%= link_to label,
              team_index_path(branch: val),
              class: "px-3 py-1.5 text-sm rounded-lg font-medium transition-colors " +
                     (is_active ? "bg-primary text-white" :
                                  "bg-white dark:bg-gray-800 text-gray-600 dark:text-gray-300 border border-gray-200 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700") %>
      <% end %>
    </div>
  </div>

  <%# 팀 전체 KPI 대시보드 %>
  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-4 text-center">
      <p class="text-2xl font-bold text-gray-900 dark:text-white"><%= @summary[:total_members] %></p>
      <p class="text-xs text-gray-500 dark:text-gray-500 mt-1"><%= t("team.kpi.total_members") %></p>
    </div>
    <div class="bg-blue-50 dark:bg-blue-900/20 rounded-xl border border-blue-200 dark:border-blue-800 p-4 text-center">
      <p class="text-2xl font-bold text-blue-600 dark:text-blue-400"><%= @summary[:total_active] %></p>
      <p class="text-xs text-blue-500 dark:text-blue-400 mt-1"><%= t("team.kpi.total_active") %></p>
    </div>
    <div class="bg-indigo-50 dark:bg-indigo-900/20 rounded-xl border border-indigo-200 dark:border-indigo-800 p-4 text-center">
      <p class="text-2xl font-bold text-indigo-600 dark:text-indigo-400"><%= @summary[:avg_per_member] %></p>
      <p class="text-xs text-indigo-500 dark:text-indigo-400 mt-1"><%= t("team.kpi.avg_per_member") %></p>
    </div>
    <div class="bg-red-50 dark:bg-red-900/20 rounded-xl border border-red-200 dark:border-red-800 p-4 text-center">
      <p class="text-2xl font-bold text-red-600 dark:text-red-400"><%= @summary[:total_overdue] %></p>
      <p class="text-xs text-red-500 dark:text-red-400 mt-1"><%= t("team.kpi.total_overdue") %></p>
    </div>
    <div class="bg-amber-50 dark:bg-amber-900/20 rounded-xl border border-amber-200 dark:border-amber-800 p-4 text-center">
      <p class="text-2xl font-bold text-amber-600 dark:text-amber-400"><%= @summary[:overdue_rate] %>%</p>
      <p class="text-xs text-amber-500 dark:text-amber-400 mt-1"><%= t("team.kpi.overdue_rate") %></p>
    </div>
    <div class="bg-orange-50 dark:bg-orange-900/20 rounded-xl border border-orange-200 dark:border-orange-800 p-4 text-center">
      <p class="text-2xl font-bold text-orange-600 dark:text-orange-400"><%= @summary[:overloaded] %></p>
      <p class="text-xs text-orange-500 dark:text-orange-400 mt-1"><%= t("team.kpi.overloaded") %></p>
    </div>
  </div>

  <%# FR-02: 워크로드 카드 그리드 %>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    <% @workloads.each do |w| %>
      <% user = w[:user] %>
      <% is_overloaded = w[:active_orders] >= 8 %>
      <%
        today = Date.today
        if w[:nearest_due]
          days    = (w[:nearest_due] - today).to_i
          d_label = days < 0  ? "D+#{days.abs}" :
                    days == 0 ? 'D-Day'          : "D-#{days}"
          d_color = days < 0  ? 'bg-red-600 text-white dark:bg-red-700' :
                    days <= 7 ? 'bg-orange-500 text-white dark:bg-orange-600' :
                                'bg-green-600 text-white dark:bg-green-700'
        end
      %>
      <div class="bg-white dark:bg-gray-800 rounded-xl border p-5 transition-all
                  <%= is_overloaded ? 'border-red-300 dark:border-red-700' : 'border-gray-200 dark:border-gray-700' %>">

        <%# 이름 영역 + 과부하/D-day 배지 %>
        <div class="flex items-start justify-between mb-4">
          <div class="flex items-center gap-3 min-w-0">
            <%= link_to team_path(user), class: "flex items-center gap-3 min-w-0 hover:opacity-80 transition-opacity" do %>
              <div class="w-10 h-10 rounded-full bg-primary/10 dark:bg-primary/20 flex items-center justify-center text-primary font-bold text-lg flex-shrink-0">
                <%= user.initials %>
              </div>
              <div class="min-w-0">
                <p class="font-semibold text-gray-900 dark:text-white truncate"><%= user.display_name %></p>
                <div class="flex items-center gap-2 mt-0.5">
                  <span class="text-xs px-2 py-0.5 rounded-full
                    <%= user.role == 'admin'   ? 'bg-purple-100 dark:bg-purple-900/30 text-purple-700 dark:text-purple-400' :
                        user.role == 'manager' ? 'bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-400'   :
                                                 'bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-500' %>">
                    <%= { 'admin' => t("team.card.role_admin"), 'manager' => t("team.card.role_manager"), 'member' => t("team.card.role_member"), 'viewer' => t("team.card.role_viewer") }[user.role] || user.role %>
                  </span>
                  <% if user.branch.present? %>
                    <span class="text-xs text-gray-500 dark:text-gray-500">
                      <%= user.branch == 'abu_dhabi' ? t("team.branch_abu_dhabi") : t("team.branch_seoul") %>
                    </span>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>

          <%# FR-01: 과부하 + D-day 배지 묶음 %>
          <div class="flex flex-col items-end gap-1 shrink-0">
            <% if is_overloaded %>
              <span class="text-xs font-semibold bg-red-100 dark:bg-red-900/30 text-red-600 dark:text-red-400 px-2 py-0.5 rounded-full">
                <%= t("team.card.overloaded_badge") %>
              </span>
            <% end %>
            <% if w[:nearest_due] %>
              <span class="text-xs font-semibold px-2 py-0.5 rounded-full <%= d_color %>"><%= d_label %></span>
            <% end %>
          </div>
        </div>

        <%# 4개 숫자 카드 %>
        <div class="grid grid-cols-4 gap-2">
          <div class="bg-gray-50 dark:bg-gray-700/50 rounded-lg p-2 text-center">
            <p class="text-xl font-bold text-gray-900 dark:text-white"><%= w[:active_orders] %></p>
            <p class="text-xs text-gray-500 dark:text-gray-500 mt-0.5"><%= t("team.card.active") %></p>
          </div>
          <div class="bg-red-50 dark:bg-red-900/20 rounded-lg p-2 text-center">
            <p class="text-xl font-bold text-red-600 dark:text-red-400"><%= w[:overdue_orders] %></p>
            <p class="text-xs text-red-500 dark:text-red-400 mt-0.5"><%= t("team.card.overdue") %></p>
          </div>
          <div class="bg-orange-50 dark:bg-orange-900/20 rounded-lg p-2 text-center">
            <p class="text-xl font-bold text-orange-600 dark:text-orange-400"><%= w[:urgent_orders] %></p>
            <p class="text-xs text-orange-500 dark:text-orange-400 mt-0.5"><%= t("team.card.due_7days") %></p>
          </div>
          <div class="bg-gray-50 dark:bg-gray-700/50 rounded-lg p-2 text-center">
            <p class="text-xl font-bold text-gray-900 dark:text-white"><%= w[:tasks_pending] %></p>
            <p class="text-xs text-gray-500 dark:text-gray-500 mt-0.5"><%= t("team.card.tasks") %></p>
          </div>
        </div>

        <%# 워크로드 바 %>
        <% load_pct = [[w[:active_orders] * 10, 100].min, 0].max %>
        <div class="mt-4">
          <div class="flex justify-between text-xs text-gray-500 dark:text-gray-500 mb-1">
            <span><%= t("team.card.workload") %></span>
            <span><%= load_pct %>%</span>
          </div>
          <div class="w-full h-1.5 bg-gray-100 dark:bg-gray-700 rounded-full overflow-hidden">
            <div class="h-full rounded-full transition-all
                        <%= w[:active_orders] >= 8 ? 'bg-red-400' : w[:active_orders] >= 5 ? 'bg-orange-400' : 'bg-green-400' %>"
                 style="width: <%= load_pct %>%"></div>
          </div>
        </div>

        <%# FR-03: Admin Role 드롭다운 %>
        <% if current_user.admin? %>
          <div class="mt-3 pt-3 border-t border-gray-200 dark:border-gray-700 flex items-center justify-between">
            <span class="text-xs text-gray-500 dark:text-gray-500"><%= t("team.card.change_role") %></span>
            <%= form_with url: update_role_team_path(user), method: :patch, local: true do |f| %>
              <%= f.select :role,
                    [[t("team.card.role_viewer"), 'viewer'], [t("team.card.role_member"), 'member'], [t("team.card.role_manager"), 'manager'], [t("team.card.role_admin"), 'admin']],
                    { selected: user.role },
                    { class:    "text-xs border border-gray-200 dark:border-gray-600 rounded px-1.5 py-0.5 " \
                                "bg-white dark:bg-gray-700 text-gray-700 dark:text-gray-300 cursor-pointer",
                      onchange: "this.form.requestSubmit()" } %>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

  <% if @members.empty? %>
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-12 text-center">
      <svg class="w-12 h-12 mx-auto text-gray-200 dark:text-gray-600 mb-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
      <p class="text-sm text-gray-500 dark:text-gray-500"><%= t("team.empty.no_members") %></p>
    </div>
  <% end %>

  <%# ISS-218: 팀원 × 주별 작업 부하 히트맵 (최근 8주) %>
  <% if @heatmap_data.any? && @heatmap_max > 0 %>
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-5">
      <div class="flex items-center justify-between mb-4">
        <div>
          <h2 class="text-sm font-semibold text-gray-900 dark:text-white"><%= t("team.heatmap.title") %></h2>
          <p class="text-xs text-gray-500 dark:text-gray-500 mt-0.5"><%= t("team.heatmap.subtitle") %></p>
        </div>
        <div class="flex items-center gap-1 text-[10px] text-gray-500 dark:text-gray-500">
          <span><%= t("team.heatmap.legend_low") %></span>
          <% [ 0.1, 0.3, 0.5, 0.7, 1.0 ].each do |alpha| %>
            <span class="w-3 h-3 rounded-sm" style="background-color: rgba(0, 161, 224, <%= alpha %>);"></span>
          <% end %>
          <span><%= t("team.heatmap.legend_high") %></span>
        </div>
      </div>

      <div class="overflow-x-auto">
        <table class="text-xs w-full">
          <thead>
            <tr class="text-gray-500 dark:text-gray-400">
              <th class="text-left py-2 pr-3 font-semibold whitespace-nowrap min-w-[140px]"><%= t("team.heatmap.col_member") %></th>
              <% @heatmap_weeks.each do |w| %>
                <th class="text-center py-2 px-1 font-medium min-w-[48px]"><%= w[:label] %></th>
              <% end %>
              <th class="text-right py-2 pl-3 font-semibold whitespace-nowrap"><%= t("team.heatmap.col_total") %></th>
              <th class="text-right py-2 pl-2 font-medium text-gray-400 whitespace-nowrap"><%= t("team.heatmap.col_avg") %></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 dark:divide-gray-700">
            <% @heatmap_data.each do |row| %>
              <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/30">
                <td class="py-2 pr-3 text-gray-900 dark:text-white font-medium truncate">
                  <%= link_to row[:user].display_name, team_path(row[:user]),
                        class: "hover:text-[#00A1E0]" %>
                  <% if row[:user].branch.present? %>
                    <span class="text-[10px] text-gray-400 ml-1"><%= row[:user].branch %></span>
                  <% end %>
                </td>
                <% row[:weekly_counts].each_with_index do |c, i| %>
                  <% intensity = (c.to_f / @heatmap_max).clamp(0.0, 1.0) %>
                  <% bg = c == 0 ? "transparent" : "rgba(0, 161, 224, #{(0.15 + intensity * 0.75).round(2)})" %>
                  <% text_color = intensity > 0.6 ? "text-white" : "text-gray-700 dark:text-gray-300" %>
                  <td class="text-center py-1 px-1">
                    <div class="h-7 flex items-center justify-center rounded <%= text_color %>"
                         style="background-color: <%= bg %>;"
                         title="<%= @heatmap_weeks[i][:start].strftime('%Y-%m-%d') %> — <%= t('team.heatmap.cell_count', count: c) %>">
                      <%= c if c > 0 %>
                    </div>
                  </td>
                <% end %>
                <td class="text-right py-2 pl-3 font-bold text-gray-900 dark:text-white tabular-nums"><%= row[:total] %></td>
                <td class="text-right py-2 pl-2 text-gray-500 tabular-nums"><%= row[:avg] %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <% if @heatmap_data.size > 10 %>
        <p class="text-[11px] text-gray-500 mt-3"><%= t("team.heatmap.tip_redistribute") %></p>
      <% end %>
    </div>
  <% end %>

  <%# 담당자별 주문 분포 차트 %>
  <% if @member_order_dist.any? %>
    <% dist_max = [@member_order_dist.map { |d| d[:active] }.max || 1, 1].max %>
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-5">
      <h2 class="text-sm font-semibold text-gray-900 dark:text-white mb-4"><%= t("team.dist.title") %></h2>
      <div class="space-y-3">
        <% @member_order_dist.each do |d| %>
          <div class="flex items-center gap-3">
            <span class="text-xs text-gray-600 dark:text-gray-400 w-20 truncate text-right flex-shrink-0"><%= d[:name] %></span>
            <div class="flex-1 flex items-center gap-1 h-6">
              <% active_w = (d[:active].to_f / dist_max * 100).round(1) %>
              <% overdue_w = d[:overdue] > 0 ? (d[:overdue].to_f / dist_max * 100).round(1) : 0 %>
              <% safe_w = [(active_w - overdue_w), 0].max %>
              <% if d[:overdue] > 0 %>
                <div class="h-5 rounded-l bg-red-400 dark:bg-red-500" style="width: <%= overdue_w %>%; min-width: 4px;" title="<%= t('team.dist.tip_overdue', count: d[:overdue]) %>"></div>
                <div class="h-5 <%= safe_w > 0 ? 'rounded-r' : '' %> bg-blue-400 dark:bg-blue-500" style="width: <%= safe_w %>%;" title="<%= t('team.dist.tip_active', count: d[:active] - d[:overdue]) %>"></div>
              <% else %>
                <div class="h-5 rounded bg-blue-400 dark:bg-blue-500" style="width: <%= active_w %>%; min-width: 4px;" title="<%= t('team.dist.tip_active', count: d[:active]) %>"></div>
              <% end %>
            </div>
            <span class="text-xs font-semibold text-gray-700 dark:text-gray-300 w-8 text-right flex-shrink-0"><%= d[:active] %></span>
          </div>
        <% end %>
      </div>
      <div class="flex items-center gap-4 mt-4 pt-3 border-t border-gray-100 dark:border-gray-700">
        <div class="flex items-center gap-1.5">
          <div class="w-3 h-3 rounded-sm bg-blue-400 dark:bg-blue-500"></div>
          <span class="text-xs text-gray-500 dark:text-gray-500"><%= t("team.dist.legend_active") %></span>
        </div>
        <div class="flex items-center gap-1.5">
          <div class="w-3 h-3 rounded-sm bg-red-400 dark:bg-red-500"></div>
          <span class="text-xs text-gray-500 dark:text-gray-500"><%= t("team.dist.legend_overdue") %></span>
        </div>
      </div>
    </div>
  <% end %>
</div>
