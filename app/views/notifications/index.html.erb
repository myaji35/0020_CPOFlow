<% content_for :page_title, "알림" %>

<div class="flex flex-col gap-4">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-gray-900 dark:text-white">알림 센터</h1>
      <p class="text-sm text-gray-500 dark:text-gray-500 mt-1">
        <% if @unread_count > 0 %>
          읽지 않은 알림 <span class="font-semibold text-primary"><%= @unread_count %>건</span>
        <% else %>
          모두 확인했습니다
        <% end %>
      </p>
    </div>
    <%# ISS-207: 액션 바 %>
    <div class="flex items-center gap-2">
      <%# 읽지 않음 토글 %>
      <%= link_to notifications_path(filter: @current_filter == "unread" ? nil : "unread", type: (@current_type unless @current_type == "all")),
            class: "inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium transition-colors border
                    #{@current_filter == 'unread' ? 'bg-[#00A1E0] text-white border-[#00A1E0]' : 'bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-300 border-gray-300 dark:border-gray-600 hover:bg-gray-50 dark:hover:bg-gray-700'}" do %>
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4" fill="currentColor" stroke="none"/></svg>
        읽지 않음 <%= "(#{@unread_count})" if @unread_count.to_i > 0 %>
      <% end %>
      <% if @unread_count > 0 %>
        <%= button_to (@current_type == "all" ? "모두 읽음" : "#{@current_type} 모두 읽음"),
              read_all_notifications_path(type: @current_type),
              method: :patch,
              class: "inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-300 border border-gray-300 dark:border-gray-600 hover:bg-gray-50 dark:hover:bg-gray-700 cursor-pointer" %>
      <% end %>
    </div>
  </div>

  <!-- 카테고리 필터 탭 (AUDIT-004: category 기반 + 빈 카테고리 숨김) -->
  <div class="flex gap-0 border-b border-gray-200 dark:border-gray-700 overflow-x-auto" id="notification-tabs">
    <%# 전체 탭 %>
    <% [
      ["all",               "전체"],
      ["mentioned",         "@멘션"],
      ["due_date",          "납기"],
      ["status_changed",    "상태변경"],
      ["assigned",          "배정"],
      ["visa",              "비자"],
      ["contract",          "계약"],
      ["overdue_escalation","미배정 에스컬"],
      ["ecount_slip_failed","eCount 오류"],
      ["oauth_signup",      "신규 가입"],
      ["system",            "시스템"]
    ].each do |cat, label|
      count  = cat == "all" ? @total_count : @category_counts[cat].to_i
      unread = cat == "all" ? @unread_count : @category_counts_unread[cat].to_i
      next if cat != "all" && count == 0  # 빈 카테고리 숨김
      active = @current_category == cat %>
      <%= link_to notifications_path(category: (cat unless cat == "all"), filter: @current_filter == "unread" ? "unread" : nil),
            class: "px-4 py-2.5 text-sm font-medium transition-colors border-b-2 whitespace-nowrap flex items-center gap-1.5
                    #{active ? 'border-primary text-primary' : 'border-transparent text-gray-500 dark:text-gray-500 hover:text-gray-700 dark:hover:text-gray-300'}" do %>
        <%= label %>
        <% if count > 0 %>
          <span class="text-[10px] <%= active ? 'bg-primary/10 text-primary' : 'bg-gray-100 dark:bg-gray-700 text-gray-500' %> rounded-full px-1.5 py-0.5 font-semibold tabular-nums">
            <%= count %><% if unread > 0 %>·<span class="text-[#D93025]"><%= unread %></span><% end %>
          </span>
        <% end %>
      <% end %>
    <% end %>
  </div>

  <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 overflow-hidden">
    <% if @notifications.any? %>
      <% @notifications.each do |n| %>
        <div class="notification-item flex items-start gap-3 px-5 py-4 border-b border-gray-50 dark:border-gray-700
                    hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors
                    <%= n.read? ? '' : 'bg-blue-50 dark:bg-blue-900/20' %>"
             data-type="<%= n.notification_type %>">

          <!-- 읽음 상태 점 -->
          <div class="flex-shrink-0 flex items-center pt-2">
            <div class="w-1.5 h-1.5 rounded-full <%= n.read? ? 'bg-transparent' : 'bg-primary' %>"></div>
          </div>

          <!-- 알림 타입 아이콘 (category 기반) -->
          <% n_cat = n.category %>
          <div class="w-8 h-8 rounded-full flex items-center justify-center flex-shrink-0
            <%= case n_cat
                when 'due_date'          then 'bg-red-100 dark:bg-red-900/30'
                when 'status_changed'    then 'bg-blue-100 dark:bg-blue-900/30'
                when 'assigned'          then 'bg-green-100 dark:bg-green-900/30'
                when 'mentioned'         then 'bg-amber-100 dark:bg-amber-900/30'
                when 'visa'              then 'bg-indigo-100 dark:bg-indigo-900/30'
                when 'contract'          then 'bg-teal-100 dark:bg-teal-900/30'
                when 'overdue_escalation' then 'bg-orange-100 dark:bg-orange-900/30'
                when 'ecount_slip_failed' then 'bg-rose-100 dark:bg-rose-900/30'
                when 'oauth_signup'      then 'bg-cyan-100 dark:bg-cyan-900/30'
                else 'bg-purple-100 dark:bg-purple-900/30'
                end %>">
            <svg class="w-4 h-4 <%= case n_cat
                when 'due_date'          then 'text-red-600 dark:text-red-400'
                when 'status_changed'    then 'text-blue-600 dark:text-blue-400'
                when 'assigned'          then 'text-green-600 dark:text-green-400'
                when 'mentioned'         then 'text-amber-600 dark:text-amber-400'
                when 'visa'              then 'text-indigo-600 dark:text-indigo-400'
                when 'contract'          then 'text-teal-600 dark:text-teal-400'
                when 'overdue_escalation' then 'text-orange-600 dark:text-orange-400'
                when 'ecount_slip_failed' then 'text-rose-600 dark:text-rose-400'
                when 'oauth_signup'      then 'text-cyan-600 dark:text-cyan-400'
                else 'text-purple-600 dark:text-purple-400'
                end %>" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <% case n_cat
                 when 'due_date' %>
                <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>
              <% when 'status_changed' %>
                <polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/>
              <% when 'assigned' %>
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
              <% when 'mentioned' %>
                <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
              <% when 'visa', 'contract' %>
                <rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
              <% when 'overdue_escalation' %>
                <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
              <% when 'ecount_slip_failed' %>
                <polygon points="7.86 2 16.14 2 22 7.86 22 16.14 16.14 22 7.86 22 2 16.14 2 7.86 7.86 2"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
              <% when 'oauth_signup' %>
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/>
              <% else %>
                <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
              <% end %>
            </svg>
          </div>

          <!-- 내용 -->
          <div class="flex-1 min-w-0">
            <div class="flex items-start justify-between gap-2">
              <p class="text-sm <%= n.read? ? 'font-medium text-gray-700 dark:text-gray-300' : 'font-semibold text-gray-900 dark:text-white' %>">
                <%= n.title %>
              </p>
              <span class="text-xs text-gray-500 dark:text-gray-500 whitespace-nowrap" title="<%= n.created_at.strftime('%Y-%m-%d %H:%M') %>">
                <%= time_ago_in_words(n.created_at) %> 전
              </span>
            </div>
            <% if n.body.present? %>
              <p class="text-xs text-gray-500 dark:text-gray-500 mt-0.5 truncate"><%= n.body %></p>
            <% end %>
            <% if n.notifiable.is_a?(Order) %>
              <button onclick="openOrderDrawer(<%= n.notifiable.id %>, <%= n.notifiable.title.to_json %>, '<%= order_path(n.notifiable) %>')"
                      class="text-xs text-primary hover:underline mt-1 cursor-pointer bg-transparent border-0 p-0">
                주문 보기 →
              </button>
            <% end %>
          </div>

          <!-- 읽음 처리 버튼 -->
          <% unless n.read? %>
            <%= button_to read_notification_path(n), method: :patch,
                class: "text-gray-300 hover:text-primary transition-colors bg-transparent border-0 cursor-pointer p-1",
                title: "읽음 처리" do %>
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
            <% end %>
          <% end %>
        </div>
      <% end %>
    <% else %>
      <div class="p-16 text-center">
        <svg class="w-12 h-12 mx-auto text-gray-200 dark:text-gray-600 mb-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
        <% if @current_filter == "unread" %>
          <p class="text-sm font-medium text-gray-500 dark:text-gray-400">읽지 않은 알림이 없습니다 🎉</p>
          <%= link_to "전체 알림 보기", notifications_path(type: (@current_type unless @current_type == "all")),
                class: "inline-block mt-3 text-xs text-[#00A1E0] hover:underline" %>
        <% elsif @current_type != "all" %>
          <p class="text-sm font-medium text-gray-500 dark:text-gray-400"><%= @current_type.humanize %> 유형의 알림이 없습니다</p>
          <%= link_to "전체 알림 보기", notifications_path,
                class: "inline-block mt-3 text-xs text-[#00A1E0] hover:underline" %>
        <% else %>
          <p class="text-sm font-medium text-gray-500 dark:text-gray-400">새 알림이 없습니다</p>
          <p class="text-xs text-gray-400 dark:text-gray-500 mt-1">주문 상태 변경, 납기 알림, 배정 등이 여기에 표시됩니다</p>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<script>
  function filterNotifications(type) {
    // 탭 활성화
    document.querySelectorAll('#notification-tabs button').forEach(function(btn) {
      btn.classList.remove('border-primary', 'text-primary');
      btn.classList.add('border-transparent', 'text-gray-500');
    });
    var activeTab = document.getElementById('tab-' + type);
    if (activeTab) {
      activeTab.classList.add('border-primary', 'text-primary');
      activeTab.classList.remove('border-transparent', 'text-gray-500');
    }

    // 항목 필터
    document.querySelectorAll('.notification-item').forEach(function(item) {
      if (type === 'all' || item.dataset.type === type) {
        item.style.display = '';
      } else {
        item.style.display = 'none';
      }
    });
  }
</script>
