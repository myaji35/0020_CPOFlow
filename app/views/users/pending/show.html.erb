<% content_for :page_title, "직원 등록 대기 중" %>

<div class="min-h-screen flex items-center justify-center bg-gray-50 dark:bg-gray-900 px-4">
  <div class="max-w-md w-full bg-white dark:bg-gray-800 rounded-2xl shadow-xl border border-gray-200 dark:border-gray-700 p-8">
    <div class="flex justify-center mb-5">
      <div class="w-14 h-14 rounded-full bg-amber-100 dark:bg-amber-900/30 flex items-center justify-center">
        <svg class="w-7 h-7 text-amber-600 dark:text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/>
          <line x1="12" y1="8" x2="12" y2="12"/>
          <line x1="12" y1="16" x2="12.01" y2="16"/>
        </svg>
      </div>
    </div>

    <h1 class="text-xl font-semibold text-gray-900 dark:text-white text-center mb-2">
      직원 등록 대기 중
    </h1>
    <p class="text-sm text-gray-600 dark:text-gray-400 text-center mb-6">
      <%= current_user&.email %>
    </p>

    <div class="bg-gray-50 dark:bg-gray-900/50 rounded-lg p-4 mb-6 text-sm text-gray-700 dark:text-gray-300 leading-relaxed">
      CPOFlow는 <strong>AtoZ2010 직원 전용</strong>입니다.<br>
      직원관리 시스템에 귀하의 이메일이 등록되어야 사용 가능합니다.<br><br>
      관리자에게 본인 이메일(<strong><%= current_user&.email %></strong>)을 알려주시면
      직원 정보 등록 후 자동으로 활성화됩니다.
    </div>

    <div class="flex flex-col gap-2">
      <%= button_to "로그아웃",
            destroy_user_session_path,
            method: :delete,
            class: "w-full text-center px-4 py-2.5 bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 text-gray-700 dark:text-gray-200 text-sm font-medium rounded-lg transition-colors" %>
    </div>

    <p class="text-xs text-gray-500 dark:text-gray-500 text-center mt-6">
      AtoZ2010 Inc. — CPOFlow
    </p>
  </div>
</div>
