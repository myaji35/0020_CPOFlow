<% content_for :title, t("leaves.show.title") %>

<div class="max-w-3xl mx-auto space-y-6">
  <!-- Header -->
  <div class="flex items-center justify-between">
    <div class="flex items-center gap-3">
      <%= link_to leaves_path, class: "text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-200" do %>
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
      <% end %>
      <h1 class="text-xl font-bold text-gray-900 dark:text-white"><%= t("leaves.show.title") %></h1>
    </div>
    <!-- 액션 버튼 -->
    <div class="flex items-center gap-2">
      <% if @leave.status == "requested" && (current_user.manager? || current_user.admin?) %>
        <%= button_to approve_manager_leave_path(@leave), method: :patch, form: { data: { turbo_confirm: t("leaves.confirms.approve") } },
            class: "inline-flex items-center gap-1.5 bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold px-3 py-2 rounded-lg transition-colors" do %>
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
          <%= t("leaves.actions.approve_manager") %>
        <% end %>
      <% end %>
      <% if @leave.status == "manager_approved" && current_user.admin? %>
        <%= button_to approve_admin_leave_path(@leave), method: :patch, form: { data: { turbo_confirm: t("leaves.confirms.approve") } },
            class: "inline-flex items-center gap-1.5 bg-green-600 hover:bg-green-700 text-white text-sm font-semibold px-3 py-2 rounded-lg transition-colors" do %>
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
          <%= t("leaves.actions.approve_admin") %>
        <% end %>
      <% end %>
      <% if %w[requested manager_approved].include?(@leave.status) && (current_user.manager? || current_user.admin?) %>
        <%= form_with url: reject_leave_path(@leave), method: :patch, local: true do |rf| %>
          <div class="flex gap-1">
            <%= rf.text_field :rejection_reason, placeholder: t("leaves.form.rejection_reason_placeholder"),
                class: "px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg text-sm text-gray-900 dark:text-white bg-white dark:bg-gray-800 w-48 focus:outline-none focus:border-red-400" %>
            <%= rf.submit t("leaves.actions.reject"),
                class: "bg-red-600 hover:bg-red-700 text-white text-sm font-semibold px-3 py-2 rounded-lg transition-colors cursor-pointer" %>
          </div>
        <% end %>
      <% end %>
      <% if %w[requested manager_approved].include?(@leave.status) && @leave.employee.user_id == current_user.id %>
        <%= button_to cancel_leave_path(@leave), method: :patch, form: { data: { turbo_confirm: t("leaves.confirms.cancel") } },
            class: "inline-flex items-center gap-1.5 border border-gray-200 dark:border-gray-600 text-gray-600 dark:text-gray-400 text-sm px-3 py-2 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors" do %>
          <%= t("leaves.actions.cancel") %>
        <% end %>
      <% end %>
    </div>
  </div>

  <!-- 상태 + 기본정보 카드 -->
  <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 shadow-sm p-6">
    <div class="flex items-start justify-between mb-4">
      <div>
        <div class="flex items-center gap-3 mb-1">
          <span class="inline-flex px-2.5 py-1 text-xs font-semibold rounded-full <%= @leave.status_badge_class %>"><%= @leave.status_label %></span>
          <span class="inline-flex px-2.5 py-1 text-xs font-medium rounded-full text-white" style="background: <%= @leave.leave_type_color %>"><%= @leave.leave_type_label %></span>
        </div>
        <h2 class="text-lg font-semibold text-gray-900 dark:text-white">
          <%= @leave.employee.name %> — <%= @leave.days_requested %><%= t("leaves.days_unit") %>
        </h2>
        <p class="text-sm text-gray-500 dark:text-gray-400 mt-0.5">
          <%= @leave.start_date.strftime("%Y.%m.%d") %> ~ <%= @leave.end_date.strftime("%Y.%m.%d") %>
        </p>
      </div>
      <p class="text-xs text-gray-400 dark:text-gray-500"><%= t("leaves.show.requested_at") %>: <%= @leave.requested_at.strftime("%Y.%m.%d %H:%M") %></p>
    </div>

    <% if @leave.reason.present? %>
      <div class="bg-gray-50 dark:bg-gray-700/40 rounded-lg px-4 py-3">
        <p class="text-xs text-gray-500 dark:text-gray-400 font-semibold mb-1"><%= t("leaves.form.reason") %></p>
        <p class="text-sm text-gray-700 dark:text-gray-300 whitespace-pre-wrap"><%= @leave.reason %></p>
      </div>
    <% end %>
  </div>

  <!-- 승인 이력 타임라인 -->
  <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 shadow-sm p-6">
    <h3 class="text-sm font-semibold text-gray-700 dark:text-gray-300 mb-4"><%= t("leaves.show.approval_timeline") %></h3>
    <ol class="relative border-l border-gray-200 dark:border-gray-700 ml-3 space-y-4">
      <!-- 신청 -->
      <li class="ml-6">
        <span class="absolute -left-3 flex items-center justify-center w-6 h-6 rounded-full bg-yellow-100 dark:bg-yellow-900/30 ring-4 ring-white dark:ring-gray-800">
          <svg class="w-3 h-3 text-yellow-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        </span>
        <p class="text-sm font-medium text-gray-900 dark:text-white"><%= t("leaves.show.event_requested") %></p>
        <p class="text-xs text-gray-500 dark:text-gray-400"><%= @leave.requested_at.strftime("%Y.%m.%d %H:%M") %></p>
      </li>
      <!-- 매니저 승인 -->
      <% if @leave.manager_approved_at %>
        <li class="ml-6">
          <span class="absolute -left-3 flex items-center justify-center w-6 h-6 rounded-full bg-blue-100 dark:bg-blue-900/30 ring-4 ring-white dark:ring-gray-800">
            <svg class="w-3 h-3 text-blue-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
          </span>
          <p class="text-sm font-medium text-gray-900 dark:text-white"><%= t("leaves.show.event_manager_approved") %></p>
          <p class="text-xs text-gray-500 dark:text-gray-400"><%= @leave.manager_approved_at.strftime("%Y.%m.%d %H:%M") %> — <%= @leave.manager_approved_by&.name || "-" %></p>
        </li>
      <% end %>
      <!-- 최종 승인 -->
      <% if @leave.admin_approved_at %>
        <li class="ml-6">
          <span class="absolute -left-3 flex items-center justify-center w-6 h-6 rounded-full bg-green-100 dark:bg-green-900/30 ring-4 ring-white dark:ring-gray-800">
            <svg class="w-3 h-3 text-green-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
          </span>
          <p class="text-sm font-medium text-gray-900 dark:text-white"><%= t("leaves.show.event_approved") %></p>
          <p class="text-xs text-gray-500 dark:text-gray-400"><%= @leave.admin_approved_at.strftime("%Y.%m.%d %H:%M") %> — <%= @leave.admin_approved_by&.name || "-" %></p>
        </li>
      <% end %>
      <!-- 반려 -->
      <% if @leave.rejected_at %>
        <li class="ml-6">
          <span class="absolute -left-3 flex items-center justify-center w-6 h-6 rounded-full bg-red-100 dark:bg-red-900/30 ring-4 ring-white dark:ring-gray-800">
            <svg class="w-3 h-3 text-red-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </span>
          <p class="text-sm font-medium text-gray-900 dark:text-white"><%= t("leaves.show.event_rejected") %></p>
          <p class="text-xs text-gray-500 dark:text-gray-400"><%= @leave.rejected_at.strftime("%Y.%m.%d %H:%M") %> — <%= @leave.rejected_by&.name || "-" %></p>
          <% if @leave.rejection_reason.present? %>
            <p class="text-xs text-red-600 dark:text-red-400 mt-1 bg-red-50 dark:bg-red-900/20 rounded px-2 py-1"><%= @leave.rejection_reason %></p>
          <% end %>
        </li>
      <% end %>
    </ol>
  </div>

  <!-- 첨부 문서 -->
  <% if @leave.documents.attached? %>
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 shadow-sm p-6">
      <h3 class="text-sm font-semibold text-gray-700 dark:text-gray-300 mb-3"><%= t("leaves.show.documents") %></h3>
      <div class="space-y-2">
        <% @leave.documents.each do |doc| %>
          <%= link_to rails_blob_path(doc, disposition: "attachment"),
              class: "flex items-center gap-3 px-3 py-2.5 border border-gray-200 dark:border-gray-700 rounded-lg hover:border-[#00A1E0] hover:bg-blue-50 dark:hover:bg-blue-900/10 transition-colors group" do %>
            <svg class="w-5 h-5 text-gray-400 group-hover:text-[#00A1E0]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
            <span class="text-sm text-gray-700 dark:text-gray-300 flex-1 truncate"><%= doc.blob.filename %></span>
            <span class="text-xs text-gray-400"><%= number_to_human_size(doc.blob.byte_size) %></span>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
