<!DOCTYPE html>
<html lang="<%= user_signed_in? ? current_user.preferred_locale : 'en' %>"
      data-theme="<%= user_signed_in? ? current_user.preferred_theme : 'light' %>">
  <head>
    <title><%= content_for(:title) || "CPOFlow" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='6' fill='%23166c72'/><text x='16' y='22' font-family='Arial,sans-serif' font-size='16' font-weight='bold' fill='white' text-anchor='middle'>CF</text></svg>" type="image/svg+xml">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <!-- TailwindCSS CDN (dark mode via class strategy) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        darkMode: 'class',
        theme: {
          extend: {
            colors: {
              // Legacy 토큰 — 기존 클래스 호환 유지 (점진 마이그레이션)
              primary:   { DEFAULT: '#1E3A5F', light: '#2D5282', dark: '#142844' },
              accent:    { DEFAULT: '#00A1E0', light: '#33b5e8' },
              danger:    '#D93025',
              warning:   '#F4A83A',
              success:   '#1E8E3E',
              // ── Redesign 토큰 (Phase 1) ──
              // Neutrals — cool gray, procurement shell 용
              ink: {
                50:  '#fafbfc',
                75:  '#f5f6f8',
                100: '#eff1f4',
                150: '#e7eaee',
                200: '#dde1e6',
                300: '#c1c7d0',
                400: '#97a0ad',
                500: '#6b7585',
                600: '#4a5361',
                700: '#2b323d',
                800: '#1e242d',
                900: '#151a21',
                950: '#0c1014',
              },
              // Deep Teal brand (OKLCH 195 equivalent hex)
              brand: {
                50:  '#e6f4f4',
                100: '#c7e7e8',
                200: '#99d2d4',
                400: '#3f9ba1',
                500: '#1f8389',
                600: '#166c72',
                700: '#11555a',
                900: '#072d31',
              },
              ok:     { 50: '#e9f6ed', 100: '#c6e7d0', 500: '#2e9856', 700: '#1f6f3f' },
              warn:   { 50: '#fdf2dc', 100: '#fbdea1', 500: '#d99a2a', 700: '#9a6a17' },
              dangerx:{ 50: '#fbe6e3', 100: '#f5c1b8', 500: '#c84431', 700: '#933123' },
              info:   { 50: '#e8edfb', 100: '#c3cef1', 500: '#3d5cc9', 700: '#293f93' },
              accentx:{ 50: '#f1e5fb', 500: '#8348c5' },
              // Stage-specific (9 procurement stages)
              stage: {
                new:     '#4a64d6',   // indigo
                quo:     '#894fc4',   // violet
                pending: '#d0962e',   // amber
                po:      '#1a7079',   // teal (brand 계열)
                deliver: '#2d8a4e',   // green
                problem: '#c54431',   // red
                grn:     '#2c7040',   // green-dark
                giveup:  '#7a7b82',   // gray
                done:    '#2b3e42',   // deep slate
              },
            },
            fontFamily: {
              sans: ['Inter Tight', 'Pretendard Variable', 'Pretendard', '-apple-system', 'Segoe UI', 'sans-serif'],
              mono: ['JetBrains Mono', 'SF Mono', 'ui-monospace', 'Menlo', 'monospace'],
            },
            borderRadius: {
              xs: '3px', sm: '5px', md: '7px', lg: '10px',
            },
            boxShadow: {
              'sh-1': '0 1px 2px rgba(12,16,20,.06), 0 1px 1px rgba(12,16,20,.04)',
              'sh-2': '0 2px 6px rgba(12,16,20,.06), 0 1px 2px rgba(12,16,20,.08)',
              'sh-3': '0 8px 24px rgba(12,16,20,.08), 0 2px 6px rgba(12,16,20,.06)',
              'sh-4': '0 24px 48px rgba(12,16,20,.14), 0 8px 16px rgba(12,16,20,.08)',
            },
          }
        }
      }
    </script>
    <!-- Inter Tight + Pretendard (디자인 타이포그래피) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" as="style" crossorigin href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable.min.css" />
    <!-- Dark mode initializer (prevent flash) -->
    <script>
      (function() {
        var theme = document.documentElement.getAttribute('data-theme');
        if (theme === 'dark') {
          document.documentElement.classList.add('dark');
        } else if (theme === 'system') {
          if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
            document.documentElement.classList.add('dark');
          }
        }
      })();
    </script>

    <!-- Alpine.js CDN -->
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>

    <!-- Line Icons 공식 CDN (cdn.lineicons.com) — jsdelivr는 폰트 경로 문제로 아이콘 미노출 -->
    <link rel="stylesheet" href="https://cdn.lineicons.com/4.0/lineicons.css" />

    <%# Cytoscape.js + dagre layout (Procurement Ontology M2 — Drawer Flow 탭) %>
    <script src="https://unpkg.com/cytoscape@3.30.2/dist/cytoscape.min.js" defer></script>
    <script src="https://unpkg.com/dagre@0.8.5/dist/dagre.min.js" defer></script>
    <script src="https://unpkg.com/cytoscape-dagre@2.5.0/cytoscape-dagre.js" defer></script>

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <%= yield :head %>
  </head>

  <body class="bg-ink-75 dark:bg-ink-950 text-ink-900 dark:text-ink-100 antialiased transition-colors duration-200 font-sans"
        style="font-feature-settings: 'cv11','ss01';">
    <% if user_signed_in? %>
      <div class="flex h-screen overflow-hidden relative"
           x-data="{ sidebarPinned: (typeof localStorage !== 'undefined' && localStorage.getItem('sidebar_collapsed') === 'true') }"
           @sidebar-pinned-changed.window="sidebarPinned = $event.detail">
        <!-- Sidebar spacer: pinned 상태에서 호버 펼침 시 사이드바가 absolute 가 되므로 본문이 밀리지 않도록 14px 자리 유지 -->
        <div class="shrink-0 transition-[width] duration-200" :class="sidebarPinned ? 'w-14' : 'w-0'"></div>
        <!-- Sidebar Navigation -->
        <%= render "shared/sidebar" %>

        <!-- Main Content -->
        <div class="flex flex-col flex-1 overflow-hidden">
          <!-- Top Header -->
          <%= render "shared/header" %>

          <!-- Flash Messages -->
          <% if notice.present? %>
            <div class="mx-6 mt-4 px-4 py-3 bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 rounded-lg text-green-800 dark:text-green-400 text-sm flex items-center gap-2">
              <i class="lni lni-checkmark-circle text-green-600 dark:text-green-400"></i>
              <%= notice %>
            </div>
          <% end %>
          <% if alert.present? %>
            <div class="mx-6 mt-4 px-4 py-3 bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-lg text-red-800 dark:text-red-400 text-sm flex items-center gap-2">
              <i class="lni lni-warning text-red-600 dark:text-red-400"></i>
              <%= alert %>
            </div>
          <% end %>

          <%# ISS-271: Gmail 토큰 만료/연결 끊김 전역 배너 %>
          <% health = gmail_connection_health %>
          <% if health[:needs_action] %>
            <div class="flex items-center gap-3 bg-[#c84431] text-white px-4 py-2.5 text-sm border-b border-red-900"
                 role="alert" data-controller="gmail-health-banner">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
              <div class="flex-1 leading-tight">
                <% if health[:disconnected_count].to_i > 0 %>
                  <strong>Gmail 연결 끊김 <%= health[:disconnected_count] %>건</strong> —
                <% end %>
                <% if health[:reauth_count].to_i > 0 %>
                  <strong>재인증 필요 <%= health[:reauth_count] %>건</strong> —
                <% end %>
                메일 수집이 중단됩니다. 지금 다시 연결하세요.
              </div>
              <%= link_to gmail_oauth_authorize_path,
                          class: "inline-flex items-center gap-1 bg-white text-[#c84431] px-3 py-1 rounded-md text-xs font-semibold hover:bg-gray-100 transition-colors" do %>
                다시 연결
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              <% end %>
              <%= link_to "설정", settings_root_path,
                          class: "text-xs text-white/80 hover:text-white underline underline-offset-2" %>
            </div>
          <% end %>

          <!-- Page Content -->
          <main class="flex-1 overflow-y-auto p-6 bg-ink-75 dark:bg-ink-950">
            <%= yield %>
          </main>
        </div>
      </div>

      <%# ===== Command Palette (Cmd+K) ===== %>
      <div data-controller="command-palette">
        <div data-command-palette-target="modal"
             class="hidden fixed inset-0 z-50 flex items-start justify-center pt-20 px-4"
             data-action="click->command-palette#closeOnBackdrop">
          <div class="absolute inset-0 bg-black/50 backdrop-blur-sm"></div>
          <div class="relative w-full max-w-xl bg-white dark:bg-gray-800 rounded-2xl shadow-2xl border border-gray-200 dark:border-gray-700 overflow-hidden">
            <%# 검색 입력 %>
            <div class="flex items-center gap-3 px-4 py-3 border-b border-gray-200 dark:border-gray-700">
              <svg class="w-4 h-4 text-gray-500 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
              <input data-command-palette-target="input"
                     data-action="input->command-palette#search keydown->command-palette#handleKeydown"
                     type="text"
                     placeholder="주문, 발주처, 거래처, 직원, 현장 검색..."
                     class="flex-1 bg-transparent text-sm text-gray-900 dark:text-white placeholder-gray-400 outline-none">
              <kbd class="hidden sm:inline-flex px-1.5 py-0.5 text-xs text-gray-500 dark:text-gray-500 border border-gray-200 dark:border-gray-600 rounded">ESC</kbd>
            </div>
            <%# 결과 목록 %>
            <div data-command-palette-target="results"
                 class="max-h-80 overflow-y-auto py-1">
              <div class="px-4 py-6 text-center">
                <p class="text-sm text-gray-500 dark:text-gray-500">검색어를 2자 이상 입력하세요</p>
                <p class="text-xs text-gray-300 dark:text-gray-600 mt-1">주문 · 발주처 · 거래처 · 직원 · 현장 통합 검색</p>
              </div>
            </div>
            <%# 푸터 %>
            <div class="px-4 py-2 border-t border-gray-200 dark:border-gray-700 flex items-center gap-3 text-xs text-gray-500 dark:text-gray-500">
              <span><kbd class="px-1 py-0.5 border border-gray-200 dark:border-gray-600 rounded text-xs">↑↓</kbd> 탐색</span>
              <span><kbd class="px-1 py-0.5 border border-gray-200 dark:border-gray-600 rounded text-xs">↵</kbd> 이동</span>
              <span><kbd class="px-1 py-0.5 border border-gray-200 dark:border-gray-600 rounded text-xs">⌘K</kbd> 열기</span>
            </div>
          </div>
        </div>
      </div>

      <%# ===== Order Detail Drawer ===== %>
      <div id="order-drawer-backdrop"
           class="fixed inset-0 bg-black/40 z-40 hidden transition-opacity duration-300 opacity-0"
           onclick="closeOrderDrawer()"></div>

      <div id="order-drawer"
           class="fixed top-0 right-0 h-full w-full max-w-2xl bg-white dark:bg-gray-800 shadow-2xl z-50 transform translate-x-full transition-transform duration-300 ease-in-out flex flex-col">
        <%# Drawer Header %>
        <div class="flex items-center gap-3 px-6 py-4 border-b border-gray-200 dark:border-gray-700 flex-shrink-0 bg-white dark:bg-gray-800">
          <div class="flex-1 min-w-0 flex items-center gap-1.5 truncate">
            <span id="drawer-ref-badge" class="hidden font-bold text-[#1E3A5F] dark:text-blue-400 font-mono text-xs flex-shrink-0"></span>
            <span id="drawer-title" class="text-sm font-semibold text-gray-900 dark:text-white truncate"></span>
            <button id="drawer-edit-title-btn" onclick="editDrawerTitle()" title="제목 수정"
                    class="flex-shrink-0 p-1 rounded hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors text-gray-400 hover:text-gray-600">
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
            </button>
          </div>
          <div class="flex items-center gap-2 flex-shrink-0">
            <%# 다음 단계 버튼 (JS로 제어) %>
            <form id="drawer-next-status-form" method="post" action="#" class="hidden">
              <input type="hidden" name="_method" value="patch">
              <input type="hidden" name="authenticity_token" id="drawer-csrf-token">
              <input type="hidden" name="status" id="drawer-next-status-value">
              <button type="submit"
                      class="flex items-center gap-1 text-xs font-medium px-2.5 py-1.5 rounded-lg bg-accent text-white hover:bg-accent/90 transition-colors">
                <span id="drawer-next-status-label"></span>
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
              </button>
            </form>
            <a id="drawer-open-link" href="#"
               class="flex items-center gap-1.5 text-xs text-gray-500 dark:text-gray-500 border border-gray-200 dark:border-gray-600 px-2.5 py-1.5 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors">
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
              펼침 화면
            </a>
            <button onclick="closeOrderDrawer()"
                    class="p-1.5 rounded-lg text-gray-500 dark:text-gray-500 hover:text-gray-600 dark:hover:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
          </div>
        </div>
        <%# Drawer Body %>
        <div id="order-drawer-body" class="flex-1 overflow-y-auto">
          <div class="flex items-center justify-center h-32 text-gray-200">
            <svg class="w-10 h-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="1"/></svg>
          </div>
        </div>
      </div>

      <%# ===== 첨부파일 미리보기 모달 (전역 — 드로어에서도 사용) ===== %>
      <div id="preview-modal" class="fixed inset-0 z-[60] hidden" onclick="closePreviewModal(event)">
        <div class="absolute inset-0 bg-black/60 backdrop-blur-sm"></div>
        <div class="relative flex flex-col mx-auto mt-8 mb-8 w-[95vw] max-w-6xl h-[calc(100vh-4rem)] bg-white dark:bg-gray-900 rounded-xl shadow-2xl overflow-hidden" onclick="event.stopPropagation()">
          <div class="flex items-center justify-between px-5 py-3 border-b border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800">
            <div class="flex items-center gap-2 min-w-0">
              <svg class="w-4 h-4 text-gray-500 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
              <span id="preview-modal-title" class="text-sm font-semibold text-gray-700 dark:text-gray-200 truncate"></span>
            </div>
            <div class="flex items-center gap-2 flex-shrink-0">
              <a id="preview-modal-newtab" href="#" target="_blank" class="p-2 rounded-lg hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors" title="새 탭에서 열기">
                <svg class="w-4 h-4 text-gray-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
              </a>
              <button onclick="closePreviewModal()" class="p-2 rounded-lg hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors" title="닫기">
                <svg class="w-4 h-4 text-gray-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
              </button>
            </div>
          </div>
          <div id="preview-modal-loading" class="absolute inset-0 flex items-center justify-center bg-white/80 dark:bg-gray-900/80 z-10" style="top:48px;">
            <div class="flex flex-col items-center gap-3">
              <div class="w-8 h-8 border-3 border-blue-200 border-t-blue-500 rounded-full animate-spin"></div>
              <span class="text-sm text-gray-500">미리보기 로딩 중...</span>
            </div>
          </div>
          <iframe id="preview-modal-iframe" class="flex-1 w-full border-0" src="about:blank" onload="document.getElementById('preview-modal-loading').style.display='none'"></iframe>
        </div>
      </div>

      <script>
        // 첨부파일 미리보기 모달 (전역)
        function openPreviewModal(filename, url) {
          var modal = document.getElementById('preview-modal');
          var iframe = document.getElementById('preview-modal-iframe');
          var title = document.getElementById('preview-modal-title');
          var newtab = document.getElementById('preview-modal-newtab');
          var loading = document.getElementById('preview-modal-loading');
          title.textContent = filename;
          newtab.href = url;
          loading.style.display = 'flex';
          iframe.src = url;
          modal.classList.remove('hidden');
          document.body.style.overflow = 'hidden';
        }
        function closePreviewModal(event) {
          if (event && event.target !== event.currentTarget) return;
          var modal = document.getElementById('preview-modal');
          var iframe = document.getElementById('preview-modal-iframe');
          modal.classList.add('hidden');
          iframe.src = 'about:blank';
          document.body.style.overflow = '';
        }
        document.addEventListener('keydown', function(e) {
          if (e.key === 'Escape' && !document.getElementById('preview-modal').classList.contains('hidden')) closePreviewModal();
        });
        // postMessage로 iframe 내부에서 모달 닫기
        window.addEventListener('message', function(e) {
          if (e.data === 'close-preview-modal') closePreviewModal();
        });

        var KANBAN_COLUMNS = ['new_rfq','make_quo','pending_po','new_po','delivery_items','problem','get_grn','give_up'];
        var STATUS_LABELS  = {
          new_rfq:'New(신규)', make_quo:'Make QUO(견적작성)', pending_po:'Pending PO(발주대기)',
          new_po:'New PO(발주확정)', delivery_items:'Delivery Items(납품진행)', problem:'Problem(문제)', get_grn:'Get GRN(수령확인)', give_up:'Give Up(포기)', done:'Done(완료)'
        };
        // ISS-274: 상태별 "주된 다음 전이" — give_up 재개 등 복구 경로 포함
        var STATUS_PRIMARY_NEXT = {
          new_rfq:'make_quo', make_quo:'pending_po', pending_po:'new_po', new_po:'delivery_items',
          delivery_items:'get_grn', problem:'delivery_items', get_grn:'done',
          give_up:'new_rfq' // 재개(복구)
        };
        var STATUS_CTA_LABEL = {
          give_up: '재개 (New로 되돌리기)' // 복구 UX 명확화
        };

        var _drawerOrderId = null;
        var _drawerOrderPath = null;

        function openOrderDrawer(orderId, orderTitle, orderPath, referenceNo) {
          _drawerOrderId = orderId;
          _drawerOrderPath = orderPath;
          var drawer   = document.getElementById('order-drawer');
          var backdrop = document.getElementById('order-drawer-backdrop');
          var body     = document.getElementById('order-drawer-body');
          var title    = document.getElementById('drawer-title');
          var refBadge = document.getElementById('drawer-ref-badge');
          var openLink = document.getElementById('drawer-open-link');

          title.textContent = orderTitle || 'Order Detail';
          if (referenceNo) {
            refBadge.textContent = referenceNo;
            refBadge.classList.remove('hidden');
          } else {
            refBadge.classList.add('hidden');
          }
          openLink.href = orderPath || '#';

          // ISS-263: 초기엔 status 미지, fetch 후 data-order-status 파싱해 세팅
          var nextForm  = document.getElementById('drawer-next-status-form');
          var nextLabel = document.getElementById('drawer-next-status-label');
          var nextInput = document.getElementById('drawer-next-status-value');
          var csrfInput = document.getElementById('drawer-csrf-token');
          nextForm.classList.add('hidden');

          function _setupNextStatusButton(currentStatus) {
            if (!currentStatus) { nextForm.classList.add('hidden'); return; }
            // ISS-274: STATUS_PRIMARY_NEXT 테이블 기반 — give_up도 "재개" CTA 노출
            var nextStatus = STATUS_PRIMARY_NEXT[currentStatus];
            if (!nextStatus) { nextForm.classList.add('hidden'); return; }
            nextLabel.textContent = STATUS_CTA_LABEL[currentStatus] || STATUS_LABELS[nextStatus] || nextStatus;
            nextInput.value = nextStatus;
            var csrfMeta = document.querySelector('meta[name="csrf-token"]');
            if (csrfMeta && csrfInput) csrfInput.value = csrfMeta.content;
            nextForm.action = orderPath + '/move_status';
            nextForm.classList.remove('hidden');
          }

          body.innerHTML = '<div class="flex items-center justify-center h-40"><svg class="w-6 h-6 text-gray-300 animate-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg></div>';

          backdrop.classList.remove('hidden');
          requestAnimationFrame(function() {
            backdrop.classList.remove('opacity-0');
            drawer.classList.remove('translate-x-full');
          });
          document.body.style.overflow = 'hidden';

          fetch(orderPath + '?drawer=1', {
            headers: { 'Accept': 'text/html', 'X-Requested-With': 'XMLHttpRequest' }
          })
          .then(function(r) {
            if (r.status === 404) {
              // 카드가 휴지통으로 이동된 경우 (archived) — 친절한 안내 + 자동 새로고침 제안
              body.innerHTML = '<div class="p-6 space-y-3"><div class="text-sm text-amber-700 font-semibold">이 카드는 더 이상 칸반에 없습니다.</div><div class="text-xs text-gray-500">휴지통으로 이동되었거나 다른 사용자가 이미 이동한 카드일 수 있습니다.</div><button onclick="closeOrderDrawer(); window.location.reload();" class="px-3 py-2 text-xs bg-primary text-white rounded-md">화면 새로고침</button></div>';
              throw new Error('drawer_not_found');
            }
            return r.text();
          })
          .then(function(html) {
            var parser = new DOMParser();
            var doc    = parser.parseFromString(html, 'text/html');
            var el     = doc.getElementById('order-drawer-content');
            body.innerHTML = el ? el.innerHTML : '<div class="p-6 space-y-2"><div class="text-sm text-amber-700 font-semibold">카드 내용을 불러올 수 없습니다.</div><div class="text-xs text-gray-500">화면이 오래된 상태일 수 있습니다.</div><button onclick="closeOrderDrawer(); window.location.reload();" class="px-3 py-2 text-xs bg-primary text-white rounded-md">화면 새로고침</button></div>';
            // ISS-263: 드로어 콘텐츠 data-order-status로 "다음 단계" 버튼 활성화
            _setupNextStatusButton(el ? el.getAttribute('data-order-status') : null);
          })
          .catch(function(err) {
            if (err && err.message === 'drawer_not_found') return;
            body.innerHTML = '<div class="p-6 text-sm text-red-400">네트워크 오류가 발생했습니다.</div>';
          });
        }

        function closeOrderDrawer() {
          const drawer   = document.getElementById('order-drawer');
          const backdrop = document.getElementById('order-drawer-backdrop');
          drawer.classList.add('translate-x-full');
          backdrop.classList.add('opacity-0');
          setTimeout(() => {
            backdrop.classList.add('hidden');
            document.body.style.overflow = '';
          }, 300);
        }

        // 2026-04-29: 드로어 담당자 추가/제거 — document 단일 delegation.
        // drawer 콘텐츠가 fetch innerHTML 로 삽입되어도 document 핸들러는 그대로라 자동 동작.
        // (innerHTML 안의 <script> 는 브라우저가 실행하지 않으므로 document 레벨 필수)
        if (!window.__drawerAssigneesDelegationInstalled) {
          window.__drawerAssigneesDelegationInstalled = true;

          // 글로벌 헬퍼 — 카드 partial 전체 재렌더로 모든 변경 정보 즉시 반영
          // (담당자, D-X 배지, 카드상태 색상, 제목, 첨부 카운트, 자식 카운트, SLA 리본)
          window.refreshKanbanCard = function(orderId) {
            console.log('[refreshKanbanCard] 시작 orderId=', orderId);
            return fetch('/kanban/card/' + orderId, {
              headers: { 'Accept': 'text/html', 'X-Requested-With': 'XMLHttpRequest' }
            })
              .then(function(r) {
                console.log('[refreshKanbanCard] 응답 status=', r.status);
                return r.ok ? r.text() : null;
              })
              .then(function(html) {
                if (!html) { console.warn('[refreshKanbanCard] 빈 응답'); return; }
                var existing = document.getElementById('kanban-card-' + orderId);
                if (!existing) { console.warn('[refreshKanbanCard] kanban-card-' + orderId + ' 요소 없음'); return; }
                var tmp = document.createElement('div');
                tmp.innerHTML = html.trim();
                var fresh = tmp.firstElementChild;
                if (fresh) {
                  existing.replaceWith(fresh);
                  console.log('[refreshKanbanCard] 교체 완료');
                }
              })
              .catch(function(err) { console.error('[refreshKanbanCard] 실패', err); });
          };

          function _drawerReloadAssignees(orderId) {
            var root = document.getElementById('order-assignees-' + orderId);
            var drawerPromise = Promise.resolve();
            if (root) {
              var orderPath = root.dataset.drawerOrderPath || ('/orders/' + orderId);
              drawerPromise = fetch(orderPath + '?drawer=1', {
                headers: { 'Accept': 'text/html', 'X-Requested-With': 'XMLHttpRequest' }
              })
                .then(function(r) { return r.text(); })
                .then(function(html) {
                  var doc = new DOMParser().parseFromString(html, 'text/html');
                  var fresh = doc.getElementById('order-assignees-' + orderId);
                  if (fresh) root.innerHTML = fresh.innerHTML;
                });
            }
            // 카드 영역도 동시 갱신
            return Promise.all([drawerPromise, window.refreshKanbanCard(orderId)]);
          }

          document.addEventListener('click', function(e) {
            var assignBtn = e.target.closest('.js-drawer-assign');
            var unassignBtn = e.target.closest('.js-drawer-unassign');
            if (!assignBtn && !unassignBtn) return;

            var root = (assignBtn || unassignBtn).closest('[data-drawer-order-id]');
            if (!root) return;
            var orderId = root.dataset.drawerOrderId;
            var csrfToken = document.querySelector('meta[name=csrf-token]')?.content;

            if (assignBtn) {
              e.preventDefault();
              var empId = assignBtn.dataset.actionAssignEmployee;
              assignBtn.disabled = true;
              var body = new URLSearchParams();
              body.append('employee_id', empId);
              fetch('/orders/' + orderId + '/assignments', {
                method: 'POST',
                headers: {
                  'X-CSRF-Token': csrfToken,
                  'Content-Type': 'application/x-www-form-urlencoded',
                  'Accept': 'application/json'
                },
                body: body.toString()
              })
                .then(function(r) {
                  if (!r.ok) throw new Error(r.status);
                  return r.json();
                })
                .then(function() { return _drawerReloadAssignees(orderId); })
                .catch(function(err) {
                  assignBtn.disabled = false;
                  alert('담당자 배정 실패: ' + err.message);
                });
            } else if (unassignBtn) {
              e.preventDefault();
              var name = unassignBtn.dataset.employeeName || '담당자';
              if (!confirm(name + '을(를) 담당자에서 제거할까요?')) return;
              var aid = unassignBtn.dataset.actionUnassign;
              unassignBtn.disabled = true;
              var row = unassignBtn.closest('.flex.items-center.gap-2.group');
              if (row) row.style.opacity = '0.4';

              fetch('/orders/' + orderId + '/assignments/' + aid, {
                method: 'DELETE',
                headers: { 'X-CSRF-Token': csrfToken, 'Accept': 'application/json' }
              })
                .then(function(r) {
                  if (!r.ok) throw new Error(r.status);
                  return r.json();
                })
                .then(function() { return _drawerReloadAssignees(orderId); })
                .catch(function(err) {
                  if (row) row.style.opacity = '1';
                  unassignBtn.disabled = false;
                  alert('담당자 제거 실패: ' + err.message);
                });
            }
          });
        }

        // ── 드로어 제목 인라인 편집 ──────────────────────────
        function editDrawerTitle() {
          var titleEl = document.getElementById('drawer-title');
          var btn = document.getElementById('drawer-edit-title-btn');
          if (!titleEl || !_drawerOrderPath) return;
          var currentTitle = titleEl.textContent.trim();
          var newTitle = prompt('제목 수정', currentTitle);
          if (newTitle === null || newTitle.trim() === '' || newTitle.trim() === currentTitle) return;
          var csrf = document.querySelector('meta[name="csrf-token"]');
          fetch(_drawerOrderPath, {
            method: 'PATCH',
            headers: {
              'Content-Type': 'application/json',
              'X-CSRF-Token': csrf ? csrf.content : '',
              'Accept': 'application/json'
            },
            body: JSON.stringify({ order: { title: newTitle.trim() } })
          }).then(function(r) {
            if (r.ok) {
              titleEl.textContent = newTitle.trim();
              // 칸반 카드 제목도 업데이트
              var card = document.querySelector('[data-order-id="' + _drawerOrderId + '"]');
              if (card) {
                var h4 = card.querySelector('h4');
                if (h4) h4.textContent = newTitle.trim();
                card.dataset.title = newTitle.trim();
              }
            } else {
              alert('저장 실패');
            }
          });
        }

        // ── 관리번호 인라인 편집 ──────────────────────────────
        function editTrackingNo(orderId, field) {
          var container = document.getElementById('tracking-' + field + '-' + orderId);
          if (!container) return;
          var display = container.querySelector('.tracking-display');
          var input   = container.querySelector('.tracking-input');
          if (display) display.classList.add('hidden');
          if (input) { input.classList.remove('hidden'); input.focus(); input.select(); }
        }

        function cancelTrackingEdit(inputEl) {
          var container = inputEl.closest('[id^="tracking-"]');
          var display = container.querySelector('.tracking-display');
          inputEl.classList.add('hidden');
          if (display) display.classList.remove('hidden');
        }

        function saveTrackingNo(inputEl) {
          var orderId = inputEl.dataset.orderId;
          var field   = inputEl.dataset.field;
          var value   = inputEl.value.trim();
          var csrf    = document.querySelector('meta[name="csrf-token"]').content;

          fetch('/orders/' + orderId + '/quick_update', {
            method:  'PATCH',
            headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrf, 'Accept': 'application/json' },
            body:    JSON.stringify({ order: { [field]: value } })
          })
          .then(function(r) { return r.json(); })
          .then(function(data) {
            if (data.success) {
              // 디스플레이 텍스트 갱신
              var container = document.getElementById('tracking-' + field + '-' + orderId);
              var display = container.querySelector('.tracking-display');
              if (value) {
                display.className = display.className.replace(/italic/g, '').replace(/text-gray-500/g, '');
                display.innerHTML = value + ' <svg class="w-3 h-3 inline ml-1 text-gray-500 opacity-0 group-hover/edit:opacity-100 transition-opacity" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>';
              }
              display.classList.remove('hidden');
              inputEl.classList.add('hidden');
            }
          });
        }

        // ── 동적 관리번호(TrackingCode) 인라인 편집 ───────────────
        function editTrackingCode(orderId, codeId) {
          var container = document.getElementById('tracking-code-' + codeId + '-' + orderId);
          if (!container) return;
          var display = container.querySelector('.tracking-display');
          var input   = container.querySelector('.tracking-input');
          if (display) display.classList.add('hidden');
          if (input) { input.classList.remove('hidden'); input.focus(); input.select(); }
        }

        function saveTrackingCode(inputEl) {
          var orderId = inputEl.dataset.orderId;
          var codeId  = inputEl.dataset.trackingCodeId;
          var value   = inputEl.value.trim();
          var csrf    = document.querySelector('meta[name="csrf-token"]').content;

          fetch('/orders/' + orderId + '/update_tracking', {
            method:  'PATCH',
            headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrf, 'Accept': 'application/json' },
            body:    JSON.stringify({ tracking_code_id: codeId, value: value })
          })
          .then(function(r) { return r.json(); })
          .then(function(data) {
            if (data.success) {
              var container = document.getElementById('tracking-code-' + codeId + '-' + orderId);
              var display = container.querySelector('.tracking-display');
              if (value) {
                display.className = display.className.replace(/italic/g, '').replace(/text-gray-500/g, '');
                display.innerHTML = value + ' <svg class="w-3 h-3 inline ml-1 text-gray-500 opacity-0 group-hover/edit:opacity-100 transition-opacity" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>';
              } else {
                display.className = 'tracking-display block text-xs text-gray-500 italic rounded px-2 py-1.5 border border-dashed border-gray-200 dark:border-gray-600 cursor-pointer hover:bg-gray-50 dark:hover:bg-gray-700 hover:border-gray-300 transition-colors';
                display.innerHTML = '미등록 <svg class="w-3 h-3 inline ml-1 text-gray-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>';
              }
              display.classList.remove('hidden');
              inputEl.classList.add('hidden');
              // 카드 자동 갱신: 칸반에 머물러 있다면 해당 카드 partial 다시 그리기
              if (window.refreshKanbanCard) window.refreshKanbanCard(orderId);
            }
          });
        }

        // 드로어 탭 전환 — innerHTML 삽입 시 <script> 미실행 문제로 전역 정의
        function switchDrawerTab(orderId, tabId) {
          var panels = ['detail', 'tasks', 'comments', 'attachments', 'history', 'flow'];
          var ACTIVE = ['border-brand-600', 'text-brand-700'];
          var INACT  = ['border-transparent', 'text-ink-500', 'dark:text-ink-400'];
          panels.forEach(function(p) {
            var panel = document.getElementById('drawer-panel-' + orderId + '-' + p);
            var tab   = document.getElementById('drawer-tab-'   + orderId + '-' + p);
            if (!panel || !tab) return;
            if (p === tabId) {
              panel.classList.remove('hidden');
              tab.classList.add.apply(tab.classList, ACTIVE);
              tab.classList.remove.apply(tab.classList, INACT);
            } else {
              panel.classList.add('hidden');
              tab.classList.remove.apply(tab.classList, ACTIVE);
              tab.classList.add.apply(tab.classList, INACT);
            }
          });
        }

        // 드로어 단축키 — J/K 이동, R 답장(코멘트 탭), T 태스크 탭, C 코멘트 탭, Enter 다음 스테이지
        document.addEventListener('keydown', function(e) {
          // 입력 중이면 무시
          var t = e.target;
          if (t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.isContentEditable)) return;
          var drawer = document.getElementById('order-drawer');
          if (!drawer || drawer.classList.contains('translate-x-full')) return;
          var content = drawer.querySelector('[data-order-id]');
          if (!content) return;
          var orderId = content.dataset.orderId;
          if (e.key === 'r' || e.key === 'R') { switchDrawerTab(orderId, 'comments'); e.preventDefault(); }
          else if (e.key === 't' || e.key === 'T') { switchDrawerTab(orderId, 'tasks'); e.preventDefault(); }
          else if (e.key === 'c' || e.key === 'C') { switchDrawerTab(orderId, 'comments'); e.preventDefault(); }
          else if (e.key === 'Enter') {
            var btn = document.querySelector('#drawer-action-bar-' + orderId + ' button[type=submit]');
            if (btn) { btn.click(); e.preventDefault(); }
          }
        });

        // 히스토리 메일 스레드 아코디언 토글
        function toggleThreadEmail(orderId, threadOrderId) {
          var container = document.getElementById('thread-accordion-' + orderId);
          if (!container) return;
          // 모든 본문 패널 찾기
          var allBodies = container.querySelectorAll('[id$="-body"]');
          var allChevrons = container.querySelectorAll('[id$="-chevron"]');
          var targetBody = document.getElementById('thread-item-' + orderId + '-' + threadOrderId + '-body');
          var targetChevron = document.getElementById('thread-item-' + orderId + '-' + threadOrderId + '-chevron');
          if (!targetBody) return;
          var isOpen = !targetBody.classList.contains('hidden');
          // 모두 접기
          allBodies.forEach(function(el) { el.classList.add('hidden'); });
          allChevrons.forEach(function(el) { el.style.transform = ''; });
          // 이미 열려있었으면 그냥 접기만, 아니면 클릭한 것 열기
          if (!isOpen) {
            targetBody.classList.remove('hidden');
            if (targetChevron) targetChevron.style.transform = 'rotate(180deg)';
          }
        }

        // 우선순위 드롭다운 토글 — 동일 이유로 전역 정의
        function togglePriorityDropdown(orderId, event) {
          if (event) event.stopPropagation();
          var menu = document.getElementById('priority-menu-' + orderId);
          if (menu) menu.classList.toggle('hidden');
        }

        document.addEventListener('click', function(e) {
          if (!e.target.closest('[id^="priority-dropdown-"]')) {
            document.querySelectorAll('[id^="priority-menu-"]').forEach(function(m) {
              m.classList.add('hidden');
            });
          }
        });

        document.addEventListener('keydown', e => { if (e.key === 'Escape') { closePreviewModal(); closeOrderDrawer(); } });

        // 전역 첨부파일 미리보기 모달
        function openPreviewModal(filename, url) {
          var modal = document.getElementById('global-preview-modal');
          if (!modal) return;
          var iframe = document.getElementById('global-preview-iframe');
          var title = document.getElementById('global-preview-title');
          var newtab = document.getElementById('global-preview-newtab');
          title.textContent = filename || '미리보기';
          if (newtab) newtab.href = url;
          iframe.src = url;
          modal.classList.remove('hidden');
          document.body.style.overflow = 'hidden';
        }
        function closePreviewModal(event) {
          if (event && event.target !== event.currentTarget) return;
          var modal = document.getElementById('global-preview-modal');
          if (!modal) return;
          var iframe = document.getElementById('global-preview-iframe');
          modal.classList.add('hidden');
          if (iframe) iframe.src = 'about:blank';
          document.body.style.overflow = '';
        }
      </script>

      <%# 전역 첨부파일 미리보기 모달 (Orders 첨부파일 탭용) %>
      <div id="global-preview-modal" class="hidden fixed inset-0 z-[9999] bg-black/60 flex items-center justify-center" onclick="closePreviewModal(event)">
        <div class="bg-white dark:bg-gray-800 rounded-xl shadow-2xl w-[90vw] max-w-5xl h-[85vh] flex flex-col overflow-hidden" onclick="event.stopPropagation()">
          <div class="flex items-center justify-between px-5 py-3 border-b border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800">
            <h3 id="global-preview-title" class="text-sm font-semibold text-gray-900 dark:text-white truncate">미리보기</h3>
            <div class="flex items-center gap-2">
              <a id="global-preview-newtab" href="#" target="_blank" rel="noopener" class="p-1.5 rounded hover:bg-gray-200 dark:hover:bg-gray-600 transition-colors" title="새 탭에서 열기">
                <svg class="w-4 h-4 text-gray-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
              </a>
              <button onclick="closePreviewModal()" class="p-1.5 rounded hover:bg-gray-200 dark:hover:bg-gray-600 transition-colors" title="닫기">
                <svg class="w-4 h-4 text-gray-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
              </button>
            </div>
          </div>
          <div class="flex-1 relative">
            <iframe id="global-preview-iframe" src="about:blank" class="w-full h-full border-0"></iframe>
          </div>
        </div>
      </div>

    <% else %>
      <!-- Auth pages: no sidebar -->
      <%= yield %>
    <% end %>
  </body>
</html>
