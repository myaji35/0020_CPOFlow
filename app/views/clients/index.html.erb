<% content_for :title, "발주처 관리" %>

<div class="flex flex-col gap-6">
  <!-- Header -->
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-gray-900 dark:text-white">발주처 관리</h1>
      <p class="text-sm text-gray-500 dark:text-gray-500 mt-1">발주처별 거래 현황 및 담당자 관리</p>
    </div>
    <%# ISS-264: viewer는 Create 버튼 비노출 %>
    <% if current_user.admin? || current_user.manager? || current_user.member? %>
      <%= link_to new_client_path, class: "inline-flex items-center gap-2 bg-primary text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-primary-dark transition-colors" do %>
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        새 발주처 등록
      <% end %>
    <% end %>
  </div>

  <!-- 검색/필터 -->
  <%= form_with url: clients_path, method: :get, local: true, class: "flex gap-3 items-center flex-wrap" do |f| %>
    <div class="relative flex-1 max-w-xs">
      <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      <%= f.text_field :q, placeholder: "회사명, 코드 검색...", value: params[:q],
          class: "w-full pl-9 pr-3 py-2 border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary" %>
    </div>
    <%= f.select :country, options_for_select([["전체 국가", ""], ["AE", "AE"], ["KR", "KR"], ["CH", "CH"], ["US", "US"]], params[:country]),
        {}, class: "border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary" %>
    <%= f.select :industry, options_for_select([["전체 산업", ""]] + Client::INDUSTRIES.map { |i| [{ "nuclear"=>"원전","hydro"=>"수력","tunnel"=>"터널","gtx"=>"GTX","construction"=>"건설","general"=>"일반" }[i] || i, i] }, params[:industry]),
        {}, class: "border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary" %>
    <%= f.select :sort, options_for_select([["이름순", ""], ["거래금액순", "value"], ["오더건수순", "orders"]], params[:sort]),
        {}, class: "border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary" %>
    <%= f.submit "검색", class: "bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 px-4 py-2 rounded-lg text-sm font-medium hover:bg-gray-200 dark:hover:bg-gray-600 cursor-pointer" %>
  <% end %>

  <!-- 통계 카드 -->
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-4 shadow-sm">
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 rounded-lg bg-primary/10 dark:bg-primary/20 flex items-center justify-center">
          <svg class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </div>
        <div>
          <p class="text-xs text-gray-500 dark:text-gray-500 font-medium">총 발주처</p>
          <p class="text-xl font-bold text-gray-900 dark:text-white"><%= @total_count %></p>
        </div>
      </div>
    </div>
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-4 shadow-sm">
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 rounded-lg bg-green-50 dark:bg-green-900/20 flex items-center justify-center">
          <svg class="w-4 h-4 text-green-600 dark:text-green-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        </div>
        <div>
          <p class="text-xs text-gray-500 dark:text-gray-500 font-medium">주문 연결</p>
          <p class="text-xl font-bold text-green-600 dark:text-green-400"><%= @order_linked_count %></p>
        </div>
      </div>
    </div>
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-4 shadow-sm">
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 rounded-lg bg-blue-50 dark:bg-blue-900/20 flex items-center justify-center">
          <svg class="w-4 h-4 text-blue-600 dark:text-blue-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
        </div>
        <div>
          <p class="text-xs text-gray-500 dark:text-gray-500 font-medium">총 거래금액</p>
          <p class="text-xl font-bold text-primary">$<%= number_with_delimiter(@total_value.round.to_i) %></p>
        </div>
      </div>
    </div>
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-4 shadow-sm">
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 rounded-lg bg-purple-50 dark:bg-purple-900/20 flex items-center justify-center">
          <svg class="w-4 h-4 text-purple-600 dark:text-purple-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        </div>
        <div>
          <p class="text-xs text-gray-500 dark:text-gray-500 font-medium">최근 30일 신규</p>
          <p class="text-xl font-bold text-purple-600 dark:text-purple-400"><%= @recent_30d_count %></p>
        </div>
      </div>
    </div>
  </div>

  <!-- 테이블 -->
  <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 shadow-sm overflow-hidden">
    <table class="w-full">
      <thead class="bg-gray-50 dark:bg-gray-700/50 border-b border-gray-200 dark:border-gray-700">
        <tr>
          <th class="text-left px-4 py-3 text-xs font-semibold text-gray-500 dark:text-gray-500 uppercase tracking-wide">회사명</th>
          <th class="text-left px-4 py-3 text-xs font-semibold text-gray-500 dark:text-gray-500 uppercase tracking-wide">국가</th>
          <th class="text-left px-4 py-3 text-xs font-semibold text-gray-500 dark:text-gray-500 uppercase tracking-wide">산업</th>
          <th class="text-left px-4 py-3 text-xs font-semibold text-gray-500 dark:text-gray-500 uppercase tracking-wide">신용</th>
          <th class="text-left px-4 py-3 text-xs font-semibold text-gray-500 dark:text-gray-500 uppercase tracking-wide">리스크</th>
          <th class="text-right px-4 py-3 text-xs font-semibold text-gray-500 dark:text-gray-500 uppercase tracking-wide">오더</th>
          <th class="text-right px-4 py-3 text-xs font-semibold text-gray-500 dark:text-gray-500 uppercase tracking-wide">거래금액</th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-50 dark:divide-gray-700">
        <% @clients.each do |client| %>
          <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors">
            <td class="px-4 py-3">
              <div class="font-medium text-gray-900 dark:text-white"><%= client.name %></div>
              <div class="text-xs text-gray-500 dark:text-gray-500"><%= client.code %></div>
            </td>
            <td class="px-4 py-3 text-sm text-gray-600 dark:text-gray-500"><%= client.country %></td>
            <td class="px-4 py-3">
              <% if client.industry.present? %>
                <span class="inline-flex px-2 py-0.5 text-xs font-medium rounded-full bg-blue-50 dark:bg-blue-900/30 text-blue-700 dark:text-blue-400"><%= client.industry_label %></span>
              <% end %>
            </td>
            <td class="px-4 py-3">
              <% if client.credit_grade.present? %>
                <% grade_class = { "A" => "bg-green-600 text-white dark:bg-green-900/30 dark:text-green-400", "B" => "bg-blue-50 text-blue-700 dark:bg-blue-900/30 dark:text-blue-400", "C" => "bg-yellow-500 text-white dark:bg-yellow-900/30 dark:text-yellow-400", "D" => "bg-red-600 text-white dark:bg-red-900/30 dark:text-red-400" }[client.credit_grade] || "bg-gray-50 text-gray-700 dark:bg-gray-700 dark:text-gray-500" %>
                <span class="inline-flex px-2 py-0.5 text-xs font-bold rounded-full <%= grade_class %>"><%= client.credit_grade %>등급</span>
              <% end %>
            </td>
            <td class="px-4 py-3">
              <%
                c_total     = client.orders.where.not(due_date: nil).count
                c_delivered = client.orders.where(status: :get_grn).count
                c_overdue   = client.orders.where("due_date < ? AND status NOT IN (?, ?)", Date.today, Order.statuses[:get_grn], Order.statuses[:give_up]).count
                c_rate      = c_total > 0 ? ((c_total - c_overdue).to_f / c_total * 100).round(1) : nil
                risk_grade  = if c_rate.nil? then nil
                              elsif c_rate >= 90 && c_overdue == 0 then "A"
                              elsif c_rate >= 75 || c_overdue <= 1  then "B"
                              elsif c_rate >= 60 || c_overdue <= 3  then "C"
                              else "D"
                              end
                risk_cls = { "A" => "bg-green-600 text-white",
                             "B" => "bg-blue-600 text-white",
                             "C" => "bg-yellow-500 text-white",
                             "D" => "bg-red-600 text-white" }
                risk_desc = { "A" => "우수", "B" => "양호", "C" => "주의", "D" => "위험" }
              %>
              <% if risk_grade %>
                <span class="inline-flex items-center gap-1 px-2 py-0.5 text-xs font-bold rounded-full <%= risk_cls[risk_grade] %>" title="납기준수율 <%= c_rate %>%">
                  <%= risk_grade %><span class="font-normal opacity-80"><%= risk_desc[risk_grade] %></span>
                </span>
              <% else %>
                <span class="text-xs text-gray-300 dark:text-gray-600">-</span>
              <% end %>
            </td>
            <td class="px-4 py-3 text-right text-sm text-gray-700 dark:text-gray-300"><%= client.orders.count %></td>
            <td class="px-4 py-3 text-right text-sm font-medium text-gray-900 dark:text-white">$<%= number_with_delimiter(client.total_order_value.round.to_i) %></td>
            <td class="px-4 py-3 text-right">
              <%= link_to "상세", client, class: "text-xs text-primary hover:underline" %>
            </td>
          </tr>
        <% end %>
        <% if @clients.empty? %>
          <tr><td colspan="8" class="px-4 py-12 text-center text-gray-500 dark:text-gray-500 text-sm">등록된 발주처가 없습니다.</td></tr>
        <% end %>
      </tbody>
    </table>

    <!-- 페이지네이션 -->
    <% if @total_pages > 1 %>
      <div class="px-4 py-3 border-t border-gray-200 dark:border-gray-700 flex items-center justify-between">
        <p class="text-xs text-gray-500 dark:text-gray-500">
          총 <%= @total_count %>개 중 <%= [(@page - 1) * @per_page + 1, @total_count].min %>–<%= [@page * @per_page, @total_count].min %>개 표시
        </p>
        <div class="flex gap-1">
          <% if @page > 1 %>
            <%= link_to clients_path(params.permit(:q, :country, :industry, :sort).merge(page: @page - 1)),
                class: "px-3 py-1 text-xs rounded-lg border border-gray-200 dark:border-gray-600 text-gray-600 dark:text-gray-500 hover:bg-gray-50 dark:hover:bg-gray-700" do %>
              ← 이전
            <% end %>
          <% end %>
          <% ([@page - 2, 1].max..[@page + 2, @total_pages].min).each do |p| %>
            <%= link_to p, clients_path(params.permit(:q, :country, :industry, :sort).merge(page: p)),
                class: "px-3 py-1 text-xs rounded-lg #{p == @page ? 'bg-primary text-white' : 'border border-gray-200 dark:border-gray-600 text-gray-600 dark:text-gray-500 hover:bg-gray-50 dark:hover:bg-gray-700'}" %>
          <% end %>
          <% if @page < @total_pages %>
            <%= link_to clients_path(params.permit(:q, :country, :industry, :sort).merge(page: @page + 1)),
                class: "px-3 py-1 text-xs rounded-lg border border-gray-200 dark:border-gray-600 text-gray-600 dark:text-gray-500 hover:bg-gray-50 dark:hover:bg-gray-700" do %>
              다음 →
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
