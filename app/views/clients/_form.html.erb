<%= form_with model: @client, local: true, class: "space-y-6" do |f| %>
  <% if @client.errors.any? %>
    <div class="bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-lg p-4">
      <ul class="text-sm text-red-700 dark:text-red-400 space-y-1">
        <% @client.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.label :name, t("clients.form_company_name"), class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
      <%= f.text_field :name, class: "w-full border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary", placeholder: "e.g. ENEC" %>
    </div>
    <div>
      <%= f.label :code, t("clients.form_code"), class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
      <%= f.text_field :code, class: "w-full border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary", placeholder: "e.g. CL-001" %>
    </div>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.label :country, t("clients.form_country"), class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
      <%= f.text_field :country, class: "w-full border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary", placeholder: "e.g. AE, KR, US" %>
    </div>
    <div>
      <%= f.label :industry, t("clients.form_industry"), class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
      <%= f.select :industry,
          options_for_select([[t("clients.form_select"), ""]] + Client::INDUSTRIES.map { |i| [{ "nuclear"=>"원전","hydro"=>"수력","tunnel"=>"터널","gtx"=>"GTX","construction"=>"건설","general"=>"일반" }[i] || i, i] }, @client.industry),
          {}, class: "w-full border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary" %>
    </div>
  </div>

  <div class="grid grid-cols-3 gap-4">
    <div>
      <%= f.label :credit_grade, t("clients.form_credit_grade"), class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
      <%= f.select :credit_grade,
          options_for_select([[t("clients.form_select"), ""]] + Client::CREDIT_GRADES.map { |g| [g + "등급", g] }, @client.credit_grade),
          {}, class: "w-full border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary" %>
    </div>
    <div>
      <%= f.label :payment_terms, t("clients.form_payment_terms"), class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
      <%= f.select :payment_terms,
          options_for_select([[t("clients.form_select"), ""]] + Client::PAYMENT_TERMS, @client.payment_terms),
          {}, class: "w-full border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary" %>
    </div>
    <div>
      <%= f.label :currency, t("clients.form_currency"), class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
      <%= f.select :currency,
          options_for_select(["AED", "USD", "KRW", "EUR", "CHF"].map { |c| [c, c] }, @client.currency || "AED"),
          {}, class: "w-full border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary" %>
    </div>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.label :address, t("clients.form_address"), class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
      <%= f.text_field :address, class: "w-full border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary" %>
    </div>
    <div>
      <%= f.label :website, t("clients.form_website"), class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
      <%= f.url_field :website, class: "w-full border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary", placeholder: "https://" %>
    </div>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.label :contract_start_date, t("clients.form_contract_start"), class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
      <%= f.date_field :contract_start_date, class: "w-full border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary" %>
    </div>
    <div>
      <%= f.label :ecount_code, t("clients.form_ecount_code"), class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
      <%= f.text_field :ecount_code, class: "w-full border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary" %>
    </div>
  </div>

  <div>
    <%= f.label :notes, t("clients.form_notes"), class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
    <%= f.text_area :notes, rows: 3, class: "w-full border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary" %>
  </div>

  <div>
    <%= f.label :default_assignee_id, "기본 담당자", class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
    <%= f.select :default_assignee_id,
        options_for_select([["(없음)", ""]] + User.where(role: [:member, :manager, :admin]).order(:name).map { |u| [u.name, u.id] }, @client.default_assignee_id),
        {}, class: "w-full border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary" %>
    <% if @client.default_assignee_id.blank? %>
      <p class="mt-1 text-xs text-amber-600 dark:text-amber-400 bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-700 rounded px-2 py-1">
        ⚠️ 기본 담당자가 없으면 신규 Order가 미배정 상태로 누적됩니다
      </p>
    <% else %>
      <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">이 발주처로 들어오는 Order의 기본 담당자</p>
    <% end %>
  </div>

  <div class="flex items-center gap-2">
    <%= f.check_box :active, class: "rounded border-gray-300 dark:border-gray-600 text-primary focus:ring-primary" %>
    <%= f.label :active, t("clients.form_active"), class: "text-sm font-medium text-gray-700 dark:text-gray-300" %>
  </div>

  <div class="flex gap-3 pt-2">
    <%= f.submit @client.new_record? ? t("clients.form_submit_create") : t("clients.form_submit_update"), class: "bg-primary text-white px-6 py-2 rounded-lg text-sm font-medium hover:bg-primary-dark transition-colors cursor-pointer" %>
    <%= link_to t("clients.form_cancel"), @client.new_record? ? clients_path : @client, class: "border border-gray-200 dark:border-gray-600 text-gray-600 dark:text-gray-500 px-6 py-2 rounded-lg text-sm font-medium hover:bg-gray-50 dark:hover:bg-gray-700" %>
  </div>
<% end %>
