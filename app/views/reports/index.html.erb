<%# 경영 리포트 고도화 — Chart.js + 기간 필터 + CSV + 인쇄 %>
<% content_for :page_title, "경영 리포트" %>

<%# Chart.js CDN %>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

<%# Print CSS %>
<style>
  @media print {
    nav, aside, header, .no-print { display: none !important; }
    .print-only { display: block !important; }
    .print-break { page-break-before: always; }
    body { font-size: 10pt; background: white !important; }
    .bg-white, .dark\:bg-gray-800 { box-shadow: none !important; border: 1px solid #e5e7eb !important; background: white !important; }
    canvas { display: none !important; }
    .chart-table { display: table !important; }
  }
  @media screen {
    .print-only { display: none !important; }
    .chart-table { display: none !important; }
  }
</style>

<%# 증감률 배지 헬퍼 %>
<%# delta_badge helper는 ReportsHelper에 정의됨 %>

<div class="flex flex-col gap-6">

  <%# ── 헤더 ── %>
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-gray-900 dark:text-white">경영 리포트</h1>
      <p class="text-sm text-gray-500 dark:text-gray-500 mt-0.5"><%= @from_str %> ~ <%= @to_str %></p>
    </div>
    <div class="flex items-center gap-2 no-print">
      <%# PDF 내보내기 %>
      <%= link_to reports_export_pdf_path(period: @period, from: params[:from], to: params[:to], board_id: @selected_board&.id),
            class: "inline-flex items-center gap-1.5 px-3 py-1.5 bg-[#1E3A5F] text-white rounded-lg text-sm hover:bg-[#16325C] transition-colors",
            target: "_blank" do %>
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
        PDF 내보내기
      <% end %>
      <%# CSV 다운로드 %>
      <%= link_to reports_export_csv_path(period: @period, from: params[:from], to: params[:to], board_id: @selected_board&.id, format: :csv),
            class: "inline-flex items-center gap-1.5 px-3 py-1.5 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors" do %>
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M3 15h18M9 3v18"/></svg>
        CSV 내보내기
      <% end %>
      <%# 인쇄 %>
      <button onclick="window.print()"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
        인쇄
      </button>
    </div>
  </div>

  <%# ── 필터 영역 ── %>
  <div class="no-print">
    <div class="flex flex-wrap items-center gap-3">
      <%# 보드 필터 %>
      <% if @boards.size > 1 %>
        <div class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-gray-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
          <select onchange="applyBoardFilter(this.value)"
                  class="text-sm border border-gray-300 dark:border-gray-600 rounded-lg px-3 py-1.5 bg-white dark:bg-gray-800 text-gray-900 dark:text-white focus:outline-none focus:border-[#00A1E0] focus:ring-1 focus:ring-[#00A1E0]">
            <option value="">전체 보드</option>
            <% @boards.each do |board| %>
              <option value="<%= board.id %>" <%= 'selected' if @selected_board&.id == board.id %>><%= board.name %></option>
            <% end %>
          </select>
        </div>
        <div class="w-px h-6 bg-gray-200 dark:bg-gray-700"></div>
      <% end %>
      <%# 기간 필터 %>
      <div class="flex gap-1 bg-gray-100 dark:bg-gray-800 p-1 rounded-lg">
        <% [
          ["this_month",   "이번달"],
          ["last_month",   "지난달"],
          ["this_quarter", "이번분기"],
          ["this_year",    "올해"],
          ["custom",       "직접입력"]
        ].each do |val, label| %>
          <% active_cls = @period == val ? 'bg-white dark:bg-gray-700 shadow text-gray-900 dark:text-white' : 'text-gray-500 dark:text-gray-500 hover:text-gray-700 dark:hover:text-gray-300' %>
          <%= link_to label, reports_path(period: val, board_id: @selected_board&.id),
                class: "px-3 py-1.5 rounded-md text-sm font-medium transition-colors cursor-pointer #{active_cls}" %>
        <% end %>
      </div>
      <%# 직접입력 날짜 picker %>
      <% if @period == "custom" %>
        <%= form_with url: reports_path, method: :get, class: "flex items-center gap-2" do |f| %>
          <%= f.hidden_field :period, value: "custom" %>
          <%= f.hidden_field :board_id, value: @selected_board&.id %>
          <%= f.date_field :from, value: params[:from] || @from_str,
                class: "text-sm border border-gray-200 dark:border-gray-600 rounded-lg px-3 py-1.5 bg-white dark:bg-gray-800 text-gray-900 dark:text-white" %>
          <span class="text-gray-500 text-sm">~</span>
          <%= f.date_field :to, value: params[:to] || @to_str,
                class: "text-sm border border-gray-200 dark:border-gray-600 rounded-lg px-3 py-1.5 bg-white dark:bg-gray-800 text-gray-900 dark:text-white" %>
          <%= f.submit "조회",
                class: "px-3 py-1.5 bg-primary text-white text-sm rounded-lg hover:bg-primary/90 cursor-pointer transition-colors" %>
        <% end %>
      <% end %>
    </div>
  </div>

  <%# ── KPI 카드 (7개) ── %>
  <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-7 gap-3">
    <%# 수주 건수 %>
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-4">
      <p class="text-xs text-gray-500 dark:text-gray-500">수주 건수</p>
      <p class="text-2xl font-bold text-gray-900 dark:text-white mt-1">
        <%= @kpi[:new_orders] %><span class="text-sm font-normal ml-0.5">건</span>
      </p>
      <div class="flex flex-wrap items-center gap-x-2 mt-1">
        <%= delta_badge(@kpi[:new_orders], @kpi[:prev_orders], label: "전기") %>
        <%= delta_badge(@kpi[:new_orders], @kpi[:yoy_orders], label: "YoY") %>
      </div>
    </div>
    <%# 납품 건수 %>
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-4">
      <p class="text-xs text-gray-500 dark:text-gray-500">납품 건수</p>
      <p class="text-2xl font-bold text-green-600 dark:text-green-400 mt-1">
        <%= @kpi[:delivered] %><span class="text-sm font-normal ml-0.5">건</span>
      </p>
      <div class="flex flex-wrap items-center gap-x-2 mt-1">
        <%= delta_badge(@kpi[:delivered], @kpi[:prev_delivered], label: "전기") %>
        <%= delta_badge(@kpi[:delivered], @kpi[:yoy_delivered], label: "YoY") %>
      </div>
    </div>
    <%# 수주액 %>
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-4">
      <p class="text-xs text-gray-500 dark:text-gray-500">수주액</p>
      <p class="text-2xl font-bold text-blue-600 dark:text-blue-400 mt-1">
        $<%= number_with_delimiter((@kpi[:total_value] / 1000).round) %><span class="text-sm font-normal ml-0.5">K</span>
      </p>
      <div class="flex flex-wrap items-center gap-x-2 mt-1">
        <%= delta_badge(@kpi[:total_value], @kpi[:prev_value], label: "전기") %>
        <%= delta_badge(@kpi[:total_value], @kpi[:yoy_value], label: "YoY") %>
      </div>
    </div>
    <%# 납기 준수율 %>
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-4">
      <p class="text-xs text-gray-500 dark:text-gray-500">납기 준수율</p>
      <p class="text-2xl font-bold mt-1 <%= @kpi[:on_time_rate] >= 90 ? 'text-green-600' : @kpi[:on_time_rate] >= 70 ? 'text-yellow-500' : 'text-red-500' %>">
        <%= @kpi[:on_time_rate] %>%
      </p>
      <div class="flex flex-wrap items-center gap-x-2 mt-1">
        <%= delta_badge(@kpi[:on_time_rate], @kpi[:prev_on_time], label: "전기") %>
        <%= delta_badge(@kpi[:on_time_rate], @kpi[:yoy_on_time], label: "YoY") %>
      </div>
    </div>
    <%# 납기 지연 %>
    <div class="bg-white dark:bg-gray-800 rounded-xl border <%= @kpi[:overdue] > 0 ? 'border-red-200 dark:border-red-800' : 'border-gray-200 dark:border-gray-700' %> p-4">
      <p class="text-xs text-gray-500 dark:text-gray-500">납기 지연</p>
      <p class="text-2xl font-bold mt-1 <%= @kpi[:overdue] > 0 ? 'text-red-600 dark:text-red-400' : 'text-gray-900 dark:text-white' %>">
        <%= @kpi[:overdue] %><span class="text-sm font-normal ml-0.5">건</span>
      </p>
    </div>
    <%# 긴급 처리 %>
    <div class="bg-white dark:bg-gray-800 rounded-xl border <%= @kpi[:urgent] > 0 ? 'border-orange-200 dark:border-orange-800' : 'border-gray-200 dark:border-gray-700' %> p-4">
      <p class="text-xs text-gray-500 dark:text-gray-500">긴급 처리</p>
      <p class="text-2xl font-bold mt-1 <%= @kpi[:urgent] > 0 ? 'text-orange-600 dark:text-orange-400' : 'text-gray-900 dark:text-white' %>">
        <%= @kpi[:urgent] %><span class="text-sm font-normal ml-0.5">건</span>
      </p>
    </div>
    <%# 평균 소요일 %>
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-4">
      <p class="text-xs text-gray-500 dark:text-gray-500">평균 소요일</p>
      <p class="text-2xl font-bold text-gray-900 dark:text-white mt-1">
        <%= @kpi[:avg_lead_days] %><span class="text-sm font-normal ml-0.5">일</span>
      </p>
    </div>
  </div>

  <%# ── 인쇄 전용 헤더 ── %>
  <div class="print-only mb-4">
    <div class="flex items-center justify-between border-b-2 border-gray-900 pb-3 mb-3">
      <div>
        <h1 class="text-xl font-bold text-gray-900">CPOFlow - 경영 리포트</h1>
        <p class="text-sm text-gray-600"><%= @from_str %> ~ <%= @to_str %><%= " | #{@selected_board.name}" if @selected_board %></p>
      </div>
      <p class="text-xs text-gray-500">출력일: <%= Date.today.strftime("%Y-%m-%d") %></p>
    </div>
  </div>

  <%# ── 월별 트렌드 인쇄용 테이블 ── %>
  <div class="print-break">
    <table class="chart-table w-full text-sm border border-gray-200 mb-4">
      <caption class="text-left text-sm font-semibold text-gray-700 mb-2">월별 수주 트렌드 (최근 12개월)</caption>
      <thead class="bg-gray-50">
        <tr>
          <th class="px-3 py-2 text-left text-xs font-semibold text-gray-500 border border-gray-200">월</th>
          <th class="px-3 py-2 text-right text-xs font-semibold text-gray-500 border border-gray-200">수주</th>
          <th class="px-3 py-2 text-right text-xs font-semibold text-gray-500 border border-gray-200">납품</th>
          <th class="px-3 py-2 text-right text-xs font-semibold text-gray-500 border border-gray-200">수주액($K)</th>
        </tr>
      </thead>
      <tbody>
        <% @monthly.each do |m| %>
          <tr>
            <td class="px-3 py-1.5 border border-gray-200 text-gray-700"><%= m[:label] %></td>
            <td class="px-3 py-1.5 border border-gray-200 text-right tabular-nums"><%= m[:orders] %></td>
            <td class="px-3 py-1.5 border border-gray-200 text-right tabular-nums"><%= m[:delivered] %></td>
            <td class="px-3 py-1.5 border border-gray-200 text-right tabular-nums">$<%= m[:value] %>K</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%# ── 차트 행 (2열) ── %>
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

    <%# 월별 트렌드 Chart.js %>
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-5">
      <h2 class="text-sm font-semibold text-gray-700 dark:text-gray-300 mb-4">월별 수주 트렌드 (최근 12개월)</h2>
      <div style="position:relative; height:220px;">
        <canvas id="trendChart"></canvas>
      </div>
    </div>

    <%# 파이프라인 퍼널 %>
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-5">
      <h2 class="text-sm font-semibold text-gray-700 dark:text-gray-300 mb-4">파이프라인 현황</h2>
      <% funnel_stages = [
           ["new_rfq",        "New",             "bg-gray-400"],
           ["make_quo",       "Make QUO",        "bg-blue-400"],
           ["pending_po",     "Pending PO",      "bg-indigo-400"],
           ["new_po",         "New PO",          "bg-purple-400"],
           ["delivery_items", "Delivery Items",  "bg-yellow-400"],
           ["problem",        "Problem",         "bg-orange-400"],
           ["get_grn",        "Get GRN",         "bg-green-500"],
           ["give_up",        "Give Up",         "bg-gray-200"]
         ]
         funnel_total = [@funnel.values.sum, 1].max %>
      <div class="flex flex-col gap-2.5">
        <% funnel_stages.each do |key, label, color| %>
          <% cnt = @funnel[key] || 0 %>
          <% pct = (cnt.to_f / funnel_total * 100).round(1) %>
          <div class="flex items-center gap-3">
            <span class="text-xs text-gray-500 dark:text-gray-500 w-24 flex-shrink-0"><%= label %></span>
            <div class="flex-1 bg-gray-100 dark:bg-gray-700 rounded-full h-5 relative overflow-hidden">
              <div class="<%= color %> h-5 rounded-full transition-all" style="width:<%= [pct, 1].max %>%"></div>
              <span class="absolute inset-0 flex items-center px-2 text-xs font-medium <%= cnt > 0 ? 'text-white' : 'text-gray-500' %>">
                <%= cnt %>건
              </span>
            </div>
            <span class="text-xs text-gray-500 dark:text-gray-500 w-10 text-right tabular-nums"><%= pct %>%</span>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <%# ── Top 10 (3열) ── %>
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

    <%# 발주처별 수주액 %>
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-5">
      <h2 class="text-sm font-semibold text-gray-700 dark:text-gray-300 mb-4">발주처별 수주액 Top 10</h2>
      <% if @by_client.any? %>
        <% max_val = [(@by_client.first&.last || 0).to_f, 1].max %>
        <div class="flex flex-col gap-2">
          <% @by_client.each do |name, val| %>
            <div class="flex items-center gap-2">
              <span class="text-xs text-gray-600 dark:text-gray-500 w-28 truncate" title="<%= name %>"><%= name&.truncate(16) %></span>
              <div class="flex-1 bg-gray-100 dark:bg-gray-700 rounded-full h-2">
                <div class="h-2 rounded-full" style="width:<%= [(val.to_f / max_val * 100).round, 2].max %>%; background-color:rgb(var(--color-primary, 30 58 95))"></div>
              </div>
              <span class="text-xs text-gray-500 dark:text-gray-500 w-16 text-right tabular-nums">$<%= number_with_delimiter((val.to_f / 1000).round) %>K</span>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-sm text-gray-500 dark:text-gray-500 text-center py-6">해당 기간 데이터 없음</p>
      <% end %>
    </div>

    <%# 거래처별 발주 건수 %>
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-5">
      <h2 class="text-sm font-semibold text-gray-700 dark:text-gray-300 mb-4">거래처별 발주 건수</h2>
      <% if @by_supplier.any? %>
        <% max_cnt = [(@by_supplier.first&.last || 0).to_i, 1].max %>
        <div class="flex flex-col gap-2">
          <% @by_supplier.each do |name, cnt| %>
            <div class="flex items-center gap-2">
              <span class="text-xs text-gray-600 dark:text-gray-500 w-28 truncate" title="<%= name %>"><%= name&.truncate(16) %></span>
              <div class="flex-1 bg-gray-100 dark:bg-gray-700 rounded-full h-2">
                <div class="h-2 rounded-full" style="width:<%= [(cnt.to_f / max_cnt * 100).round, 2].max %>%; background-color:rgb(var(--color-accent, 0 161 224))"></div>
              </div>
              <span class="text-xs text-gray-500 dark:text-gray-500 w-10 text-right tabular-nums"><%= cnt %>건</span>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-sm text-gray-500 dark:text-gray-500 text-center py-6">해당 기간 데이터 없음</p>
      <% end %>
    </div>

    <%# 프로젝트별 수주액 %>
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-5">
      <h2 class="text-sm font-semibold text-gray-700 dark:text-gray-300 mb-4">프로젝트별 수주액</h2>
      <% if @by_project.any? %>
        <% max_pv = [(@by_project.first&.last || 0).to_f, 1].max %>
        <div class="flex flex-col gap-2">
          <% @by_project.each do |name, val| %>
            <div class="flex items-center gap-2">
              <span class="text-xs text-gray-600 dark:text-gray-500 w-28 truncate" title="<%= name %>"><%= name&.truncate(16) %></span>
              <div class="flex-1 bg-gray-100 dark:bg-gray-700 rounded-full h-2">
                <div class="h-2 rounded-full" style="width:<%= [(val.to_f / max_pv * 100).round, 2].max %>%; background-color:#7C3AED"></div>
              </div>
              <span class="text-xs text-gray-500 dark:text-gray-500 w-16 text-right tabular-nums">$<%= number_with_delimiter((val.to_f / 1000).round) %>K</span>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-sm text-gray-500 dark:text-gray-500 text-center py-6">해당 기간 데이터 없음</p>
      <% end %>
    </div>
  </div>

  <%# ── 담당자별 성과 ── %>
  <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 overflow-hidden print-break">
    <div class="px-5 py-4 border-b border-gray-200 dark:border-gray-700">
      <h2 class="text-sm font-semibold text-gray-700 dark:text-gray-300">담당자별 성과</h2>
    </div>
    <% if @by_assignee.any? %>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="bg-gray-50 dark:bg-gray-700/50">
            <tr>
              <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-500">담당자</th>
              <th class="px-5 py-3 text-right text-xs font-semibold text-gray-500 dark:text-gray-500">담당 건수</th>
              <th class="px-5 py-3 text-right text-xs font-semibold text-gray-500 dark:text-gray-500">납품 건수</th>
              <th class="px-5 py-3 text-right text-xs font-semibold text-gray-500 dark:text-gray-500">납기 준수율</th>
              <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-500">납기 준수 현황</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 dark:divide-gray-700">
            <% @by_assignee.each do |u| %>
              <% rate = u.delivered_count.to_i > 0 ? (u.on_time_count.to_f / u.delivered_count * 100).round(1) : 0.0 %>
              <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/30">
                <td class="px-5 py-3 font-medium text-gray-900 dark:text-white"><%= u.name %></td>
                <td class="px-5 py-3 text-right tabular-nums text-gray-700 dark:text-gray-300"><%= u.order_count %></td>
                <td class="px-5 py-3 text-right tabular-nums text-green-600 dark:text-green-400 font-medium"><%= u.delivered_count %></td>
                <td class="px-5 py-3 text-right tabular-nums">
                  <span class="font-semibold <%= rate >= 90 ? 'text-green-600 dark:text-green-400' : rate >= 70 ? 'text-yellow-600 dark:text-yellow-400' : 'text-red-500 dark:text-red-400' %>">
                    <%= rate %>%
                  </span>
                </td>
                <td class="px-5 py-3">
                  <% bar_w = [rate.to_i, 2].max %>
                  <div class="w-32 bg-gray-100 dark:bg-gray-700 rounded-full h-2">
                    <div class="h-2 rounded-full <%= rate >= 90 ? 'bg-green-500' : rate >= 70 ? 'bg-yellow-400' : 'bg-red-400' %>"
                         style="width:<%= bar_w %>%"></div>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="flex flex-col items-center justify-center py-12 text-center">
        <svg class="w-10 h-10 text-gray-200 dark:text-gray-600 mb-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        <p class="text-sm text-gray-500 dark:text-gray-500">해당 기간 담당자 데이터 없음</p>
      </div>
    <% end %>
  </div>

</div>

<%# ── Chart.js 스크립트 ── %>
<script>
(function() {
  const isDark = document.documentElement.classList.contains('dark');
  const gridColor  = isDark ? 'rgba(255,255,255,0.08)' : 'rgba(0,0,0,0.06)';
  const tickColor  = isDark ? '#9ca3af' : '#6b7280';
  const labels     = <%= @monthly.map { |m| m[:label] }.to_json.html_safe %>;
  const ordersData = <%= @monthly.map { |m| m[:orders] }.to_json.html_safe %>;
  const delivData  = <%= @monthly.map { |m| m[:delivered] }.to_json.html_safe %>;
  const valueData  = <%= @monthly.map { |m| m[:value] }.to_json.html_safe %>;

  const ctx = document.getElementById('trendChart');
  if (!ctx) return;

  // 월 라벨 → 날짜 범위 매핑 (yy.mm → from/to)
  function monthLabelToRange(label) {
    const parts = label.split('.');
    const year = 2000 + parseInt(parts[0]);
    const month = parseInt(parts[1]) - 1;
    const from = new Date(year, month, 1);
    const to = new Date(year, month + 1, 0);
    const fmt = d => d.toISOString().slice(0, 10);
    return { from: fmt(from), to: fmt(to) };
  }

  new Chart(ctx, {
    data: {
      labels,
      datasets: [
        {
          type: 'line',
          label: '수주',
          data: ordersData,
          borderColor: '#1E3A5F',
          backgroundColor: 'rgba(30,58,95,0.08)',
          borderWidth: 2,
          pointRadius: 3,
          tension: 0.35,
          fill: true,
          yAxisID: 'y'
        },
        {
          type: 'line',
          label: '납품',
          data: delivData,
          borderColor: '#1E8E3E',
          backgroundColor: 'rgba(30,142,62,0.06)',
          borderWidth: 2,
          pointRadius: 3,
          tension: 0.35,
          fill: true,
          yAxisID: 'y'
        },
        {
          type: 'bar',
          label: '수주액($K)',
          data: valueData,
          backgroundColor: 'rgba(0,161,224,0.25)',
          borderColor: 'rgba(0,161,224,0.6)',
          borderWidth: 1,
          borderRadius: 3,
          yAxisID: 'y1'
        }
      ]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      interaction: { mode: 'index', intersect: false },
      onClick: function(evt, elements) {
        if (!elements.length) return;
        const idx = elements[0].index;
        const range = monthLabelToRange(labels[idx]);
        window.location = '/orders?created_from=' + range.from + '&created_to=' + range.to;
      },
      plugins: {
        legend: { labels: { color: tickColor, font: { size: 11 }, boxWidth: 12, padding: 12 } },
        tooltip: {
          callbacks: {
            footer: function() { return '클릭하면 해당 월 주문 목록으로 이동'; }
          }
        }
      },
      scales: {
        x: {
          grid: { color: gridColor },
          ticks: { color: tickColor, font: { size: 10 } }
        },
        y: {
          position: 'left',
          grid: { color: gridColor },
          ticks: { color: tickColor, font: { size: 10 } },
          title: { display: true, text: '건수', color: tickColor, font: { size: 10 } }
        },
        y1: {
          position: 'right',
          grid: { drawOnChartArea: false },
          ticks: { color: tickColor, font: { size: 10 }, callback: v => '$' + v + 'K' },
          title: { display: true, text: '수주액', color: tickColor, font: { size: 10 } }
        }
      }
    }
  });
})();

// 보드 필터
function applyBoardFilter(boardId) {
  const url = new URL(window.location.href);
  if (boardId) {
    url.searchParams.set('board_id', boardId);
  } else {
    url.searchParams.delete('board_id');
  }
  window.location = url.toString();
}
</script>
