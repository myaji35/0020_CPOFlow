<% content_for :page_title, t("dashboard.title") %>

<%# ISS-240: 신규 사용자 온보딩 카드 (onboarded? false일 때만 표시) %>
<% unless current_user.onboarded? %>
  <% steps = current_user.onboarding_steps %>
  <% done_count = steps.count { |s| s[:done] } %>
  <div class="mb-6 bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 overflow-hidden">
    <%# 헤더 + 진행 바 %>
    <div class="px-6 pt-5 pb-4 border-b border-gray-100 dark:border-gray-700">
      <div class="flex items-center justify-between mb-3">
        <div class="flex items-center gap-2">
          <div class="w-8 h-8 rounded-lg flex items-center justify-center" style="background:#166c72;">
            <svg class="w-4 h-4 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
              <polyline points="9 22 9 12 15 12 15 22"/>
            </svg>
          </div>
          <div>
            <p class="text-sm font-semibold text-gray-900 dark:text-white"><%= t("dashboard.onboarding.title") %></p>
            <p class="text-xs text-gray-500 dark:text-gray-400"><%= t("dashboard.onboarding.subtitle") %></p>
          </div>
        </div>
        <div class="flex items-center gap-3">
          <%# ISS-280: 3분 둘러보기 튜토리얼 — 신규 사용자 온보딩 보강 %>
          <a href="/help/getting-started.html" target="_blank" rel="noopener"
             class="inline-flex items-center gap-1 text-xs font-medium px-2.5 py-1 border border-gray-300 dark:border-gray-600 rounded-md text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors">
            <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
            <%= t("dashboard.onboarding.tour") %>
          </a>
          <span class="text-sm font-semibold" style="color:#166c72;"><%= done_count %> / 3</span>
        </div>
      </div>
      <%# 진행 바 %>
      <div class="h-1.5 bg-gray-100 dark:bg-gray-700 rounded-full overflow-hidden">
        <div class="h-full rounded-full transition-all duration-500"
             style="background:#166c72; width:<%= (done_count / 3.0 * 100).round %>%"></div>
      </div>
    </div>
    <%# 3단계 체크리스트 %>
    <div class="divide-y divide-gray-100 dark:divide-gray-700">
      <%# Step 1: Gmail 연결 %>
      <% step1 = steps[0] %>
      <div class="px-6 py-4 flex items-center justify-between gap-4">
        <div class="flex items-center gap-3 min-w-0">
          <%# 체크 아이콘 %>
          <% if step1[:done] %>
            <div class="w-7 h-7 rounded-full flex items-center justify-center shrink-0" style="background:#166c72;">
              <svg class="w-4 h-4 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
            </div>
          <% else %>
            <div class="w-7 h-7 rounded-full border-2 border-gray-300 dark:border-gray-600 flex items-center justify-center shrink-0">
              <span class="text-xs font-semibold text-gray-400 dark:text-gray-500">1</span>
            </div>
          <% end %>
          <div class="min-w-0">
            <p class="text-sm font-medium <%= step1[:done] ? 'line-through text-gray-400 dark:text-gray-500' : 'text-gray-900 dark:text-white' %>">
              <%= t("dashboard.onboarding.step1_title") %>
            </p>
            <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5"><%= t("dashboard.onboarding.step1_desc") %></p>
          </div>
        </div>
        <% unless step1[:done] %>
          <%= link_to gmail_oauth_authorize_path,
                data: { turbo: false },
                class: "shrink-0 inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-white rounded-lg transition-opacity hover:opacity-90",
                style: "background:#166c72;" do %>
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/>
            </svg>
            <%= t("dashboard.onboarding.step1_action") %>
          <% end %>
        <% end %>
      </div>
      <%# Step 2: 첫 발주 만들기 %>
      <% step2 = steps[1] %>
      <div class="px-6 py-4 flex items-center justify-between gap-4">
        <div class="flex items-center gap-3 min-w-0">
          <% if step2[:done] %>
            <div class="w-7 h-7 rounded-full flex items-center justify-center shrink-0" style="background:#166c72;">
              <svg class="w-4 h-4 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
            </div>
          <% else %>
            <div class="w-7 h-7 rounded-full border-2 border-gray-300 dark:border-gray-600 flex items-center justify-center shrink-0">
              <span class="text-xs font-semibold text-gray-400 dark:text-gray-500">2</span>
            </div>
          <% end %>
          <div class="min-w-0">
            <p class="text-sm font-medium <%= step2[:done] ? 'line-through text-gray-400 dark:text-gray-500' : 'text-gray-900 dark:text-white' %>">
              <%= t("dashboard.onboarding.step2_title") %>
            </p>
            <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5"><%= t("dashboard.onboarding.step2_desc") %></p>
          </div>
        </div>
        <% unless step2[:done] %>
          <%= link_to new_order_path,
                class: "shrink-0 inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-white rounded-lg transition-opacity hover:opacity-90",
                style: "background:#166c72;" do %>
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
            </svg>
            <%= t("dashboard.onboarding.step2_action") %>
          <% end %>
        <% end %>
      </div>
      <%# Step 3: 담당자 배정 받기 %>
      <% step3 = steps[2] %>
      <div class="px-6 py-4 flex items-center justify-between gap-4">
        <div class="flex items-center gap-3 min-w-0">
          <% if step3[:done] %>
            <div class="w-7 h-7 rounded-full flex items-center justify-center shrink-0" style="background:#166c72;">
              <svg class="w-4 h-4 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
            </div>
          <% else %>
            <div class="w-7 h-7 rounded-full border-2 border-gray-300 dark:border-gray-600 flex items-center justify-center shrink-0">
              <span class="text-xs font-semibold text-gray-400 dark:text-gray-500">3</span>
            </div>
          <% end %>
          <div class="min-w-0">
            <p class="text-sm font-medium <%= step3[:done] ? 'line-through text-gray-400 dark:text-gray-500' : 'text-gray-900 dark:text-white' %>">
              <%= t("dashboard.onboarding.step3_title") %>
            </p>
            <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5"><%= t("dashboard.onboarding.step3_desc") %></p>
          </div>
        </div>
        <% unless step3[:done] %>
          <%= link_to kanban_path,
                class: "shrink-0 inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-gray-700 dark:text-gray-300 bg-gray-100 dark:bg-gray-700 rounded-lg transition-opacity hover:opacity-80" do %>
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="7" height="18" rx="1"/><rect x="14" y="3" width="7" height="10" rx="1"/>
            </svg>
            <%= t("dashboard.onboarding.step3_action") %>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
<% end %>

<%# ISS-039: Critical Order 즉시 조치 배너 %>
<% critical_count = Order.critical.count %>
<% if critical_count > 0 %>
  <div class="mb-4 rounded-lg border-l-4 border-[#D93025] bg-[#FEE4E2] p-4 flex items-center justify-between gap-4">
    <div class="flex items-center gap-3">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none"
           stroke="#D93025" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0">
        <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
        <line x1="12" y1="9" x2="12" y2="13"/>
        <line x1="12" y1="17" x2="12.01" y2="17"/>
      </svg>
      <div>
        <p class="text-sm font-bold text-[#D93025]"><%= t("dashboard.critical_banner", count: critical_count) %></p>
        <p class="text-xs text-[#16325C] mt-0.5"><%= t("dashboard.critical_detail") %></p>
      </div>
    </div>
    <%= link_to t("dashboard.critical_action"),
                kanban_path(filter: "overdue"),
                class: "shrink-0 inline-flex items-center px-4 py-2 rounded-lg text-sm font-semibold text-white hover:opacity-90 transition-opacity",
                style: "background:#D93025;" %>
  </div>
<% end %>

<%# FR-01: Quick Actions 헤더 %>
<div class="flex items-center justify-between mb-6">
  <div>
    <h1 class="text-[22px] font-semibold tracking-tight text-ink-900 dark:text-white"><%= t("dashboard.title") %></h1>
    <p class="text-[12px] text-ink-500 mt-0.5"><%= t("dashboard.subtitle") %></p>
  </div>
  <div class="flex items-center gap-2">
    <%= link_to new_order_path,
          class: "flex items-center gap-1.5 h-8 px-3 bg-brand-600 text-white text-[13px] font-medium rounded-md hover:bg-brand-700 transition-colors" do %>
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
      </svg>
      <%= t("dashboard.new_order_btn") %>
    <% end %>
    <%= link_to calendar_path,
          class: "flex items-center gap-1.5 px-3 py-2 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 text-gray-700 dark:text-gray-300 text-sm font-medium rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors" do %>
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/>
        <line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
      </svg>
      <%= t("dashboard.calendar_link") %>
    <% end %>
    <%= link_to kanban_path,
          class: "flex items-center gap-1.5 px-3 py-2 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 text-gray-700 dark:text-gray-300 text-sm font-medium rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors" do %>
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="3" width="7" height="18" rx="1"/><rect x="14" y="3" width="7" height="10" rx="1"/>
        <rect x="14" y="17" width="7" height="4" rx="1"/>
      </svg>
      <%= t("dashboard.kanban_link") %>
    <% end %>
  </div>
</div>

<%# ISS-273: manager/admin 전용 팀 요약 KPI — 상단 배치 (0.5초 룰)
    하단 '담당자별 워크로드' 풀 테이블로 가는 점프 링크도 포함 %>
<% if (current_user.admin? || current_user.manager?) && @assignee_workload.present? %>
  <% team_overdue = @assignee_workload.sum { |u| u.overdue_count.to_i } %>
  <% team_urgent  = @assignee_workload.sum { |u| u.urgent_count.to_i } %>
  <% team_total   = @assignee_workload.sum { |u| u.total_count.to_i } %>
  <% top_overloaded = @assignee_workload.sort_by { |u| -u.total_count.to_i }.first(3) %>
  <div class="grid grid-cols-1 md:grid-cols-4 gap-3 mb-6">
    <a href="#team-workload" class="p-4 bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 hover:border-[#166c72] hover:shadow-sm transition-all">
      <p class="text-xs text-gray-500 dark:text-gray-400 font-medium"><%= t("dashboard.team_total") %></p>
      <p class="text-2xl font-bold text-gray-900 dark:text-white mt-1"><%= team_total %></p>
      <p class="text-xs text-gray-500 mt-1"><%= t("dashboard.team_assignees", count: @assignee_workload.size) %></p>
    </a>
    <a href="#team-workload" class="p-4 bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 hover:border-[#c84431] hover:shadow-sm transition-all">
      <p class="text-xs text-gray-500 dark:text-gray-400 font-medium"><%= t("dashboard.team_overdue") %></p>
      <p class="text-2xl font-bold <%= team_overdue.positive? ? 'text-[#c84431]' : 'text-gray-900 dark:text-white' %> mt-1"><%= team_overdue %></p>
      <p class="text-xs text-gray-500 mt-1"><%= team_overdue.positive? ? t("dashboard.action_needed") : t("dashboard.normal") %></p>
    </a>
    <a href="#team-workload" class="p-4 bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 hover:border-[#d99a2a] hover:shadow-sm transition-all">
      <p class="text-xs text-gray-500 dark:text-gray-400 font-medium"><%= t("dashboard.team_urgent") %></p>
      <p class="text-2xl font-bold <%= team_urgent.positive? ? 'text-[#d99a2a]' : 'text-gray-900 dark:text-white' %> mt-1"><%= team_urgent %></p>
      <p class="text-xs text-gray-500 mt-1"><%= team_urgent.positive? ? t("dashboard.sla_warning") : t("dashboard.normal") %></p>
    </a>
    <div class="p-4 bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700">
      <p class="text-xs text-gray-500 dark:text-gray-400 font-medium"><%= t("dashboard.team_top3") %></p>
      <div class="mt-1 space-y-0.5">
        <% top_overloaded.each do |u| %>
          <div class="flex items-center justify-between text-xs">
            <span class="truncate text-gray-800 dark:text-gray-200"><%= u.name.presence || u.email.split('@').first %></span>
            <span class="font-semibold text-gray-900 dark:text-white"><%= u.total_count %></span>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>

<%# 보드별 요약 — admin/owner만 전체, 일반 사용자는 접근 가능한 보드만 %>
<% if @board_summaries.size > 1 %>
  <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-6">
    <% @board_summaries.each do |summary| %>
      <% next unless can_access_board?(summary[:board]) %>
      <a href="<%= kanban_path(board_id: summary[:board].id) %>"
         class="p-4 bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 hover:border-[#00A1E0] hover:shadow-sm transition-all">
        <p class="text-xs text-gray-500 dark:text-gray-400 font-medium"><%= summary[:board].name %></p>
        <p class="text-2xl font-bold text-gray-900 dark:text-white mt-1"><%= summary[:total] %></p>
        <div class="flex gap-3 mt-2 text-xs">
          <span class="text-blue-600 dark:text-blue-400"><%= t("dashboard.board_summary_new", count: summary[:new_rfq]) %></span>
          <span class="text-amber-600 dark:text-amber-400"><%= t("dashboard.board_summary_in_progress", count: summary[:in_progress]) %></span>
          <span class="text-emerald-600 dark:text-emerald-400"><%= t("dashboard.board_summary_done", count: summary[:done]) %></span>
        </div>
      </a>
    <% end %>
  </div>
<% end %>

<%# ISS-216: 이번 주 / 다음 주 예정 납기 위젯 %>
<% if (@due_this_week_count.to_i > 0) || (@due_next_week_count.to_i > 0) %>
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-6">
    <%# 이번 주 %>
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-4">
      <div class="flex items-center justify-between mb-3">
        <div class="flex items-center gap-2">
          <div class="w-8 h-8 rounded-lg bg-[#00A1E0]/10 flex items-center justify-center">
            <svg class="w-4 h-4 text-[#00A1E0]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          </div>
          <div>
            <h3 class="text-sm font-bold text-gray-900 dark:text-white"><%= t("dashboard.due_this_week") %></h3>
            <p class="text-xs text-gray-500 dark:text-gray-400"><%= t("dashboard.due_this_week_range", from: Date.today.strftime("%m/%d"), to: Date.today.end_of_week.strftime("%m/%d"), count: @due_this_week_count) %></p>
          </div>
        </div>
        <% if @due_this_week_count > @due_this_week.size %>
          <%= link_to orders_path(filter: "this_week"), class: "text-xs text-[#00A1E0] hover:underline" do %>
            <%= t("dashboard.view_all_count", count: @due_this_week_count) %>
          <% end %>
        <% end %>
      </div>
      <% if @due_this_week.any? %>
        <ul class="divide-y divide-gray-100 dark:divide-gray-700">
          <% @due_this_week.each do |o| %>
            <% d_day = (o.due_date - Date.today).to_i %>
            <% urgency = d_day < 0 ? 'text-[#D93025]' : (d_day <= 1 ? 'text-[#F4A83A]' : 'text-gray-700 dark:text-gray-300') %>
            <li class="py-2 flex items-center gap-3">
              <span class="text-xs font-bold tabular-nums w-12 shrink-0 <%= urgency %>">
                <%= d_day < 0 ? "D+#{d_day.abs}" : (d_day.zero? ? "D-Day" : "D-#{d_day}") %>
              </span>
              <div class="flex-1 min-w-0">
                <%= link_to o.title.presence || t("dashboard.no_title"), order_path(o),
                      class: "text-sm font-medium text-gray-900 dark:text-white hover:text-[#00A1E0] truncate block" %>
                <p class="text-xs text-gray-500 dark:text-gray-500">
                  <%= o.client&.name || "—" %> · <%= o.due_date.strftime("%m/%d") %>
                  <% if o.assignees.any? %> · <%= o.assignees.map(&:name).join(", ").truncate(30) %><% end %>
                </p>
              </div>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-xs text-gray-400 dark:text-gray-500 text-center py-4"><%= t("dashboard.no_due_this_week") %></p>
      <% end %>
    </div>

    <%# 다음 주 %>
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-4">
      <div class="flex items-center justify-between mb-3">
        <div class="flex items-center gap-2">
          <div class="w-8 h-8 rounded-lg bg-gray-100 dark:bg-gray-700 flex items-center justify-center">
            <svg class="w-4 h-4 text-gray-600 dark:text-gray-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          </div>
          <div>
            <h3 class="text-sm font-bold text-gray-900 dark:text-white"><%= t("dashboard.due_next_week") %></h3>
            <p class="text-xs text-gray-500 dark:text-gray-400"><%= t("dashboard.due_next_week_range", from: (Date.today + 1.week).beginning_of_week.strftime("%m/%d"), to: (Date.today + 1.week).end_of_week.strftime("%m/%d"), count: @due_next_week_count) %></p>
          </div>
        </div>
      </div>
      <% if @due_next_week.any? %>
        <ul class="divide-y divide-gray-100 dark:divide-gray-700">
          <% @due_next_week.each do |o| %>
            <li class="py-2 flex items-center gap-3">
              <span class="text-xs font-medium text-gray-500 tabular-nums w-12 shrink-0">
                <%= o.due_date.strftime("%m/%d") %>
              </span>
              <div class="flex-1 min-w-0">
                <%= link_to o.title.presence || t("dashboard.no_title"), order_path(o),
                      class: "text-sm font-medium text-gray-700 dark:text-gray-300 hover:text-[#00A1E0] truncate block" %>
                <p class="text-xs text-gray-500 dark:text-gray-500">
                  <%= o.client&.name || "—" %>
                  <% if o.assignees.any? %> · <%= o.assignees.map(&:name).join(", ").truncate(30) %><% end %>
                </p>
              </div>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-xs text-gray-400 dark:text-gray-500 text-center py-4"><%= t("dashboard.no_due_next_week") %></p>
      <% end %>
    </div>
  </div>
<% end %>

<!-- ════════════════════════════════════════════════════════════
     ROW 1: 핵심 KPI 카드 (6개)
     ════════════════════════════════════════════════════════════ -->
<div class="grid grid-cols-2 lg:grid-cols-3 xl:grid-cols-6 gap-3 mb-6">

  <!-- 1. 진행 중 발주 -->
  <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-4">
    <div class="flex items-start justify-between">
      <div>
        <p class="text-xs font-medium text-gray-500 dark:text-gray-500 uppercase tracking-wide mb-2"><%= t("dashboard.kpi_in_progress") %></p>
        <p class="text-3xl font-bold text-gray-900 dark:text-white"><%= @total_active %></p>
        <p class="text-xs text-gray-500 dark:text-gray-500 mt-1"><%= t("dashboard.kpi_unit") %></p>
      </div>
      <div class="w-9 h-9 rounded-lg bg-blue-50 dark:bg-blue-900/30 flex items-center justify-center">
        <svg class="w-5 h-5 text-blue-600 dark:text-blue-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="3" width="20" height="14" rx="2"/>
          <path d="M8 21h8M12 17v4"/>
        </svg>
      </div>
    </div>
    <%# FR-03: 7일 미니 스파크라인 %>
    <% if @daily_sparkline.any?(&:positive?) %>
      <% max_s = [@daily_sparkline.max, 1].max %>
      <div class="flex items-end gap-px mt-3 h-6">
        <% @daily_sparkline.each do |val| %>
          <div class="flex-1 rounded-sm bg-blue-200 dark:bg-blue-700/60"
               style="height: <%= [val.to_f / max_s * 100, 8].max.round %>%"
               title="<%= val %>건"></div>
        <% end %>
      </div>
      <p class="text-xs text-gray-500 dark:text-gray-500 mt-1"><%= t("dashboard.kpi_trend_7days") %></p>
    <% end %>
  </div>

  <!-- 2. 이번달 납품 -->
  <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-4">
    <div class="flex items-start justify-between">
      <div>
        <p class="text-xs font-medium text-gray-500 dark:text-gray-500 uppercase tracking-wide mb-2"><%= t("dashboard.kpi_delivered_this_month") %></p>
        <p class="text-3xl font-bold text-green-600 dark:text-green-400"><%= @delivered_this_month %></p>
        <p class="text-xs text-gray-500 dark:text-gray-500 mt-1"><%= t("dashboard.kpi_delivered_unit") %></p>
      </div>
      <div class="w-9 h-9 rounded-lg bg-green-50 dark:bg-green-900/30 flex items-center justify-center">
        <svg class="w-5 h-5 text-green-600 dark:text-green-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
          <polyline points="22 4 12 14.01 9 11.01"/>
        </svg>
      </div>
    </div>
  </div>

  <!-- 3. 지연 발주 (FR-02: 드릴다운) -->
  <div class="bg-white dark:bg-gray-800 rounded-xl border <%= @overdue_count > 0 ? 'border-red-200 dark:border-red-700 bg-red-50 dark:bg-red-900/20' : 'border-gray-200 dark:border-gray-700' %> p-4
              <%= @overdue_count > 0 ? 'cursor-pointer select-none hover:opacity-90 transition-opacity' : '' %>"
       <%= @overdue_count > 0 ? 'onclick="toggleKpiPanel(\'overdue\')"' : '' %>>
    <div class="flex items-start justify-between">
      <div>
        <p class="text-xs font-medium text-gray-500 dark:text-gray-500 uppercase tracking-wide mb-2"><%= t("dashboard.kpi_overdue") %></p>
        <p class="text-3xl font-bold <%= @overdue_count > 0 ? 'text-red-600 dark:text-red-400' : 'text-gray-900 dark:text-white' %>"><%= @overdue_count %></p>
        <p class="text-xs text-gray-500 dark:text-gray-500 mt-1"><%= @overdue_count > 0 ? t("dashboard.kpi_overdue_action") : t("dashboard.kpi_overdue_ok") %></p>
        <% if @overdue_count > 0 %>
          <p class="text-xs text-red-400 dark:text-red-500 mt-1.5"><%= t("dashboard.kpi_click_to_view") %></p>
        <% end %>
      </div>
      <div class="w-9 h-9 rounded-lg <%= @overdue_count > 0 ? 'bg-red-100 dark:bg-red-900/40' : 'bg-gray-50 dark:bg-gray-700' %> flex items-center justify-center">
        <svg class="w-5 h-5 <%= @overdue_count > 0 ? 'text-red-500' : 'text-gray-500' %>" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/>
          <line x1="12" y1="8" x2="12" y2="12"/>
          <line x1="12" y1="16" x2="12.01" y2="16"/>
        </svg>
      </div>
    </div>
  </div>

  <!-- 4. 긴급 발주 (D-7) (FR-02: 드릴다운) -->
  <div class="bg-white dark:bg-gray-800 rounded-xl border <%= @urgent_count > 0 ? 'border-orange-200 dark:border-orange-700 bg-orange-50 dark:bg-orange-900/20' : 'border-gray-200 dark:border-gray-700' %> p-4
              <%= @urgent_count > 0 ? 'cursor-pointer select-none hover:opacity-90 transition-opacity' : '' %>"
       <%= @urgent_count > 0 ? 'onclick="toggleKpiPanel(\'urgent\')"' : '' %>>
    <div class="flex items-start justify-between">
      <div>
        <p class="text-xs font-medium text-gray-500 dark:text-gray-500 uppercase tracking-wide mb-2"><%= t("dashboard.kpi_urgent_d7") %></p>
        <p class="text-3xl font-bold <%= @urgent_count > 0 ? 'text-orange-600 dark:text-orange-400' : 'text-gray-900 dark:text-white' %>"><%= @urgent_count %></p>
        <p class="text-xs text-gray-500 dark:text-gray-500 mt-1"><%= t("dashboard.kpi_urgent_unit") %></p>
        <% if @urgent_count > 0 %>
          <p class="text-xs text-orange-400 dark:text-orange-500 mt-1.5"><%= t("dashboard.kpi_click_to_view") %></p>
        <% end %>
      </div>
      <div class="w-9 h-9 rounded-lg <%= @urgent_count > 0 ? 'bg-orange-100 dark:bg-orange-900/40' : 'bg-gray-50 dark:bg-gray-700' %> flex items-center justify-center">
        <svg class="w-5 h-5 <%= @urgent_count > 0 ? 'text-orange-500' : 'text-gray-500' %>" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/>
          <polyline points="12 6 12 12 16 14"/>
        </svg>
      </div>
    </div>
  </div>

  <!-- 5. 납기 준수율 (이번달) -->
  <%# nil = 이번달 납기완료 데이터 없음 (측정 불가) %>
  <% rate_no_data = @on_time_rate_this_month.nil? %>
  <% rate_val     = @on_time_rate_this_month.to_f %>
  <% rate_color   = rate_no_data ? 'text-gray-400 dark:text-gray-500' : rate_val >= 90 ? 'text-green-600 dark:text-green-400' : rate_val >= 75 ? 'text-orange-500 dark:text-orange-400' : 'text-red-500 dark:text-red-400' %>
  <% rate_trend   = (!rate_no_data && @on_time_rate_last_month.present?) ? (rate_val - @on_time_rate_last_month.to_f) : nil %>
  <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-4">
    <div class="flex items-start justify-between">
      <div>
        <p class="text-xs font-medium text-gray-500 dark:text-gray-500 uppercase tracking-wide mb-2"><%= t("dashboard.kpi_on_time_rate") %></p>
        <% if rate_no_data %>
          <p class="text-3xl font-bold text-gray-300 dark:text-gray-600">—</p>
          <p class="text-xs text-gray-400 dark:text-gray-500 mt-1"><%= t("dashboard.kpi_no_data") %></p>
        <% else %>
          <p class="text-3xl font-bold <%= rate_color %>"><%= rate_val %>%</p>
          <% if rate_trend && rate_trend.abs >= 0.1 %>
            <p class="text-xs mt-1 <%= rate_trend > 0 ? 'text-green-500' : 'text-red-500' %>">
              <span class="inline-flex items-center gap-0.5">
                <% if rate_trend > 0 %>
                  <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="18 15 12 9 6 15"/></svg>
                <% else %>
                  <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                <% end %>
                <%= t("dashboard.kpi_vs_last_month", pct: rate_trend.abs.round(1)) %>
              </span>
            </p>
          <% else %>
            <p class="text-xs text-gray-400 dark:text-gray-500 mt-1"><%= t("dashboard.kpi_no_change") %></p>
          <% end %>
        <% end %>
      </div>
      <div class="w-9 h-9 rounded-lg bg-purple-50 dark:bg-purple-900/30 flex items-center justify-center">
        <svg class="w-5 h-5 text-purple-600 dark:text-purple-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
        </svg>
      </div>
    </div>
  </div>

  <!-- 6. 이번달 수주 금액 -->
  <%# ISS-040 보강: 이번달 데이터 자체가 0이면 측정 불가 (last_month>0이라도 100% 하락 표시 금지) %>
  <% value_no_data = @total_value_this_month.to_f == 0 %>
  <% value_trend   = if @total_value_last_month.to_f > 0
                       ((@total_value_this_month.to_f - @total_value_last_month.to_f) / @total_value_last_month.to_f * 100).round(1)
                     else
                       nil
                     end %>
  <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-4">
    <div class="flex items-start justify-between">
      <div>
        <p class="text-xs font-medium text-gray-500 dark:text-gray-500 uppercase tracking-wide mb-2"><%= t("dashboard.kpi_revenue_this_month") %></p>
        <% if value_no_data %>
          <p class="text-2xl font-bold text-gray-300 dark:text-gray-600">—</p>
          <p class="text-xs text-gray-400 dark:text-gray-500 mt-1"><%= t("dashboard.kpi_no_data") %></p>
        <% else %>
          <p class="text-2xl font-bold text-gray-900 dark:text-white">$<%= number_to_human(@total_value_this_month.to_i, units: { thousand: "K", million: "M" }, format: "%n%u", precision: 1) %></p>
          <% if value_trend && value_trend.abs >= 0.1 %>
            <p class="text-xs mt-1 <%= value_trend > 0 ? 'text-green-500' : 'text-red-500' %>">
              <span class="inline-flex items-center gap-0.5">
                <% if value_trend > 0 %>
                  <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="18 15 12 9 6 15"/></svg>
                <% else %>
                  <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                <% end %>
                <%= t("dashboard.kpi_vs_last_month", pct: value_trend.abs) %>
              </span>
            </p>
          <% elsif value_trend.nil? %>
            <p class="text-xs text-gray-400 dark:text-gray-500 mt-1"><%= t("dashboard.kpi_no_last_month") %></p>
          <% else %>
            <p class="text-xs text-gray-400 dark:text-gray-500 mt-1"><%= t("dashboard.kpi_no_change") %></p>
          <% end %>
        <% end %>
      </div>
      <div class="w-9 h-9 rounded-lg bg-indigo-50 dark:bg-indigo-900/30 flex items-center justify-center">
        <svg class="w-5 h-5 text-indigo-600 dark:text-indigo-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="12" y1="1" x2="12" y2="23"/>
          <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
        </svg>
      </div>
    </div>
  </div>

  <%# FR-02: 드릴다운 패널 — 지연 주문 %>
  <div id="kpi-panel-overdue"
       class="hidden col-span-2 lg:col-span-3 xl:col-span-6
              bg-red-50 dark:bg-red-900/10 border border-red-200 dark:border-red-800
              rounded-xl overflow-hidden">
    <div class="px-4 py-3 border-b border-red-100 dark:border-red-800 flex items-center justify-between">
      <p class="text-sm font-semibold text-red-700 dark:text-red-400"><%= t("dashboard.overdue_panel_title") %></p>
      <button onclick="toggleKpiPanel('overdue')" class="text-red-400 hover:text-red-600 transition-colors">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>
    <% if @overdue_orders_brief.any? %>
      <div class="divide-y divide-red-100 dark:divide-red-800/50">
        <% @overdue_orders_brief.each do |order| %>
          <div class="flex items-center gap-3 px-4 py-2.5 hover:bg-red-100/50 dark:hover:bg-red-900/20 cursor-pointer transition-colors"
               onclick="openOrderDrawer(<%= order.id %>, <%= order.title.to_json %>, '<%= order_path(order) %>')">
            <div class="flex-1 min-w-0">
              <p class="text-sm font-medium text-gray-900 dark:text-white truncate"><%= order.title %></p>
              <p class="text-xs text-gray-500 dark:text-gray-500 truncate">
                <%= order.client&.name || order.customer_name %>
              </p>
            </div>
            <div class="flex items-center gap-2 shrink-0">
              <%= status_badge(order) %>
              <%= due_badge(order) %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="px-4 py-6 text-center text-sm text-gray-500 dark:text-gray-500"><%= t("dashboard.no_overdue") %></div>
    <% end %>
  </div>

  <%# FR-02: 드릴다운 패널 — 긴급 주문 (D-7) %>
  <div id="kpi-panel-urgent"
       class="hidden col-span-2 lg:col-span-3 xl:col-span-6
              bg-orange-50 dark:bg-orange-900/10 border border-orange-200 dark:border-orange-800
              rounded-xl overflow-hidden">
    <div class="px-4 py-3 border-b border-orange-100 dark:border-orange-800 flex items-center justify-between">
      <p class="text-sm font-semibold text-orange-700 dark:text-orange-400"><%= t("dashboard.urgent_panel_title") %></p>
      <button onclick="toggleKpiPanel('urgent')" class="text-orange-400 hover:text-orange-600 transition-colors">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>
    <% if @urgent_orders_brief.any? %>
      <div class="divide-y divide-orange-100 dark:divide-orange-800/50">
        <% @urgent_orders_brief.each do |order| %>
          <div class="flex items-center gap-3 px-4 py-2.5 hover:bg-orange-100/50 dark:hover:bg-orange-900/20 cursor-pointer transition-colors"
               onclick="openOrderDrawer(<%= order.id %>, <%= order.title.to_json %>, '<%= order_path(order) %>')">
            <div class="flex-1 min-w-0">
              <p class="text-sm font-medium text-gray-900 dark:text-white truncate"><%= order.title %></p>
              <p class="text-xs text-gray-500 dark:text-gray-500 truncate">
                <%= order.client&.name || order.customer_name %>
              </p>
            </div>
            <div class="flex items-center gap-2 shrink-0">
              <%= status_badge(order) %>
              <%= due_badge(order) %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="px-4 py-6 text-center text-sm text-gray-500 dark:text-gray-500"><%= t("dashboard.no_urgent") %></div>
    <% end %>
  </div>
</div>

<!-- ════════════════════════════════════════════════════════════
     CPO Agent 브리핑 (KPI 아래)
     ════════════════════════════════════════════════════════════ -->
<%= render "dashboard/agent_briefing" %>

<!-- ════════════════════════════════════════════════════════════
     ROW 2: Pipeline + 현장 카테고리
     ════════════════════════════════════════════════════════════ -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-4 mb-6">

  <!-- Kanban Pipeline (2/3 너비) -->
  <div class="lg:col-span-2 bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-5">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-sm font-semibold text-gray-700 dark:text-gray-300 uppercase tracking-wide"><%= t("dashboard.pipeline_title") %></h2>
      <%= link_to t("dashboard.kanban_view"), kanban_path, class: "text-xs text-accent hover:underline" %>
    </div>
    <%
      total_active_pipeline = @kanban_counts.except("get_grn").values.sum.to_f
    %>
    <div class="space-y-2">
      <% Order::KANBAN_COLUMNS.each do |status| %>
        <% count = @kanban_counts[status] || 0 %>
        <% pct = total_active_pipeline > 0 && status != "get_grn" ? (count / total_active_pipeline * 100).round : 0 %>
        <% bar_color = { "new_rfq" => "bg-gray-400", "make_quo" => "bg-blue-400", "pending_po" => "bg-yellow-400",
                         "new_po" => "bg-indigo-400", "delivery_items" => "bg-orange-400",
                         "problem" => "bg-purple-400", "get_grn" => "bg-green-500", "give_up" => "bg-gray-200" }[status] %>
        <div class="flex items-center gap-3">
          <span class="text-xs text-gray-500 dark:text-gray-500 w-16 shrink-0"><%= Order::STATUS_LABELS[status] %></span>
          <div class="flex-1 bg-gray-100 dark:bg-gray-700 rounded-full h-2 overflow-hidden">
            <div class="<%= bar_color %> h-2 rounded-full transition-all duration-500"
                 style="width: <%= status == 'get_grn' ? (@delivered_this_month.to_f / [@total_active + @delivered_this_month, 1].max * 100).round : pct %>%"></div>
          </div>
          <span class="text-sm font-bold text-gray-900 dark:text-white w-8 text-right"><%= count %></span>
        </div>
      <% end %>
    </div>
  </div>

  <!-- 현장 카테고리별 (1/3 너비) -->
  <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-5">
    <h2 class="text-sm font-semibold text-gray-700 dark:text-gray-300 uppercase tracking-wide mb-4"><%= t("dashboard.project_category_title") %></h2>
    <% cat_colors = { "nuclear" => "bg-purple-600 text-white dark:bg-purple-700",
                      "hydro"   => "bg-blue-600 text-white dark:bg-blue-700",
                      "tunnel"  => "bg-orange-500 text-white dark:bg-orange-600",
                      "gtx"     => "bg-green-600 text-white dark:bg-green-700" } %>
    <% cat_total_orders = @site_category_data.sum { |c| c[:orders] } %>
    <% if cat_total_orders == 0 %>
      <div class="flex flex-col items-center justify-center py-6 text-center">
        <svg class="w-8 h-8 text-gray-300 dark:text-gray-600 mb-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="3" width="7" height="18" rx="1"/><rect x="14" y="3" width="7" height="10" rx="1"/>
        </svg>
        <p class="text-xs text-gray-400 dark:text-gray-500"><%= t("dashboard.no_project_data") %></p>
      </div>
    <% else %>
      <div class="space-y-3">
        <% @site_category_data.each do |cat| %>
          <% next if cat[:orders] == 0 %>
          <div class="flex items-center gap-3">
            <span class="text-xs font-semibold px-2 py-1 rounded-md <%= cat_colors[cat[:category]] %> w-14 text-center shrink-0">
              <%= cat[:label] %>
            </span>
            <div class="flex-1">
              <div class="flex items-center justify-between text-xs mb-1">
                <span class="text-gray-600 dark:text-gray-300"><%= t("dashboard.order_count", count: cat[:orders]) %></span>
                <span class="text-gray-500 dark:text-gray-500">$<%= number_to_human(cat[:value].to_i, units: { thousand: "K", million: "M" }, format: "%n%u", precision: 1) %></span>
              </div>
              <div class="bg-gray-100 dark:bg-gray-700 rounded-full h-1.5">
                <div class="<%= cat_colors[cat[:category]].split.first %> opacity-70 h-1.5 rounded-full"
                     style="width: <%= (cat[:orders].to_f / [cat_total_orders, 1].max * 100).round %>%"></div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<!-- ════════════════════════════════════════════════════════════
     ROW 3: 기간별 트렌드 차트 (풀 너비)
     ════════════════════════════════════════════════════════════ -->
<div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-5 mb-6"
     x-data="{ period: 'monthly' }">
  <div class="flex items-center justify-between mb-4">
    <h2 class="text-sm font-semibold text-gray-700 dark:text-gray-300 uppercase tracking-wide"><%= t("dashboard.trend_title") %></h2>
    <div class="flex gap-1 bg-gray-100 dark:bg-gray-700 rounded-lg p-1">
      <% [['weekly', t('dashboard.trend_weekly')], ['monthly', t('dashboard.trend_monthly')], ['quarterly', t('dashboard.trend_quarterly')], ['yearly', t('dashboard.trend_yearly')]].each do |val, label| %>
        <button
          @click="period = '<%= val %>'; showPeriod('<%= val %>')"
          :class="period === '<%= val %>' ? 'bg-white dark:bg-gray-600 text-gray-900 dark:text-white shadow-sm' : 'text-gray-500 dark:text-gray-500 hover:text-gray-700 dark:hover:text-gray-200'"
          class="px-3 py-1.5 text-xs font-medium rounded-md transition-colors">
          <%= label %>
        </button>
      <% end %>
    </div>
  </div>

  <!-- 주간 차트 -->
  <div id="chart-weekly" class="hidden">
    <p class="text-xs text-gray-500 dark:text-gray-500 mb-3"><%= t("dashboard.weekly_desc") %></p>
    <% max_w = [@weekly_data.map { |w| w[:orders] }.max.to_i, 1].max %>
    <div class="flex items-end gap-2" style="height:120px;">
      <% @weekly_data.each do |w| %>
        <div class="flex-1 flex flex-col items-center justify-end gap-0.5 h-full">
          <div class="w-full flex gap-px items-end" style="height:104px;">
            <div class="flex-1 bg-blue-400 dark:bg-blue-500 rounded-t-sm opacity-80 transition-all"
                 style="height:<%= (w[:orders].to_f / max_w * 100).round %>%"
                 title="<%= t('dashboard.chart_orders_title', count: w[:orders]) %>"></div>
            <div class="flex-1 bg-green-400 dark:bg-green-500 rounded-t-sm opacity-80 transition-all"
                 style="height:<%= (w[:delivered].to_f / max_w * 100).round %>%"
                 title="<%= t('dashboard.chart_delivered_title', count: w[:delivered]) %>"></div>
          </div>
          <span class="text-xs text-gray-500 dark:text-gray-500 truncate w-full text-center leading-tight"><%= w[:label] %></span>
        </div>
      <% end %>
    </div>
    <div class="flex items-center gap-4 mt-2">
      <div class="flex items-center gap-1.5"><div class="w-3 h-3 rounded bg-blue-400 opacity-80"></div><span class="text-xs text-gray-500 dark:text-gray-500"><%= t("dashboard.chart_orders") %></span></div>
      <div class="flex items-center gap-1.5"><div class="w-3 h-3 rounded bg-green-400 opacity-80"></div><span class="text-xs text-gray-500 dark:text-gray-500"><%= t("dashboard.chart_delivered") %></span></div>
    </div>
  </div>

  <!-- 월간 차트 (기본) -->
  <div id="chart-monthly">
    <p class="text-xs text-gray-500 dark:text-gray-500 mb-3"><%= t("dashboard.monthly_desc") %></p>
    <% max_m = [@monthly_data.map { |m| m[:orders] }.max.to_i, 1].max %>
    <div class="flex items-end gap-1.5" style="height:120px;">
      <% @monthly_data.each do |m| %>
        <div class="flex-1 flex flex-col items-center justify-end gap-0.5 h-full">
          <div class="w-full flex gap-px items-end" style="height:104px;">
            <div class="flex-1 bg-blue-400 dark:bg-blue-500 rounded-t-sm opacity-80"
                 style="height:<%= (m[:orders].to_f / max_m * 100).round %>%"
                 title="<%= t('dashboard.chart_orders_title', count: m[:orders]) %>"></div>
            <div class="flex-1 bg-green-400 dark:bg-green-500 rounded-t-sm opacity-80"
                 style="height:<%= (m[:delivered].to_f / max_m * 100).round %>%"
                 title="<%= t('dashboard.chart_delivered_title', count: m[:delivered]) %>"></div>
          </div>
          <span class="text-xs text-gray-500 dark:text-gray-500 truncate w-full text-center leading-tight"><%= m[:label] %></span>
        </div>
      <% end %>
    </div>
    <div class="flex items-center gap-4 mt-2">
      <div class="flex items-center gap-1.5"><div class="w-3 h-3 rounded bg-blue-400 opacity-80"></div><span class="text-xs text-gray-500 dark:text-gray-500"><%= t("dashboard.chart_orders") %></span></div>
      <div class="flex items-center gap-1.5"><div class="w-3 h-3 rounded bg-green-400 opacity-80"></div><span class="text-xs text-gray-500 dark:text-gray-500"><%= t("dashboard.chart_delivered") %></span></div>
    </div>
  </div>

  <!-- 분기 차트 -->
  <div id="chart-quarterly" class="hidden">
    <p class="text-xs text-gray-500 dark:text-gray-500 mb-3"><%= t("dashboard.quarterly_desc") %></p>
    <div class="grid gap-3" style="grid-template-columns: repeat(<%= @quarterly_data.length %>, 1fr);">
      <% @quarterly_data.each do |q| %>
        <% rate_cls = q[:on_time_rate].to_f >= 90 ? 'text-green-600 dark:text-green-400' : q[:on_time_rate].to_f >= 75 ? 'text-orange-500 dark:text-orange-400' : 'text-red-500 dark:text-red-400' %>
        <div class="bg-gray-50 dark:bg-gray-700/50 rounded-lg p-3 text-center">
          <p class="text-xs font-bold text-gray-500 dark:text-gray-500 mb-2"><%= q[:label] %></p>
          <p class="text-2xl font-bold text-gray-900 dark:text-white"><%= q[:orders] %></p>
          <p class="text-xs text-gray-500 dark:text-gray-500 mb-2"><%= t("dashboard.chart_orders") %></p>
          <div class="border-t border-gray-200 dark:border-gray-600 pt-2">
            <p class="text-base font-bold <%= rate_cls %>"><%= q[:on_time_rate] %>%</p>
            <p class="text-xs text-gray-500 dark:text-gray-500"><%= t("dashboard.chart_on_time") %></p>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <!-- 연간 차트 -->
  <div id="chart-yearly" class="hidden">
    <p class="text-xs text-gray-500 dark:text-gray-500 mb-3"><%= t("dashboard.yearly_desc") %></p>
    <div class="grid grid-cols-3 gap-4">
      <% @yearly_data.each do |y| %>
        <% rate_cls = y[:on_time_rate].to_f >= 90 ? 'text-green-600 dark:text-green-400' : y[:on_time_rate].to_f >= 75 ? 'text-orange-500 dark:text-orange-400' : 'text-red-500 dark:text-red-400' %>
        <div class="bg-gray-50 dark:bg-gray-700/50 rounded-xl p-5 text-center">
          <p class="text-sm font-bold text-gray-700 dark:text-gray-300 mb-3"><%= y[:label] %></p>
          <div class="grid grid-cols-2 gap-2 mb-3">
            <div>
              <p class="text-2xl font-bold text-gray-900 dark:text-white"><%= y[:orders] %></p>
              <p class="text-xs text-gray-500 dark:text-gray-500"><%= t("dashboard.chart_orders") %></p>
            </div>
            <div>
              <p class="text-2xl font-bold text-green-600 dark:text-green-400"><%= y[:delivered] %></p>
              <p class="text-xs text-gray-500 dark:text-gray-500"><%= t("dashboard.chart_delivered") %></p>
            </div>
          </div>
          <div class="border-t border-gray-200 dark:border-gray-600 pt-3">
            <p class="text-xl font-bold <%= rate_cls %>"><%= y[:on_time_rate] %>%</p>
            <p class="text-xs text-gray-500 dark:text-gray-500 mb-1"><%= t("dashboard.chart_on_time") %></p>
            <p class="text-sm font-semibold text-gray-700 dark:text-gray-300">$<%= number_with_delimiter(y[:total_value].to_i) %></p>
            <p class="text-xs text-gray-500 dark:text-gray-500"><%= t("dashboard.chart_revenue") %></p>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>

<!-- ════════════════════════════════════════════════════════════
     ROW 4: 하단 — 긴급 납기 + 비자 만료 + Sheets 상태
     ════════════════════════════════════════════════════════════ -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-4 mb-6">

  <!-- 긴급 납기 발주 -->
  <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700">
    <div class="flex items-center justify-between px-5 py-3 border-b border-gray-200 dark:border-gray-700">
      <h3 class="text-sm font-semibold text-gray-900 dark:text-white"><%= t("dashboard.urgent_deliveries_title") %></h3>
      <%= link_to t("dashboard.kanban_link"), kanban_path, class: "text-xs text-accent hover:underline" %>
    </div>
    <div class="divide-y divide-gray-50 dark:divide-gray-700/50">
      <% if @urgent_orders.empty? %>
        <div class="px-5 py-6 text-center text-xs text-gray-500 dark:text-gray-500"><%= t("dashboard.no_urgent_orders_short") %></div>
      <% else %>
        <% @urgent_orders.each do |order| %>
          <%= link_to order_path(order), class: "flex items-center gap-3 px-4 py-3 hover:bg-gray-50 dark:hover:bg-gray-700/40 transition-colors" do %>
            <% days = order.due_date ? (order.due_date - Date.today).to_i : nil %>
            <div class="w-10 h-10 rounded-lg flex items-center justify-center shrink-0
                        <%= days && days < 0 ? 'bg-red-100 dark:bg-red-900/30' : 'bg-orange-100 dark:bg-orange-900/30' %>">
              <span class="text-xs font-bold <%= days && days < 0 ? 'text-red-600 dark:text-red-400' : 'text-orange-600 dark:text-orange-400' %>">
                <%= days ? (days < 0 ? "D+#{-days}" : "D-#{days}") : "—" %>
              </span>
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-xs font-medium text-gray-900 dark:text-white truncate"><%= order.title %></p>
              <p class="text-xs text-gray-500 dark:text-gray-500 truncate"><%= order.customer_name %></p>
            </div>
            <%= status_badge(order) %>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </div>

  <!-- 비자 만료 현황 -->
  <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700">
    <div class="flex items-center justify-between px-5 py-3 border-b border-gray-200 dark:border-gray-700">
      <h3 class="text-sm font-semibold text-gray-900 dark:text-white"><%= t("dashboard.visa_expiry_title") %></h3>
      <% total_expiring = Visa.where(status: "active").where(expiry_date: Date.today..90.days.from_now).count %>
      <% if total_expiring > 0 %>
        <span class="text-xs bg-red-100 dark:bg-red-900/40 text-red-600 dark:text-red-400 px-2 py-0.5 rounded-full font-medium"><%= total_expiring %>건</span>
      <% end %>
    </div>
    <div class="divide-y divide-gray-50 dark:divide-gray-700/50">
      <% if @expiring_visas.empty? %>
        <div class="px-5 py-6 text-center text-xs text-gray-500 dark:text-gray-500"><%= t("dashboard.no_visa_expiry") %></div>
      <% else %>
        <% @expiring_visas.each do |visa| %>
          <% days = (visa.expiry_date - Date.today).to_i %>
          <% lvl_cls = days <= 30 ? 'text-red-600 dark:text-red-400 bg-red-50 dark:bg-red-900/20' : days <= 60 ? 'text-orange-600 dark:text-orange-400 bg-orange-50 dark:bg-orange-900/20' : 'text-yellow-600 dark:text-yellow-400 bg-yellow-50 dark:bg-yellow-900/20' %>
          <div class="flex items-center gap-3 px-4 py-3">
            <div class="w-10 h-10 rounded-lg flex items-center justify-center shrink-0 <%= lvl_cls.split.last(2).join(' ') %>">
              <span class="text-xs font-bold <%= lvl_cls.split.first %>">D-<%= days %></span>
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-xs font-medium text-gray-900 dark:text-white truncate"><%= visa.employee&.name %></p>
              <p class="text-xs text-gray-500 dark:text-gray-500"><%= visa.visa_type %> · <%= visa.expiry_date&.strftime("%Y.%m.%d") %></p>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>

  <!-- 계약 만료 현황 -->
  <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700">
    <div class="flex items-center justify-between px-5 py-3 border-b border-gray-200 dark:border-gray-700">
      <h3 class="text-sm font-semibold text-gray-900 dark:text-white"><%= t("dashboard.contract_expiry_title") %></h3>
      <% total_expiring_contracts = EmploymentContract.expiring_within(30).count %>
      <% if total_expiring_contracts > 0 %>
        <span class="text-xs bg-orange-100 dark:bg-orange-900/40 text-orange-600 dark:text-orange-400 px-2 py-0.5 rounded-full font-medium"><%= total_expiring_contracts %>건</span>
      <% end %>
    </div>
    <div class="divide-y divide-gray-50 dark:divide-gray-700/50">
      <% if @expiring_contracts.empty? %>
        <div class="px-5 py-6 text-center text-xs text-gray-500 dark:text-gray-500"><%= t("dashboard.no_contract_expiry") %></div>
      <% else %>
        <% @expiring_contracts.each do |contract| %>
          <% days = (contract.end_date - Date.today).to_i %>
          <% lvl_cls = days <= 7 ? 'text-red-600 dark:text-red-400 bg-red-50 dark:bg-red-900/20' : days <= 14 ? 'text-orange-600 dark:text-orange-400 bg-orange-50 dark:bg-orange-900/20' : 'text-yellow-600 dark:text-yellow-400 bg-yellow-50 dark:bg-yellow-900/20' %>
          <div class="flex items-center gap-3 px-4 py-3">
            <div class="w-10 h-10 rounded-lg flex items-center justify-center shrink-0 <%= lvl_cls.split.last(2).join(' ') %>">
              <span class="text-xs font-bold <%= lvl_cls.split.first %>">D-<%= days %></span>
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-xs font-medium text-gray-900 dark:text-white truncate"><%= contract.employee&.name %></p>
              <p class="text-xs text-gray-500 dark:text-gray-500"><%= contract.status_label %> · <%= contract.end_date&.strftime("%Y.%m.%d") %></p>
            </div>
            <%= link_to employee_path(contract.employee), class: "text-xs text-primary hover:underline shrink-0" do %><%= t("dashboard.view_link") %><% end %>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>

  <!-- Google Sheets 상태 + 최근 발주 -->
  <div class="flex flex-col gap-4">
    <!-- Sheets 동기화 -->
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-4">
      <div class="flex items-center justify-between mb-3">
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-green-600 dark:text-green-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="3" width="18" height="18" rx="2"/>
            <path d="M3 9h18M3 15h18M9 3v18"/>
          </svg>
          <p class="text-sm font-semibold text-gray-900 dark:text-white">Google Sheets</p>
          <% if @sheets_mock %>
            <span class="text-xs px-1.5 py-0.5 rounded-full bg-blue-50 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400">Mock</span>
          <% end %>
        </div>
        <%= button_to sync_sheets_path, method: :post,
            class: "text-xs px-3 py-1.5 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors shrink-0" do %>
          <%= t("dashboard.sheets.sync_now") %>
        <% end %>
      </div>
      <% if @last_sync %>
        <% status_cls = @last_sync.success? ? 'text-green-600 dark:text-green-400' : @last_sync.failed? ? 'text-red-500 dark:text-red-400' : 'text-blue-600 dark:text-blue-400' %>
        <div class="grid grid-cols-2 gap-2 text-xs">
          <div class="bg-gray-50 dark:bg-gray-700/50 rounded-lg p-2 text-center">
            <p class="font-bold text-gray-900 dark:text-white"><%= @last_sync.orders_count %></p>
            <p class="text-gray-500 dark:text-gray-500"><%= t("nav.orders") %></p>
          </div>
          <div class="bg-gray-50 dark:bg-gray-700/50 rounded-lg p-2 text-center">
            <p class="font-bold text-gray-900 dark:text-white"><%= @last_sync.employees_count %></p>
            <p class="text-gray-500 dark:text-gray-500"><%= t("nav.employees") %></p>
          </div>
        </div>
        <p class="text-xs text-gray-500 dark:text-gray-500 mt-2 text-center">
          <span class="<%= status_cls %> font-medium"><%= @last_sync.status_label %></span>
          · <%= @last_sync.synced_at&.strftime("%m/%d %H:%M") %>
        </p>
      <% else %>
        <p class="text-xs text-gray-500 dark:text-gray-500 text-center py-2"><%= t("dashboard.no_sync") %></p>
      <% end %>
    </div>

    <!-- 최근 발주 -->
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 flex-1">
      <div class="flex items-center justify-between px-4 py-3 border-b border-gray-200 dark:border-gray-700">
        <h3 class="text-sm font-semibold text-gray-900 dark:text-white"><%= t("dashboard.recent_orders_title") %></h3>
        <%= link_to t("dashboard.new_order_short"), new_order_path, class: "text-xs bg-accent text-white px-2.5 py-1 rounded-lg hover:bg-blue-700 transition-colors" %>
      </div>
      <div class="divide-y divide-gray-50 dark:divide-gray-700/50">
        <% @recent_orders.first(4).each do |order| %>
          <%= link_to order_path(order), class: "flex items-center gap-2 px-4 py-2.5 hover:bg-gray-50 dark:hover:bg-gray-700/40 transition-colors" do %>
            <div class="flex-1 min-w-0">
              <p class="text-xs font-medium text-gray-900 dark:text-white truncate"><%= order.title %></p>
              <p class="text-xs text-gray-500 dark:text-gray-500"><%= order.created_at.strftime("%m/%d") %></p>
            </div>
            <%= status_badge(order) %>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</div>

<!-- ════════════════════════════════════════════════════════════
     ROW 5: FR-06 Top5 발주처 / 거래처
     ════════════════════════════════════════════════════════════ -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-6">

  <!-- Top5 발주처 -->
  <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700">
    <div class="flex items-center justify-between px-5 py-3 border-b border-gray-200 dark:border-gray-700">
      <h3 class="text-sm font-semibold text-gray-900 dark:text-white"><%= t("dashboard.top5_clients_title") %></h3>
      <%= link_to t("dashboard.view_all"), clients_path, class: "text-xs text-accent hover:underline" %>
    </div>
    <% max_client_val = [@top_clients.map { |c| c.total_value.to_f }.max.to_f, 1].max %>
    <div class="divide-y divide-gray-50 dark:divide-gray-700/50">
      <% if @top_clients.empty? %>
        <div class="px-5 py-8 text-center">
          <svg class="w-10 h-10 mx-auto text-gray-300 dark:text-gray-600 mb-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
          <p class="text-xs text-gray-500 dark:text-gray-500"><%= t("dashboard.no_trade_data") %></p>
        </div>
      <% else %>
        <% @top_clients.each_with_index do |client, idx| %>
          <div class="flex items-center gap-3 px-4 py-3 hover:bg-gray-50 dark:hover:bg-gray-700/40 transition-colors">
            <span class="w-5 h-5 rounded-full bg-primary/10 dark:bg-primary/20 text-primary text-xs font-bold flex items-center justify-center shrink-0"><%= idx + 1 %></span>
            <div class="flex-1 min-w-0">
              <div class="flex items-center justify-between mb-1">
                <%= link_to client.name, client_path(client.id), class: "text-sm font-medium text-gray-900 dark:text-white hover:text-primary truncate max-w-[120px] inline-block" %>
                <span class="text-xs font-semibold text-gray-700 dark:text-gray-300 shrink-0 ml-2">
                  $<%= number_to_human(client.total_value.to_f.to_i, units: { thousand: 'K', million: 'M' }, format: '%n%u', precision: 1) %>
                </span>
              </div>
              <div class="flex items-center gap-2">
                <div class="flex-1 bg-gray-100 dark:bg-gray-700 rounded-full h-1.5">
                  <div class="bg-primary rounded-full h-1.5 transition-all duration-500"
                       style="width: <%= (client.total_value.to_f / max_client_val * 100).round %>%"></div>
                </div>
                <span class="text-xs text-gray-500 dark:text-gray-500 shrink-0"><%= t("dashboard.order_count", count: client.order_count) %></span>
              </div>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>

  <!-- Top5 거래처 -->
  <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700">
    <div class="flex items-center justify-between px-5 py-3 border-b border-gray-200 dark:border-gray-700">
      <h3 class="text-sm font-semibold text-gray-900 dark:text-white"><%= t("dashboard.top5_suppliers_title") %></h3>
      <%= link_to t("dashboard.view_all"), suppliers_path, class: "text-xs text-accent hover:underline" %>
    </div>
    <% max_supplier_val = [@top_suppliers.map { |s| s.total_value.to_f }.max.to_f, 1].max %>
    <div class="divide-y divide-gray-50 dark:divide-gray-700/50">
      <% if @top_suppliers.empty? %>
        <div class="px-5 py-8 text-center">
          <svg class="w-10 h-10 mx-auto text-gray-300 dark:text-gray-600 mb-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
          <p class="text-xs text-gray-500 dark:text-gray-500"><%= t("dashboard.no_trade_data") %></p>
        </div>
      <% else %>
        <% @top_suppliers.each_with_index do |supplier, idx| %>
          <div class="flex items-center gap-3 px-4 py-3 hover:bg-gray-50 dark:hover:bg-gray-700/40 transition-colors">
            <span class="w-5 h-5 rounded-full bg-purple-100 dark:bg-purple-900/30 text-purple-700 dark:text-purple-400 text-xs font-bold flex items-center justify-center shrink-0"><%= idx + 1 %></span>
            <div class="flex-1 min-w-0">
              <div class="flex items-center justify-between mb-1">
                <%= link_to supplier.name, supplier_path(supplier.id), class: "text-sm font-medium text-gray-900 dark:text-white hover:text-primary truncate max-w-[120px] inline-block" %>
                <span class="text-xs font-semibold text-gray-700 dark:text-gray-300 shrink-0 ml-2">
                  $<%= number_to_human(supplier.total_value.to_f.to_i, units: { thousand: 'K', million: 'M' }, format: '%n%u', precision: 1) %>
                </span>
              </div>
              <div class="flex items-center gap-2">
                <div class="flex-1 bg-gray-100 dark:bg-gray-700 rounded-full h-1.5">
                  <div class="bg-purple-400 dark:bg-purple-500 rounded-full h-1.5 transition-all duration-500"
                       style="width: <%= (supplier.total_value.to_f / max_supplier_val * 100).round %>%"></div>
                </div>
                <span class="text-xs text-gray-500 dark:text-gray-500 shrink-0"><%= t("dashboard.order_count", count: supplier.order_count) %></span>
              </div>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
</div>

<!-- ════════════════════════════════════════════════════════════
     ROW 6: 담당자별 워크로드
     ════════════════════════════════════════════════════════════ -->
<div id="team-workload" class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 mb-6 scroll-mt-6">
  <div class="flex items-center justify-between px-5 py-3 border-b border-gray-200 dark:border-gray-700">
    <h3 class="text-sm font-semibold text-gray-900 dark:text-white"><%= t("dashboard.workload_title") %></h3>
    <span class="text-xs text-gray-500 dark:text-gray-500">
      <%= t("dashboard.workload_total", count: @assignee_workload.sum { |u| u.total_count.to_i }) %>
    </span>
  </div>

  <% if @assignee_workload.empty? %>
    <div class="px-5 py-8 text-center text-sm text-gray-500 dark:text-gray-500"><%= t("dashboard.no_workload") %></div>
  <% else %>
    <% max_count = [@assignee_workload.map { |u| u.total_count.to_i }.max, 1].max %>
    <% avatar_pairs = [
         %w[bg-blue-600 text-white],
         %w[bg-purple-600 text-white],
         %w[bg-green-600 text-white],
         %w[bg-orange-500 text-white],
         %w[bg-pink-600 text-white]
       ] %>
    <% role_labels = {
         "admin"   => [t("dashboard.role_admin"),   "bg-red-600 text-white dark:bg-red-700"],
         "manager" => [t("dashboard.role_manager"), "bg-blue-600 text-white dark:bg-blue-700"],
         "member"  => [t("dashboard.role_member"),  "bg-gray-500 text-white dark:bg-gray-600"],
         "viewer"  => [t("dashboard.role_viewer"),  "bg-gray-400 text-white dark:bg-gray-500"]
       } %>

    <div class="divide-y divide-gray-50 dark:divide-gray-700/50">
      <% @assignee_workload.each_with_index do |u, idx| %>
        <% overdue = u.overdue_count.to_i %>
        <% urgent  = u.urgent_count.to_i %>
        <% total   = u.total_count.to_i %>
        <% row_bg = overdue > 0 ? "bg-red-50/50 dark:bg-red-900/10"
                  : urgent  > 0 ? "bg-orange-50/50 dark:bg-orange-900/10"
                  : "" %>
        <% avatar = avatar_pairs[idx % 5] %>
        <% bar_color = overdue > 0 ? "bg-red-400 dark:bg-red-500"
                     : urgent  > 0 ? "bg-orange-400 dark:bg-orange-500"
                     : "bg-blue-400 dark:bg-blue-500" %>
        <% role_info   = role_labels[u.role] || [t("dashboard.role_member"), "bg-gray-500 text-white"] %>
        <% branch_label = u.branch == "abu_dhabi" ? "Abu Dhabi" : "Seoul" %>

        <div class="flex items-center gap-4 px-5 py-3 <%= row_bg %> transition-colors">
          <%# 이니셜 아바타 %>
          <div class="w-9 h-9 rounded-full <%= avatar[0] %> <%= avatar[1] %> flex items-center justify-center text-sm font-bold shrink-0">
            <%= u.name.to_s.split.map(&:first).first(2).join.upcase.presence || u.name.to_s[0..1].upcase %>
          </div>

          <%# 담당자 정보 %>
          <div class="w-40 shrink-0">
            <p class="text-sm font-medium text-gray-900 dark:text-white truncate"><%= u.name.presence || u.id %></p>
            <div class="flex items-center gap-1 mt-0.5">
              <span class="text-xs px-1.5 py-0.5 rounded-md font-medium <%= role_info[1] %>"><%= role_info[0] %></span>
              <span class="text-xs text-gray-500 dark:text-gray-500"><%= branch_label %></span>
            </div>
          </div>

          <%# 워크로드 바 %>
          <div class="flex-1">
            <div class="bg-gray-100 dark:bg-gray-700 rounded-full h-2">
              <div class="<%= bar_color %> h-2 rounded-full transition-all duration-500"
                   style="width: <%= (total.to_f / max_count * 100).round %>%"></div>
            </div>
          </div>

          <%# 총 건수 %>
          <div class="w-14 text-right shrink-0">
            <span class="text-sm font-bold text-gray-900 dark:text-white"><%= total %></span>
            <span class="text-xs text-gray-500 dark:text-gray-500"><%= t("dashboard.kpi_unit") %></span>
          </div>

          <%# 긴급/지연 배지 %>
          <div class="flex items-center gap-1 w-24 justify-end shrink-0">
            <% if urgent > 0 %>
              <span class="text-xs px-1.5 py-0.5 rounded-md bg-orange-100 dark:bg-orange-900/40 text-orange-700 dark:text-orange-400 font-medium whitespace-nowrap"><%= t("dashboard.urgent_badge", count: urgent) %></span>
            <% end %>
            <% if overdue > 0 %>
              <span class="text-xs px-1.5 py-0.5 rounded-md bg-red-100 dark:bg-red-900/40 text-red-700 dark:text-red-400 font-medium whitespace-nowrap"><%= t("dashboard.overdue_badge", count: overdue) %></span>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>

<script>
// FR-02: KPI 드릴다운 패널 토글
function toggleKpiPanel(type) {
  var panels = ['overdue', 'urgent'];
  var panel  = document.getElementById('kpi-panel-' + type);
  var isHidden = panel.classList.contains('hidden');
  panels.forEach(function(t) {
    document.getElementById('kpi-panel-' + t).classList.add('hidden');
  });
  if (isHidden) panel.classList.remove('hidden');
}

function showPeriod(period) {
  ['weekly', 'monthly', 'quarterly', 'yearly'].forEach(p => {
    document.getElementById('chart-' + p).classList.add('hidden');
  });
  document.getElementById('chart-' + period).classList.remove('hidden');
}
// 초기: 월간 표시
showPeriod('monthly');
</script>
