<% content_for :title, t("contact_persons.new_title") %>
<div class="max-w-xl">
  <div class="mb-6">
    <div class="flex items-center gap-2 text-sm text-gray-500 mb-1">
      <%= link_to @contactable.name, @contactable, class: "hover:text-primary" %>
      <span>/</span><span><%= t("contact_persons.new_title") %></span>
    </div>
    <h1 class="text-2xl font-bold text-gray-900 dark:text-white"><%= t("contact_persons.new_title") %></h1>
  </div>
  <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 shadow-sm p-6">
    <%= render "form" %>
  </div>
</div>
