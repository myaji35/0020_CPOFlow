<%# ISS-042: 사이드바 기본 expanded (아이콘+라벨) — Alpine.js collapse 토글 %>
<nav class="flex flex-col bg-primary text-white h-full shrink-0 z-20 transition-all duration-200"
     x-data="{ collapsed: (typeof localStorage !== 'undefined' && localStorage.getItem('sidebar_collapsed') === 'true') }"
     x-init="$watch('collapsed', v => localStorage.setItem('sidebar_collapsed', v))"
     :class="collapsed ? 'w-16 group' : 'w-56'">
  <!-- Logo + Collapse Toggle -->
  <div class="flex items-center h-16 px-3 border-b border-primary-light overflow-hidden">
    <div class="w-8 h-8 bg-accent rounded-lg flex items-center justify-center shrink-0">
      <span class="text-white font-bold text-sm">CF</span>
    </div>
    <span class="ml-3 font-bold text-sm whitespace-nowrap flex-1 truncate transition-opacity duration-200"
          :class="collapsed ? 'opacity-0 pointer-events-none w-0 ml-0' : 'opacity-100'">CPOFlow</span>
    <button @click="collapsed = !collapsed"
            class="ml-auto shrink-0 w-6 h-6 flex items-center justify-center rounded-md hover:bg-white/20 text-blue-200 hover:text-white transition-colors"
            :title="collapsed ? '메뉴 펼치기' : '메뉴 접기'">
      <svg class="w-4 h-4 transition-transform duration-200" :class="collapsed ? 'rotate-180' : ''"
           viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="15 18 9 12 15 6"/>
      </svg>
    </button>
  </div>

  <!-- Nav Items -->
  <div class="flex flex-col flex-1 py-4 gap-1 overflow-hidden">
    <%= nav_link_to dashboard_path, icon: "lni lni-grid-alt", label: t("nav.dashboard") %>
    <%= nav_link_to inbox_path, icon: "lni lni-envelope", label: t("nav.inbox") do %>
      <% rfq_count = Order.new_rfq.count %>
      <% if rfq_count > 0 %>
        <span class="ml-auto bg-accent text-white text-xs rounded-full px-1.5 py-0.5 transition-opacity"
              :class="collapsed ? 'opacity-0 w-0 overflow-hidden' : 'opacity-100'"><%= rfq_count %></span>
      <% end %>
    <% end %>
    <%= nav_link_to kanban_path, icon: "lni lni-layout", label: t("nav.kanban") %>
    <%= nav_link_to orders_path, icon: "lni lni-clipboard", label: t("nav.orders") %>
    <%= nav_link_to calendar_path, icon: "lni lni-calendar", label: t("nav.calendar") %>
    <%= nav_link_to team_index_path, icon: "lni lni-users", label: t("nav.team") %>

    <!-- 거래처 섹션 구분선 -->
    <div class="my-2 mx-3 border-t border-white/20"></div>
    <%= nav_link_to clients_path, icon: "lni lni-briefcase", label: "발주처" %>
    <%= nav_link_to suppliers_path, icon: "lni lni-delivery", label: "거래처" %>
    <%= nav_link_to contact_persons_path, icon: "lni lni-users", label: "외부 담당자" %>
    <%= nav_link_to projects_path, icon: "lni lni-map-marker", label: "현장" %>
    <%= nav_link_to employees_path, icon: "lni lni-user", label: "직원 관리" %>
    <%= nav_link_to org_chart_path, icon: "lni lni-graph", label: "조직도" %>

    <% if current_user.manager? || current_user.admin? %>
      <!-- Admin 섹션 구분선 -->
      <div class="my-2 mx-3 border-t border-white/20"></div>
      <%= nav_link_to reports_path, icon: "lni lni-bar-chart", label: "경영 리포트" %>

      <%# eCount 그룹 — 5개 하위 메뉴를 접힘/펼침으로 묶음 %>
      <% ecount_active = request.path.start_with?("/admin/ecount") || request.path.start_with?("/admin/imports") %>
      <div x-data="{ open: <%= ecount_active ? 'true' : 'false' %> }" class="mx-1">
        <%# 부모 항목: eCount %>
        <button type="button"
                @click="open = !open"
                class="w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors overflow-hidden <%= ecount_active ? 'bg-white/20 text-white' : 'text-blue-100 hover:bg-white/10 hover:text-white' %>">
          <i class="lni lni-network text-xl shrink-0 w-5 text-center"></i>
          <span class="whitespace-nowrap transition-opacity duration-200 truncate flex-1 text-left"
                x-bind:class="collapsed ? 'opacity-0 w-0 overflow-hidden' : 'opacity-100'">eCount</span>
          <i class="lni lni-chevron-down text-sm transition-transform duration-200"
             :class="{ 'rotate-180': open }"
             x-bind:style="collapsed ? 'display:none' : ''"></i>
        </button>

        <%# 하위 메뉴 — open일 때만 표시 + collapsed면 전체 숨김 %>
        <div x-show="open" x-transition x-cloak
             x-bind:class="collapsed ? 'hidden' : ''"
             class="mt-1 ml-3 pl-3 border-l border-white/20 space-y-0.5">
          <% ecount_children = [
            { path: admin_ecount_sync_index_path,    icon: "lni lni-reload",  label: "API 동기화" },
            { path: admin_ecount_products_path,      icon: "lni lni-package", label: "품목" },
            { path: admin_ecount_transactions_path,  icon: "lni lni-files",   label: "거래내역" },
            { path: admin_imports_path,              icon: "lni lni-upload",  label: "Import (CSV)" }
          ] %>
          <% ecount_children.each do |item| %>
            <% is_active = current_page?(item[:path]) || request.path.start_with?(item[:path]) %>
            <%= link_to item[:path], class: "flex items-center gap-2.5 px-3 py-2 rounded-md text-[13px] #{ is_active ? 'bg-white/15 text-white font-medium' : 'text-blue-100/80 hover:bg-white/10 hover:text-white' }" do %>
              <i class="<%= item[:icon] %> text-base w-4 text-center"></i>
              <span class="truncate"><%= item[:label] %></span>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>
    <% if current_user.admin? %>
      <%= nav_link_to settings_menu_permissions_path, icon: "lni lni-shield", label: "메뉴 권한" %>
      <%= nav_link_to admin_reviews_path, icon: "lni lni-comments-alt", label: "피드백 관리" %>
    <% end %>
  </div>

  <!-- Bottom: Settings + User -->
  <div class="py-4 border-t border-primary-light overflow-hidden">
    <%= nav_link_to settings_root_path, icon: "lni lni-cog", label: t("nav.settings") %>

    <!-- User avatar -->
    <div class="flex items-center px-3 py-2 mt-2 gap-3 overflow-hidden">
      <div class="w-8 h-8 rounded-full bg-accent flex items-center justify-center text-xs font-bold shrink-0">
        <%= current_user.initials %>
      </div>
      <div class="transition-opacity overflow-hidden" :class="collapsed ? 'opacity-0 w-0' : 'opacity-100'">
        <p class="text-xs font-medium truncate"><%= current_user.display_name %></p>
        <p class="text-xs text-blue-200 truncate"><%= current_user.role.capitalize %></p>
      </div>
    </div>
  </div>
</nav>
