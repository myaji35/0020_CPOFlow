<%# Redesign Phase 1 — 52px topbar (paper bg + ink-150 hairline + ink-75 search + brand-400 focus) %>
<header class="flex items-center gap-3 h-[52px] bg-white dark:bg-ink-900 border-b border-ink-150 dark:border-ink-800 px-5 shrink-0 z-10">
  <!-- Title -->
  <div class="min-w-0 flex-shrink">
    <h1 class="text-[15px] font-semibold text-ink-900 dark:text-white tracking-tight truncate"><%= content_for(:page_title) { "CPOFlow" } %></h1>
  </div>

  <!-- Search (⌘K) -->
  <button onclick="document.dispatchEvent(new CustomEvent('open-command-palette'))"
          title="⌘K 또는 Ctrl+K 로 전역 검색"
          class="hidden sm:flex items-center gap-2 h-8 px-3 flex-1 max-w-[480px] text-[13px] bg-ink-75 dark:bg-ink-800 text-ink-600 dark:text-ink-300 border border-transparent hover:bg-ink-100 dark:hover:bg-ink-700 focus:bg-white focus:border-brand-400 focus:ring-[3px] focus:ring-brand-50 rounded-md transition-all">
    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
    <span class="flex-1 text-left text-ink-500">주문, 발주처, 거래처, 직원, 현장 검색...</span>
    <kbd class="font-mono text-[10px] bg-white dark:bg-ink-900 border border-ink-200 dark:border-ink-700 px-1.5 py-px rounded-xs text-ink-500">⌘K</kbd>
  </button>
  <button onclick="document.dispatchEvent(new CustomEvent('open-command-palette'))"
          title="전역 검색"
          class="sm:hidden flex items-center justify-center w-8 h-8 rounded-md text-ink-600 hover:bg-ink-100 transition-colors">
    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
  </button>

  <div class="ml-auto flex items-center gap-1">
    <!-- 알림 (긴급 + 미읽음) -->
    <% urgent = Order.urgent.count %>
    <% unread_count = current_user.notifications.unread.count rescue 0 %>
    <% badge_count = urgent + unread_count %>
    <% recent_notifications = current_user.notifications.recent.includes(:notifiable).limit(10) rescue [] %>
    <div id="notification-bell" class="relative">
      <button onclick="toggleNotificationPanel(event)"
              class="relative w-8 h-8 grid place-items-center rounded-md text-ink-600 dark:text-ink-300 hover:bg-ink-100 dark:hover:bg-ink-800 hover:text-ink-900 dark:hover:text-white transition-colors"
              title="알림">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
        <% if badge_count > 0 %>
          <span class="absolute top-[5px] right-[5px] w-2 h-2 rounded-full bg-red-500 border-2 border-white dark:border-ink-900"></span>
        <% end %>
      </button>

      <!-- 드롭다운 패널 -->
      <div id="notification-panel"
           class="hidden absolute right-0 top-9 w-80 bg-white dark:bg-ink-900 border border-ink-150 dark:border-ink-800 rounded-lg shadow-sh-3 z-50 overflow-hidden">
        <div class="flex items-center justify-between px-4 py-3 border-b border-ink-100 dark:border-ink-800">
          <span class="text-[13px] font-semibold text-ink-900 dark:text-white">알림
            <% if unread_count > 0 %>
              <span class="ml-1 text-[10px] bg-brand-600 text-white rounded-full px-1.5 py-px font-semibold"><%= unread_count %></span>
            <% end %>
          </span>
          <div class="flex items-center gap-3">
            <% if unread_count > 0 %>
              <%= button_to "모두 읽음", read_all_notifications_path, method: :patch,
                  class: "text-[11px] text-brand-600 hover:underline bg-transparent border-0 cursor-pointer p-0" %>
            <% end %>
            <%= link_to "전체 보기 →", notifications_path,
                class: "text-[11px] text-ink-500 hover:text-brand-600 transition-colors" %>
          </div>
        </div>

        <% if urgent > 0 %>
          <%= link_to kanban_path, class: "flex items-center gap-2 px-4 py-2.5 bg-red-50 dark:bg-red-900/20 hover:bg-red-100 dark:hover:bg-red-900/30 transition-colors" do %>
            <svg class="w-4 h-4 text-red-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
            <span class="text-[11px] font-semibold text-red-600 dark:text-red-400">긴급 오더 <%= urgent %>건</span>
            <span class="text-[11px] text-red-400 dark:text-red-500 ml-auto">보기 →</span>
          <% end %>
        <% end %>

        <div class="max-h-96 overflow-y-auto divide-y divide-ink-100 dark:divide-ink-800">
          <% if recent_notifications.any? %>
            <% recent_notifications.each do |n| %>
              <div class="flex items-start gap-3 px-4 py-3 hover:bg-ink-50 dark:hover:bg-ink-800 transition-colors <%= n.read? ? '' : 'bg-brand-50/60 dark:bg-ink-800/50' %>"
                   <% if n.notifiable.is_a?(Order) %>
                   onclick="markNotificationRead(<%= n.id %>); toggleNotificationPanel(); openOrderDrawer(<%= n.notifiable.id %>, <%= n.notifiable.title.to_json %>, '<%= order_path(n.notifiable) %>')"
                   style="cursor:pointer"
                   <% end %>>
                <div class="flex-shrink-0 pt-1.5">
                  <div class="w-1.5 h-1.5 rounded-full <%= n.read? ? 'bg-transparent' : 'bg-brand-600' %>"></div>
                </div>
                <div class="w-7 h-7 rounded-full grid place-items-center flex-shrink-0
                  <%= case n.notification_type
                      when 'due_date'       then 'bg-red-100 dark:bg-red-900/30'
                      when 'status_changed' then 'bg-blue-100 dark:bg-blue-900/30'
                      when 'assigned'       then 'bg-green-100 dark:bg-green-900/30'
                      when 'system'         then 'bg-purple-100 dark:bg-purple-900/30'
                      when 'mentioned'      then 'bg-amber-100 dark:bg-amber-900/30'
                      else                       'bg-ink-100 dark:bg-ink-800'
                      end %>">
                  <svg class="w-3.5 h-3.5 <%= case n.notification_type
                      when 'due_date'       then 'text-red-600 dark:text-red-400'
                      when 'status_changed' then 'text-blue-600 dark:text-blue-400'
                      when 'assigned'       then 'text-green-600 dark:text-green-400'
                      when 'system'         then 'text-purple-600 dark:text-purple-400'
                      when 'mentioned'      then 'text-amber-600 dark:text-amber-400'
                      else                       'text-ink-500'
                      end %>" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <% case n.notification_type
                       when 'due_date' %>
                      <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>
                    <% when 'status_changed' %>
                      <polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/>
                    <% when 'assigned' %>
                      <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
                    <% when 'system' %>
                      <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
                    <% when 'mentioned' %>
                      <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
                    <% else %>
                      <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/>
                    <% end %>
                  </svg>
                </div>
                <div class="flex-1 min-w-0">
                  <p class="text-[12px] leading-snug <%= n.read? ? 'font-medium text-ink-700 dark:text-ink-300' : 'font-semibold text-ink-900 dark:text-white' %>">
                    <%= n.title %>
                  </p>
                  <% if n.body.present? %>
                    <p class="text-[11px] text-ink-500 mt-0.5 truncate"><%= n.body %></p>
                  <% end %>
                  <span class="text-[11px] text-ink-500" title="<%= n.created_at.strftime('%Y-%m-%d %H:%M') %>"><%= time_ago_in_words(n.created_at) %> 전</span>
                </div>
              </div>
            <% end %>
          <% else %>
            <div class="p-8 text-center">
              <svg class="w-8 h-8 mx-auto text-ink-200 dark:text-ink-600 mb-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
              <p class="text-[12px] text-ink-500">새 알림이 없습니다</p>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <script>
      function toggleNotificationPanel(e) {
        if (e) e.stopPropagation();
        document.getElementById('notification-panel').classList.toggle('hidden');
      }
      // ISS-멘션버그: 카드 클릭 시 알림 자동 읽음 처리 (badge가 영원히 unread 상태로 남는 문제 해결)
      function markNotificationRead(id) {
        var token = (document.querySelector('meta[name="csrf-token"]') || {}).content || '';
        fetch('/notifications/' + id + '/read', {
          method: 'PATCH',
          headers: { 'X-CSRF-Token': token, 'Accept': 'application/json' }
        }).catch(function(){});
      }
      document.addEventListener('click', function(e) {
        var bell = document.getElementById('notification-bell');
        var panel = document.getElementById('notification-panel');
        if (panel && !panel.classList.contains('hidden') && bell && !bell.contains(e.target)) {
          panel.classList.add('hidden');
        }
      });
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
          var panel = document.getElementById('notification-panel');
          if (panel) panel.classList.add('hidden');
        }
      });
    </script>

    <!-- Avatar (small, non-button — logout은 sidebar 하단) -->
    <div class="w-8 h-8 rounded-full bg-brand-600 grid place-items-center text-[11px] font-bold text-white tracking-wider ml-1" title="<%= current_user.display_name %>">
      <%= current_user.initials %>
    </div>
  </div>
</header>
