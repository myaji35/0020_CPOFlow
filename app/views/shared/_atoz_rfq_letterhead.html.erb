<%# locals: rfq_no, due_date, address (default to Abu Dhabi) %>
<% address ||= "Sector M41 - Abu Dhabi Industrial City - ICAD I - Abu Dhabi PO Box 93543" %>
<table cellpadding="0" cellspacing="0" border="0" style="width:100%; max-width:680px; margin-bottom:16px; font-family:'Helvetica Neue', Arial, sans-serif;">
  <tr>
    <td colspan="2" style="text-align:center; padding:16px 0; border-bottom:2px solid #222;">
      <h1 style="font-size:22px; font-weight:bold; margin:0; color:#222; letter-spacing:1px;">Request For Quotation</h1>
    </td>
  </tr>
</table>

<table cellpadding="6" cellspacing="0" border="0" style="width:100%; max-width:680px; margin-bottom:16px; font-size:13px; color:#222;">
  <tr style="background:#e5e5e5;">
    <td style="width:30%; font-weight:bold; border:1px solid #999;">RFQ No.</td>
    <td style="border:1px solid #999;"><%= rfq_no.presence || "—" %></td>
  </tr>
  <tr>
    <td style="font-weight:bold; border:1px solid #999;">Inquiry Due Date</td>
    <td style="border:1px solid #999;"><%= due_date.presence || "—" %></td>
  </tr>
  <tr>
    <td style="font-weight:bold; border:1px solid #999; vertical-align:top;">Inquiry Address</td>
    <td style="border:1px solid #999;"><%= address %></td>
  </tr>
</table>

<p style="font-size:13px; color:#222; margin:12px 0;">
  Please provide the best quotation for the below inquiry.<br>
  <strong>Note</strong>: Please include the delivery charge to this address.
</p>
