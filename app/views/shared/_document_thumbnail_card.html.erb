<% blob = doc.blob %>
<% filename = blob.filename.to_s %>
<% ext = File.extname(filename).downcase.delete('.') %>
<% mime = blob.content_type.to_s.downcase %>
<%
  is_image = mime.start_with?("image/")
  is_pdf   = mime.include?("pdf") || ext == "pdf"
  is_excel = mime.include?("spreadsheet") || mime.include?("excel") || %w[xlsx xls csv].include?(ext)
  is_word  = mime.include?("wordprocessingml") || mime.include?("msword") || %w[docx doc].include?(ext)
  is_html  = mime.include?("html") || %w[html htm].include?(ext)
  is_text  = mime.start_with?("text/") || %w[txt md json yaml yml xml log].include?(ext)
  is_zip   = %w[zip rar 7z gz tar].include?(ext)

  bg, icon_color, icon_path = case
    when is_image then ["bg-purple-50", "text-purple-500", :image]
    when is_pdf   then ["bg-red-50",    "text-red-500",    :pdf]
    when is_excel then ["bg-emerald-50", "text-emerald-600", :sheet]
    when is_word  then ["bg-blue-50",   "text-blue-600",   :word]
    when is_html  then ["bg-violet-50", "text-violet-600", :code]
    when is_text  then ["bg-gray-100",  "text-gray-600",   :text]
    when is_zip   then ["bg-amber-50",  "text-amber-600",  :archive]
    else               ["bg-gray-50",   "text-gray-400",   :file]
  end

  thumb_url = nil
  if is_image
    begin
      thumb_url = url_for(doc.variant(resize_to_fill: [480, 320]).processed)
    rescue StandardError
      thumb_url = url_for(doc) rescue nil
    end
  elsif is_pdf && doc.representable?
    begin
      thumb_url = url_for(doc.preview(resize_to_fill: [480, 320]).processed)
    rescue StandardError
      thumb_url = nil
    end
  end
%>

<% compact = local_assigns.fetch(:compact, false) %>
<div id="doc-card-<%= doc.id %>"
     class="group relative bg-white border border-gray-200 rounded-lg overflow-hidden hover:shadow-md hover:border-[#00A1E0] transition-all">
  <%# 섬네일 영역 (3:2 비율) %>
  <div class="relative aspect-[3/2] flex items-center justify-center <%= bg %> overflow-hidden">
    <% if thumb_url %>
      <%= image_tag thumb_url, class: "w-full h-full object-cover", loading: "lazy", alt: filename %>
    <% else %>
      <svg class="<%= compact ? 'w-8 h-8' : 'w-14 h-14' %> <%= icon_color %>" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <% case icon_path
        when :pdf %>
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
          <polyline points="14 2 14 8 20 8"/>
          <text x="6" y="18" font-size="6" font-weight="bold" fill="currentColor" stroke="none">PDF</text>
        <% when :sheet %>
          <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
          <line x1="3" y1="9" x2="21" y2="9"/><line x1="3" y1="15" x2="21" y2="15"/>
          <line x1="9" y1="3" x2="9" y2="21"/><line x1="15" y1="3" x2="15" y2="21"/>
        <% when :word %>
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
          <polyline points="14 2 14 8 20 8"/>
          <line x1="9" y1="13" x2="15" y2="13"/><line x1="9" y1="17" x2="15" y2="17"/>
        <% when :code %>
          <polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>
        <% when :text %>
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
          <polyline points="14 2 14 8 20 8"/>
          <line x1="9" y1="13" x2="15" y2="13"/><line x1="9" y1="17" x2="15" y2="17"/>
        <% when :archive %>
          <polyline points="21 8 21 21 3 21 3 8"/><rect x="1" y="3" width="22" height="5"/>
          <line x1="10" y1="12" x2="14" y2="12"/>
        <% when :image %>
          <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
          <circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/>
        <% else %>
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
          <polyline points="14 2 14 8 20 8"/>
        <% end %>
      </svg>
    <% end %>
    <%# 우상단 액션 — hover 시 표시 %>
    <div class="absolute top-1.5 right-1.5 flex gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
      <%= link_to rails_blob_path(doc, disposition: "inline"), target: "_blank", rel: "noopener",
          class: "w-6 h-6 flex items-center justify-center bg-white/90 hover:bg-white border border-gray-200 rounded shadow-sm",
          title: "보기" do %>
        <svg class="w-3.5 h-3.5 text-gray-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
      <% end %>
      <%= link_to rails_blob_path(doc, disposition: "attachment"),
          class: "w-6 h-6 flex items-center justify-center bg-white/90 hover:bg-white border border-gray-200 rounded shadow-sm",
          title: "다운로드" do %>
        <svg class="w-3.5 h-3.5 text-gray-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
      <% end %>
      <% if can_edit %>
        <%= button_to rails_blob_path(doc), method: :delete,
            form: { data: { turbo_confirm: "이 파일을 삭제하시겠습니까?" } },
            class: "w-6 h-6 flex items-center justify-center bg-white/90 hover:bg-red-50 border border-gray-200 rounded shadow-sm cursor-pointer",
            title: "삭제" do %>
          <svg class="w-3.5 h-3.5 text-red-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-2 14a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2L5 6"/></svg>
        <% end %>
      <% end %>
    </div>
  </div>
  <%# 메타 정보 %>
  <div class="<%= compact ? 'px-1.5 py-1' : 'px-2.5 py-2' %> border-t border-gray-100">
    <p class="<%= compact ? 'text-[10px]' : 'text-xs' %> font-medium text-gray-800 truncate" title="<%= filename %>"><%= filename %></p>
    <% unless compact %>
      <div class="flex items-center justify-between mt-0.5">
        <span class="text-[10px] text-gray-500 uppercase font-mono"><%= ext.presence || "FILE" %></span>
        <span class="text-[10px] text-gray-500"><%= number_to_human_size(blob.byte_size) %></span>
      </div>
    <% end %>
  </div>
</div>
