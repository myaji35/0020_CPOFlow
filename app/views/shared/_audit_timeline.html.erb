<%#
  ISS-303: HR 변경이력 타임라인 partial.
  Locals:
    activities — Activity 컬렉션 (recent 정렬, 최대 N건)
    title      — 섹션 제목 (기본: 변경 이력)
%>
<% title = local_assigns[:title] || "변경 이력" %>

<div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-6 mt-6">
  <div class="flex items-center justify-between mb-4">
    <h3 class="text-base font-semibold text-gray-900 dark:text-white"><%= title %></h3>
    <span class="text-xs text-gray-400"><%= activities.size %>건</span>
  </div>

  <% if activities.empty? %>
    <div class="flex flex-col items-center justify-center py-8 gap-2">
      <svg class="w-8 h-8 text-gray-200 dark:text-gray-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
      </svg>
      <p class="text-sm text-gray-500 dark:text-gray-500">변경 이력이 없습니다.</p>
    </div>
  <% else %>
    <ol class="relative border-l border-gray-200 dark:border-gray-700 ml-2 space-y-3">
      <% activities.each do |a| %>
        <li class="ml-4">
          <span class="absolute -left-1.5 w-3 h-3 rounded-full <%= a.action == 'destroyed' ? 'bg-red-500' : a.action == 'created' ? 'bg-emerald-500' : 'bg-accent' %>"></span>
          <div class="flex items-baseline gap-2 flex-wrap text-sm">
            <span class="font-medium text-gray-900 dark:text-white"><%= a.user&.email&.split('@')&.first || '시스템' %></span>
            <span class="text-gray-500 dark:text-gray-400"><%= a.action_label %></span>
            <% if a.field_changed? %>
              <span class="text-gray-700 dark:text-gray-300">— <%= a.field_label %>:</span>
              <span class="px-1.5 py-0.5 text-xs rounded bg-red-50 dark:bg-red-900/20 text-red-700 dark:text-red-300 line-through"><%= a.display_value(a.old_value) %></span>
              <span class="text-gray-400">→</span>
              <span class="px-1.5 py-0.5 text-xs rounded bg-emerald-50 dark:bg-emerald-900/20 text-emerald-700 dark:text-emerald-300"><%= a.display_value(a.new_value) %></span>
            <% end %>
            <% if a.auditable.present? && a.auditable_type != 'Employee' %>
              <span class="text-xs text-gray-400">[<%= a.auditable_type %>#<%= a.auditable_id %>]</span>
            <% end %>
            <span class="ml-auto text-xs text-gray-400 dark:text-gray-500"><%= l(a.created_at, format: :short) rescue a.created_at.strftime('%y.%m.%d %H:%M') %></span>
          </div>
        </li>
      <% end %>
    </ol>
  <% end %>
</div>
