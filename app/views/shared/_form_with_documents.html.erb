<% record = local_assigns.fetch(:record) %>
<% f = local_assigns.fetch(:f) %>
<% docs = (record.persisted? ? record.documents.includes(:blob).to_a : []) rescue [] %>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 min-h-[600px]">
  <%# 좌: 폼 입력 %>
  <div class="flex flex-col gap-4 overflow-y-auto">
    <%= yield %>
  </div>

  <%# 우: 첨부 미리보기 — Stimulus 컨트롤러로 새 파일 선택 즉시 미리보기 %>
  <div class="bg-gray-50 dark:bg-gray-900 rounded-xl border border-gray-200 dark:border-gray-700 p-4 flex flex-col"
       data-controller="document-preview">
    <div class="flex items-center justify-between mb-3">
      <h3 class="text-sm font-semibold text-gray-700 dark:text-gray-300">
        첨부 미리보기
        <% if record.persisted? && docs.any? %>
          <span class="text-xs font-normal text-gray-500">(<%= docs.size %>건)</span>
        <% end %>
      </h3>
    </div>

    <%# 큰 미리보기 영역 — 항상 존재. 빈 상태일 땐 emptyTarget으로 표시 %>
    <div class="flex-1 flex flex-col gap-3 min-h-[360px]">
      <div data-document-preview-target="viewer"
           class="flex-1 bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 overflow-hidden flex items-center justify-center min-h-[360px]">
        <% if docs.any? %>
          <% first = docs.first %>
          <% if first.blob.content_type.to_s.start_with?("image/") %>
            <%= image_tag rails_blob_path(first), class: "max-w-full max-h-[500px] object-contain", alt: first.blob.filename %>
          <% elsif first.blob.content_type == "application/pdf" %>
            <iframe src="<%= rails_blob_path(first) %>" class="w-full h-[500px] border-0" title="<%= first.blob.filename %>"></iframe>
          <% else %>
            <div class="text-center p-6">
              <svg class="w-16 h-16 mx-auto text-gray-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
              <p class="text-sm text-gray-500 mt-2"><%= first.blob.filename %></p>
              <%= link_to "다운로드", rails_blob_path(first, disposition: "attachment"), class: "text-xs text-primary mt-2 inline-block" %>
            </div>
          <% end %>
        <% else %>
          <%# 빈 상태 안내 — 파일 선택 시 컨트롤러가 hidden 처리 %>
          <div data-document-preview-target="empty" class="text-center p-6 border-2 border-dashed border-gray-300 dark:border-gray-600 rounded-lg w-full h-full flex items-center justify-center">
            <div>
              <svg class="w-12 h-12 mx-auto text-gray-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                <polyline points="17 8 12 3 7 8"/>
                <line x1="12" y1="3" x2="12" y2="15"/>
              </svg>
              <p class="text-sm text-gray-500 mt-3">PDF나 이미지를 끌어다 놓거나<br>아래 버튼으로 추가하세요</p>
            </div>
          </div>
        <% end %>
      </div>

      <%# 저장된 첨부 썸네일 그리드 (여러 첨부 시) %>
      <% if docs.size > 1 %>
        <div class="grid grid-cols-4 gap-2">
          <% docs.each do |doc| %>
            <button type="button"
                    data-action="document-preview#switch"
                    data-document-preview-blob-url-param="<%= rails_blob_path(doc) %>"
                    data-document-preview-content-type-param="<%= doc.blob.content_type %>"
                    data-document-preview-filename-param="<%= doc.blob.filename %>"
                    class="aspect-square bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded hover:border-[#00A1E0] transition-colors p-1 flex items-center justify-center overflow-hidden">
              <% if doc.blob.content_type.to_s.start_with?("image/") %>
                <%= image_tag rails_blob_path(doc), class: "w-full h-full object-cover rounded", alt: doc.blob.filename %>
              <% else %>
                <span class="text-xs text-gray-500 truncate w-full text-center leading-tight"><%= doc.blob.filename %></span>
              <% end %>
            </button>
          <% end %>
        </div>
      <% end %>

      <%# 새로 선택한 파일 썸네일 (저장 전, JS에서 채움) %>
      <div data-document-preview-target="thumbs" class="grid grid-cols-4 gap-2 hidden"></div>
    </div>

    <%# 파일 추가 필드 — change 이벤트로 즉시 미리보기 %>
    <div class="mt-3 pt-3 border-t border-gray-200 dark:border-gray-700">
      <%= f.label :documents, "파일 추가 (PDF/이미지/Office, 최대 25MB)",
          class: "block text-xs font-medium text-gray-600 dark:text-gray-500 mb-1.5" %>
      <%= f.file_field :documents, multiple: true,
          data: {
            "document-preview-target": "input",
            action: "change->document-preview#onFileSelect"
          },
          class: "block w-full text-sm text-gray-700 dark:text-gray-200 file:mr-3 file:py-2 file:px-3 file:rounded-lg file:border-0 file:bg-[#1E3A5F] file:text-white file:text-xs file:font-medium hover:file:opacity-80 cursor-pointer" %>
    </div>
  </div>
</div>
