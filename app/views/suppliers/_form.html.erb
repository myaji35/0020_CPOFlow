<%= form_with model: @supplier, local: true, class: "space-y-5" do |f| %>
  <% if @supplier.errors.any? %>
    <div class="bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-lg p-4">
      <% @supplier.errors.full_messages.each do |msg| %>
        <p class="text-sm text-red-700 dark:text-red-400"><%= msg %></p>
      <% end %>
    </div>
  <% end %>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.label :name, t("suppliers.form_name"), class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
      <%= f.text_field :name, class: "w-full border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary" %>
    </div>
    <div>
      <%= f.label :country, t("suppliers.form_country"), class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
      <%= f.text_field :country, class: "w-full border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary" %>
    </div>
  </div>

  <div class="grid grid-cols-3 gap-4">
    <div>
      <%= f.label :credit_grade, t("suppliers.form_credit_grade"), class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
      <%= f.select :credit_grade, options_for_select([[t("suppliers.form_select"), ""]] + Supplier::CREDIT_GRADES.map { |g| [g, g] }, @supplier.credit_grade),
          {}, class: "w-full border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary" %>
    </div>
    <div>
      <%= f.label :payment_terms, t("suppliers.form_payment_terms"), class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
      <%= f.select :payment_terms, options_for_select([[t("suppliers.form_select"), ""]] + Supplier::PAYMENT_TERMS, @supplier.payment_terms),
          {}, class: "w-full border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary" %>
    </div>
    <div>
      <%= f.label :lead_time_days, t("suppliers.form_lead_time"), class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
      <%= f.number_field :lead_time_days, class: "w-full border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary" %>
    </div>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.label :email, t("suppliers.form_email"), class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
      <%= f.email_field :email, class: "w-full border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary" %>
    </div>
    <div>
      <%= f.label :phone, t("suppliers.form_phone"), class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
      <%= f.text_field :phone, class: "w-full border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary" %>
    </div>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.label :website, t("suppliers.form_website"), class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
      <%= f.url_field :website, class: "w-full border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary", placeholder: "https://" %>
    </div>
    <div>
      <%= f.label :ecount_code, t("suppliers.form_ecount_code"), class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
      <%= f.text_field :ecount_code, class: "w-full border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary" %>
    </div>
  </div>

  <div>
    <%= f.label :notes, t("suppliers.form_notes"), class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
    <%= f.text_area :notes, rows: 3, class: "w-full border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary" %>
  </div>

  <div>
    <%= f.label :default_assignee_id, "기본 담당자", class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
    <%= f.select :default_assignee_id,
        options_for_select([["(없음)", ""]] + User.where(role: [:member, :manager, :admin]).order(:name).map { |u| [u.name, u.id] }, @supplier.default_assignee_id),
        {}, class: "w-full border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary" %>
    <% if @supplier.default_assignee_id.blank? %>
      <p class="mt-1 text-xs text-amber-600 dark:text-amber-400 bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-700 rounded px-2 py-1">
        ⚠️ 기본 담당자가 없으면 신규 Order가 미배정 상태로 누적됩니다
      </p>
    <% else %>
      <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">이 거래처로 들어오는 Order의 기본 담당자</p>
    <% end %>
  </div>

  <div class="flex gap-3 pt-2">
    <%= f.submit @supplier.new_record? ? t("suppliers.form_submit_create") : t("suppliers.form_submit_update"), class: "bg-primary text-white px-6 py-2 rounded-lg text-sm font-medium hover:bg-primary-dark transition-colors cursor-pointer" %>
    <%= link_to t("suppliers.form_cancel"), @supplier.new_record? ? suppliers_path : @supplier, class: "border border-gray-200 dark:border-gray-600 text-gray-600 dark:text-gray-500 px-6 py-2 rounded-lg text-sm font-medium hover:bg-gray-50 dark:hover:bg-gray-700" %>
  </div>
<% end %>
