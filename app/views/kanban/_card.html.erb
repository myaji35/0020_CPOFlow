<%
  card_bg_style     = "background-color:#{order.card_bg_color};"
  card_border_style = "border-color:#{order.card_border_color};"
  # SLA 리본 톤 — days_until_due 기반 (2026-04-29: D+7 기본 정책 반영, 임계값 D-3/D-7)
  _days = order.days_until_due
  sla_ribbon = if order.critical? || (_days && _days < 0)
                 "bg-red-500"   # 지연/critical
               elsif _days && _days <= 3
                 "bg-red-500"   # D-3 이내 빨강
               elsif _days && _days <= 7
                 "bg-amber-500" # D-4~7 노랑
               elsif _days && _days > 7
                 "bg-emerald-500" # 여유 있음
               else
                 ""
               end
  # ISS-354 Phase 2 Wave 2 (T7) — 멘션 worst intent/state에 따른 카드 좌측 스트라이프
  # sla_overdue > intent 2 > intent 1 우선순위. 인텐트가 0이거나 멘션 없으면 미적용.
  mention_worst_intent = order.mention_worst_intent.to_i
  mention_worst_state  = order.mention_worst_state.to_s
  mention_stripe_class = if mention_worst_state == "sla_overdue"
                           "border-l-4 border-red-600"
                         elsif mention_worst_intent >= 2
                           "border-l-4 border-red-500"
                         elsif mention_worst_intent >= 1
                           "border-l-4 border-amber-500"
                         else
                           ""
                         end
%>
<div id="kanban-card-<%= order.id %>"
     class="kanban-card-root relative rounded-md border pl-[14px] pr-3 py-2.5 shadow-sh-1 hover:shadow-sh-2 hover:border-ink-300 transition-all group cursor-pointer hover:cursor-grab active:cursor-grabbing<%= ' ring-2 ring-red-500 ring-offset-1' if order.critical? %> <%= mention_stripe_class %>"
     style="<%= card_bg_style %> <%= card_border_style %>"
     data-order-id="<%= order.id %>"
     data-card-status-key="<%= order.card_status&.key %>"
     data-card-status-id="<%= order.card_status_id %>"
     data-due-days="<%= order.days_until_due.to_i %>"
     data-assignee-ids="<%= order.assignees.map(&:id).join(',') %>"
     data-title="<%= order.title %>"
     data-customer="<%= order.customer_name %>"
     data-refno="<%= order.reference_no %>"
     data-thread-id="<%= order.gmail_thread_id %>"
     data-mention-worst-intent="<%= mention_worst_intent %>"
     data-mention-worst-state="<%= mention_worst_state %>"
     title="클릭하여 상세 보기"
     onclick="if(!this._justDragged && !window._selectMode && !event.target.closest('button,a,input,select,textarea,.drag-handle,[data-prevent-card-open]')){openOrderDrawer(<%= order.id %>, <%= order.display_subject.to_json %>, '<%= order_path(order) %>', '<%= order.reference_no %>');}"
     >

  <%# SLA 리본 (좌측 4px rounded) — redesign Phase 3
      pointer-events: none 으로 카드 클릭 영역 보존 %>
  <% if sla_ribbon.present? %>
    <span class="absolute left-0 top-0 bottom-0 w-[4px] <%= sla_ribbon %> rounded-l-md shadow-[1px_0_3px_rgba(0,0,0,0.1)] pointer-events-none z-10"></span>
  <% end %>

  <%# 퀵액션 버튼 (FR-02) — hover 시 노출.
      위치를 right-1 top-1 + 배지보다 z-20으로 올려 OVERDUE/D-N 배지와 시각적 충돌 차단.
      bg를 단단히(white opacity 100%)하여 배지를 완전히 덮음. %>
  <div class="quick-actions absolute top-1 right-1 flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity z-20 pointer-events-none group-hover:pointer-events-auto">
    <button class="quick-delete-btn w-6 h-6 flex items-center justify-center rounded-md bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 text-gray-600 dark:text-gray-400 hover:bg-red-50 dark:hover:bg-red-900/30 hover:text-red-600 hover:border-red-400 shadow-md transition-colors"
            data-order-id="<%= order.id %>"
            data-order-title="<%= order.display_subject %>"
            title="삭제"
            onclick="event.stopPropagation()">
      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
    </button>
  </div>

  <!-- Card Header — 2줄 구조
       1줄: 드래그 핸들 + 관리번호 칩 (R:99999 Q:99999 P:99999)
       2줄: 보드 뱃지(KOR) + 납기 뱃지(OVERDUE 3d) -->
  <%# 드래그 핸들 — 절대 위치로 띄워 헤더 줄에서 폭을 차지하지 않음 (좌측 정렬 보장) %>
  <span class="drag-handle absolute top-2 left-1 text-gray-300 dark:text-gray-600 hover:text-gray-500 opacity-0 group-hover:opacity-100 transition-opacity z-10"
        title="드래그하여 이동">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor">
      <circle cx="9"  cy="5"  r="1.5"/><circle cx="15" cy="5"  r="1.5"/>
      <circle cx="9"  cy="12" r="1.5"/><circle cx="15" cy="12" r="1.5"/>
      <circle cx="9"  cy="19" r="1.5"/><circle cx="15" cy="19" r="1.5"/>
    </svg>
  </span>

  <div class="mb-2 space-y-1.5 min-w-0">
    <%# 관리번호 — 카드 좌측 끝에 붙여 노출 (가장 중요한 식별자) %>
    <div class="min-w-0 overflow-hidden">
      <%= render "orders/tracking_chips", order: order %>
    </div>
    <%# hover 시 quick-actions가 우측 상단에 나타나므로 우측에 여유 공간 확보(group-hover:pr-7).
        이로써 OVERDUE/D-N 배지가 삭제 아이콘과 시각적으로 겹치지 않음. %>
    <div class="flex items-center justify-between gap-1 transition-[padding] group-hover:pr-7">
      <span class="shrink-0"><%= card_status_badge(order) %></span>
      <% if order.due_date %>
        <span class="shrink-0"><%= due_badge(order) %></span>
      <% else %>
        <%# AUDIT-003: due_date 미설정 시 회색 배지 — SLA 신호 무력화 방지 %>
        <span class="shrink-0 inline-flex items-center gap-1 text-xs font-medium px-1.5 py-0.5 rounded-full bg-gray-100 dark:bg-gray-700 text-gray-500 dark:text-gray-400 border border-gray-200 dark:border-gray-600">
          <svg class="w-3 h-3 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          due 미정
        </span>
      <% end %>
    </div>
  </div>

  <!-- 클릭 영역 — root div onclick이 처리함 -->
  <div class="cursor-pointer">

  <!-- Title -->
  <h4 class="text-sm font-semibold text-gray-900 dark:text-white leading-snug group-hover:text-accent transition-colors mb-1">
    <%= order.display_subject %>
  </h4>

  <%# 스레드 뱃지 — Inbox 그룹핑(reference_no) 또는 서브 이벤트 수(parent_order_id) %>
  <% inbox_thread_count = local_assigns[:thread_count] %>
  <% inbox_is_thread    = local_assigns[:is_thread] %>
  <% if inbox_is_thread %>
    <div class="inline-flex items-center gap-1 text-xs text-accent bg-blue-50 dark:bg-blue-900/30 px-1.5 py-0.5 rounded-full mb-1.5">
      <svg class="w-3 h-3 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
      스레드 <%= inbox_thread_count %>건
    </div>
  <% else %>
    <% sub_count = order.sub_orders.size %>
    <% if sub_count > 0 %>
      <div class="inline-flex items-center gap-1 text-xs text-accent bg-blue-50 dark:bg-blue-900/30 px-1.5 py-0.5 rounded-full mb-1.5">
        <svg class="w-3 h-3 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        +<%= sub_count %>건
      </div>
    <% end %>
  <% end %>

  <!-- 발주처 / 현장 -->
  <div class="flex flex-wrap items-center gap-1.5 mb-2">
    <% if order.client %>
      <span class="text-xs bg-blue-50 dark:bg-blue-900/30 text-blue-700 dark:text-blue-400 px-1.5 py-0.5 rounded-full flex items-center gap-1">
        <i class="lni lni-briefcase text-xs"></i>
        <%= order.client.name %>
      </span>
    <% elsif order.customer_name.present? %>
      <span class="text-xs text-gray-500 dark:text-gray-500 flex items-center gap-1">
        <i class="lni lni-user text-xs"></i>
        <%= order.customer_name %>
      </span>
    <% end %>
    <% if order.project %>
      <span class="text-xs bg-green-50 dark:bg-green-900/30 text-green-700 dark:text-green-400 px-1.5 py-0.5 rounded-full flex items-center gap-1">
        <i class="lni lni-construction text-xs"></i>
        <%= order.project.name %>
      </span>
    <% end %>
  </div>

  <!-- Item name if present -->
  <% if order.item_name.present? %>
    <p class="text-xs text-gray-500 dark:text-gray-500 mb-2 flex items-center gap-1">
      <i class="lni lni-package text-xs"></i>
      <%= order.item_name %> <%= "× #{order.quantity}" if order.quantity %>
    </p>
  <% end %>

  <!-- Tags -->
  <% if order.tags_array.any? %>
    <div class="flex flex-wrap gap-1 mb-2">
      <% order.tags_array.first(3).each do |tag| %>
        <span class="text-xs bg-blue-50 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 px-1.5 py-0.5 rounded"><%= tag %></span>
      <% end %>
    </div>
  <% end %>

  <!-- Task progress -->
  <% prog = order.task_progress %>
  <% if prog[:total] > 0 %>
    <div class="mb-2">
      <%= task_progress_bar(order) %>
    </div>
  <% end %>

  <%= render "orders/mention_dot_strip", order: order, viewer: current_user, variant: :kanban_card %>

  <!-- Footer: Assignees + Meta -->
  <div class="flex items-center justify-between pt-2 border-t border-gray-50 dark:border-gray-700">
    <!-- Assignee avatars -->
    <div class="flex -space-x-1">
      <% order.assignees.first(3).each do |u| %>
        <div class="w-5 h-5 rounded-full bg-primary text-white text-xs flex items-center justify-center border border-white dark:border-gray-800 font-medium"
             title="<%= u.display_name %>">
          <%= u.initials %>
        </div>
      <% end %>
    </div>

    <!-- Meta icons -->
    <div class="flex items-center gap-2 text-xs text-gray-500 dark:text-gray-500">
      <% if order.comments.any? %>
        <span class="flex items-center gap-0.5">
          <i class="lni lni-comments"></i>
          <%= order.comments.count %>
        </span>
      <% end %>
      <span class="flex items-center gap-0.5">
        <i class="lni lni-calendar"></i>
        <%= order.due_date&.strftime("%b %d") || "—" %>
      </span>
    </div>
  </div>
  </div><!-- /클릭 영역 -->
</div>
