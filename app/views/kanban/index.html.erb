<% content_for :page_title, t("kanban.title", default: "발주 보드") %>
<% content_for :head do %>
  <!-- SortableJS for drag-and-drop -->
  <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"></script>
<% end %>

<div class="flex items-center justify-between mb-5">
  <div class="flex items-center gap-2">
    <select onchange="window.location.href='/kanban?board_id=' + this.value"
            class="px-3 py-2 bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 rounded-lg text-sm font-semibold text-gray-900 dark:text-white focus:outline-none focus:border-[#00A1E0] focus:ring-1 focus:ring-[#00A1E0]">
      <% @boards.each do |board| %>
        <option value="<%= board.id %>" <%= "selected" if board.id == @current_board.id %>>
          <%= board.name %>
        </option>
      <% end %>
    </select>
    <span class="text-sm text-gray-500 dark:text-gray-500">— AtoZ2010 Inc.</span>
  </div>
  <% is_purchase_board = @current_board.is_default? || @current_board.board_type == "purchase" %>
  <%= link_to new_order_path(board_id: @current_board.id), class: "flex items-center gap-2 bg-accent text-white text-sm font-medium px-4 py-2 rounded-lg hover:bg-blue-500 transition-colors" do %>
    <i class="lni lni-plus"></i>
    <%= is_purchase_board ? "신규 발주" : "새 카드" %>
  <% end %>
</div>

<!-- 필터 바 (FR-01) -->
<div id="kanban-filter-bar" class="flex flex-wrap items-center gap-2 mb-4 p-3 bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700">
  <%# 담당자 드롭다운 %>
  <select id="filter-assignee"
          class="text-xs border border-gray-200 dark:border-gray-600 rounded-lg px-2 py-1.5 bg-white dark:bg-gray-700 text-gray-700 dark:text-gray-200 focus:outline-none focus:ring-2 focus:ring-accent/40">
    <option value="">전체 담당자</option>
    <% @filter_employees.each do |emp| %>
      <option value="<%= emp.id %>"><%= emp.display_name %></option>
    <% end %>
  </select>

  <%# 카드 상태 토글 — CardStatus 프리셋 동적 렌더 %>
  <div class="flex rounded-lg border border-gray-200 dark:border-gray-600 overflow-hidden text-xs">
    <button class="filter-priority-btn px-2.5 py-1.5 bg-white dark:bg-gray-700 text-gray-600 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-600 transition-colors border-r border-gray-200 dark:border-gray-600 last:border-0"
            data-value="">전체</button>
    <% @card_statuses.each do |cs| %>
      <button class="filter-priority-btn px-2.5 py-1.5 bg-white dark:bg-gray-700 text-gray-600 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-600 transition-colors border-r border-gray-200 dark:border-gray-600 last:border-0"
              data-value="<%= cs.key %>">
        <span class="inline-block w-2 h-2 rounded-full mr-1 align-middle" style="background-color: <%= cs.text_color %>"></span>
        <%= cs.name %>
      </button>
    <% end %>
  </div>

  <%# 납기 토글 %>
  <div class="flex rounded-lg border border-gray-200 dark:border-gray-600 overflow-hidden text-xs">
    <% [["", "전체"], ["urgent", "납기 7일 내"], ["overdue", "지연"]].each do |val, lbl| %>
      <button class="filter-due-btn px-2.5 py-1.5 bg-white dark:bg-gray-700 text-gray-600 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-600 transition-colors border-r border-gray-200 dark:border-gray-600 last:border-0"
              data-value="<%= val %>"><%= lbl %></button>
    <% end %>
  </div>

  <%# 키워드 검색 %>
  <div class="flex items-center gap-1.5 flex-1 min-w-[140px] max-w-[220px] border border-gray-200 dark:border-gray-600 rounded-lg px-2.5 py-1.5 bg-white dark:bg-gray-700">
    <svg class="w-3.5 h-3.5 text-gray-500 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
    <input id="filter-keyword" type="text" placeholder="검색..."
           class="text-xs bg-transparent text-gray-700 dark:text-gray-200 focus:outline-none w-full placeholder-gray-400 dark:placeholder-gray-500"
           onkeydown="if(event.key==='Enter'){event.preventDefault();this.blur();this.focus();if(typeof applyFilters==='function')applyFilters()}">
  </div>

  <%# 병합대상 버튼 — 중복 스레드가 있을 때만 카운트 표시 %>
  <button id="merge-mode-btn"
          onclick="toggleMergeMode()"
          class="flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-lg border transition-colors
                 <%= @duplicate_thread_ids.any? ? 'border-orange-300 dark:border-orange-700 bg-orange-50 dark:bg-orange-900/20 text-orange-600 dark:text-orange-400 hover:bg-orange-100 dark:hover:bg-orange-900/40' : 'border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-500 dark:text-gray-500 cursor-default' %>"
          <%= 'disabled' if @duplicate_thread_ids.empty? %>>
    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="18" r="3"/><circle cx="6" cy="6" r="3"/><path d="M13 6h3a2 2 0 0 1 2 2v7"/><path d="M11 18H8a2 2 0 0 1-2-2V9"/></svg>
    병합대상
    <% if @duplicate_thread_ids.any? %>
      <span class="inline-flex items-center justify-center min-w-[18px] h-[18px] rounded-full text-xs font-bold text-white" style="background:#D93025;"><%= @duplicate_thread_ids.size %></span>
    <% end %>
  </button>

  <%# 선택모드 버튼 — 자유 병합/일괄 작업 %>
  <button id="select-mode-btn"
          onclick="toggleSelectMode()"
          class="flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-lg border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-600 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-600 transition-colors">
    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
    선택모드
  </button>

  <%# 초기화 버튼 — 활성 필터 있을 때만 노출 %>
  <button id="filter-reset"
          class="hidden text-xs text-gray-500 dark:text-gray-500 hover:text-red-500 dark:hover:text-red-400 px-2 py-1.5 rounded-lg hover:bg-red-50 dark:hover:bg-red-900/20 transition-colors">
    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
  </button>
</div>

<%# 병합 모드 — 스레드별 그룹 리스트 (토글 시 칸반 대신 표시) %>
<div id="merge-view" class="hidden">
  <div class="mb-4 p-3 bg-orange-50 dark:bg-orange-900/20 border border-orange-200 dark:border-orange-800 rounded-xl flex items-center justify-between">
    <div class="flex items-center gap-2">
      <svg class="w-4 h-4 text-orange-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="18" r="3"/><circle cx="6" cy="6" r="3"/><path d="M13 6h3a2 2 0 0 1 2 2v7"/><path d="M11 18H8a2 2 0 0 1-2-2V9"/></svg>
      <span class="text-sm font-semibold text-orange-700 dark:text-orange-300">병합 모드</span>
      <span class="text-xs text-orange-500 dark:text-orange-400">— 각 그룹에서 메인(유지) 1개를 선택하고, 나머지에 체크 후 병합하세요</span>
    </div>
    <button onclick="toggleMergeMode()"
            class="flex items-center gap-1 text-xs text-orange-500 hover:text-orange-700 dark:hover:text-orange-300 px-2.5 py-1.5 rounded-lg hover:bg-orange-100 dark:hover:bg-orange-900/40 transition-colors">
      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      칸반으로 돌아가기
    </button>
  </div>

  <% status_colors = { "new_rfq"=>"bg-gray-400","make_quo"=>"bg-blue-400","pending_po"=>"bg-yellow-400","new_po"=>"bg-indigo-400","delivery_items"=>"bg-orange-400","problem"=>"bg-purple-400","get_grn"=>"bg-green-500","give_up"=>"bg-gray-200","done"=>"bg-emerald-600" } %>
  <% thread_colors = %w[#E53E3E #DD6B20 #D69E2E #38A169 #3182CE #805AD5 #D53F8C #2B6CB0 #C05621 #2F855A] %>

  <div class="space-y-4">
    <% @merge_groups.each_with_index do |group, gi| %>
      <% color = thread_colors[gi % thread_colors.length] %>
      <div class="bg-white dark:bg-gray-800 border-l-4 border border-gray-200 dark:border-gray-700 rounded-lg overflow-hidden"
           style="border-left-color: <%= color %>;"
           data-merge-group="<%= gi %>">

        <%# 그룹 헤더 %>
        <% main_order = group[:orders].first %>
        <% merge_order_ids = group[:orders].drop(1).map(&:id) %>
        <div class="px-5 py-3 bg-gray-50 dark:bg-gray-750 border-b border-gray-200 dark:border-gray-700 flex items-center justify-between">
          <div class="flex items-center gap-3">
            <span class="inline-flex items-center justify-center w-6 h-6 rounded-full text-white text-xs font-bold" style="background:<%= color %>"><%= group[:orders].size %></span>
            <div>
              <span class="text-sm font-semibold text-gray-900 dark:text-white"><%= main_order.display_subject.truncate(60) %></span>
              <span class="text-xs text-gray-500 dark:text-gray-500 ml-2"><%= main_order.customer_name %></span>
            </div>
          </div>
          <button onclick="executeMergeGroup(<%= main_order.id %>, [<%= merge_order_ids.join(',') %>], this)"
                  class="flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-lg bg-orange-500 text-white hover:bg-orange-600 transition-colors">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 16 12 12 8 16"/><line x1="12" y1="12" x2="12" y2="21"/><path d="M20.39 18.39A5 5 0 0 0 18 9h-1.26A8 8 0 1 0 3 16.3"/></svg>
            #<%= main_order.id %>에 병합
          </button>
        </div>

        <%# 주문 목록 %>
        <div class="divide-y divide-gray-100 dark:divide-gray-700">
          <% group[:orders].each_with_index do |order, oi| %>
            <div class="px-5 py-3 flex items-center gap-3 hover:bg-gray-50 dark:hover:bg-gray-750 transition-colors">

              <%# 메인/병합대상 라벨 %>
              <% if oi == 0 %>
                <span class="shrink-0 inline-flex items-center px-2 py-0.5 text-xs font-bold rounded bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-400">메인</span>
              <% else %>
                <span class="shrink-0 inline-flex items-center px-2 py-0.5 text-xs font-bold rounded bg-orange-100 dark:bg-orange-900/30 text-orange-600 dark:text-orange-400">병합</span>
              <% end %>

              <%# 주문 정보 %>
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 mb-0.5">
                  <span class="text-xs font-mono text-gray-500 dark:text-gray-500">#<%= order.id %></span>
                  <span class="inline-block px-2 py-0.5 text-xs font-medium rounded-full text-white <%= status_colors[order.status] || 'bg-gray-400' %>">
                    <%= Order::STATUS_LABELS[order.status] || order.status %>
                  </span>
                  <% if order.sub_orders.any? %>
                    <span class="text-xs text-blue-600 dark:text-blue-400">+<%= order.sub_orders.size %>건 서브</span>
                  <% end %>
                  <% if order.reference_no.present? %>
                    <span class="text-xs font-mono text-gray-500">Ref: <%= order.reference_no %></span>
                  <% end %>
                </div>
                <p class="text-sm text-gray-800 dark:text-gray-200 truncate"><%= order.title %></p>
                <div class="flex items-center gap-3 mt-0.5 text-xs text-gray-500 dark:text-gray-500">
                  <span><%= order.created_at.strftime("%Y-%m-%d %H:%M") %></span>
                  <span>From: <%= order.original_email_from.to_s.truncate(35) %></span>
                  <% if order.assignees.any? %>
                    <span>담당: <%= order.assignees.map(&:display_name).join(", ") %></span>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <% if @merge_groups.empty? %>
    <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg p-12 text-center">
      <svg class="w-12 h-12 mx-auto text-green-500 mb-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
      <p class="text-lg font-medium text-gray-900 dark:text-white">중복 주문이 없습니다</p>
      <p class="text-sm text-gray-500 dark:text-gray-500 mt-1">모든 칸반 카드가 정상입니다</p>
    </div>
  <% end %>
</div>

<!-- 발주 보드 -->
<div class="flex gap-4 overflow-x-auto pb-4 min-h-[calc(100vh-200px)]" id="kanban-board">
  <% @kanban_column_keys.each_with_index do |status, col_idx| %>
    <% orders = @columns[status] || [] %>
    <% label = @kanban_column_labels[status] || status.humanize %>
    <% prev_stat = col_idx > 0 ? @kanban_column_keys[col_idx - 1] : nil %>
    <% next_stat = col_idx < @kanban_column_keys.length - 1 ? @kanban_column_keys[col_idx + 1] : nil %>

    <div class="kanban-column flex flex-col w-72 shrink-0" data-status="<%= status %>">
      <!-- Column Header -->
      <div class="flex items-center justify-between mb-3 px-1">
        <div class="flex items-center gap-2">
          <span class="column-name text-sm font-semibold text-gray-700 dark:text-gray-300"><%= label %></span>
          <span class="column-count text-xs font-medium bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-500 rounded-full px-2 py-0.5"><%= status == "inbox" ? @inbox_grouped.size : orders.count %></span>
        </div>
        <% if status == "new_rfq" %>
          <%= link_to inbox_path, class: "text-xs text-accent hover:underline" do %>
            <i class="lni lni-envelope text-sm"></i>
          <% end %>
        <% end %>
      </div>

      <!-- Cards Container -->
      <div class="kanban-cards flex flex-col gap-3 flex-1 min-h-[60px] p-2 bg-gray-100 dark:bg-gray-700/50 rounded-xl"
           data-status="<%= status %>"
           id="column-<%= status %>">
        <% if status == "inbox" %>
          <% @inbox_grouped.each do |group| %>
            <%= render "kanban/card",
                       order: group[:order],
                       prev_status: prev_stat,
                       next_status: next_stat,
                       thread_count: group[:thread_count],
                       is_thread: group[:is_thread] %>
          <% end %>
        <% else %>
          <% orders.each do |order| %>
            <%= render "kanban/card", order: order, prev_status: prev_stat, next_status: next_stat %>
          <% end %>
        <% end %>

        <%# ISS-046 후속: 컬럼별 INITIAL_LIMIT 초과분 백그라운드 lazy 로드 %>
        <% column_total = (status == "inbox") ? @inbox_grouped.size : (@column_totals && @column_totals[status]) %>
        <% if column_total && column_total > KanbanController::INITIAL_LIMIT %>
          <turbo-frame id="kanban-more-<%= status %>"
                       src="<%= kanban_path(frame: 'prefetch', status: status) %>"
                       loading="lazy"
                       class="contents"></turbo-frame>
        <% end %>

        <!-- Empty state -->
        <% empty_check = status == "inbox" ? @inbox_grouped.empty? : orders.empty? %>
        <div class="empty-state flex-1 flex items-center justify-center text-xs text-gray-500 dark:text-gray-500 py-8<%= empty_check ? '' : ' hidden' %>">
          <div class="text-center">
            <i class="lni lni-inbox text-2xl block mb-1 opacity-50"></i>
            No orders
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>

<!-- 선택모드 하단 액션 바 -->
<div id="select-action-bar" class="fixed bottom-0 left-0 right-0 z-50 hidden">
  <div class="max-w-4xl mx-auto px-4 pb-4">
    <div class="flex items-center justify-between bg-primary text-white rounded-xl shadow-2xl px-5 py-3">
      <div class="flex items-center gap-3">
        <span id="select-count" class="text-sm font-medium">0개 선택</span>
      </div>
      <div class="flex items-center gap-2">
        <button onclick="openMergeModal()"
                id="action-merge-btn" disabled
                class="flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-lg bg-orange-500 hover:bg-orange-600 disabled:opacity-40 disabled:cursor-not-allowed transition-colors">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="18" r="3"/><circle cx="6" cy="6" r="3"/><path d="M13 6h3a2 2 0 0 1 2 2v7"/><path d="M11 18H8a2 2 0 0 1-2-2V9"/></svg>
          병합
        </button>
        <button onclick="bulkMovePrompt()"
                id="action-move-btn" disabled
                class="flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-lg bg-blue-500 hover:bg-blue-600 disabled:opacity-40 disabled:cursor-not-allowed transition-colors">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
          이동
        </button>
        <button onclick="clearSelection()"
                class="flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-lg bg-white/20 hover:bg-white/30 transition-colors">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          선택 해제
        </button>
      </div>
    </div>
  </div>
</div>

<!-- 병합 모달 — 메인 카드 선택 -->
<div id="merge-modal" class="fixed inset-0 z-[70] hidden">
  <div class="fixed inset-0 bg-black/40 backdrop-blur-sm" onclick="closeMergeModal()"></div>
  <div class="fixed inset-0 flex items-center justify-center p-4">
    <div class="relative bg-white dark:bg-gray-800 rounded-2xl shadow-2xl w-full max-w-md p-6">
      <div class="flex items-center gap-3 mb-4">
        <div class="w-10 h-10 rounded-full bg-orange-100 dark:bg-orange-900/30 flex items-center justify-center">
          <svg class="w-5 h-5 text-orange-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="18" r="3"/><circle cx="6" cy="6" r="3"/><path d="M13 6h3a2 2 0 0 1 2 2v7"/><path d="M11 18H8a2 2 0 0 1-2-2V9"/></svg>
        </div>
        <div>
          <h3 class="text-base font-semibold text-gray-900 dark:text-white">카드 병합</h3>
          <p class="text-xs text-gray-500 dark:text-gray-500">메인으로 유지할 카드를 선택하세요</p>
        </div>
      </div>
      <div id="merge-modal-list" class="space-y-2 mb-5 max-h-[300px] overflow-y-auto"></div>
      <div class="flex gap-2 justify-end">
        <button onclick="closeMergeModal()"
                class="px-4 py-2 text-sm font-medium text-gray-700 dark:text-gray-300 bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 rounded-lg transition-colors">
          취소
        </button>
        <button id="merge-modal-confirm" onclick="executeFreeMerge()"
                class="px-4 py-2 text-sm font-medium text-white bg-orange-500 hover:bg-orange-600 rounded-lg transition-colors flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18" cy="18" r="3"/><circle cx="6" cy="6" r="3"/><path d="M13 6h3a2 2 0 0 1 2 2v7"/><path d="M11 18H8a2 2 0 0 1-2-2V9"/></svg>
          병합 실행
        </button>
      </div>
    </div>
  </div>
</div>

<!-- 일괄이동 모달 -->
<div id="move-modal" class="fixed inset-0 z-[70] hidden">
  <div class="fixed inset-0 bg-black/40 backdrop-blur-sm" onclick="closeMoveModal()"></div>
  <div class="fixed inset-0 flex items-center justify-center p-4">
    <div class="relative bg-white dark:bg-gray-800 rounded-2xl shadow-2xl w-full max-w-sm p-6">
      <h3 class="text-base font-semibold text-gray-900 dark:text-white mb-4">일괄 이동</h3>
      <div class="grid grid-cols-2 gap-2 mb-5">
        <% @kanban_column_keys.each do |st| %>
          <button onclick="executeBulkMove('<%= st %>')"
                  class="text-left px-3 py-2 text-xs font-medium rounded-lg border border-gray-200 dark:border-gray-600 hover:bg-blue-50 dark:hover:bg-blue-900/20 hover:border-blue-300 dark:hover:border-blue-700 text-gray-700 dark:text-gray-300 transition-colors">
            <%= @kanban_column_labels[st] || st.humanize %>
          </button>
        <% end %>
      </div>
      <div class="flex justify-end">
        <button onclick="closeMoveModal()"
                class="px-4 py-2 text-sm font-medium text-gray-700 dark:text-gray-300 bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 rounded-lg transition-colors">취소</button>
