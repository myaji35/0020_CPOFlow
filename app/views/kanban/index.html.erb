<% content_for :page_title, "Kanban Board" %>
<% content_for :head do %>
  <!-- SortableJS for drag-and-drop -->
  <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"></script>
<% end %>

<div class="flex items-center justify-between mb-5">
  <div class="flex items-center gap-2">
    <h2 class="text-lg font-semibold text-gray-900 dark:text-white"><%= t("kanban.title", default: "Procurement Board") %></h2>
    <span class="text-sm text-gray-400 dark:text-gray-500">— AtoZ2010 Inc.</span>
  </div>
  <%= link_to new_order_path, class: "flex items-center gap-2 bg-accent text-white text-sm font-medium px-4 py-2 rounded-lg hover:bg-blue-500 transition-colors" do %>
    <i class="lni lni-plus"></i>
    <%= t("kanban.new_order", default: "New Order") %>
  <% end %>
</div>

<!-- 필터 바 (FR-01) -->
<div id="kanban-filter-bar" class="flex flex-wrap items-center gap-2 mb-4 p-3 bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700">
  <%# 담당자 드롭다운 %>
  <select id="filter-assignee"
          class="text-xs border border-gray-200 dark:border-gray-600 rounded-lg px-2 py-1.5 bg-white dark:bg-gray-700 text-gray-700 dark:text-gray-200 focus:outline-none focus:ring-2 focus:ring-accent/40">
    <option value="">전체 담당자</option>
    <% @filter_employees.each do |emp| %>
      <option value="<%= emp.id %>"><%= emp.display_name %></option>
    <% end %>
  </select>

  <%# 우선순위 토글 %>
  <div class="flex rounded-lg border border-gray-200 dark:border-gray-600 overflow-hidden text-xs">
    <% [["", "전체"], ["urgent", "긴급"], ["high", "높음"], ["medium", "보통"]].each do |val, lbl| %>
      <button class="filter-priority-btn px-2.5 py-1.5 bg-white dark:bg-gray-700 text-gray-600 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-600 transition-colors border-r border-gray-200 dark:border-gray-600 last:border-0"
              data-value="<%= val %>"><%= lbl %></button>
    <% end %>
  </div>

  <%# 납기 토글 %>
  <div class="flex rounded-lg border border-gray-200 dark:border-gray-600 overflow-hidden text-xs">
    <% [["", "전체"], ["urgent", "D-7"], ["overdue", "지연"]].each do |val, lbl| %>
      <button class="filter-due-btn px-2.5 py-1.5 bg-white dark:bg-gray-700 text-gray-600 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-600 transition-colors border-r border-gray-200 dark:border-gray-600 last:border-0"
              data-value="<%= val %>"><%= lbl %></button>
    <% end %>
  </div>

  <%# 키워드 검색 %>
  <div class="flex items-center gap-1.5 flex-1 min-w-[140px] max-w-[220px] border border-gray-200 dark:border-gray-600 rounded-lg px-2.5 py-1.5 bg-white dark:bg-gray-700">
    <svg class="w-3.5 h-3.5 text-gray-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
    <input id="filter-keyword" type="text" placeholder="검색..."
           class="text-xs bg-transparent text-gray-700 dark:text-gray-200 focus:outline-none w-full placeholder-gray-400 dark:placeholder-gray-500">
  </div>

  <%# 병합대상 버튼 — 중복 스레드가 있을 때만 카운트 표시 %>
  <button id="merge-mode-btn"
          onclick="toggleMergeMode()"
          class="flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-lg border transition-colors
                 <%= @duplicate_thread_ids.any? ? 'border-orange-300 dark:border-orange-700 bg-orange-50 dark:bg-orange-900/20 text-orange-600 dark:text-orange-400 hover:bg-orange-100 dark:hover:bg-orange-900/40' : 'border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-400 dark:text-gray-500 cursor-default' %>"
          <%= 'disabled' if @duplicate_thread_ids.empty? %>>
    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="18" r="3"/><circle cx="6" cy="6" r="3"/><path d="M13 6h3a2 2 0 0 1 2 2v7"/><path d="M11 18H8a2 2 0 0 1-2-2V9"/></svg>
    병합대상
    <% if @duplicate_thread_ids.any? %>
      <span class="inline-flex items-center justify-center min-w-[18px] h-[18px] rounded-full text-[10px] font-bold text-white" style="background:#D93025;"><%= @duplicate_thread_ids.size %></span>
    <% end %>
  </button>

  <%# 초기화 버튼 — 활성 필터 있을 때만 노출 %>
  <button id="filter-reset"
          class="hidden text-xs text-gray-400 dark:text-gray-500 hover:text-red-500 dark:hover:text-red-400 px-2 py-1.5 rounded-lg hover:bg-red-50 dark:hover:bg-red-900/20 transition-colors">
    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
  </button>
</div>

<%# 병합 모드 패널 — 토글 시 노출 %>
<div id="merge-panel" class="hidden mb-4 p-3 bg-orange-50 dark:bg-orange-900/20 border border-orange-200 dark:border-orange-800 rounded-xl">
  <div class="flex items-center justify-between">
    <div class="flex items-center gap-2">
      <svg class="w-4 h-4 text-orange-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="18" r="3"/><circle cx="6" cy="6" r="3"/><path d="M13 6h3a2 2 0 0 1 2 2v7"/><path d="M11 18H8a2 2 0 0 1-2-2V9"/></svg>
      <span class="text-sm font-semibold text-orange-700 dark:text-orange-300">병합 모드</span>
      <span class="text-xs text-orange-500 dark:text-orange-400">— 같은 색 테두리 = 같은 스레드. 메인 1개 선택 후 나머지를 병합합니다.</span>
    </div>
    <div class="flex items-center gap-2">
      <span id="merge-selection-info" class="text-xs text-orange-600 dark:text-orange-400"></span>
      <button id="merge-execute-btn" onclick="executeMerge()" disabled
              class="flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-lg bg-orange-500 text-white hover:bg-orange-600 disabled:opacity-40 disabled:cursor-not-allowed transition-colors">
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 16 12 12 8 16"/><line x1="12" y1="12" x2="12" y2="21"/><path d="M20.39 18.39A5 5 0 0 0 18 9h-1.26A8 8 0 1 0 3 16.3"/></svg>
        병합 실행
      </button>
      <button onclick="toggleMergeMode()"
              class="text-xs text-orange-400 hover:text-orange-600 dark:hover:text-orange-300 px-2 py-1.5 rounded-lg hover:bg-orange-100 dark:hover:bg-orange-900/40 transition-colors">
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
  </div>
</div>

<!-- Kanban Board -->
<div class="flex gap-4 overflow-x-auto pb-4 min-h-[calc(100vh-200px)]" id="kanban-board">
  <% Order::KANBAN_COLUMNS.each_with_index do |status, col_idx| %>
    <% orders = @columns[status] || [] %>
    <% label = Order::STATUS_LABELS[status] %>
    <% prev_stat = col_idx > 0 ? Order::KANBAN_COLUMNS[col_idx - 1] : nil %>
    <% next_stat = col_idx < Order::KANBAN_COLUMNS.length - 1 ? Order::KANBAN_COLUMNS[col_idx + 1] : nil %>

    <div class="kanban-column flex flex-col w-72 shrink-0" data-status="<%= status %>">
      <!-- Column Header -->
      <div class="flex items-center justify-between mb-3 px-1">
        <div class="flex items-center gap-2">
          <span class="column-name text-sm font-semibold text-gray-700 dark:text-gray-300"><%= label %></span>
          <span class="column-count text-xs font-medium bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-400 rounded-full px-2 py-0.5"><%= orders.count %></span>
        </div>
        <% if status == "new_rfq" %>
          <%= link_to inbox_path, class: "text-xs text-accent hover:underline" do %>
            <i class="lni lni-envelope text-sm"></i>
          <% end %>
        <% end %>
      </div>

      <!-- Cards Container -->
      <div class="kanban-cards flex flex-col gap-3 flex-1 min-h-[60px] p-2 bg-gray-100 dark:bg-gray-700/50 rounded-xl"
           data-status="<%= status %>"
           id="column-<%= status %>">
        <% orders.each do |order| %>
          <%= render "kanban/card", order: order, prev_status: prev_stat, next_status: next_stat %>
        <% end %>

        <!-- Empty state -->
        <% empty_check = orders.empty? %>
        <div class="empty-state flex-1 flex items-center justify-center text-xs text-gray-400 dark:text-gray-500 py-8<%= empty_check ? '' : ' hidden' %>">
          <div class="text-center">
            <i class="lni lni-inbox text-2xl block mb-1 opacity-50"></i>
            No orders
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>

<!-- 삭제 확인 모달 -->
<div id="delete-confirm-modal" class="fixed inset-0 z-[60] hidden">
  <div class="fixed inset-0 bg-black/40 backdrop-blur-sm" onclick="closeDeleteModal()"></div>
  <div class="fixed inset-0 flex items-center justify-center p-4">
    <div class="relative bg-white dark:bg-gray-800 rounded-2xl shadow-2xl w-full max-w-sm p-6">
      <div class="flex items-center gap-3 mb-4">
        <div class="w-10 h-10 rounded-full bg-red-100 dark:bg-red-900/30 flex items-center justify-center">
          <svg class="w-5 h-5 text-red-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
        </div>
        <div>
          <h3 class="text-base font-semibold text-gray-900 dark:text-white">발주 삭제</h3>
          <p class="text-xs text-gray-500 dark:text-gray-400">이 작업은 되돌릴 수 없습니다</p>
        </div>
      </div>
      <p class="text-sm text-gray-600 dark:text-gray-300 mb-5">
        <span id="delete-order-title" class="font-medium text-gray-900 dark:text-white"></span>
        <span class="block mt-1 text-gray-500 dark:text-gray-400">관련 댓글, 작업, 활동 기록도 함께 삭제됩니다.</span>
      </p>
      <div class="flex gap-2 justify-end">
        <button onclick="closeDeleteModal()"
                class="px-4 py-2 text-sm font-medium text-gray-700 dark:text-gray-300 bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 rounded-lg transition-colors">
          취소
        </button>
        <button id="delete-confirm-btn"
                class="px-4 py-2 text-sm font-medium text-white bg-red-500 hover:bg-red-600 rounded-lg transition-colors flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
          삭제
        </button>
      </div>
    </div>
  </div>
</div>

<%# ── 병합 모드 JS ─────────────────────────────────────────── %>
<script>
var DUPLICATE_THREADS = <%= @duplicate_thread_ids.to_json.html_safe %>;
var mergeMode = false;
var mergeMainId = null;
var mergeCandidateIds = [];

// 스레드별 고유 색상
var THREAD_COLORS = ['#E53E3E','#DD6B20','#D69E2E','#38A169','#3182CE','#805AD5','#D53F8C','#2B6CB0','#C05621','#2F855A'];

function toggleMergeMode() {
  mergeMode = !mergeMode;
  var panel = document.getElementById('merge-panel');
  var btn = document.getElementById('merge-mode-btn');

  panel.classList.toggle('hidden', !mergeMode);
  btn.classList.toggle('ring-2', mergeMode);
  btn.classList.toggle('ring-orange-400', mergeMode);

  if (mergeMode) {
    enterMergeMode();
  } else {
    exitMergeMode();
  }
}

function enterMergeMode() {
  mergeMainId = null;
  mergeCandidateIds = [];

  // 중복 카드만 하이라이트, 나머지 흐리게
  document.querySelectorAll('[data-order-id]').forEach(function(card) {
    var tid = card.dataset.threadId;
    var idx = DUPLICATE_THREADS.indexOf(tid);

    if (idx >= 0) {
      // 중복 카드: 색상 테두리 + 체크박스 표시
      var color = THREAD_COLORS[idx % THREAD_COLORS.length];
      card.style.boxShadow = 'inset 0 0 0 2.5px ' + color;
      card.style.opacity = '1';
      card.dataset.mergeGroup = idx;

      // 체크박스 삽입
      if (!card.querySelector('.merge-cb-wrap')) {
        var wrap = document.createElement('div');
        wrap.className = 'merge-cb-wrap absolute top-2 left-2 z-20';
        wrap.innerHTML = '<label class="flex items-center gap-1 cursor-pointer bg-white dark:bg-gray-800 rounded-md px-1.5 py-0.5 shadow border border-gray-200 dark:border-gray-600">'
          + '<input type="checkbox" class="merge-cb rounded border-gray-300 text-orange-500 focus:ring-orange-500" data-order-id="' + card.dataset.orderId + '" data-thread-id="' + tid + '" onchange="onMergeCheckChange(this)">'
          + '<span class="text-[10px] font-medium text-gray-600 dark:text-gray-300">#' + card.dataset.orderId + '</span>'
          + '</label>';
        card.style.position = 'relative';
        card.appendChild(wrap);
      }
    } else {
      // 비중복 카드: 흐리게
      card.style.opacity = '0.35';
      card.style.pointerEvents = 'none';
    }
  });

  updateMergeInfo();
}

function exitMergeMode() {
  document.querySelectorAll('[data-order-id]').forEach(function(card) {
    card.style.boxShadow = '';
    card.style.opacity = '';
    card.style.pointerEvents = '';
    delete card.dataset.mergeGroup;
    var wrap = card.querySelector('.merge-cb-wrap');
    if (wrap) wrap.remove();
  });
  mergeMainId = null;
  mergeCandidateIds = [];
  updateMergeInfo();
}

function onMergeCheckChange(cb) {
  var checked = document.querySelectorAll('.merge-cb:checked');
  var ids = [];
  checked.forEach(function(c) { ids.push(parseInt(c.dataset.orderId)); });

  if (ids.length === 0) {
    mergeMainId = null;
    mergeCandidateIds = [];
  } else {
    // 첫 번째 체크된 것이 메인, 나머지가 병합 대상
    mergeMainId = ids[0];
    mergeCandidateIds = ids.slice(1);
  }

  // 체크박스 라벨 업데이트: 메인/병합 구분
  document.querySelectorAll('.merge-cb').forEach(function(c) {
    var label = c.parentElement.querySelector('span');
    var oid = parseInt(c.dataset.orderId);
    if (c.checked && oid === mergeMainId) {
      label.textContent = '#' + oid + ' (메인)';
      label.className = 'text-[10px] font-bold text-blue-600 dark:text-blue-400';
    } else if (c.checked) {
      label.textContent = '#' + oid + ' (병합)';
      label.className = 'text-[10px] font-bold text-orange-600 dark:text-orange-400';
    } else {
      label.textContent = '#' + oid;
      label.className = 'text-[10px] font-medium text-gray-600 dark:text-gray-300';
    }
  });

  updateMergeInfo();
}

function updateMergeInfo() {
  var info = document.getElementById('merge-selection-info');
  var btn = document.getElementById('merge-execute-btn');

  if (!mergeMainId) {
    info.textContent = '카드를 선택하세요 (첫 번째 = 메인)';
    btn.disabled = true;
  } else if (mergeCandidateIds.length === 0) {
    info.textContent = '메인: #' + mergeMainId + ' — 병합할 카드를 추가 선택하세요';
    btn.disabled = true;
  } else {
    info.textContent = '메인: #' + mergeMainId + ' ← 병합: ' + mergeCandidateIds.map(function(id){ return '#'+id; }).join(', ');
    btn.disabled = false;
  }
}

function executeMerge() {
  if (!mergeMainId || mergeCandidateIds.length === 0) return;
  if (!confirm('선택한 ' + mergeCandidateIds.length + '개 카드를 #' + mergeMainId + '에 병합합니다.\n병합된 카드는 서브 주문으로 변환되어 칸반에서 사라집니다.\n\n계속하시겠습니까?')) return;

  var csrf = document.querySelector('meta[name="csrf-token"]').content;

  fetch('/kanban/merge', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrf },
    body: JSON.stringify({ main_order_id: mergeMainId, merge_order_ids: mergeCandidateIds })
  })
  .then(function(r) { return r.json(); })
  .then(function(data) {
    if (data.success) {
      // 병합된 카드를 DOM에서 제거
      data.merged_ids.forEach(function(id) {
        var card = document.querySelector('[data-order-id="' + id + '"]');
        if (card) {
          card.style.transition = 'all 0.3s ease';
          card.style.opacity = '0';
          card.style.transform = 'scale(0.9)';
          setTimeout(function() { card.remove(); }, 300);
        }
      });

      // 메인 카드의 서브 카운트 업데이트
      var mainCard = document.querySelector('[data-order-id="' + data.main_id + '"]');
      if (mainCard) {
        mainCard.style.boxShadow = '0 0 0 2px #38A169';
        setTimeout(function() { mainCard.style.boxShadow = ''; }, 2000);
      }

      // 토스트
      setTimeout(function() {
        toggleMergeMode();
        // 페이지 새로고침으로 카운트 정확히 반영
        window.location.reload();
      }, 500);
    } else {
      alert('병합 실패: ' + (data.error || '알 수 없는 오류'));
    }
  })
  .catch(function() {
    alert('네트워크 오류가 발생했습니다.');
  });
}
</script>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const CSRF = document.querySelector('meta[name="csrf-token"]').content;

  // 컬럼 카운트 배지 업데이트
  function updateCounts() {
    document.querySelectorAll('.kanban-column').forEach(function(col) {
      const count = col.querySelectorAll('[data-order-id]').length;
      const badge = col.querySelector('.column-count');
      if (badge) badge.textContent = count;

      // 빈 칼럼 empty-state 토글
      const cards  = col.querySelector('.kanban-cards');
      const empty  = col.querySelector('.empty-state');
      if (!cards || !empty) return;
      const hasCards = cards.querySelectorAll('[data-order-id]').length > 0;
      empty.style.display = hasCards ? 'none' : '';
    });
  }

  // 드래그 중 타겟 컬럼 하이라이트
  function highlightColumn(el, on) {
    if (!el) return;
    el.classList.toggle('ring-2', on);
    el.classList.toggle('ring-accent', on);
    el.classList.toggle('ring-inset', on);
    el.classList.toggle('bg-blue-50/60', on);
    el.classList.toggle('dark:bg-blue-900/20', on);
  }

  // 이동 성공 토스트
  function showToast(msg, ok) {
    const old = document.getElementById('kanban-toast');
    if (old) old.remove();
    const t = document.createElement('div');
    t.id = 'kanban-toast';
    t.className = 'fixed bottom-6 left-1/2 -translate-x-1/2 z-50 px-4 py-2.5 rounded-xl text-sm font-medium shadow-lg transition-all duration-300 flex items-center gap-2 '
      + (ok ? 'bg-green-500 text-white' : 'bg-red-500 text-white');
    t.innerHTML = (ok
      ? '<svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>'
      : '<svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>')
      + msg;
    document.body.appendChild(t);
    setTimeout(function() { t.style.opacity = '0'; setTimeout(function() { t.remove(); }, 300); }, 2500);
  }

  // ── FR-01: 필터 ──────────────────────────────────────────────
  const filterAssignee = document.getElementById('filter-assignee');
  const filterKeyword  = document.getElementById('filter-keyword');
  const filterReset    = document.getElementById('filter-reset');
  let   activePriority = '';
  let   activeDue      = '';

  function setActiveToggle(btnClass, activeVal) {
    document.querySelectorAll('.' + btnClass).forEach(function(btn) {
      const on = btn.dataset.value === activeVal;
      btn.classList.toggle('bg-accent',            on);
      btn.classList.toggle('text-white',           on);
      btn.classList.toggle('bg-white',            !on);
      btn.classList.toggle('dark:bg-gray-700',    !on);
      btn.classList.toggle('text-gray-600',       !on);
      btn.classList.toggle('dark:text-gray-300',  !on);
    });
  }

  function applyFilters() {
    const assigneeVal = filterAssignee.value;
    const keyword     = filterKeyword.value.toLowerCase().trim();
    const anyActive   = assigneeVal || activePriority || activeDue || keyword;

    document.querySelectorAll('[data-order-id]').forEach(function(card) {
      const assigneeIds = (card.dataset.assigneeIds || '').split(',').filter(Boolean);
      const assigneeOk  = !assigneeVal || assigneeIds.includes(assigneeVal);

      const priorityOk  = !activePriority || card.dataset.priority === activePriority;

      const dueDays = parseInt(card.dataset.dueDays, 10);
      const dueOk   = !activeDue ? true
        : activeDue === 'overdue' ? dueDays < 0
        : activeDue === 'urgent'  ? (dueDays >= 0 && dueDays <= 7)
        : true;

      const text      = (card.dataset.title || '') + ' ' + (card.dataset.customer || '');
      const keywordOk = !keyword || text.toLowerCase().includes(keyword);

      card.classList.toggle('hidden', !(assigneeOk && priorityOk && dueOk && keywordOk));
    });

    filterReset.classList.toggle('hidden', !anyActive);
    updateCounts();
  }

  document.querySelectorAll('.filter-priority-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      activePriority = activePriority === btn.dataset.value ? '' : btn.dataset.value;
      setActiveToggle('filter-priority-btn', activePriority);
      applyFilters();
    });
  });

  document.querySelectorAll('.filter-due-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      activeDue = activeDue === btn.dataset.value ? '' : btn.dataset.value;
      setActiveToggle('filter-due-btn', activeDue);
      applyFilters();
    });
  });

  filterAssignee.addEventListener('change', applyFilters);
  filterKeyword.addEventListener('input', applyFilters);

  filterReset.addEventListener('click', function() {
    filterAssignee.value = '';
    filterKeyword.value  = '';
    activePriority = '';
    activeDue      = '';
    setActiveToggle('filter-priority-btn', '');
    setActiveToggle('filter-due-btn', '');
    applyFilters();
  });

  setActiveToggle('filter-priority-btn', '');
  setActiveToggle('filter-due-btn', '');

  // ── FR-02: 퀵액션 ──────────────────────────────────────────
  document.addEventListener('click', function(e) {
    const btn = e.target.closest('.quick-move-btn');
    if (!btn) return;
    e.stopPropagation();

    const orderId = btn.dataset.orderId;
    const moveTo  = btn.dataset.moveTo;
    const cardEl  = document.querySelector('[data-order-id="' + orderId + '"]');
    if (!orderId || !moveTo || !cardEl) return;

    btn.disabled = true;
    btn.classList.add('opacity-50');

    fetch('/orders/' + orderId + '/move', {
      method:  'PATCH',
      headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF },
      body:    JSON.stringify({ status: moveTo })
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
      if (data.success) {
        const targetCol = document.getElementById('column-' + moveTo);
        if (targetCol) {
          targetCol.insertBefore(cardEl, targetCol.firstChild);
          updateCounts();
          const colLabel = targetCol.closest('.kanban-column')?.querySelector('.column-name')?.textContent || moveTo;
          showToast('→ ' + colLabel + ' 이동 완료', true);
        }
      } else {
        showToast('이동 실패: ' + (data.errors || []).join(', '), false);
        btn.disabled = false;
        btn.classList.remove('opacity-50');
      }
    })
    .catch(function() {
      showToast('네트워크 오류가 발생했습니다.', false);
      btn.disabled = false;
      btn.classList.remove('opacity-50');
    });
  });

  // ── 삭제 기능 ──────────────────────────────────────────────
  var deleteOrderId = null;

  window.closeDeleteModal = function() {
    document.getElementById('delete-confirm-modal').classList.add('hidden');
    deleteOrderId = null;
  };

  document.addEventListener('click', function(e) {
    var btn = e.target.closest('.quick-delete-btn');
    if (!btn) return;
    e.stopPropagation();

    deleteOrderId = btn.dataset.orderId;
    document.getElementById('delete-order-title').textContent = btn.dataset.orderTitle || '이 발주';
    document.getElementById('delete-confirm-modal').classList.remove('hidden');
  });

  document.getElementById('delete-confirm-btn').addEventListener('click', function() {
    if (!deleteOrderId) return;

    var confirmBtn = this;
    confirmBtn.disabled = true;
    confirmBtn.textContent = '삭제 중...';

    fetch('/orders/' + deleteOrderId, {
      method:  'DELETE',
      headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF, 'Accept': 'application/json' }
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
      if (data.success) {
        var cardEl = document.querySelector('[data-order-id="' + deleteOrderId + '"]');
        if (cardEl) {
          cardEl.style.transition = 'all 0.3s ease';
          cardEl.style.opacity = '0';
          cardEl.style.transform = 'scale(0.9)';
          setTimeout(function() {
            cardEl.remove();
            updateCounts();
          }, 300);
        }
        showToast('발주가 삭제되었습니다.', true);
      } else {
        showToast('삭제 실패', false);
      }
      closeDeleteModal();
      confirmBtn.disabled = false;
      confirmBtn.innerHTML = '<svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg> 삭제';
    })
    .catch(function() {
      showToast('네트워크 오류가 발생했습니다.', false);
      closeDeleteModal();
      confirmBtn.disabled = false;
      confirmBtn.innerHTML = '<svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg> 삭제';
    });
  });

  // 각 컬럼에 SortableJS 적용
  document.querySelectorAll('.kanban-cards').forEach(function(column) {
    new Sortable(column, {
      group:       'kanban',
      animation:   180,
      easing:      'cubic-bezier(0.25, 1, 0.5, 1)',
      handle:      '.drag-handle',   // 핸들 아이콘으로만 드래그
      ghostClass:  'kanban-ghost',
      dragClass:   'kanban-dragging',
      chosenClass: 'kanban-chosen',

      onStart: function(evt) {
        document.querySelectorAll('.kanban-cards').forEach(function(c) {
          if (c !== evt.from) highlightColumn(c, true);
        });
      },

      onEnd: function(evt) {
        // 모든 하이라이트 해제
        document.querySelectorAll('.kanban-cards').forEach(function(c) {
          highlightColumn(c, false);
        });

        const cardEl   = evt.item;
        const orderId  = cardEl.dataset.orderId;
        const newCol   = evt.to;
        const oldCol   = evt.from;
        const newStatus = newCol.dataset.status;
        const oldStatus = oldCol.dataset.status;

        // 같은 컬럼 내 재정렬 → 서버 호출 불필요
        if (newStatus === oldStatus) return;

        // 낙관적 UI: 카드 컬럼명 배지 즉시 업데이트
        const statusBadge = cardEl.querySelector('.card-status-badge');
        if (statusBadge) statusBadge.textContent = newCol.closest('.kanban-column').querySelector('.column-name')?.textContent || '';

        updateCounts();

        fetch('/orders/' + orderId + '/move', {
          method:  'PATCH',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF },
          body:    JSON.stringify({ status: newStatus })
        })
        .then(function(r) { return r.json(); })
        .then(function(data) {
          if (data.success) {
            const colLabel = newCol.closest('.kanban-column').querySelector('.column-name')?.textContent || newStatus;
            showToast('→ ' + colLabel + ' 이동 완료', true);
          } else {
            // 실패 시 원위치 복원
            if (evt.oldIndex < oldCol.children.length) {
              oldCol.insertBefore(cardEl, oldCol.children[evt.oldIndex]);
            } else {
              oldCol.appendChild(cardEl);
            }
            updateCounts();
            showToast('이동 실패: ' + (data.errors || []).join(', '), false);
          }
        })
        .catch(function() {
          oldCol.insertBefore(cardEl, oldCol.children[evt.oldIndex] || null);
          updateCounts();
          showToast('네트워크 오류가 발생했습니다.', false);
        });
      }
    });
  });
});
</script>

<style>
.kanban-ghost    { opacity: 0.35; border: 2px dashed #00A1E0 !important; background: #e0f2fe !important; border-radius: 0.5rem; }
.kanban-dragging { opacity: 0.95; transform: rotate(1.5deg) scale(1.03); box-shadow: 0 12px 32px rgba(0,0,0,0.18) !important; }
.kanban-chosen   { box-shadow: 0 0 0 2px #00A1E0; }
.drag-handle     { cursor: grab; touch-action: none; }
.drag-handle:active { cursor: grabbing; }
</style>
