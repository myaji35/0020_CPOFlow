<%# ── 병합 모드 JS ─────────────────────────────────────────── %>
<script>
function toggleMergeMode() {
  var board = document.getElementById('kanban-board');
  var mergeView = document.getElementById('merge-view');
  var filterBar = document.getElementById('kanban-filter-bar');
  var btn = document.getElementById('merge-mode-btn');
  var isShowing = mergeView.classList.contains('hidden');

  board.classList.toggle('hidden', isShowing);
  mergeView.classList.toggle('hidden', !isShowing);
  filterBar.classList.toggle('hidden', isShowing);
  btn.classList.toggle('ring-2', isShowing);
  btn.classList.toggle('ring-orange-400', isShowing);
}

// 그룹별 병합 실행 (메인 ID + 병합 대상 IDs 직접 전달)
function executeMergeGroup(mainId, mergeIds, btn) {
  if (!mainId || mergeIds.length === 0) return;
  if (!confirm(mergeIds.length + '개 카드를 #' + mainId + '에 병합합니다.\n병합된 카드는 서브 주문으로 변환되어 칸반에서 사라집니다.\n\n계속하시겠습니까?')) return;

  var csrf = document.querySelector('meta[name="csrf-token"]').content;
  btn.disabled = true;
  btn.textContent = '처리 중...';

  fetch('/kanban/merge', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrf },
    body: JSON.stringify({ main_order_id: mainId, merge_order_ids: mergeIds })
  })
  .then(function(r) { return r.json(); })
  .then(function(data) {
    if (data.success) {
      var groupEl = btn.closest('[data-merge-group]');
      if (groupEl) {
        groupEl.style.transition = 'all 0.4s ease';
        groupEl.style.opacity = '0';
        groupEl.style.transform = 'scale(0.98)';
        setTimeout(function() {
          groupEl.innerHTML = '<div class="px-5 py-4 text-center text-sm text-green-600 dark:text-green-400 font-medium">' +
            '<svg class="w-5 h-5 inline-block mr-1 -mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>' +
            data.merged_ids.length + '건을 #' + data.main_id + '에 병합 완료</div>';
          groupEl.style.opacity = '1';
          groupEl.style.transform = '';
        }, 400);
      }
      setTimeout(function() { window.location.reload(); }, 1500);
    } else {
      alert('병합 실패: ' + (data.error || '알 수 없는 오류'));
      btn.disabled = false;
      btn.textContent = '병합';
    }
  })
  .catch(function() {
    alert('네트워크 오류가 발생했습니다.');
    btn.disabled = false;
    btn.textContent = '병합';
  });
}

// ── 선택모드 JS ────────────────────────────────────────────
var selectMode = false;
window._selectMode = false;
var selectedIds = [];

function toggleSelectMode() {
  selectMode = !selectMode;
  window._selectMode = selectMode;
  var btn = document.getElementById('select-mode-btn');
  var actionBar = document.getElementById('select-action-bar');

  btn.classList.toggle('bg-primary', selectMode);
  btn.classList.toggle('text-white', selectMode);
  btn.classList.toggle('border-[#1E3A5F]', selectMode);
  btn.classList.toggle('bg-white', !selectMode);
  btn.classList.toggle('dark:bg-gray-700', !selectMode);
  btn.classList.toggle('text-gray-600', !selectMode);
  btn.classList.toggle('dark:text-gray-300', !selectMode);

  if (selectMode) {
    selectedIds = [];
    // 보이는 카드에만 체크박스 추가 (필터로 숨겨진 카드 제외)
    document.querySelectorAll('[data-order-id]').forEach(function(card) {
      if (card.classList.contains('hidden')) return;
      if (!card.querySelector('.select-cb-wrap')) {
        var wrap = document.createElement('div');
        wrap.className = 'select-cb-wrap absolute top-2 left-2 z-20';
        wrap.innerHTML = '<input type="checkbox" class="select-cb rounded border-gray-300 text-[#1E3A5F] focus:ring-[#1E3A5F] w-4 h-4 cursor-pointer shadow" data-order-id="' + card.dataset.orderId + '">';
        card.style.position = 'relative';
        card.appendChild(wrap);
        wrap.querySelector('input').addEventListener('change', onSelectChange);
      }
    });
    actionBar.classList.remove('hidden');
    updateSelectBar();
  } else {
    clearSelection();
    // 체크박스 제거
    document.querySelectorAll('.select-cb-wrap').forEach(function(w) { w.remove(); });
    actionBar.classList.add('hidden');
  }
}

function onSelectChange(e) {
  var id = parseInt(e.target.dataset.orderId);
  var card = document.querySelector('[data-order-id="' + id + '"]');
  if (e.target.checked) {
    if (!selectedIds.includes(id)) selectedIds.push(id);
    card.classList.add('ring-2', 'ring-[#1E3A5F]');
  } else {
    selectedIds = selectedIds.filter(function(x) { return x !== id; });
    card.classList.remove('ring-2', 'ring-[#1E3A5F]');
  }
  updateSelectBar();
}

function clearSelection() {
  selectedIds = [];
  document.querySelectorAll('.select-cb').forEach(function(cb) {
    cb.checked = false;
  });
  document.querySelectorAll('[data-order-id]').forEach(function(card) {
    card.classList.remove('ring-2', 'ring-[#1E3A5F]');
  });
  updateSelectBar();
}

function updateSelectBar() {
  document.getElementById('select-count').textContent = selectedIds.length + '개 선택';
  document.getElementById('action-merge-btn').disabled = selectedIds.length < 2;
  document.getElementById('action-move-btn').disabled = selectedIds.length < 1;
}

// 병합 모달
function openMergeModal() {
  if (selectedIds.length < 2) return;
  var list = document.getElementById('merge-modal-list');
  list.innerHTML = '';

  selectedIds.forEach(function(id, i) {
    var card = document.querySelector('[data-order-id="' + id + '"]');
    var title = card ? (card.dataset.title || '#' + id) : '#' + id;
    var customer = card ? (card.dataset.customer || '') : '';

    var row = document.createElement('label');
    row.className = 'flex items-center gap-3 p-3 border border-gray-200 dark:border-gray-700 rounded-lg cursor-pointer hover:bg-gray-50 dark:hover:bg-gray-750 transition-colors';
    row.innerHTML = '<input type="radio" name="merge_main" value="' + id + '" class="text-blue-600 focus:ring-blue-500"' + (i === 0 ? ' checked' : '') + '>'
      + '<div class="min-w-0 flex-1">'
      + '<span class="text-xs font-mono text-gray-500">#' + id + '</span>'
      + '<p class="text-sm font-medium text-gray-900 dark:text-white truncate">' + title + '</p>'
      + '<span class="text-xs text-gray-500">' + customer + '</span>'
      + '</div>'
      + (i === 0 ? '<span class="text-xs font-bold text-blue-600 bg-blue-50 dark:bg-blue-900/30 px-1.5 py-0.5 rounded">메인</span>' : '');
    list.appendChild(row);
  });

  // 라디오 변경 시 "메인" 라벨 이동
  list.querySelectorAll('input[name="merge_main"]').forEach(function(r) {
    r.addEventListener('change', function() {
      list.querySelectorAll('span.text-blue-600').forEach(function(s) { s.remove(); });
      if (r.checked) {
        var badge = document.createElement('span');
        badge.className = 'text-xs font-bold text-blue-600 bg-blue-50 dark:bg-blue-900/30 px-1.5 py-0.5 rounded';
        badge.textContent = '메인';
        r.closest('label').appendChild(badge);
      }
    });
  });

  document.getElementById('merge-modal').classList.remove('hidden');
}

function closeMergeModal() {
  document.getElementById('merge-modal').classList.add('hidden');
}

function executeFreeMerge() {
  var mainRadio = document.querySelector('#merge-modal-list input[name="merge_main"]:checked');
  if (!mainRadio) return;
  var mainId = parseInt(mainRadio.value);
  var mergeIds = selectedIds.filter(function(id) { return id !== mainId; });

  if (mergeIds.length === 0) return;
  closeMergeModal();

  var csrf = document.querySelector('meta[name="csrf-token"]').content;
  var confirmBtn = document.getElementById('merge-modal-confirm');
  confirmBtn.disabled = true;

  fetch('/kanban/merge', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrf },
    body: JSON.stringify({ main_order_id: mainId, merge_order_ids: mergeIds })
  })
  .then(function(r) { return r.json(); })
  .then(function(data) {
    if (data.success) {
      window.location.reload();
    } else {
      alert('병합 실패: ' + (data.error || '알 수 없는 오류'));
      confirmBtn.disabled = false;
    }
  })
  .catch(function() {
    alert('네트워크 오류가 발생했습니다.');
    confirmBtn.disabled = false;
  });
}

// 일괄이동 모달
function bulkMovePrompt() {
  if (selectedIds.length < 1) return;
  document.getElementById('move-modal').classList.remove('hidden');
}

function closeMoveModal() {
  document.getElementById('move-modal').classList.add('hidden');
}

function executeBulkMove(newStatus) {
  closeMoveModal();
  var csrf = document.querySelector('meta[name="csrf-token"]').content;
  var promises = selectedIds.map(function(id) {
    return fetch('/orders/' + id + '/move', {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrf },
      body: JSON.stringify({ status: newStatus })
    }).then(function(r) { return r.json(); });
  });
  Promise.all(promises).then(function() {
    window.location.reload();
  }).catch(function() {
    alert('일부 이동에 실패했습니다.');
    window.location.reload();
  });
}
</script>

<script>
function initKanban() {
  if (window._kanbanInitialized) return;
  window._kanbanInitialized = true;
  const CSRF = document.querySelector('meta[name="csrf-token"]').content;

  // 컬럼 카운트 배지 업데이트
  function updateCounts() {
    document.querySelectorAll('.kanban-column').forEach(function(col) {
      const count = col.querySelectorAll('[data-order-id]:not(.hidden)').length;
      const badge = col.querySelector('.column-count');
      if (badge) badge.textContent = count;

      // 빈 칼럼 empty-state 토글
      const cards  = col.querySelector('.kanban-cards');
      const empty  = col.querySelector('.empty-state');
      if (!cards || !empty) return;
      const hasCards = cards.querySelectorAll('[data-order-id]:not(.hidden)').length > 0;
      empty.style.display = hasCards ? 'none' : '';
    });
  }

  // 드래그 중 타겟 컬럼 하이라이트
  function highlightColumn(el, on) {
    if (!el) return;
    el.classList.toggle('ring-2', on);
    el.classList.toggle('ring-accent', on);
    el.classList.toggle('ring-inset', on);
    el.classList.toggle('bg-blue-50/60', on);
    el.classList.toggle('dark:bg-blue-900/20', on);
  }

  // 이동 성공 토스트
  function showToast(msg, ok) {
    const old = document.getElementById('kanban-toast');
    if (old) old.remove();
    const t = document.createElement('div');
    t.id = 'kanban-toast';
    t.className = 'fixed bottom-6 left-1/2 -translate-x-1/2 z-50 px-4 py-2.5 rounded-xl text-sm font-medium shadow-lg transition-all duration-300 flex items-center gap-2 '
      + (ok ? 'bg-green-500 text-white' : 'bg-red-500 text-white');
    t.innerHTML = (ok
      ? '<svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>'
      : '<svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>')
      + msg;
    document.body.appendChild(t);
    setTimeout(function() { t.style.opacity = '0'; setTimeout(function() { t.remove(); }, 300); }, 2500);
  }

  // ── FR-01: 필터 ──────────────────────────────────────────────
  const filterAssignee = document.getElementById('filter-assignee');
  const filterKeyword  = document.getElementById('filter-keyword');
  const filterReset    = document.getElementById('filter-reset');
  let   activePriority = '';
  let   activeDue      = '';

  function setActiveToggle(btnClass, activeVal) {
    document.querySelectorAll('.' + btnClass).forEach(function(btn) {
      const on = btn.dataset.value === activeVal;
      btn.classList.toggle('bg-accent',            on);
      btn.classList.toggle('text-white',           on);
      btn.classList.toggle('bg-white',            !on);
      btn.classList.toggle('dark:bg-gray-700',    !on);
      btn.classList.toggle('text-gray-600',       !on);
      btn.classList.toggle('dark:text-gray-300',  !on);
    });
  }

  function applyFilters() {
    const assigneeVal = filterAssignee.value;
    const keyword     = filterKeyword.value.toLowerCase().trim();
    const anyActive   = assigneeVal || activePriority || activeDue || keyword;

    document.querySelectorAll('[data-order-id]').forEach(function(card) {
      const assigneeIds = (card.dataset.assigneeIds || '').split(',').filter(Boolean);
      const assigneeOk  = !assigneeVal || assigneeIds.includes(assigneeVal);

      const priorityOk  = !activePriority || card.dataset.cardStatusKey === activePriority;

      const dueDays = parseInt(card.dataset.dueDays, 10);
      const dueOk   = !activeDue ? true
        : activeDue === 'overdue' ? dueDays < 0
        : activeDue === 'urgent'  ? (dueDays >= 0 && dueDays <= 7)
        : true;

      const text      = (card.dataset.title || '') + ' ' + (card.dataset.customer || '') + ' ' + (card.dataset.refno || '');
      const keywordOk = !keyword || text.toLowerCase().includes(keyword);

      card.classList.toggle('hidden', !(assigneeOk && priorityOk && dueOk && keywordOk));
    });

    filterReset.classList.toggle('hidden', !anyActive);
    updateCounts();
  }

  document.querySelectorAll('.filter-priority-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      activePriority = activePriority === btn.dataset.value ? '' : btn.dataset.value;
      setActiveToggle('filter-priority-btn', activePriority);
      applyFilters();
    });
  });

  document.querySelectorAll('.filter-due-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      activeDue = activeDue === btn.dataset.value ? '' : btn.dataset.value;
      setActiveToggle('filter-due-btn', activeDue);
      applyFilters();
    });
  });

  filterAssignee.addEventListener('change', applyFilters);
  filterKeyword.addEventListener('input', applyFilters);
  filterKeyword.addEventListener('keyup', applyFilters);
  filterKeyword.addEventListener('compositionend', applyFilters);

  filterReset.addEventListener('click', function() {
    filterAssignee.value = '';
    filterKeyword.value  = '';
    activePriority = '';
    activeDue      = '';
    setActiveToggle('filter-priority-btn', '');
    setActiveToggle('filter-due-btn', '');
    applyFilters();
  });

  setActiveToggle('filter-priority-btn', '');
  setActiveToggle('filter-due-btn', '');

  // ── FR-02: 퀵액션 ──────────────────────────────────────────
  document.addEventListener('click', function(e) {
    const btn = e.target.closest('.quick-move-btn');
    if (!btn) return;
    e.stopPropagation();

    const orderId = btn.dataset.orderId;
    const moveTo  = btn.dataset.moveTo;
    const cardEl  = document.querySelector('[data-order-id="' + orderId + '"]');
    if (!orderId || !moveTo || !cardEl) return;

    btn.disabled = true;
    btn.classList.add('opacity-50');

    fetch('/orders/' + orderId + '/move', {
      method:  'PATCH',
      headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF },
      body:    JSON.stringify({ status: moveTo })
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
      if (data.success) {
        const targetCol = document.getElementById('column-' + moveTo);
        if (targetCol) {
          targetCol.insertBefore(cardEl, targetCol.firstChild);
          updateCounts();
          const colLabel = targetCol.closest('.kanban-column')?.querySelector('.column-name')?.textContent || moveTo;
          showToast('→ ' + colLabel + ' 이동 완료', true);
        }
      } else {
        showToast('이동 실패: ' + (data.errors || []).join(', '), false);
        btn.disabled = false;
        btn.classList.remove('opacity-50');
      }
    })
    .catch(function() {
      showToast('네트워크 오류가 발생했습니다.', false);
      btn.disabled = false;
      btn.classList.remove('opacity-50');
    });
  });

  // ── 삭제 기능 ──────────────────────────────────────────────
  var deleteOrderId = null;

  window.closeDeleteModal = function() {
    document.getElementById('delete-confirm-modal').classList.add('hidden');
    deleteOrderId = null;
  };

  document.addEventListener('click', function(e) {
    var btn = e.target.closest('.quick-delete-btn');
    if (!btn) return;
    e.stopPropagation();

    deleteOrderId = btn.dataset.orderId;
    document.getElementById('delete-order-title').textContent = btn.dataset.orderTitle || '이 발주';
    document.getElementById('delete-confirm-modal').classList.remove('hidden');
  });

  document.getElementById('delete-confirm-btn').addEventListener('click', function() {
    if (!deleteOrderId) return;

    var confirmBtn = this;
    confirmBtn.disabled = true;
    confirmBtn.textContent = '삭제 중...';

    fetch('/orders/' + deleteOrderId, {
      method:  'DELETE',
      headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF, 'Accept': 'application/json' }
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
      if (data.success) {
        var cardEl = document.querySelector('[data-order-id="' + deleteOrderId + '"]');
        if (cardEl) {
          cardEl.style.transition = 'all 0.3s ease';
          cardEl.style.opacity = '0';
          cardEl.style.transform = 'scale(0.9)';
          setTimeout(function() {
            cardEl.remove();
            updateCounts();
          }, 300);
        }
        showToast('발주가 삭제되었습니다.', true);
      } else {
        showToast('삭제 실패', false);
      }
      closeDeleteModal();
      confirmBtn.disabled = false;
      confirmBtn.innerHTML = '<svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg> 삭제';
    })
    .catch(function() {
      showToast('네트워크 오류가 발생했습니다.', false);
      closeDeleteModal();
      confirmBtn.disabled = false;
      confirmBtn.innerHTML = '<svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg> 삭제';
    });
  });

  // 각 컬럼에 SortableJS 적용
  document.querySelectorAll('.kanban-cards').forEach(function(column) {
    new Sortable(column, {
      group:       'kanban',
      animation:   180,
      easing:      'cubic-bezier(0.25, 1, 0.5, 1)',
      handle:      '.drag-handle',   // 핸들 아이콘으로만 드래그
      ghostClass:  'kanban-ghost',
      dragClass:   'kanban-dragging',
      chosenClass: 'kanban-chosen',

      onStart: function(evt) {
        document.querySelectorAll('.kanban-cards').forEach(function(c) {
          if (c !== evt.from) highlightColumn(c, true);
        });
      },

      onEnd: function(evt) {
        // 모든 하이라이트 해제
        document.querySelectorAll('.kanban-cards').forEach(function(c) {
          highlightColumn(c, false);
        });

        const cardEl   = evt.item;
        const orderId  = cardEl.dataset.orderId;
        const newCol   = evt.to;
        const oldCol   = evt.from;
        const newStatus = newCol.dataset.status;
        const oldStatus = oldCol.dataset.status;

        // 같은 컬럼 내 재정렬 → 서버 호출 불필요
        if (newStatus === oldStatus) return;

        // 낙관적 UI: 카드 컬럼명 배지 즉시 업데이트
        const statusBadge = cardEl.querySelector('.card-status-badge');
        if (statusBadge) statusBadge.textContent = newCol.closest('.kanban-column').querySelector('.column-name')?.textContent || '';

        updateCounts();

        fetch('/orders/' + orderId + '/move', {
          method:  'PATCH',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF },
          body:    JSON.stringify({ status: newStatus })
        })
        .then(function(r) { return r.json(); })
        .then(function(data) {
          if (data.success) {
            const colLabel = newCol.closest('.kanban-column').querySelector('.column-name')?.textContent || newStatus;
            showToast('→ ' + colLabel + ' 이동 완료', true);
          } else {
            // 실패 시 원위치 복원
            if (evt.oldIndex < oldCol.children.length) {
              oldCol.insertBefore(cardEl, oldCol.children[evt.oldIndex]);
            } else {
              oldCol.appendChild(cardEl);
            }
            updateCounts();
            showToast('이동 실패: ' + (data.errors || []).join(', '), false);
          }
        })
        .catch(function() {
          oldCol.insertBefore(cardEl, oldCol.children[evt.oldIndex] || null);
          updateCounts();
          showToast('네트워크 오류가 발생했습니다.', false);
        });
      }
    });
  });
}
document.addEventListener('turbo:load', initKanban);
document.addEventListener('turbo:before-visit', function() { window._kanbanInitialized = false; });
</script>

