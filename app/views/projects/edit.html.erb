<% content_for :title, "#{t('projects.edit_title')} - #{@project.name}" %>
<div class="max-w-2xl">
  <div class="mb-6">
    <div class="flex items-center gap-2 text-sm text-gray-500 mb-1">
      <%= link_to t("projects.breadcrumb"), projects_path, class: "hover:text-primary" %>
      <span>/</span>
      <%= link_to @project.name, @project, class: "hover:text-primary" %>
      <span>/</span><span><%= t("projects.form_submit_update") %></span>
    </div>
    <h1 class="text-2xl font-bold text-gray-900 dark:text-white"><%= t("projects.edit_title") %></h1>
  </div>
  <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 shadow-sm p-6">
    <%= render "form" %>
  </div>
</div>
