<% content_for :title, t("employee_assignments.edit.title") %>
<div class="flex flex-col gap-4">
  <div class="flex items-center gap-2 text-sm text-gray-500">
    <%= link_to @employee.name, @employee, class: "hover:text-primary" %>
    <span>/</span><span><%= t("employee_assignments.edit.breadcrumb") %></span>
  </div>
  <h1 class="text-2xl font-bold text-gray-900 dark:text-white"><%= t("employee_assignments.edit.title") %></h1>
  <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 shadow-sm p-6">
    <%= render "form", assignment: @assignment %>
  </div>
</div>
