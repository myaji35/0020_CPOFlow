<%= form_with model: [@employee, assignment], class: "flex flex-col gap-4" do |f| %>
  <% if assignment.errors.any? %>
    <div class="bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 text-red-700 dark:text-red-400 px-4 py-3 rounded-lg text-sm">
      <% assignment.errors.full_messages.each do |msg| %><p><%= msg %></p><% end %>
    </div>
  <% end %>

  <div class="grid grid-cols-2 gap-4">
    <div class="col-span-2">
      <%= f.label :project_id, t("employee_assignments.form.project"), class: "block text-xs font-medium text-gray-600 dark:text-gray-500 mb-1" %>
      <%= f.select :project_id,
          @projects.map { |p| ["#{p.name} (#{p.site_category_label})", p.id] },
          { include_blank: t("employee_assignments.form.select_project") },
          class: "w-full border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-primary" %>
    </div>
    <div>
      <%= f.label :role, t("employee_assignments.form.role"), class: "block text-xs font-medium text-gray-600 dark:text-gray-500 mb-1" %>
      <%= f.text_field :role, class: "w-full border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-primary", placeholder: t("employee_assignments.form.role_placeholder") %>
    </div>
    <div>
      <%= f.label :status, t("employee_assignments.form.status"), class: "block text-xs font-medium text-gray-600 dark:text-gray-500 mb-1" %>
      <%= f.select :status, [[t("employee_assignments.status.active"), "active"], [t("employee_assignments.status.completed"), "completed"], [t("employee_assignments.status.cancelled"), "cancelled"]], {},
          class: "w-full border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-primary" %>
    </div>
    <div>
      <%= f.label :start_date, t("employee_assignments.form.start_date"), class: "block text-xs font-medium text-gray-600 dark:text-gray-500 mb-1" %>
      <%= f.date_field :start_date, required: true, class: "w-full border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-primary" %>
    </div>
    <div>
      <%= f.label :end_date, t("employee_assignments.form.end_date"), class: "block text-xs font-medium text-gray-600 dark:text-gray-500 mb-1" %>
      <%= f.date_field :end_date, class: "w-full border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-primary" %>
    </div>
    <div class="col-span-2">
      <%= f.label :notes, t("employee_assignments.form.notes"), class: "block text-xs font-medium text-gray-600 dark:text-gray-500 mb-1" %>
      <%= f.text_area :notes, rows: 2, class: "w-full border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-primary resize-none" %>
    </div>
  </div>

  <div class="flex justify-end gap-3">
    <%= link_to t("actions.cancel"), @employee, class: "px-4 py-2 border border-gray-200 dark:border-gray-600 text-gray-600 dark:text-gray-500 rounded-lg text-sm hover:bg-gray-50 dark:hover:bg-gray-700" %>
    <%= f.submit assignment.new_record? ? t("employee_assignments.form.submit_create") : t("actions.save"),
        class: "px-4 py-2 bg-primary text-white rounded-lg text-sm font-medium hover:bg-primary-dark cursor-pointer" %>
  </div>
<% end %>
