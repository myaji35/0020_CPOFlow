        </a>
      </div>
    </div>
  </div>

  <script>
    function verifyApiKey() {
      var btn = document.getElementById('verify-btn');
      var statusDiv = document.getElementById('api-key-status');
      var statusContent = document.getElementById('api-key-status-content');
      btn.disabled = true;
      btn.textContent = '<%= t("settings.ai_api_verifying") %>';
      statusDiv.classList.add('hidden');

      fetch('<%= settings_verify_api_key_path %>', {
        method: 'POST',
        headers: { 'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content, 'Accept': 'application/json' }
      })
      .then(function(r) { return r.json(); })
      .then(function(data) {
        statusDiv.classList.remove('hidden');
        if (data.status === 'ok') {
          statusContent.className = 'flex items-center gap-2 px-3 py-2 rounded-lg text-xs bg-green-50 dark:bg-green-900/20 text-green-700 dark:text-green-400 border border-green-200 dark:border-green-800';
          statusContent.innerHTML = '<svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>' + data.message;
        } else {
          statusContent.className = 'flex items-center gap-2 px-3 py-2 rounded-lg text-xs bg-red-50 dark:bg-red-900/20 text-red-700 dark:text-red-400 border border-red-200 dark:border-red-800';
          statusContent.innerHTML = '<svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>' + data.message;
        }
      })
      .catch(function() {
        statusDiv.classList.remove('hidden');
        statusContent.className = 'flex items-center gap-2 px-3 py-2 rounded-lg text-xs bg-red-600 text-white border border-red-200';
        statusContent.textContent = '<%= t("kanban.js_network_error") %>';
      })
      .finally(function() {
        btn.disabled = false;
        btn.textContent = '<%= t("settings.ai_api_verify_btn") %>';
      });
    }
  </script>

