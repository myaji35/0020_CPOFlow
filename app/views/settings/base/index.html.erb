    </div>

    <div class="px-6 py-5">
      <%# Anthropic API Key %>
      <div class="mb-5">
        <div class="flex items-center justify-between mb-3">
          <div>
            <p class="text-sm font-medium text-gray-900 dark:text-gray-100">Anthropic API Key</p>
            <p class="text-xs text-gray-500 dark:text-gray-500">Claude Haiku — RFQ 이메일 판정, 답변 초안 생성</p>
          </div>
          <button type="button" onclick="verifyApiKey()" id="verify-btn"
