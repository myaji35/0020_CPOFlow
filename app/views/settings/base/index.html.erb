<%# Settings — main page with Gmail connection management %>
<div class="max-w-4xl mx-auto py-8 px-4">

  <%# ISS-240: 신규 사용자 Gmail 연결 안내 (onboarded? false일 때만) %>
  <% unless current_user.onboarded? %>
    <div class="mb-6 rounded-xl border p-4 flex items-start gap-3" style="border-color:rgba(22,108,114,0.3); background:rgba(22,108,114,0.06);">
      <div class="w-8 h-8 rounded-lg flex items-center justify-center shrink-0" style="background:#166c72;">
        <svg class="w-4 h-4 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
        </svg>
      </div>
      <div class="flex-1 min-w-0">
        <p class="text-sm font-semibold text-gray-900 dark:text-white mb-0.5"><%= t("settings.gmail_onboarding_title") %></p>
        <p class="text-xs text-gray-600 dark:text-gray-400"><%= t("settings.gmail_onboarding_desc").html_safe %></p>
      </div>
    </div>
  <% end %>

  <%# Page header %>
  <div class="mb-8">
    <h1 class="text-[22px] font-semibold tracking-tight text-ink-900 dark:text-white">Settings</h1>
    <p class="text-[12px] text-ink-500 mt-1">Manage your account preferences and integrations</p>
  </div>

  <%# Flash messages %>
  <% if notice %>
    <div class="mb-4 rounded-lg bg-green-50 border border-green-200 px-4 py-3 text-green-800 text-sm flex items-center gap-2">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
      <%= notice %>
    </div>
  <% end %>
  <% if alert %>
    <div class="mb-4 rounded-lg bg-red-50 border border-red-200 px-4 py-3 text-red-800 text-sm flex items-center gap-2">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
      <%= alert %>
    </div>
  <% end %>

  <%# --- Gmail Integration Section --- %>
  <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 mb-6">
    <div class="px-6 py-4 border-b border-gray-200 dark:border-gray-700 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <%# Gmail G icon (inline SVG) %>
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M20 18H17V9.24L12 13L7 9.24V18H4V6H6.2L12 10.76L17.8 6H20V18Z" fill="#EA4335"/>
        </svg>
        <div>
          <h2 class="text-base font-semibold text-gray-900">Gmail Integration</h2>
          <p class="text-xs text-gray-500">Auto-detect RFQ emails and convert to Kanban cards</p>
        </div>
        <span class="ml-2 inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium <%= @gmail_connected_count > 0 ? 'bg-green-600 text-white' : 'bg-gray-200 text-gray-600' %>">
          <%= @gmail_connected_count > 0 ? t("settings.gmail_connected_count", count: @gmail_connected_count) : t("settings.gmail_not_connected") %>
        </span>
      </div>
      <%= link_to gmail_oauth_authorize_path, data: { turbo: false }, class: "flex items-center gap-2 px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-lg transition-colors" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Connect Gmail
      <% end %>
    </div>

    <% if @email_accounts.any? %>
      <ul class="divide-y divide-gray-100">
        <% @email_accounts.each do |account| %>
          <li class="px-6 py-4 flex items-center justify-between">
            <div class="flex items-center gap-3">
              <%# Status dot — 연결됐어도 토큰 만료면 노란색 경고 %>
              <% token_ok = account.connected? && !account.token_expired? %>
              <% needs_reauth = account.connected? && account.token_expired? && !account.needs_refresh? %>
              <span class="w-2 h-2 rounded-full <%= token_ok ? 'bg-green-500' : (account.connected? ? 'bg-yellow-400' : 'bg-gray-300') %>"></span>
              <div>
                <p class="text-sm font-medium text-gray-900"><%= account.email %></p>
                <p class="text-xs text-gray-500">
                  <% if account.connected? %>
                    <% if needs_reauth %>
                      <span class="text-red-500 font-medium"><%= t("settings.gmail_reauth_needed") %></span>
                    <% elsif account.token_expired? %>
                      <span class="text-yellow-600 font-medium"><%= t("settings.gmail_token_refreshing") %></span>
                    <% elsif account.last_synced_at %>
                      Last synced <%= time_ago_in_words(account.last_synced_at) %> ago
                    <% else %>
                      Connected — not synced yet
                    <% end %>
                    &nbsp;·&nbsp;
                    <span class="<%= token_ok ? 'text-green-600' : 'text-yellow-600' %> font-medium"><%= token_ok ? 'Active' : 'Warning' %></span>
                  <% else %>
                    Disconnected
                  <% end %>
                </p>
              </div>
            </div>
            <div class="flex items-center gap-2">
              <% if account.connected? %>
                <%# Manual sync trigger %>
                <%= button_to "Sync Now", sync_settings_email_account_path(account), method: :post, class: "text-xs px-3 py-1.5 border border-gray-200 rounded-lg hover:bg-gray-50 text-gray-600 transition-colors", disabled: account.synced_recently? %>
              <% end %>
              <%# Disconnect %>
              <%= link_to "Disconnect", gmail_oauth_disconnect_path(account), data: { turbo_method: :delete, turbo_confirm: "Disconnect #{account.email}?" }, class: "text-xs px-3 py-1.5 border border-red-200 text-red-600 rounded-lg hover:bg-red-50 transition-colors" %>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <div class="px-6 py-8 text-center">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 mx-auto text-gray-300 mb-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
        <p class="text-sm text-gray-500">No Gmail accounts connected.</p>
        <p class="text-xs text-gray-500 mt-1">Connect your Gmail to auto-import RFQ emails.</p>
      </div>
    <% end %>
  </div>

  <%# --- Google Chat 알림 Section --- %>
  <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 mb-6">
    <div class="px-6 py-4 border-b border-gray-200 dark:border-gray-700 flex items-center gap-3">
      <svg class="w-5 h-5 text-green-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
      <div>
        <h2 class="text-base font-semibold text-gray-900 dark:text-gray-100"><%= t("settings.gchat_title") %></h2>
        <p class="text-xs text-gray-500 dark:text-gray-500"><%= t("settings.gchat_subtitle") %></p>
      </div>
      <% webhook_set = AppSetting.google_chat_webhook_url.present? %>
      <span class="ml-auto text-xs px-2 py-0.5 rounded-full font-medium <%= webhook_set ? 'bg-green-600 text-white dark:bg-green-900/30 dark:text-green-400' : 'bg-gray-500 text-white dark:bg-gray-700 dark:text-gray-500' %>">
        <%= webhook_set ? t("settings.status_connected") : t("settings.status_not_set") %>
      </span>
    </div>

    <div class="px-6 py-5">
      <%= form_with url: settings_notifications_path, method: :patch, class: "space-y-4" do |f| %>
        <div>
          <label class="block text-xs font-medium text-gray-600 dark:text-gray-500 mb-1">
            Google Chat Incoming Webhook URL
          </label>
          <div class="flex gap-2">
            <%= f.text_field :google_chat_webhook_url,
                value: AppSetting.google_chat_webhook_url.to_s,
                placeholder: "https://chat.googleapis.com/v1/spaces/.../messages?key=...&token=...",
                class: "flex-1 border border-gray-200 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-100 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 font-mono" %>
            <%= f.submit t("common.save"),
                class: "px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-lg transition-colors cursor-pointer whitespace-nowrap" %>
          </div>
          <p class="text-xs text-gray-500 dark:text-gray-500 mt-1">
            <%= t("settings.gchat_webhook_hint") %>
          </p>
        </div>
      <% end %>

      <% if AppSetting.google_chat_webhook_url.present? %>
        <div class="flex items-center justify-between pt-3 border-t border-gray-200 dark:border-gray-700">
          <div>
            <p class="text-sm font-medium text-gray-700 dark:text-gray-300"><%= t("settings.gchat_test_title") %></p>
            <p class="text-xs text-gray-500 dark:text-gray-500"><%= t("settings.gchat_test_desc") %></p>
          </div>
          <%= button_to settings_test_notifications_path, method: :post,
              class: "flex items-center gap-2 px-4 py-2 border border-gray-200 dark:border-gray-600 text-gray-700 dark:text-gray-300 text-sm rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors" do %>
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
            <span><%= t("settings.gchat_test_btn") %></span>
          <% end %>
        </div>

        <div class="mt-3 rounded-lg bg-blue-50 dark:bg-blue-900/20 border border-blue-100 dark:border-blue-800 px-4 py-3">
          <p class="text-xs font-semibold text-blue-700 dark:text-blue-300 mb-1"><%= t("settings.gchat_schedule_title") %></p>
          <ul class="text-xs text-blue-600 dark:text-blue-400 space-y-0.5">
            <li><%= t("settings.gchat_schedule_d14") %></li>
            <li><%= t("settings.gchat_schedule_d7") %></li>
            <li><%= t("settings.gchat_schedule_d3") %></li>
            <li><%= t("settings.gchat_schedule_d0") %></li>
          </ul>
        </div>
      <% end %>
    </div>
  </div>

  <%# --- ISS-230: 개인별 알림 채널 설정 --- %>
  <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 mb-6">
    <div class="px-6 py-4 border-b border-gray-200 dark:border-gray-700 flex items-center justify-between">
      <div>
        <h2 class="text-base font-semibold text-gray-900 dark:text-gray-100"><%= t("settings.notification_pref_title") %></h2>
        <p class="text-xs text-gray-500 dark:text-gray-500"><%= t("settings.notification_pref_subtitle") %></p>
      </div>
    </div>
    <%= form_with url: settings_update_notification_preferences_path, method: :patch, class: "px-6 py-4" do %>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-gray-200 dark:border-gray-700">
              <th class="text-left py-2 text-xs font-semibold text-gray-600 dark:text-gray-400"><%= t("settings.notification_type_col") %></th>
              <% User::NOTIFICATION_CHANNELS.each do |key, label| %>
                <th class="text-center py-2 text-xs font-semibold text-gray-600 dark:text-gray-400 min-w-[90px]"><%= label %></th>
              <% end %>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 dark:divide-gray-700">
            <% User::NOTIFICATION_TYPES.each do |type_key, meta| %>
              <tr>
                <td class="py-2.5 text-sm text-gray-900 dark:text-white font-medium"><%= meta[:label] %></td>
                <% User::NOTIFICATION_CHANNELS.each do |ch_key, _ch_label| %>
                  <td class="py-2.5 text-center">
                    <label class="inline-flex items-center justify-center cursor-pointer">
                      <input type="hidden" name="preferences[<%= type_key %>][<%= ch_key %>]" value="false" />
                      <input type="checkbox"
                             name="preferences[<%= type_key %>][<%= ch_key %>]"
                             value="true"
                             <%= 'checked' if current_user.notify_on?(type_key, ch_key) %>
                             class="w-4 h-4 rounded border-gray-300 text-[#00A1E0] focus:ring-[#00A1E0]" />
                    </label>
                  </td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <div class="mt-4 flex items-center justify-between">
        <p class="text-[11px] text-gray-500 dark:text-gray-500">
          <%= t("settings.notification_pref_hint") %>
        </p>
        <%= submit_tag t("settings.notification_save_btn"), class: "text-sm font-medium bg-[#00A1E0] hover:bg-[#0090c8] text-white px-4 py-2 rounded-lg transition-colors cursor-pointer" %>
      </div>
    <% end %>
  </div>

  <%# --- Profile Section --- %>
  <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 mb-6">
    <div class="px-6 py-4 border-b border-gray-200 dark:border-gray-700 flex items-center justify-between">
      <h2 class="text-base font-semibold text-gray-900 dark:text-gray-100">Profile</h2>
      <span class="text-xs text-gray-500 dark:text-gray-400"><%= current_user.name %> &middot; <%= current_user.role.humanize %></span>
    </div>
    <%= form_with url: settings_profile_path, method: :patch, class: "px-6 py-4 space-y-4" do |f| %>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-medium text-gray-600 dark:text-gray-500 mb-1">Name</label>
          <%= f.text_field :name, value: current_user.name, class: "w-full border border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-100 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
        </div>
        <div>
          <label class="block text-xs font-medium text-gray-600 dark:text-gray-500 mb-1">Email</label>
          <input type="text" value="<%= current_user.email %>" disabled class="w-full border border-gray-300 dark:border-gray-700 rounded-lg px-3 py-2.5 text-sm bg-gray-50 dark:bg-gray-900 text-gray-500 cursor-not-allowed" />
        </div>
      </div>
      <div>
        <label class="block text-xs font-medium text-gray-600 dark:text-gray-500 mb-1">Branch</label>
        <input type="text" value="<%= current_user.branch.to_s.humanize %>" disabled class="w-full border border-gray-300 dark:border-gray-700 rounded-lg px-3 py-2.5 text-sm bg-gray-50 dark:bg-gray-900 text-gray-500 cursor-not-allowed" />
      </div>
      <div class="flex justify-end">
        <%= f.submit "Save Changes", class: "px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-lg transition-colors cursor-pointer" %>
      </div>
    <% end %>
  </div>

  <%# --- Language & Theme Section --- %>
  <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 mb-6">
    <div class="px-6 py-4 border-b border-gray-200 dark:border-gray-700 flex items-center gap-3">
      <svg class="w-5 h-5 text-gray-500 dark:text-gray-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
      <div>
        <h2 class="text-base font-semibold text-gray-900 dark:text-gray-100"><%= t("settings.preferences_title") %></h2>
        <p class="text-xs text-gray-500 dark:text-gray-500"><%= t("settings.preferences_subtitle") %></p>
      </div>
    </div>

    <%# 언어 설정 %>
    <div class="px-6 py-5 border-b border-gray-200 dark:border-gray-700">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm font-medium text-gray-900 dark:text-gray-100"><%= t("settings.language_label") %></p>
          <p class="text-xs text-gray-500 dark:text-gray-500 mt-0.5"><%= t("settings.language_hint") %></p>
        </div>
        <div class="flex gap-2">
          <% [["한국어", "ko"], ["English", "en"], ["العربية", "ar"]].each do |label, code| %>
            <%= button_to settings_update_locale_path, method: :patch,
                params: { locale: code },
                class: "px-4 py-2 text-sm font-medium rounded-lg border transition-colors #{current_user.preferred_locale == code ? 'bg-primary text-white border-primary' : 'border-gray-200 dark:border-gray-600 text-gray-700 dark:text-gray-300 hover:border-primary hover:text-primary dark:hover:border-accent dark:hover:text-accent'}" do %>
              <%= label %>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>

    <%# 다크모드 설정 %>
    <div class="px-6 py-5">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm font-medium text-gray-900 dark:text-gray-100"><%= t("settings.theme_label") %></p>
          <p class="text-xs text-gray-500 dark:text-gray-500 mt-0.5"><%= t("settings.theme_hint") %></p>
        </div>
        <div class="flex gap-2">
          <% [
            [t("settings.theme_light"), "light", "☀️"],
            [t("settings.theme_dark"), "dark", "🌙"],
            [t("settings.theme_system"), "system", "💻"]
          ].each do |label, code, icon| %>
            <%= button_to settings_update_theme_path, method: :patch,
                params: { theme: code },
                class: "flex items-center gap-1.5 px-4 py-2 text-sm font-medium rounded-lg border transition-colors #{current_user.preferred_theme == code ? 'bg-primary text-white border-primary' : 'border-gray-200 dark:border-gray-600 text-gray-700 dark:text-gray-300 hover:border-primary hover:text-primary dark:hover:border-accent dark:hover:text-accent'}" do %>
              <span><%= icon %></span>
              <span><%= label %></span>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <%# --- Admin Only Section --- %>
  <% if current_user.admin? %>

  <%# Google Sheets 연동 설정 (Admin Only) %>
  <% sheets_url = AppConfig.sheets_spreadsheet_url %>
  <% sheets_id  = AppConfig.sheets_spreadsheet_id %>
  <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 mb-6">
    <div class="px-6 py-4 border-b border-gray-200 dark:border-gray-700 flex items-center gap-3">
      <%# Google Sheets 아이콘 %>
      <svg class="w-5 h-5 text-green-600 dark:text-green-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <rect x="3" y="3" width="18" height="18" rx="2"/>
        <path d="M3 9h18M3 15h18M9 3v18"/>
      </svg>
      <div>
        <h2 class="text-base font-semibold text-gray-900 dark:text-gray-100"><%= t("settings.sheets_title") %> <span class="text-xs font-normal text-gray-500 dark:text-gray-500 ml-1">Admin only</span></h2>
        <p class="text-xs text-gray-500 dark:text-gray-500"><%= t("settings.sheets_subtitle") %></p>
      </div>
    </div>

    <div class="px-6 py-5">
      <%# 현재 연동 상태 %>
      <% if sheets_id.present? %>
        <div class="flex items-center gap-2 mb-4 px-3 py-2 bg-green-50 dark:bg-green-900/20 rounded-lg">
          <svg class="w-4 h-4 text-green-600 dark:text-green-400 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          <div class="flex-1 min-w-0">
            <p class="text-xs font-medium text-green-800 dark:text-green-300"><%= t("settings.sheets_linked") %></p>
            <p class="text-xs text-green-600 dark:text-green-400 font-mono truncate">ID: <%= sheets_id %></p>
          </div>
          <% if sheets_url.present? %>
            <a href="<%= sheets_url %>" target="_blank" rel="noopener"
               class="flex items-center gap-1 text-xs text-green-700 dark:text-green-400 hover:underline flex-shrink-0">
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
              <%= t("settings.sheets_open_btn") %>
            </a>
          <% end %>
        </div>
      <% else %>
        <div class="flex items-center gap-2 mb-4 px-3 py-2 bg-gray-50 dark:bg-gray-700/50 rounded-lg">
          <svg class="w-4 h-4 text-gray-500 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          <p class="text-xs text-gray-500 dark:text-gray-500"><%= t("settings.sheets_not_linked") %></p>
        </div>
      <% end %>

      <%# URL 입력 폼 %>
      <%= form_with url: admin_sheets_config_path, method: :patch, class: "space-y-3" do |f| %>
        <div>
          <label class="block text-xs font-medium text-gray-600 dark:text-gray-500 mb-1">
            Google Sheets URL
          </label>
          <div class="flex gap-2">
            <input type="url" name="spreadsheet_url"
                   value="<%= sheets_url %>"
                   placeholder="https://docs.google.com/spreadsheets/d/..."
