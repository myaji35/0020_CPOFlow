        <%= form_with url: settings_api_keys_path, method: :patch, class: "flex gap-2" do |f| %>
          <div class="flex-1">
            <%= f.text_field :anthropic_api_key,
                value: current_key.present? ? "sk-ant-...#{current_key[-8..]}" : "",
                placeholder: has_credential_key ? t("settings.ai_api_credential_placeholder") : "sk-ant-api03-...",
                class: "w-full px-3 py-2.5 border border-gray-300 dark:border-gray-600 rounded-lg text-sm text-gray-900 dark:text-gray-100 dark:bg-gray-700 placeholder-gray-400 focus:outline-none focus:border-[#00A1E0] focus:ring-1 focus:ring-[#00A1E0]",
                autocomplete: "off" %>
          </div>
          <%= f.submit t("common.save"), class: "px-4 py-2.5 bg-primary hover:bg-primary-dark text-white text-sm font-medium rounded-lg transition-colors cursor-pointer" %>
