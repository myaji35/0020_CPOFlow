<% content_for :title, "블럭(칼럼) 관리" %>

<div class="max-w-4xl mx-auto p-6">
  <%# 상위 네비게이션 %>
  <nav class="flex items-center gap-2 text-sm mb-4">
    <%= link_to "설정", settings_root_path, class: "text-[#00A1E0] hover:underline" %>
    <span class="text-gray-400">›</span>
    <%= link_to "칸반 보드 관리", settings_kanban_boards_path, class: "text-[#00A1E0] hover:underline" %>
    <span class="text-gray-400">›</span>
    <span class="text-gray-600 font-medium"><%= @current_board&.name %> 블럭 관리</span>
  </nav>

  <%# Header %>
  <div class="flex items-center justify-between mb-2">
    <div>
      <h1 class="text-xl font-bold text-gray-900 dark:text-white">블럭(칼럼) 관리</h1>
      <p class="text-sm text-gray-500 mt-1">보드별 칸반 칼럼을 추가·편집·순서 변경·삭제합니다.</p>
    </div>
    <button type="button" onclick="document.getElementById('newColumnModal').classList.remove('hidden')"
            class="px-3 py-2 bg-[#00A1E0] text-white rounded-lg text-sm font-medium hover:bg-[#0083b7] shrink-0">
      + 새 블럭 추가
    </button>
  </div>

  <%# Board selector %>
  <div class="flex items-center gap-3 mb-4">
    <label class="text-xs font-semibold text-gray-600 mb-1.5">보드:</label>
    <select onchange="window.location.href='<%= settings_kanban_columns_path %>?board_id=' + this.value"
            class="px-3 py-2.5 border border-gray-300 rounded-lg text-sm bg-white text-gray-900 focus:outline-none focus:border-[#00A1E0] focus:ring-1 focus:ring-[#00A1E0]">
      <% KanbanBoard.ordered.each do |board| %>
        <option value="<%= board.id %>" <%= "selected" if board.id == @current_board.id %>><%= board.name %></option>
      <% end %>
    </select>
  </div>

  <%# Flash %>
  <% flash.each do |type, msg| %>
    <div class="mb-3 px-3 py-2 rounded text-sm <%= type == 'notice' ? 'bg-green-50 text-green-800 border border-green-200' : 'bg-red-50 text-red-800 border border-red-200' %>"><%= msg %></div>
  <% end %>

  <%# Errors %>
  <% if @kanban_column&.errors&.any? %>
    <div class="mb-3 px-3 py-2 rounded bg-red-50 border border-red-200 text-red-800 text-sm">
      <% @kanban_column.errors.full_messages.each do |m| %>
        <p><%= m %></p>
      <% end %>
    </div>
  <% end %>

  <%# Column table %>
  <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 overflow-hidden">
    <% if @kanban_columns.any? %>
      <table class="w-full text-sm">
        <thead>
          <tr class="bg-gray-50 dark:bg-gray-700 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase">
            <th class="px-4 py-3 w-10"></th>
            <th class="px-4 py-3">색상</th>
            <th class="px-4 py-3">이름</th>
            <th class="px-4 py-3">Key</th>
            <th class="px-4 py-3 text-center">WIP 제한</th>
            <th class="px-4 py-3 text-center">완료단계</th>
            <th class="px-4 py-3 text-right">작업</th>
          </tr>
        </thead>
        <tbody id="columnSortable" class="divide-y divide-gray-100 dark:divide-gray-700">
          <% @kanban_columns.each do |col| %>
            <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50" data-id="<%= col.id %>">
              <%# Drag handle %>
              <td class="px-4 py-3 cursor-grab text-gray-400">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="5" r="1"/><circle cx="9" cy="12" r="1"/><circle cx="9" cy="19" r="1"/><circle cx="15" cy="5" r="1"/><circle cx="15" cy="12" r="1"/><circle cx="15" cy="19" r="1"/></svg>
              </td>
              <%# Color chip %>
              <td class="px-4 py-3">
                <span class="inline-block w-6 h-6 rounded border border-gray-200" style="background:<%= col.color %>;"></span>
              </td>
              <%# Name %>
              <td class="px-4 py-3 font-medium text-gray-900 dark:text-white"><%= col.name %></td>
              <%# Key %>
              <td class="px-4 py-3 text-gray-500 font-mono text-xs"><%= col.key %></td>
              <%# WIP limit %>
              <td class="px-4 py-3 text-center text-gray-500"><%= col.wip_limit || "-" %></td>
              <%# Is final %>
              <td class="px-4 py-3 text-center">
                <% if col.is_final %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium" style="background:#10B981; color:white;">Yes</span>
                <% else %>
                  <span class="text-gray-400 text-xs">-</span>
                <% end %>
              </td>
              <%# Actions %>
              <td class="px-4 py-3 text-right">
                <div class="flex items-center justify-end gap-2">
                  <button type="button" onclick="openEditModal(<%= col.id %>, '<%= j(col.name) %>', '<%= col.color %>', '<%= col.wip_limit %>', <%= col.is_final %>)"
                          class="text-[#00A1E0] hover:text-[#0083b7] text-xs font-medium">편집</button>
                  <%= button_to settings_kanban_column_path(col, board_id: @current_board.id),
                      method: :delete,
                      data: { turbo_confirm: "블럭 '#{col.name}'을(를) 삭제합니다." },
                      class: "text-red-500 hover:text-red-700 text-xs font-medium" do %>
                    삭제
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div class="px-6 py-10 text-center text-gray-400 text-sm">
        이 보드에 블럭이 없습니다. "새 블럭 추가" 버튼을 클릭하세요.
      </div>
    <% end %>
  </div>

  <%# Back link %>
  <div class="mt-4">
    <%= link_to "← 보드 관리로 돌아가기", settings_kanban_boards_path, class: "text-sm text-[#00A1E0] hover:underline" %>
  </div>
</div>

<%# ========== New Column Modal ========== %>
<div id="newColumnModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/40">
  <div class="bg-white dark:bg-gray-800 rounded-xl shadow-xl w-full max-w-md mx-4 p-6">
    <h2 class="text-lg font-bold text-gray-900 dark:text-white mb-4">새 블럭 추가</h2>
    <%= form_with model: @kanban_column, url: settings_kanban_columns_path(board_id: @current_board.id), method: :post, local: true do |f| %>
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-semibold text-gray-600 mb-1.5">이름 <span class="text-red-500">*</span></label>
          <%= f.text_field :name, class: "w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:border-[#00A1E0] focus:ring-1 focus:ring-[#00A1E0]", placeholder: "예: 검토 중" %>
        </div>
        <div>
          <label class="block text-xs font-semibold text-gray-600 mb-1.5">Key (비우면 자동 생성)</label>
          <%= f.text_field :key, class: "w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:border-[#00A1E0] focus:ring-1 focus:ring-[#00A1E0] font-mono", placeholder: "예: review" %>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold text-gray-600 mb-1.5">색상</label>
            <%= f.color_field :color, value: "#E5E7EB", class: "w-full h-10 rounded-lg border border-gray-300 cursor-pointer" %>
          </div>
          <div>
            <label class="block text-xs font-semibold text-gray-600 mb-1.5">WIP 제한</label>
            <%= f.number_field :wip_limit, min: 1, class: "w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:border-[#00A1E0] focus:ring-1 focus:ring-[#00A1E0]", placeholder: "무제한" %>
          </div>
        </div>
        <div class="flex items-center gap-2">
          <%= f.check_box :is_final, class: "rounded border-gray-300 text-[#00A1E0] focus:ring-[#00A1E0]" %>
          <label class="text-sm text-gray-700 dark:text-gray-300">완료 단계 (Done/Give Up 등)</label>
        </div>
      </div>
      <div class="flex justify-end gap-3 mt-6">
        <button type="button" onclick="document.getElementById('newColumnModal').classList.add('hidden')"
                class="px-4 py-2 text-sm text-gray-600 hover:text-gray-800">취소</button>
        <%= f.submit "추가", class: "px-4 py-2 bg-[#00A1E0] text-white rounded-lg text-sm font-medium hover:bg-[#0083b7] cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>

<%# ========== Edit Column Modal ========== %>
<div id="editColumnModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/40">
  <div class="bg-white dark:bg-gray-800 rounded-xl shadow-xl w-full max-w-md mx-4 p-6">
    <h2 class="text-lg font-bold text-gray-900 dark:text-white mb-4">블럭 수정</h2>
    <form id="editColumnForm" method="post">
      <input type="hidden" name="_method" value="patch">
      <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-semibold text-gray-600 mb-1.5">이름</label>
          <input type="text" name="kanban_column[name]" id="editColName"
                 class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm text-gray-900 focus:outline-none focus:border-[#00A1E0] focus:ring-1 focus:ring-[#00A1E0]">
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold text-gray-600 mb-1.5">색상</label>
            <input type="color" name="kanban_column[color]" id="editColColor"
                   class="w-full h-10 rounded-lg border border-gray-300 cursor-pointer">
          </div>
          <div>
            <label class="block text-xs font-semibold text-gray-600 mb-1.5">WIP 제한</label>
            <input type="number" name="kanban_column[wip_limit]" id="editColWip" min="1"
                   class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm text-gray-900 focus:outline-none focus:border-[#00A1E0] focus:ring-1 focus:ring-[#00A1E0]"
                   placeholder="무제한">
          </div>
        </div>
        <div class="flex items-center gap-2">
          <input type="hidden" name="kanban_column[is_final]" value="0">
          <input type="checkbox" name="kanban_column[is_final]" id="editColFinal" value="1"
                 class="rounded border-gray-300 text-[#00A1E0] focus:ring-[#00A1E0]">
          <label class="text-sm text-gray-700 dark:text-gray-300">완료 단계</label>
        </div>
      </div>
      <div class="flex justify-end gap-3 mt-6">
        <button type="button" onclick="document.getElementById('editColumnModal').classList.add('hidden')"
                class="px-4 py-2 text-sm text-gray-600 hover:text-gray-800">취소</button>
        <button type="submit" class="px-4 py-2 bg-[#00A1E0] text-white rounded-lg text-sm font-medium hover:bg-[#0083b7] cursor-pointer">저장</button>
      </div>
    </form>
  </div>
</div>

<script>
document.addEventListener("turbo:load", function() {
  // Edit modal opener
  window.openEditModal = function(id, name, color, wip, isFinal) {
    var boardId = "<%= @current_board.id %>";
    document.getElementById("editColumnForm").action = "/settings/kanban_columns/" + id + "?board_id=" + boardId;
    document.getElementById("editColName").value = name;
    document.getElementById("editColColor").value = color;
    document.getElementById("editColWip").value = (wip === "null" || wip === "") ? "" : wip;
    document.getElementById("editColFinal").checked = isFinal;
    document.getElementById("editColumnModal").classList.remove("hidden");
  };

  // Simple drag-and-drop reorder (using native HTML5 drag)
  var sortable = document.getElementById("columnSortable");
  if (!sortable) return;

  var dragEl = null;
  sortable.querySelectorAll("tr").forEach(function(row) {
    row.draggable = true;
    row.addEventListener("dragstart", function(e) {
      dragEl = this;
      this.style.opacity = "0.4";
    });
    row.addEventListener("dragend", function(e) {
      this.style.opacity = "1";
      dragEl = null;
    });
    row.addEventListener("dragover", function(e) {
      e.preventDefault();
    });
    row.addEventListener("drop", function(e) {
      e.preventDefault();
      if (dragEl && dragEl !== this) {
        var parent = this.parentNode;
        // Insert before or after based on position
        var rows = Array.from(parent.children);
        var dragIdx = rows.indexOf(dragEl);
        var dropIdx = rows.indexOf(this);
        if (dragIdx < dropIdx) {
          parent.insertBefore(dragEl, this.nextSibling);
        } else {
          parent.insertBefore(dragEl, this);
        }
        // Save new order via AJAX
        var ids = Array.from(parent.children).map(function(r) { return r.dataset.id; });
        fetch("/settings/kanban_columns/reorder?board_id=" + "<%= @current_board.id %>", {
          method: "PATCH",
          headers: {
            "Content-Type": "application/json",
            "X-CSRF-Token": document.querySelector("meta[name='csrf-token']").content
          },
          body: JSON.stringify({ ids: ids })
        });
      }
    });
  });
});
</script>
