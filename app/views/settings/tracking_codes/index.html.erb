<% content_for :title, "관리번호 코드 관리" %>

<div class="max-w-4xl mx-auto p-6">
  <%# 상위 네비게이션 %>
  <nav class="flex items-center gap-2 text-sm mb-4">
    <%= link_to "설정", settings_root_path, class: "text-[#00A1E0] hover:underline" %>
    <span class="text-gray-400">›</span>
    <span class="text-gray-600 font-medium">관리번호 코드</span>
  </nav>

  <%# Header %>
  <div class="flex items-center justify-between mb-2">
    <div>
      <h1 class="text-xl font-bold text-gray-900 dark:text-white">관리번호 코드</h1>
      <p class="text-sm text-gray-500 mt-1">발주 카드에 표시할 관리번호 코드를 추가·편집·순서 변경합니다. (예: RFQ → R, QUO → Q, PO → P)</p>
    </div>
  </div>

  <%# Flash %>
  <% flash.each do |type, msg| %>
    <div class="mb-3 px-3 py-2 rounded text-sm <%= type == 'notice' ? 'bg-green-50 text-green-800 border border-green-200' : 'bg-red-50 text-red-800 border border-red-200' %>"><%= msg %></div>
  <% end %>

  <%# Errors %>
  <% if @tracking_code&.errors&.any? %>
    <div class="mb-3 px-3 py-2 rounded bg-red-50 border border-red-200 text-red-800 text-sm">
      <% @tracking_code.errors.full_messages.each do |m| %>
        <p><%= m %></p>
      <% end %>
    </div>
  <% end %>

  <%# 등록 폼 %>
  <div class="mb-4 bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-4">
    <h2 class="text-sm font-semibold text-gray-900 dark:text-white mb-3">새 관리번호 추가</h2>
    <%= form_with model: @tracking_code, url: settings_tracking_codes_path, local: true, class: "grid grid-cols-1 md:grid-cols-5 gap-3 items-end" do |f| %>
      <div>
        <label class="block text-xs font-semibold text-gray-600 mb-1.5">코드 (3자 이하)</label>
        <%= f.text_field :code, maxlength: 3, placeholder: "INV", required: true,
            class: "w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:border-[#00A1E0] focus:ring-1 focus:ring-[#00A1E0] uppercase" %>
      </div>
      <div>
        <label class="block text-xs font-semibold text-gray-600 mb-1.5">단축 라벨 (1~2자)</label>
        <%= f.text_field :short_label, maxlength: 2, placeholder: "I",
            class: "w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:border-[#00A1E0] focus:ring-1 focus:ring-[#00A1E0] uppercase" %>
        <p class="text-xs text-gray-500 mt-1">비워두면 코드 첫 글자 사용</p>
      </div>
      <div>
        <label class="block text-xs font-semibold text-gray-600 mb-1.5">풀 라벨 (선택)</label>
        <%= f.text_field :name, placeholder: "Invoice",
            class: "w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:border-[#00A1E0] focus:ring-1 focus:ring-[#00A1E0]" %>
      </div>
      <div>
        <label class="block text-xs font-semibold text-gray-600 mb-1.5">색상</label>
        <%= f.color_field :color, value: "#6366F1", class: "w-full h-[42px] border border-gray-300 rounded-lg cursor-pointer" %>
      </div>
      <div>
        <button type="submit" class="w-full px-3 py-2.5 bg-[#00A1E0] text-white rounded-lg text-sm font-medium hover:bg-[#0083b7]">+ 추가</button>
      </div>
    <% end %>
  </div>

  <%# 목록 테이블 %>
  <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 overflow-hidden">
    <% if @tracking_codes.any? %>
      <table class="w-full text-sm">
        <thead>
          <tr class="bg-gray-50 dark:bg-gray-700 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase">
            <th class="px-4 py-3 w-10">#</th>
            <th class="px-4 py-3">색상</th>
            <th class="px-4 py-3">코드</th>
            <th class="px-4 py-3">단축</th>
            <th class="px-4 py-3">풀 라벨</th>
            <th class="px-4 py-3 text-center">활성</th>
            <th class="px-4 py-3 text-right">작업</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100 dark:divide-gray-700">
          <% @tracking_codes.each do |tc| %>
            <%= form_with model: tc, url: settings_tracking_code_path(tc), method: :patch, local: true, html: { class: "contents" } do |f| %>
              <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50">
                <td class="px-4 py-3 text-gray-500"><%= tc.position %></td>
                <td class="px-4 py-3">
                  <span class="inline-flex items-center gap-2">
                    <%= f.color_field :color, value: tc.color, class: "w-6 h-6 rounded border border-gray-200 cursor-pointer p-0" %>
                  </span>
                </td>
                <td class="px-4 py-3 font-mono font-semibold text-gray-900 dark:text-white">
                  <%= f.text_field :code, value: tc.code, maxlength: 3, class: "w-20 px-2 py-1.5 border border-gray-300 rounded text-sm font-mono uppercase focus:outline-none focus:border-[#00A1E0] focus:ring-1 focus:ring-[#00A1E0]" %>
                </td>
                <td class="px-4 py-3">
                  <span class="inline-flex items-center justify-center w-7 h-7 rounded text-xs font-bold text-white" style="background: <%= tc.color %>;"><%= tc.short_label %></span>
                  <%= f.text_field :short_label, value: tc.short_label, maxlength: 2, class: "ml-2 w-12 px-2 py-1.5 border border-gray-300 rounded text-sm font-mono uppercase focus:outline-none focus:border-[#00A1E0] focus:ring-1 focus:ring-[#00A1E0]" %>
                </td>
                <td class="px-4 py-3">
                  <%= f.text_field :name, value: tc.name, class: "w-full px-2 py-1.5 border border-gray-300 rounded text-sm text-gray-900 focus:outline-none focus:border-[#00A1E0] focus:ring-1 focus:ring-[#00A1E0]" %>
                </td>
                <td class="px-4 py-3 text-center">
                  <%= f.check_box :active, checked: tc.active, class: "w-4 h-4 accent-[#00A1E0]" %>
                </td>
                <td class="px-4 py-3 text-right whitespace-nowrap">
                  <button type="submit" class="px-3 py-1.5 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded text-xs font-medium">저장</button>
                  <%= link_to "삭제", settings_tracking_code_path(tc), method: :delete,
                      data: { turbo_method: :delete, turbo_confirm: "정말 삭제하시겠습니까? '#{tc.code}'에 입력된 모든 번호도 함께 삭제됩니다." },
                      class: "ml-1 px-3 py-1.5 bg-red-50 hover:bg-red-100 text-red-700 rounded text-xs font-medium" %>
                </td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div class="px-6 py-12 text-center text-gray-500">
        <p class="text-sm">등록된 관리번호 코드가 없습니다.</p>
        <p class="text-xs mt-1">위 폼에서 RFQ, QUO, PO 등을 추가하세요.</p>
      </div>
    <% end %>
  </div>
</div>
