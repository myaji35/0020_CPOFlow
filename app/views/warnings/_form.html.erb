<%
  form_url = @warning.persisted? ? employee_warning_path(@employee, @warning) : employee_warnings_path(@employee)
  form_method = @warning.persisted? ? :patch : :post
%>
<%= form_with model: @warning, url: form_url, method: form_method, scope: :warning, local: true, multipart: true, class: "space-y-4" do |f| %>
  <% if @warning.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded p-3 text-xs text-red-700">
      <% @warning.errors.full_messages.each { |m| %><div><%= m %></div><% } %>
    </div>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <label class="block text-xs font-medium text-gray-600 mb-1">발급일시 <span class="text-red-500">*</span></label>
      <%= f.datetime_local_field :issued_at, class: "w-full px-3 py-1.5 text-sm border border-gray-300 rounded-md", required: true %>
    </div>
    <div>
      <label class="block text-xs font-medium text-gray-600 mb-1">유효 기한 (옵션)</label>
      <%= f.date_field :effective_until, class: "w-full px-3 py-1.5 text-sm border border-gray-300 rounded-md" %>
    </div>
    <div>
      <label class="block text-xs font-medium text-gray-600 mb-1">분류 <span class="text-red-500">*</span></label>
      <%= f.select :category, EmployeeWarning::CATEGORIES.map { |c| [EmployeeWarning::CATEGORY_LABELS[c], c] }, {}, class: "w-full px-3 py-1.5 text-sm border border-gray-300 rounded-md" %>
    </div>
    <div>
      <label class="block text-xs font-medium text-gray-600 mb-1">중대도 <span class="text-red-500">*</span></label>
      <%= f.select :severity, EmployeeWarning::SEVERITIES.map { |s| [EmployeeWarning::SEVERITY_LABELS[s], s] }, {}, class: "w-full px-3 py-1.5 text-sm border border-gray-300 rounded-md" %>
    </div>
    <div class="md:col-span-2">
      <label class="block text-xs font-medium text-gray-600 mb-1">제목 <span class="text-red-500">*</span></label>
      <%= f.text_field :subject, class: "w-full px-3 py-1.5 text-sm border border-gray-300 rounded-md", placeholder: "예: 출근 시간 미준수 (3주 누적)", required: true %>
    </div>
    <div class="md:col-span-2">
      <label class="block text-xs font-medium text-gray-600 mb-1">상세 내용</label>
      <%= f.text_area :description, rows: 5, class: "w-full px-3 py-1.5 text-sm border border-gray-300 rounded-md", placeholder: "사실관계, 위반사항, 시정조치 등" %>
    </div>
    <div class="md:col-span-2">
      <label class="block text-xs font-medium text-gray-600 mb-1">상태</label>
      <%= f.select :status, EmployeeWarning::STATUSES.map { |s| [EmployeeWarning::STATUS_LABELS[s], s] }, {}, class: "w-full px-3 py-1.5 text-sm border border-gray-300 rounded-md" %>
    </div>
    <div class="md:col-span-2">
      <label class="block text-xs font-medium text-gray-600 mb-1">첨부 문서 (옵션)</label>
      <%= f.file_field :documents, multiple: true, class: "block w-full text-xs" %>
    </div>
  </div>

  <div class="flex justify-end gap-2 pt-2 border-t">
    <%= link_to "취소", employee_path(@employee, tab: "warnings"), class: "px-4 py-1.5 text-sm border border-gray-300 rounded-md hover:bg-gray-50" %>
    <%= f.submit (@warning.persisted? ? "수정" : "발급"), class: "px-4 py-1.5 bg-primary text-white text-sm font-medium rounded-md hover:bg-blue-700" %>
  </div>
<% end %>
