<% content_for :title, "조직도" %>

<div class="flex flex-col gap-6"
     x-data="{
       search: '',
       matchesSearch(el) {
         if (!this.search.trim()) return true;
         const q = this.search.trim().toLowerCase();
         return el.textContent.toLowerCase().includes(q);
       }
     }">

  <%# Header %>
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-gray-900 dark:text-white">조직도</h1>
      <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">국가 · 법인 · 부서 · 직원 계층 구조</p>
    </div>
    <% if current_user.manager? || current_user.admin? %>
      <div class="flex gap-2">
        <%= link_to new_org_chart_company_path, class: "inline-flex items-center gap-1.5 px-3 py-2 bg-primary text-white text-sm font-medium rounded-lg hover:bg-primary/90 transition-colors" do %>
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          법인 추가
        <% end %>
        <% if current_user.admin? %>
          <%= link_to org_chart_countries_path, class: "inline-flex items-center gap-1.5 px-3 py-2 border border-gray-200 dark:border-gray-600 text-gray-600 dark:text-gray-400 text-sm font-medium rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors" do %>
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
            국가 관리
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>

  <%# 통계 카드 %>
  <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-4">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-lg bg-emerald-50 dark:bg-emerald-900/30 flex items-center justify-center">
          <svg class="w-5 h-5 text-emerald-600 dark:text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
        </div>
        <div>
          <p class="text-2xl font-bold text-gray-900 dark:text-white"><%= @stats[:countries] %></p>
          <p class="text-xs text-gray-500 dark:text-gray-400">국가</p>
        </div>
      </div>
    </div>
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-4">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-lg bg-blue-50 dark:bg-blue-900/30 flex items-center justify-center">
          <svg class="w-5 h-5 text-blue-600 dark:text-blue-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
        </div>
        <div>
          <p class="text-2xl font-bold text-gray-900 dark:text-white"><%= @stats[:companies] %></p>
          <p class="text-xs text-gray-500 dark:text-gray-400">법인</p>
        </div>
      </div>
    </div>
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-4">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-lg bg-violet-50 dark:bg-violet-900/30 flex items-center justify-center">
          <svg class="w-5 h-5 text-violet-600 dark:text-violet-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </div>
        <div>
          <p class="text-2xl font-bold text-gray-900 dark:text-white"><%= @stats[:departments] %></p>
          <p class="text-xs text-gray-500 dark:text-gray-400">부서</p>
        </div>
      </div>
    </div>
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-4">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-lg bg-amber-50 dark:bg-amber-900/30 flex items-center justify-center">
          <svg class="w-5 h-5 text-amber-600 dark:text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        </div>
        <div>
          <p class="text-2xl font-bold text-gray-900 dark:text-white"><%= @stats[:employees] %></p>
          <p class="text-xs text-gray-500 dark:text-gray-400">재직 직원</p>
        </div>
      </div>
    </div>
  </div>

  <% if @countries.empty? %>
    <%# 데이터 없음 %>
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-12 text-center">
      <svg class="w-12 h-12 mx-auto text-gray-300 dark:text-gray-600 mb-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
      <p class="text-gray-500 dark:text-gray-400 text-sm">등록된 조직이 없습니다.</p>
      <% if current_user.admin? %>
        <%= link_to new_org_chart_country_path, class: "mt-3 inline-flex text-sm text-primary hover:underline" do %>
          국가 먼저 추가하기 →
        <% end %>
      <% end %>
    </div>
  <% else %>
    <%# 검색바 %>
    <div class="relative">
      <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400 dark:text-gray-500 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      <input type="text"
             x-model="search"
             placeholder="직원명, 부서명으로 검색..."
             class="w-full pl-10 pr-4 py-2.5 border border-gray-300 dark:border-gray-600 rounded-lg text-sm text-gray-900 dark:text-white bg-white dark:bg-gray-800 placeholder-gray-400 dark:placeholder-gray-500 focus:outline-none focus:border-[#00A1E0] focus:ring-1 focus:ring-[#00A1E0]">
      <button x-show="search.length > 0" @click="search = ''" class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600 dark:hover:text-gray-300">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>

    <%# 국가 탭 %>
    <div x-data="{ country: '<%= @selected_country_code %>' }">
      <div class="flex gap-1 bg-gray-100 dark:bg-gray-700 rounded-lg p-1 w-fit">
        <% @countries.each do |c| %>
          <button
            @click="country = '<%= c.code %>'"
            :class="country === '<%= c.code %>' ? 'bg-white dark:bg-gray-800 shadow text-gray-900 dark:text-white' : 'text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300'"
            class="px-4 py-1.5 rounded-md text-sm font-medium transition-all">
            <%= c.flag_emoji %> <%= c.name %>
          </button>
        <% end %>
      </div>

      <%# 각 국가별 법인 트리 %>
      <% @countries.each do |country| %>
        <div x-show="country === '<%= country.code %>'" class="mt-4 space-y-4">
          <% companies = country.companies.select(&:active?) %>
          <% if companies.empty? %>
            <div class="bg-white dark:bg-gray-800 rounded-xl border border-dashed border-gray-200 dark:border-gray-600 p-8 text-center text-sm text-gray-500 dark:text-gray-400">
              이 국가에 등록된 법인이 없습니다.
              <% if current_user.manager? || current_user.admin? %>
                <%= link_to new_org_chart_company_path(country_id: country.id), class: "ml-2 text-primary hover:underline" do %>법인 추가<% end %>
              <% end %>
            </div>
          <% end %>

          <%# 부서 미배정 직원 %>
          <% unassigned = companies.flat_map { |c| c.employees.active.select { |e| e.department_id.nil? } }.sort_by(&:name) %>
          <% if unassigned.any? %>
            <div class="bg-white dark:bg-gray-800 rounded-xl border border-dashed border-gray-300 dark:border-gray-600 overflow-hidden"
                 x-data x-ref="unassigned" x-show="matchesSearch($refs.unassigned)">
              <div class="flex items-center gap-2 px-5 py-3 border-b border-gray-200 dark:border-gray-700">
                <svg class="w-4 h-4 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                <h3 class="text-sm font-medium text-gray-600 dark:text-gray-400">부서 미배정 (<%= unassigned.count %>명)</h3>
              </div>
              <div class="px-5 py-4">
                <div class="flex flex-wrap gap-2">
                  <% unassigned.each do |emp| %>
                    <%= link_to employee_path(emp), class: "flex items-center gap-2 px-3 py-1.5 bg-gray-50 dark:bg-gray-700 border border-gray-200 dark:border-gray-600 rounded-lg hover:border-primary/50 hover:shadow-sm transition-all" do %>
                      <div class="w-6 h-6 rounded-full bg-gray-200 dark:bg-gray-600 flex items-center justify-center text-gray-600 dark:text-gray-300 text-xs font-bold flex-shrink-0">
                        <%= emp.name.first.upcase %>
                      </div>
                      <div>
                        <p class="text-xs font-medium text-gray-900 dark:text-white"><%= emp.name %></p>
                        <% if emp.job_title.present? %>
                          <p class="text-xs text-gray-500 dark:text-gray-400"><%= emp.job_title %></p>
                        <% end %>
                      </div>
                      <% if emp.active_visa %>
                        <span class="w-2 h-2 rounded-full flex-shrink-0 <%= emp.visa_expiring_soon? ? 'bg-red-400' : 'bg-green-400' %>"></span>
                      <% end %>
                    <% end %>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>

          <% companies.each do |company| %>
            <% company_dept_count = company.departments.select(&:active?).count %>
            <% company_emp_count = company.employees.select(&:active?).count %>
            <div x-data="{ open: true }"
                 x-ref="company_<%= company.id %>"
                 x-show="matchesSearch($refs['company_<%= company.id %>'])"
                 class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 overflow-hidden">
              <%# 법인 헤더 %>
              <div class="flex items-center justify-between px-5 py-4 cursor-pointer hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors"
                   @click="open = !open">
                <div class="flex items-center gap-3">
                  <div class="w-9 h-9 rounded-lg bg-primary/10 dark:bg-primary/20 flex items-center justify-center">
                    <svg class="w-5 h-5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
                  </div>
                  <div>
                    <div class="flex items-center gap-2">
                      <span class="font-semibold text-gray-900 dark:text-white"><%= company.name %></span>
                      <span class="text-xs px-2 py-0.5 rounded-full bg-blue-50 dark:bg-blue-900/30 text-blue-700 dark:text-blue-400"><%= company.company_type_label %></span>
                    </div>
                    <% if company.name_en.present? %>
                      <p class="text-xs text-gray-500 dark:text-gray-400"><%= company.name_en %></p>
                    <% end %>
                  </div>
                </div>
                <div class="flex items-center gap-3">
                  <div class="flex items-center gap-2">
                    <span class="inline-flex items-center gap-1 text-xs text-gray-500 dark:text-gray-400 bg-gray-100 dark:bg-gray-700 px-2 py-0.5 rounded-full">
                      <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                      <%= company_dept_count %>개 부서
                    </span>
                    <span class="inline-flex items-center gap-1 text-xs text-gray-500 dark:text-gray-400 bg-gray-100 dark:bg-gray-700 px-2 py-0.5 rounded-full">
                      <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                      <%= company_emp_count %>명
                    </span>
                  </div>
                  <% if current_user.manager? || current_user.admin? %>
                    <%= link_to edit_org_chart_company_path(company),
                        class: "text-xs text-gray-500 dark:text-gray-400 hover:text-primary px-2 py-1 rounded hover:bg-gray-100 dark:hover:bg-gray-700",
                        onclick: "event.stopPropagation()" do %>수정<% end %>
                  <% end %>
                  <svg :class="open ? 'rotate-180' : ''" class="w-4 h-4 text-gray-400 dark:text-gray-500 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
                </div>
              </div>

              <%# 부서 트리 %>
              <div x-show="open" x-collapse class="border-t border-gray-200 dark:border-gray-700">
                <% root_depts = company.departments.select { |d| d.active? && d.parent_id.nil? }.sort_by { |d| [d.sort_order, d.name] } %>
                <% if root_depts.empty? %>
                  <div class="px-5 py-4 text-sm text-gray-500 dark:text-gray-400 text-center">
                    등록된 부서가 없습니다.
                    <% if current_user.manager? || current_user.admin? %>
                      <%= link_to new_org_chart_company_department_path(company), class: "ml-1 text-primary hover:underline" do %>부서 추가<% end %>
                    <% end %>
                  </div>
                <% else %>
                  <div class="divide-y divide-gray-50 dark:divide-gray-700/50">
                    <% root_depts.each do |dept| %>
                      <% dept_employees = dept.employees.select(&:active?).sort_by(&:name) %>
                      <div x-data="{ deptOpen: false }">
                        <%# 부서 행 %>
                        <div class="flex items-center justify-between px-5 py-3 hover:bg-gray-50 dark:hover:bg-gray-700/50 cursor-pointer"
                             @click="deptOpen = !deptOpen">
                          <div class="flex items-center gap-3 pl-4">
                            <%# 트리 연결선 %>
                            <div class="w-4 flex items-center justify-center text-gray-300 dark:text-gray-600">
                              <svg class="w-4 h-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 0v8h12" stroke-linecap="round" stroke-linejoin="round"/></svg>
                            </div>
                            <div class="w-7 h-7 rounded-md bg-violet-50 dark:bg-violet-900/30 flex items-center justify-center">
                              <svg class="w-4 h-4 text-violet-600 dark:text-violet-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                            </div>
                            <div>
                              <span class="text-sm font-medium text-gray-800 dark:text-gray-200"><%= dept.name %></span>
                              <% if dept.code.present? %>
                                <span class="text-xs text-gray-400 dark:text-gray-500 ml-1">(<%= dept.code %>)</span>
                              <% end %>
                            </div>
                          </div>
                          <div class="flex items-center gap-3">
                            <span class="inline-flex items-center gap-1 text-xs text-gray-500 dark:text-gray-400 bg-gray-100 dark:bg-gray-700 px-2 py-0.5 rounded-full">
                              <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                              <%= dept_employees.count %>명
                            </span>
                            <% if current_user.manager? || current_user.admin? %>
                              <%= link_to edit_org_chart_company_department_path(company, dept),
                                  class: "text-xs text-gray-500 dark:text-gray-400 hover:text-primary px-1.5 py-0.5 rounded hover:bg-gray-100 dark:hover:bg-gray-700",
                                  onclick: "event.stopPropagation()" do %>수정<% end %>
                            <% end %>
                            <svg :class="deptOpen ? 'rotate-180' : ''" class="w-3.5 h-3.5 text-gray-400 dark:text-gray-500 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
                          </div>
                        </div>

                        <%# 직원 목록 %>
                        <div x-show="deptOpen" x-collapse class="bg-gray-50/50 dark:bg-gray-700/20 px-5 py-3 pl-16">
                          <% if dept_employees.empty? %>
                            <p class="text-xs text-gray-500 dark:text-gray-400">배속된 직원이 없습니다.</p>
                          <% else %>
                            <div class="flex flex-wrap gap-2">
                              <% dept_employees.each do |emp| %>
                                <%= link_to employee_path(emp), class: "flex items-center gap-2 px-3 py-1.5 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg hover:border-primary/50 hover:shadow-sm transition-all" do %>
                                  <div class="w-6 h-6 rounded-full <%= Employee::AVATAR_COLORS[emp.nationality] || 'bg-primary' %> flex items-center justify-center text-white text-xs font-bold flex-shrink-0">
                                    <%= emp.name.first.upcase %>
                                  </div>
                                  <div>
                                    <p class="text-xs font-medium text-gray-900 dark:text-white"><%= emp.name %></p>
                                    <% if emp.job_title.present? %>
                                      <p class="text-xs text-gray-500 dark:text-gray-400"><%= emp.job_title %></p>
                                    <% end %>
                                  </div>
                                  <%# 비자 상태 배지 %>
                                  <% if emp.active_visa %>
                                    <span class="w-2 h-2 rounded-full flex-shrink-0 <%= emp.visa_expiring_soon? ? 'bg-red-400' : 'bg-green-400' %>"></span>
                                  <% end %>
                                <% end %>
                              <% end %>
                            </div>
                          <% end %>

                          <%# 하위 부서 %>
                          <% sub_depts = dept.sub_departments.select(&:active?).sort_by { |d| [d.sort_order, d.name] } %>
                          <% sub_depts.each do |sub| %>
                            <% sub_employees = sub.employees.select(&:active?).sort_by(&:name) %>
                            <div x-data="{ subOpen: false }" class="mt-3 pt-3 border-t border-gray-200 dark:border-gray-700">
                              <div class="flex items-center justify-between cursor-pointer" @click="subOpen = !subOpen">
                                <div class="flex items-center gap-2">
                                  <div class="w-4 flex items-center justify-center text-gray-300 dark:text-gray-600">
                                    <svg class="w-3 h-3" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 0v8h12" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                  </div>
                                  <div class="w-5 h-5 rounded bg-gray-200 dark:bg-gray-600 flex items-center justify-center">
                                    <svg class="w-3 h-3 text-gray-500 dark:text-gray-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
                                  </div>
                                  <span class="text-xs font-medium text-gray-600 dark:text-gray-400"><%= sub.name %></span>
                                  <span class="text-xs text-gray-400 dark:text-gray-500 bg-gray-100 dark:bg-gray-700 px-1.5 py-0.5 rounded-full"><%= sub_employees.count %>명</span>
                                </div>
                                <svg :class="subOpen ? 'rotate-180' : ''" class="w-3 h-3 text-gray-400 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
                              </div>
                              <div x-show="subOpen" x-collapse class="mt-2 ml-7">
                                <div class="flex flex-wrap gap-2">
                                  <% sub_employees.each do |emp| %>
                                    <%= link_to employee_path(emp), class: "flex items-center gap-2 px-3 py-1.5 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg hover:border-primary/50 text-xs transition-all" do %>
                                      <div class="w-5 h-5 rounded-full <%= Employee::AVATAR_COLORS[emp.nationality] || 'bg-primary' %> flex items-center justify-center text-white text-xs font-bold"><%= emp.name.first.upcase %></div>
                                      <span class="text-gray-900 dark:text-white"><%= emp.name %></span>
                                    <% end %>
                                  <% end %>
                                  <% if sub_employees.empty? %>
                                    <p class="text-xs text-gray-400 dark:text-gray-500">배속된 직원이 없습니다.</p>
                                  <% end %>
                                </div>
                              </div>
                            </div>
                          <% end %>

                          <% if current_user.manager? || current_user.admin? %>
                            <div class="mt-2 pt-2 border-t border-gray-200 dark:border-gray-700 flex gap-2">
                              <%= link_to new_org_chart_company_department_path(company, parent_id: dept.id),
                                  class: "text-xs text-gray-400 dark:text-gray-500 hover:text-primary" do %>+ 하위 부서<% end %>
                            </div>
                          <% end %>
                        </div>
                      </div>
                    <% end %>
                  </div>

                  <%# 부서 추가 버튼 %>
                  <% if current_user.manager? || current_user.admin? %>
                    <div class="px-5 py-3 border-t border-gray-100 dark:border-gray-700">
                      <%= link_to new_org_chart_company_department_path(company),
                          class: "inline-flex items-center gap-1 text-xs text-gray-400 dark:text-gray-500 hover:text-primary transition-colors" do %>
                        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                        부서 추가
                      <% end %>
                    </div>
                  <% end %>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
