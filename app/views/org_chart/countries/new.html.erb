<% content_for :title, t("org_chart.countries.new.title") %>

<div class="max-w-xl mx-auto py-8 px-4">
  <div class="flex items-center gap-2 text-sm text-gray-500 mb-6">
    <%= link_to t("org_chart.title"), org_chart_path, class: "hover:text-primary" %>
    <span>/</span>
    <%= link_to t("org_chart.countries.index.title"), org_chart_countries_path, class: "hover:text-primary" %>
    <span>/</span>
    <span><%= t("org_chart.countries.new.add") %></span>
  </div>

  <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-6">
    <h1 class="text-lg font-semibold text-gray-900 dark:text-white mb-6"><%= t("org_chart.countries.new.title") %></h1>

    <%= form_with model: [:org_chart, @country], class: "space-y-4" do |f| %>
      <% if @country.errors.any? %>
        <div class="rounded-lg bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 px-4 py-3 text-red-800 dark:text-red-400 text-sm">
          <ul class="list-disc list-inside">
            <% @country.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
          </ul>
        </div>
      <% end %>

      <div class="grid grid-cols-3 gap-4">
        <div>
          <label class="block text-xs font-medium text-gray-600 dark:text-gray-500 mb-1"><%= t("org_chart.countries.form.country_code_iso") %></label>
          <%= f.text_field :code, maxlength: 2, class: "w-full border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white rounded-lg px-3 py-2 text-sm uppercase focus:outline-none focus:ring-2 focus:ring-primary/50", placeholder: "AE" %>
        </div>
        <div>
          <label class="block text-xs font-medium text-gray-600 dark:text-gray-500 mb-1"><%= t("org_chart.countries.form.emoji") %></label>
          <%= f.text_field :flag_emoji, class: "w-full border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/50", placeholder: "🇦🇪" %>
        </div>
        <div>
          <label class="block text-xs font-medium text-gray-600 dark:text-gray-500 mb-1"><%= t("org_chart.countries.form.sort_order") %></label>
          <%= f.number_field :sort_order, value: 0, min: 0, class: "w-full border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/50" %>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-medium text-gray-600 dark:text-gray-500 mb-1"><%= t("org_chart.countries.form.name_ko") %></label>
          <%= f.text_field :name, class: "w-full border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/50", placeholder: "UAE" %>
        </div>
        <div>
          <label class="block text-xs font-medium text-gray-600 dark:text-gray-500 mb-1"><%= t("org_chart.countries.form.name_en") %></label>
          <%= f.text_field :name_en, class: "w-full border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/50", placeholder: "United Arab Emirates" %>
        </div>
      </div>

      <div>
        <label class="block text-xs font-medium text-gray-600 dark:text-gray-500 mb-1"><%= t("org_chart.countries.form.region") %></label>
        <%= f.select :region,
            Country::REGIONS.map { |r| [r, r] },
            { selected: @country.region, include_blank: t("org_chart.countries.form.select") },
            class: "w-full border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/50" %>
      </div>

      <div class="flex justify-end gap-2 pt-2">
        <%= link_to t("actions.cancel"), org_chart_countries_path, class: "px-4 py-2 border border-gray-200 dark:border-gray-600 text-gray-600 dark:text-gray-500 text-sm font-medium rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700" %>
        <%= f.submit t("org_chart.countries.new.title"), class: "px-4 py-2 bg-primary text-white text-sm font-medium rounded-lg cursor-pointer hover:bg-primary/90" %>
      </div>
    <% end %>
  </div>
</div>
