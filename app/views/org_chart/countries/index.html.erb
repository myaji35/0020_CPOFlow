<% content_for :title, t("org_chart.countries.index.title") %>

<div class="max-w-3xl mx-auto py-8 px-4">
  <div class="flex items-center justify-between mb-6">
    <div>
      <div class="flex items-center gap-2 text-sm text-gray-500 mb-1">
        <%= link_to t("org_chart.title"), org_chart_path, class: "hover:text-primary" %>
        <span>/</span>
        <span><%= t("org_chart.countries.index.title") %></span>
      </div>
      <h1 class="text-xl font-bold text-gray-900 dark:text-white"><%= t("org_chart.countries.index.title") %></h1>
    </div>
    <%= link_to new_org_chart_country_path, class: "inline-flex items-center gap-1.5 px-3 py-2 bg-primary text-white text-sm font-medium rounded-lg hover:bg-primary/90" do %>
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      <%= t("org_chart.countries.new.title") %>
    <% end %>
  </div>

  <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 overflow-hidden">
    <% if @countries.empty? %>
      <p class="text-center text-gray-500 dark:text-gray-500 text-sm py-12"><%= t("org_chart.countries.index.empty") %></p>
    <% else %>
      <table class="w-full text-sm">
        <thead class="bg-gray-50 dark:bg-gray-700/50 border-b border-gray-200 dark:border-gray-700">
          <tr>
            <th class="text-left px-4 py-3 text-xs font-medium text-gray-500 dark:text-gray-500"><%= t("org_chart.countries.index.country") %></th>
            <th class="text-left px-4 py-3 text-xs font-medium text-gray-500 dark:text-gray-500"><%= t("org_chart.countries.index.region") %></th>
            <th class="text-left px-4 py-3 text-xs font-medium text-gray-500 dark:text-gray-500"><%= t("org_chart.countries.index.company_count") %></th>
            <th class="px-4 py-3"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-50 dark:divide-gray-700">
          <% @countries.each do |country| %>
            <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50">
              <td class="px-4 py-3">
                <span class="mr-2"><%= country.flag_emoji %></span>
                <span class="font-medium text-gray-900 dark:text-white"><%= country.name %></span>
                <span class="text-gray-500 dark:text-gray-500 ml-1"><%= country.name_en %></span>
                <span class="text-xs text-gray-500 dark:text-gray-500 ml-1">(<%= country.code %>)</span>
              </td>
              <td class="px-4 py-3 text-gray-500 dark:text-gray-500"><%= country.region %></td>
              <td class="px-4 py-3 text-gray-500 dark:text-gray-500"><%= t("org_chart.units.items", count: country.companies.count) %></td>
              <td class="px-4 py-3 text-right">
                <%= link_to t("actions.edit"), edit_org_chart_country_path(country), class: "text-xs text-primary hover:underline mr-3" %>
                <%= link_to t("actions.delete"), org_chart_country_path(country),
                    data: { turbo_method: :delete, turbo_confirm: t("org_chart.countries.index.confirm_delete", name: country.name) },
                    class: "text-xs text-red-500 hover:underline" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </div>
</div>
