<%= form_with model: [:org_chart, company], class: "space-y-4" do |f| %>
  <% if company.errors.any? %>
    <div class="rounded-lg bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 px-4 py-3 text-red-800 dark:text-red-400 text-sm">
      <ul class="list-disc list-inside space-y-1">
        <% company.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <label class="block text-xs font-medium text-gray-600 dark:text-gray-500 mb-1"><%= t("org_chart.companies.form.name_ko") %></label>
      <%= f.text_field :name, class: "w-full border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/50", placeholder: t("org_chart.companies.form.name_placeholder") %>
    </div>
    <div>
      <label class="block text-xs font-medium text-gray-600 dark:text-gray-500 mb-1"><%= t("org_chart.companies.form.name_en") %></label>
      <%= f.text_field :name_en, class: "w-full border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/50", placeholder: "Gagahoho Inc." %>
    </div>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <label class="block text-xs font-medium text-gray-600 dark:text-gray-500 mb-1"><%= t("org_chart.companies.form.company_type") %></label>
      <%= f.select :company_type,
          Company::COMPANY_TYPES.map { |k, v| [v, k] },
          { selected: company.company_type },
          class: "w-full border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/50" %>
    </div>
    <div>
      <label class="block text-xs font-medium text-gray-600 dark:text-gray-500 mb-1"><%= t("org_chart.companies.form.country") %></label>
      <%= f.select :country_id,
          @countries.map { |c| ["#{c.flag_emoji} #{c.name}", c.id] },
          { selected: company.country_id, prompt: t("org_chart.companies.form.select_country") },
          class: "w-full border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/50" %>
    </div>
  </div>

  <div>
    <label class="block text-xs font-medium text-gray-600 dark:text-gray-500 mb-1"><%= t("org_chart.companies.form.registration_number") %></label>
    <%= f.text_field :registration_number, class: "w-full border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/50", placeholder: "000-00-00000" %>
  </div>

  <div>
    <label class="block text-xs font-medium text-gray-600 dark:text-gray-500 mb-1"><%= t("org_chart.companies.form.address") %></label>
    <%= f.text_field :address, class: "w-full border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/50" %>
  </div>

  <% if company.persisted? %>
    <div class="flex items-center gap-2">
      <%= f.check_box :active, class: "rounded border-gray-300 dark:border-gray-600" %>
      <label class="text-sm text-gray-700 dark:text-gray-300"><%= t("org_chart.companies.form.active") %></label>
    </div>
  <% end %>

  <div class="flex justify-end gap-2 pt-2">
    <%= link_to t("actions.cancel"), org_chart_path, class: "px-4 py-2 border border-gray-200 dark:border-gray-600 text-gray-600 dark:text-gray-500 text-sm font-medium rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700" %>
    <%= f.submit company.persisted? ? t("actions.save") : t("org_chart.companies.new.title"), class: "px-4 py-2 bg-primary hover:bg-primary/90 text-white text-sm font-medium rounded-lg cursor-pointer transition-colors" %>
  </div>
<% end %>
