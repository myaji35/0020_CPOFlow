<%= form_with model: [:org_chart, @company, department], class: "space-y-4" do |f| %>
  <% if department.errors.any? %>
    <div class="rounded-lg bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 px-4 py-3 text-red-800 dark:text-red-400 text-sm">
      <ul class="list-disc list-inside space-y-1">
        <% department.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <label class="block text-xs font-medium text-gray-600 dark:text-gray-500 mb-1"><%= t("org_chart.departments.form.name") %></label>
      <%= f.text_field :name, class: "w-full border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/50", placeholder: "Engineering" %>
    </div>
    <div>
      <label class="block text-xs font-medium text-gray-600 dark:text-gray-500 mb-1"><%= t("org_chart.departments.form.code") %></label>
      <%= f.text_field :code, class: "w-full border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/50", placeholder: "ENG" %>
    </div>
  </div>

  <% if @parent_departments.any? %>
    <div>
      <label class="block text-xs font-medium text-gray-600 dark:text-gray-500 mb-1"><%= t("org_chart.departments.form.parent_optional") %></label>
      <%= f.select :parent_id,
          @parent_departments.map { |d| [d.name, d.id] },
          { selected: department.parent_id, include_blank: t("org_chart.departments.form.top_level") },
          class: "w-full border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/50" %>
    </div>
  <% end %>

  <div>
    <label class="block text-xs font-medium text-gray-600 dark:text-gray-500 mb-1"><%= t("org_chart.departments.form.sort_order") %></label>
    <%= f.number_field :sort_order, value: department.sort_order || 0, min: 0,
        class: "w-24 border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/50" %>
  </div>

  <% if department.persisted? %>
    <div class="flex items-center gap-2">
      <%= f.check_box :active, class: "rounded border-gray-300 dark:border-gray-600" %>
      <label class="text-sm text-gray-700 dark:text-gray-300"><%= t("org_chart.departments.form.active") %></label>
    </div>
  <% end %>

  <div class="flex justify-end gap-2 pt-2">
    <%= link_to t("actions.cancel"), org_chart_company_path(@company), class: "px-4 py-2 border border-gray-200 dark:border-gray-600 text-gray-600 dark:text-gray-500 text-sm font-medium rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700" %>
    <%= f.submit department.persisted? ? t("actions.save") : t("org_chart.departments.new.title"), class: "px-4 py-2 bg-primary hover:bg-primary/90 text-white text-sm font-medium rounded-lg cursor-pointer transition-colors" %>
  </div>
<% end %>
