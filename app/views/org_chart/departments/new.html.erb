<% content_for :title, t("org_chart.departments.new.page_title", company: @company.name) %>

<div class="max-w-2xl mx-auto py-8 px-4">
  <div class="flex items-center gap-2 text-sm text-gray-500 mb-6">
    <%= link_to t("org_chart.title"), org_chart_path, class: "hover:text-primary" %>
    <span>/</span>
    <span><%= @company.name %></span>
    <span>/</span>
    <span><%= t("org_chart.departments.new.title") %></span>
  </div>

  <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-6">
    <h1 class="text-lg font-semibold text-gray-900 dark:text-white mb-1"><%= t("org_chart.departments.new.title") %></h1>
    <p class="text-sm text-gray-500 dark:text-gray-500 mb-6"><%= @company.name %></p>
    <%= render "form", department: @department %>
  </div>
</div>
