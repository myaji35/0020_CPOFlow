#!/usr/bin/env bash
# pre-deploy hook — kamal deploy 직전 자동 실행
# 실패 시 배포 중단(exit 1).
#
# 두 가지 게이트:
#   1. 컨트롤러/뷰의 ambiguous column SQL 패턴 grep (재발 방지)
#   2. 마이그레이션이 schema.rb와 동기화되어 있는지 (배포 후 깨짐 방지)
#
# rollback 시는 skip.
set -euo pipefail

if [ "${KAMAL_COMMAND:-}" = "rollback" ]; then
  echo "[pre-deploy] rollback — gates skip"
  exit 0
fi

echo "[pre-deploy] gate 1: ambiguous SQL column patterns"

# scoped_orders가 joins(:user)로 JOIN을 만들기 때문에 created_at/updated_at/id를
# 테이블 prefix 없이 ORDER BY/WHERE 하면 SQLite ambiguous column 5xx로 직결.
# 이미 알려진 안전 패턴(orders.created_at, users.created_at 등)은 제외.
SUSPECT=$(grep -rn -E "Arel\.sql\(\".*[^.]created_at|Arel\.sql\(\".*[^.]updated_at" \
  app/controllers/ 2>/dev/null \
  | grep -vE "orders\.created_at|orders\.updated_at|users\.created_at|users\.updated_at|clients\.created_at|suppliers\.created_at" \
  || true)

if [ -n "$SUSPECT" ]; then
  echo "[pre-deploy] FAIL — ambiguous column risk in Arel.sql:"
  echo "$SUSPECT"
  echo ""
  echo "테이블명을 명시하세요. 예: Arel.sql(\"orders.created_at DESC\")"
  exit 1
fi

echo "[pre-deploy] gate 2: schema.rb ↔ migration 동기화 검증"
# schema.rb의 version과 최신 migration 파일 timestamp 비교 — 어긋나면 schema 미갱신 = prod 깨짐 직결.
# 2026-05-08 incident: impersonation_tokens 마이그레이션이 schema에는 있었으나 prod 컨테이너의
# docker-entrypoint가 db:prepare를 발동 못해 테이블 미생성 → /impersonations 500.
SCHEMA_VERSION=$(grep -oE 'version: [0-9_]+' db/schema.rb | head -1 | awk '{print $2}' | tr -d '_')
LATEST_MIG=$(ls db/migrate/*.rb 2>/dev/null | sort | tail -1 | grep -oE '[0-9]{14}' | head -1)

if [ -z "$SCHEMA_VERSION" ] || [ -z "$LATEST_MIG" ]; then
  echo "[pre-deploy] WARN — schema/migration version 추출 실패 (skip)"
else
  echo "  schema.rb version=$SCHEMA_VERSION / latest migration=$LATEST_MIG"
  if [ "$SCHEMA_VERSION" != "$LATEST_MIG" ]; then
    echo "[pre-deploy] FAIL — schema.rb가 최신 마이그레이션과 동기화되지 않음."
    echo "  로컬에서 'bin/rails db:migrate' 실행 후 schema.rb를 커밋하세요."
    exit 1
  fi
fi

echo "[pre-deploy] gate 3: docker-entrypoint가 ./bin/rails server 인자 매칭하는지"
# CMD 변경 시 entrypoint의 db:prepare 발동 조건이 깨질 수 있음 (2026-05-08 incident 방지)
if ! grep -q "rails.*server\|server.*rails" bin/docker-entrypoint 2>/dev/null; then
  echo "[pre-deploy] FAIL — bin/docker-entrypoint에 server 매칭 로직이 없음"
  exit 1
fi

echo "[pre-deploy] all gates passed"
exit 0
